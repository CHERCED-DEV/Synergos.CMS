<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="9a1134b1-c973-4527-b988-f29f1457ad5c" Alias="sharedContentFolder" Level="2">
  <Info>
    <Name>Shared Content Folder</Name>
    <Icon>icon-folders color-grey</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Contenedor editorial para reusableBlocks. Permite agrupar bloques reutilizables (hero shared, CTA shared, newsletter form shared) en un tree separado. IsListView activo. Structure solo allows reusableBlock children. AllowAtRoot=true — editorial layer gestiona paralelo a siteRoot y settingsRoot.]]></Description>
    <AllowAtRoot>True</AllowAtRoot><IsListView>True</IsListView><Variations>Culture</Variations><IsElement>false</IsElement>
    <HistoryCleanup><PreventCleanup>False</PreventCleanup><KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays><KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays></HistoryCleanup>
    <Folder>Shared</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate><AllowedTemplates />
  </Info>
  <Structure>
    <ContentType SortOrder="0">reusableBlock</ContentType>
  </Structure>
  <GenericProperties />
  <Tabs />
</ContentType>
