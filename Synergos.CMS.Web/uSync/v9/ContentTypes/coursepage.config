  <GenericProperties>
    <GenericProperty><Key>97764bee-85bc-40dd-9c55-229676f41fce</Key><Name>Course Slug</Name><Alias>courseSlug</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Identificador único del curso en minúsculas con guiones. Ej: excel-financiero-2026.]]></Description><SortOrder>0</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage>Slug obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>9d75cfd6-dc10-4f30-8f20-0529b54d468f</Key><Name>Course Title</Name><Alias>courseTitle</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Nombre del curso tal como se anuncia.]]></Description><SortOrder>10</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Culture</Variations><MandatoryMessage>Obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>27f32abf-205b-4a80-9b7c-29e45eb6e8c0</Key><Name>Course Subtitle</Name><Alias>courseSubtitle</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Una línea que diga a quién sirve y para qué. Sale bajo el título en la tarjeta.]]></Description><SortOrder>20</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>0e546105-f62b-4f89-8edc-2eb86e079333</Key><Name>Course Category</Name><Alias>courseCategory</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Escuela o área (Finanzas, Diseño, Datos). Alimenta el filtro: escríbela igual en todos.]]></Description><SortOrder>30</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>ceba5b92-9952-44ad-b881-cbfac1193092</Key><Name>Course Level</Name><Alias>courseLevel</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Escribe beginner, intermediate o advanced. Vacío se trata como beginner.]]></Description><SortOrder>40</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>77bea579-de8a-470b-b05c-b57eb6180634</Key><Name>Price From</Name><Alias>coursePriceFrom</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Precio del plan más barato, SOLO DÍGITOS sin puntos ni símbolos. Escribe 180000, nunca 180.000. Cero o vacío se muestra como gratis.]]></Description><SortOrder>50</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>91e4ebb0-fd2f-4c76-86e2-25f4bdf0ac17</Key><Name>List Price</Name><Alias>courseListPrice</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Precio antes del descuento, SOLO DÍGITOS. Se muestra tachado. Vacío o igual al de arriba oculta el tachado.]]></Description><SortOrder>60</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
