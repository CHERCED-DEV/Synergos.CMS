    <GenericProperty><Key>45a4919b-7abe-4e03-9e3f-abbc1345776c</Key><Name>Badges</Name><Alias>courseBadges</Alias><Definition>08f6ca50-4c60-42a3-a05f-4a33f9727a3f</Definition><Type>Umbraco.MultipleTextstring</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Sellos cortos, uno por línea. Ej: Certificado · Acceso de por vida. Vacío oculta la fila.]]></Description><SortOrder>110</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
