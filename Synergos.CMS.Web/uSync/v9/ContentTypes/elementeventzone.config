<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="b3081892-170a-4784-8cdd-23f5e64252ca" Alias="elementEventZone" Level="2">
  <Info>
    <Name>Evento — Zona del recinto</Name>
    <Icon>icon-grid color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Una zona con asiento numerado: sus filas y cuántas butacas tiene cada una.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Blocks/Eventos</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>5d29684b-160f-4e80-9641-e3195f88d3c7</Key>
      <Name>Código</Name>
      <Alias>zoneId</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Identificador corto y único de la zona, en minúsculas. Ej: platea, palco-norte.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>El código de la zona es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>aaf2f584-8cbc-4228-acc7-cf9001292884</Key>
      <Name>Nombre</Name>
      <Alias>zoneName</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Nombre visible de la zona en el mapa. Ej: Platea, Palco Norte.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El nombre de la zona es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>a9731555-4cb3-4279-8507-32e51c1b9926</Key>
      <Name>Localidad</Name>
      <Alias>zoneTierCode</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Código de la localidad a la que pertenece esta zona. Tiene que existir en la pestaña Entradas.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>Indica a qué localidad pertenece la zona.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>b3de213e-cfd0-4e0b-94c9-0f8604df00db</Key>
      <Name>Precio (COP)</Name>
      <Alias>zonePrice</Alias>
      <Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition>
      <Type>Umbraco.Integer</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Precio de esta zona en pesos enteros. Déjalo en 0 para cobrar el mismo precio de su localidad.]]></Description>
      <SortOrder>30</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>d9973db3-7993-4d49-9def-44d3160495f5</Key>
      <Name>Filas</Name>
      <Alias>zoneRowLabels</Alias>
      <Definition>08f6ca50-4c60-42a3-a05f-4a33f9727a3f</Definition>
      <Type>Umbraco.MultipleTextstring</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[El rótulo de cada fila, uno por línea y en el orden real del recinto. Ej: A, B, C.]]></Description>
      <SortOrder>40</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>Una zona sin filas no tiene asientos que vender.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>64432524-63f1-49bc-8d26-2af2ed74003b</Key>
      <Name>Butacas por fila</Name>
      <Alias>zoneSeatsPerRow</Alias>
      <Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition>
      <Type>Umbraco.Integer</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Cuántas butacas tiene cada fila. Los asientos se numeran solos: A1, A2, A3...]]></Description>
      <SortOrder>50</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>Indica cuántas butacas tiene cada fila.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>96ba8908-b636-48d2-abee-f9029c710147</Key>
      <Caption>Contenido</Caption>
