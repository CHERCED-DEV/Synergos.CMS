<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="46367d43-269b-418d-b54d-075fcf6d658b" Alias="compDomClass" Level="2">
  <Info>
    <Name>Composition — DOM Class</Name>
    <Icon>icon-autofill color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición universal para exponer CSS classes y data attributes al editor en cualquier Element Type o Document Type que se renderice. Usada por el 98% de los elements del legacy (62 de 63). Shareable por diseño (filtro 3 preguntas: concern ortogonal, multi-familia, DRY real). Variations=Nothing: las clases CSS y atributos data-* son decisiones técnicas/diseño, no traducen por idioma.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Nothing</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Dom</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>ad1efd05-14fe-4cad-8489-c7da6ca500be</Key>
      <Name>CSS Class</Name>
      <Alias>cssClass</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[CSS class adicional (o lista separada por espacios) que el renderer añade al atributo class="" del elemento raíz del bloque. Útil para overrides puntuales del design system sin crear una variant nueva (ej. "is-compact bg-neutral-50"). El renderer sanitiza (valida que solo contenga caracteres válidos CSS identifier) antes de emitir. Variations=Nothing.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="dom">DOM</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>d30fc69e-d8a3-4bcd-a7ae-400ca2981bca</Key>
      <Name>CSS Data Attributes</Name>
      <Alias>cssDataAttributes</Alias>
      <Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition>
      <Type>Umbraco.TextArea</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Atributos data-* personalizados, uno por línea en formato clave=valor (ej. "testid=hero-primary\nanalytics-label=homepage-hero"). El renderer emite como data-clave="valor". Útil para selectores QA, tracking, tests E2E sin contaminar CSS classes. Solo caracteres válidos kebab-case en la clave. Variations=Nothing.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="dom">DOM</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
