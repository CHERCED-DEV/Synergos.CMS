<ContentType Key="805dafc6-0b8b-4ff2-8f02-f43ace8ff8fd" Alias="elementSynFormStepper" Level="2">
  <Info>
    <Name>Syn — Form Stepper</Name>
    <Icon>icon-ordered-list color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Formulario por pasos: se guarda como cualquier formulario del sitio.]]></Description>
    <AllowAtRoot>False</AllowAtRoot><IsListView>False</IsListView><Variations>Culture</Variations><IsElement>true</IsElement>
    <HistoryCleanup><PreventCleanup>False</PreventCleanup><KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays><KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays></HistoryCleanup>
    <Folder>Blocks/Syn</Folder>
    <Compositions><Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition><Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition><Composition Key="7a383458-6ea6-4784-a4d1-17f8d4b01073">compDomVisibility</Composition><Composition Key="0a2edb7e-8555-4044-bebc-bf0fe37662f2">compDomSpacing</Composition><Composition Key="1d5bafbb-59af-4002-8709-ebade1be0392">compDomAttributes</Composition></Compositions>
    <DefaultTemplate></DefaultTemplate><AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty><Key>1fe882a1-3d22-4634-bf10-d0fb3523a93c</Key><Name>Clave del formulario</Name><Alias>formInternalKey</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation>^[a-z][a-z0-9-]*$</Validation><Description><![CDATA[Identificador del formulario (ej. "reserva-cita"): con él se guardan y se buscan sus envíos.]]></Description><SortOrder>0</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage>El formulario necesita una clave.</MandatoryMessage><ValidationRegExpMessage>Solo minúsculas, números y guiones; empieza por una letra.</ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>c7358f27-253c-49db-a95a-b0b0d8bf4b20</Key><Name>Pasos</Name><Alias>steps</Alias><Definition>85d0818c-9ded-434f-9ec0-ed8c35afa24a</Definition><Type>Umbraco.BlockList</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Los pasos del formulario, en orden; cada uno con su título y sus campos.]]></Description><SortOrder>10</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Culture</Variations><MandatoryMessage>El formulario debe tener al menos un paso.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>26d52256-6359-4c8a-bdf9-691d111bbaa9</Key><Name>Allow Skip</Name><Alias>allowSkip</Alias><Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition><Type>Umbraco.TrueFalse</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Si activo, se puede avanzar sin completar el paso; al enviar, el sitio igual exige los obligatorios.]]></Description><SortOrder>20</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
  </GenericProperties>
