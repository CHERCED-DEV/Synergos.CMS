<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="95fef9ef-a6b2-454d-af54-b58d03b2a88e" Alias="pageBasic" Level="2">
  <Info>
    <Name>Page — Basic</Name>
    <Icon>icon-document</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Documento base para páginas simples (ADR 0014 + Layout Composer Ola 42.5). Compone compSeo para el título SEO + dos campos editoriales: body richtext (intros/contenido corto via TinyMCE) y sections (Layout Composer — el editor arma topología con presets 1col/2col/main-sidebar/3col/4col con areas y preview visual en backoffice). A partir de Ola 8, vive bajo siteRoot (AllowAtRoot=false). Para páginas editoriales complejas con bodyBlocks (editorial flat) usar pageBase; para landings sin chrome usar pageBare.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Pages</Folder>
    <Compositions>
      <Composition Key="85e75635-b950-4583-b5ca-2a51c08892e3">compSeo</Composition>
    </Compositions>
    <DefaultTemplate>PageBasic</DefaultTemplate>
    <AllowedTemplates>
      <Template Key="85100735-ee7e-423b-8cd5-13f5a1c52351">PageBasic</Template>
    </AllowedTemplates>
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>32db9a09-2ba1-4f8e-b80d-17fb86e0da05</Key>
      <Name>Body</Name>
      <Alias>body</Alias>
      <Definition>ca90c950-0aff-4e72-b976-a30b1ac57dad</Definition>
      <Type>Umbraco.TinyMCE</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Contenido HTML introductorio/corto (richtext TinyMCE). Sanitizado por la pipeline de Umbraco (SanitizeTinyMce=true en appsettings) — el template usa @Html.Raw sin sanitización adicional. Opcional: para contenido editorial estructurado con topología (hero + main-sidebar + 3col) usar sections (Layout Composer) en su lugar. Consumido por PageBasic.cshtml (Ola 7). Expuesto al mapper como PageBasicResponse.BodyHtml.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>21f6b0e7-f1d5-4d9e-9a66-f9aea6f80c6a</Key>
      <Name>Sections (Layout Composer)</Name>
      <Alias>sections</Alias>
      <Definition>bdef3027-193b-4334-b3ee-738eded72215</Definition>
      <Type>Umbraco.BlockGrid</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Layout Composer (Ola 42.5) — el editor arrastra Layout Preset blocks (Section, Container, Stack, Grid, 1col, 2col-even, Main+Sidebar, 3col, 4col) al Block Grid; cada preset define N areas (drop zones) internas donde se dropean los bloques editoriales. El backoffice muestra preview visual con divisiones de columnas vía App_Plugins/LayoutComposer/. Renderizado SSR por los partials en Views/Partials/blockgrid/Components/elementLayout*.cshtml. Usar cuando la página necesita topología (hero + 2col + 3col). Si solo necesitas un richtext corto, usa body. Variations=Culture.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>d93b758b-1c83-46c4-a278-0dff758d8e44</Key>
      <Caption>Content</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>0</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
