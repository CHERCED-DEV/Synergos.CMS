<ContentType Key="5e3ba572-dcf1-4752-b256-d11a79426f6d" Alias="compBranding" Level="2">
  <Info>
    <Name>Composition — Branding</Name>
    <Icon>icon-paint-roller color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Identifica a qué marca pertenece este nodo de configuración cuando hay varias marcas en el sitio.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup><PreventCleanup>False</PreventCleanup><KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays><KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays></HistoryCleanup>
    <Folder>Compositions</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>50ef211c-7c25-491f-93de-a716ee6c7424</Key>
      <Name>Identificador de marca</Name>
      <Alias>brandKey</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation>^[a-z][a-z0-9-]*$</Validation>
      <Description><![CDATA[Identificador único de la marca en minúsculas y guiones (ej. "default", "brand-acme").]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="branding">Branding</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>El brand key es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage>Solo minúsculas, números y guiones (ej. "brand-acme").</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>ee84b66a-a0cb-4734-87fa-a63016e0bfdd</Key>
      <Name>Nombre de marca</Name>
      <Alias>brandDisplayName</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Nombre comercial de la marca (ej. "Synergos", "ACME").]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="branding">Branding</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El display name es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
