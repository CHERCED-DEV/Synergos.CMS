<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="85a37cab-3e4d-482a-b300-f4434c6eefbb" Alias="compContentEmbed" Level="2">
  <Info>
    <Name>Composition — Content Embed</Name>
    <Icon>icon-play color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición reutilizable para referencia a un media embebido de tercero (YouTube, Vimeo, Spotify, SoundCloud, Twitter, etc.). A diferencia de elementIntIframeHost (que es un Element Type standalone para iframes), compContentEmbed se compone en cualquier tipo que necesite LLEVAR un embed junto con otro contenido (ej. un Card con un video debajo del texto). El renderer decide cómo presentarlo (iframe, player nativo, hydrate con JS) según embedType. Variations=Culture en el URL (puede variar por idioma), Nothing en metadata técnica.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Content/Media</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>7dc190d5-1568-4c62-966f-0a8a125dc207</Key>
      <Name>Embed URL</Name>
      <Alias>embedUrl</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation>^https?:\/\/.+$</Validation>
      <Description><![CDATA[URL absoluta del recurso embebido. Ejemplos: https://www.youtube.com/watch?v=<id>, https://vimeo.com/<id>, https://open.spotify.com/track/<id>, https://twitter.com/<user>/status/<id>. El renderer detecta el proveedor del host y elige el mecanismo (iframe oEmbed, player nativo, hydrate). Variations=Culture: el embed puede tener variante localizada (ej. video con voice-over por idioma).]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>La URL debe empezar con http:// o https://</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>5de3cd1d-7d9f-48b2-aa25-5ddc5691eb21</Key>
      <Name>Embed Type</Name>
      <Alias>embedType</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Clave del tipo de embed para ayudar al renderer a elegir el mecanismo: "video", "audio", "social", "code-snippet", "iframe-generic". Si queda vacío, el renderer infiere del host del URL. En olas siguientes se reemplaza por un Dropdown custom con las opciones. Variations=Nothing: clave técnica, no traduce.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>d0c5e527-d052-4b15-a247-ad6b33fa2483</Key>
      <Name>Embed Aspect Ratio</Name>
      <Alias>embedAspectRatio</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation>^\d+:\d+$</Validation>
      <Description><![CDATA[Aspect ratio del embed para evitar layout shift (CLS) durante la carga. Formato "W:H": "16:9" (video HD estándar), "4:3" (video legacy), "1:1" (square), "9:16" (vertical/shorts). Si queda vacío, el renderer asume 16:9 para video y 1:1 para audio/square. Variations=Nothing: técnico.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>Formato aspect ratio: W:H (ej. 16:9)</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>ea921ef5-3346-4881-b895-e20ecf202b2f</Key>
      <Caption>Content</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>10</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
