<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="85a37cab-3e4d-482a-b300-f4434c6eefbb" Alias="compContentEmbed" Level="2">
  <Info>
    <Name>Composition — Content Embed</Name>
    <Icon>icon-play color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Referencia a media embebido externo (YouTube, Vimeo, Spotify, etc.) por URL oEmbed.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Content/Media</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>7dc190d5-1568-4c62-966f-0a8a125dc207</Key>
      <Name>Embed URL</Name>
      <Alias>embedUrl</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[URL absoluta del recurso externo (YouTube, Vimeo, Spotify, Twitter...).]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>5de3cd1d-7d9f-48b2-aa25-5ddc5691eb21</Key>
      <Name>Embed Type</Name>
      <Alias>embedType</Alias>
      <Definition>d357a700-1e92-4780-b916-165a151cfe9b</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Tipo de embed: video/audio/social/generic.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>d0c5e527-d052-4b15-a247-ad6b33fa2483</Key>
      <Name>Embed Aspect Ratio</Name>
      <Alias>embedAspectRatio</Alias>
      <Definition>aafaa63c-146a-4305-848b-0b3bb6b9465f</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation>^\d+:\d+$</Validation>
      <Description><![CDATA[Aspect ratio del embed (ej. "16:9", "4:3") para evitar CLS.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>Formato aspect ratio: W:H (ej. 16:9)</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
