<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="4def9a2d-5d0b-44f5-a85f-2d1713129c34" Alias="elementSynProgressBar" Level="2">
  <Info>
    <Name>Syn — Progress Bar</Name>
    <Icon>icon-settings-alt color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[SynHost block — barra de progreso determinada con ARIA semantics. DOM: <synergos-progress-bar>. Props: valueNow (Nothing numeric), valueMax (Nothing numeric default 100), ariaLabel (Culture). Ideal para fundraising bars, goal trackers, completion indicators.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Syn Blocks</Folder>
    <Compositions>
      <Composition Key="84fe7a74-faa4-434f-acf1-b1ae1a50a90f">compIntegration</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>c1e98dc1-2d6d-4242-b0e2-5af0d7c8d352</Key>
      <Name>Value Now</Name>
      <Alias>valueNow</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation>^\d+(\.\d+)?$</Validation>
      <Description><![CDATA[Valor actual numérico. Float acepado (ej. "42.5"). Variations=Nothing.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>El valor actual es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage>Debe ser número.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>263ceec8-6131-47a2-8ced-1c9c9fe8070b</Key>
      <Name>Value Max</Name>
      <Alias>valueMax</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation>^\d+(\.\d+)?$</Validation>
      <Description><![CDATA[Valor máximo numérico. Default 100. Variations=Nothing.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>Debe ser número.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>ca6c14d8-5ef1-4ae5-a518-59593f0b0be1</Key>
      <Name>Aria Label</Name>
      <Alias>ariaLabel</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Descripción accesible de qué mide la barra (ej. "Recaudación de fondos para la campaña 2026"). WCAG 4.1.2. Variations=Culture.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El aria-label es obligatorio por a11y.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>1ea16dba-7144-496a-894e-1966250966f0</Key>
      <Caption>Integration</Caption>
      <Alias>integration</Alias>
      <Type>Tab</Type>
      <SortOrder>50</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
