<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="e11a9feb-fa1c-4740-9481-3dce56748473" Alias="compDomVariant" Level="2">
  <Info>
    <Name>Composition — DOM Variant</Name>
    <Icon>icon-brush color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición universal para exponer la clave de variante visual del design system (primary/secondary/ghost/outlined/…). El renderer mapea la clave a la clase CSS correspondiente (btn--primary, card--outlined, etc.) siguiendo el design system activo. Usada por el 84% de los elements legacy (53 de 63). Variations=Nothing: la variante es decisión de diseño, no traduce.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Nothing</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Dom</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>c652ad06-09e2-43f7-9aae-edb174189459</Key>
      <Name>Variant Key</Name>
      <Alias>variantKey</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Clave de variante visual del design system Synergos: "primary", "secondary", "ghost", "outlined", "neutral", "emphasis". El renderer mapea al modificador BEM o a clase utilitaria equivalente. Si queda vacía, el renderer usa el default del elemento composante. En olas siguientes esta prop se reemplaza por un Dropdown custom con las variantes enumeradas según design system oficial. Variations=Nothing: técnica.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="style">Estilo</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>a5f4407e-d1a1-4993-bd0f-c65426886695</Key>
      <Caption>Estilo</Caption>
      <Alias>style</Alias>
      <Type>Tab</Type>
      <SortOrder>20</SortOrder>
    </Tab>
