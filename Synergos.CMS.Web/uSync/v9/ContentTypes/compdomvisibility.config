<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="7a383458-6ea6-4784-a4d1-17f8d4b01073" Alias="compDomVisibility" Level="2">
  <Info>
    <Name>Composition — DOM Visibility</Name>
    <Icon>icon-eye color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición para ocultar el bloque en breakpoints específicos (mobile / tablet / desktop). Tres flags booleanos; el renderer los mapea a clases utilitarias CSS (hidden-mobile, hidden-tablet, hidden-desktop) que usa media queries del design system. Variations=Nothing: la decisión de responsive es técnica, no traduce. Unifica compVisibility legacy (misma razón de cambio — SRP).]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Nothing</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Dom</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>e62e69ac-2233-4928-b5e8-e8926af7222a</Key>
      <Name>Hide on Mobile</Name>
      <Alias>hideOnMobile</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Si está activo, el bloque no se renderiza en viewport mobile (< breakpoint md del design system). El renderer emite la clase utilitaria correspondiente; el HTML puede existir en DOM pero oculto via display:none (no SEO-friendly para content crítico). Variations=Nothing.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="visibility">Visibilidad</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>17529e0a-c878-495a-9206-67eedf58b9a6</Key>
      <Name>Hide on Tablet</Name>
      <Alias>hideOnTablet</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Si está activo, el bloque no se renderiza en viewport tablet (md ≤ viewport < lg). Variations=Nothing.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="visibility">Visibilidad</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>8361ba08-4501-4254-bc13-ee9c45adc1b6</Key>
      <Name>Hide on Desktop</Name>
      <Alias>hideOnDesktop</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Si está activo, el bloque no se renderiza en viewport desktop (≥ breakpoint lg). Útil para elementos que solo deben aparecer en mobile (ej. menú hamburguesa inline). Variations=Nothing.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="visibility">Visibilidad</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>c338e227-1a47-4f96-9abd-3e6758725eb4</Key>
      <Caption>Visibilidad</Caption>
      <Alias>visibility</Alias>
      <Type>Tab</Type>
      <SortOrder>20</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
