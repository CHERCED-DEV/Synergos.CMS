<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="610e39a0-bfd1-4786-9ddb-697884da5d4b" Alias="compDomFlex" Level="2">
  <Info>
    <Name>Composition — DOM Flex</Name>
    <Icon>icon-navigation-horizontal color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición con los 6 ejes de un contenedor Flexbox afinados a dropdowns cerrados. Sólo tiene efecto cuando compDomDisplay.displayMode="flex" (o el bloque es flex por default). Seis claves — aliases flexDirection/flexWrap/justifyContent/flexAlignItems/alignContent/flexGap; los dos con prefijo "flex" son para no colisionar con compDomGrid cuando un elemento opta por ambas. Cada una mapea a una utilidad CSS BEM (syn-flex--dir-row, syn-flex--justify-center, etc). Opt-in: container elements que quieran layouts flex (Stack, Section, Container, LogoCloud, Gallery, CtaGroup). Variations=Nothing.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Nothing</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Dom</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>38011b55-755e-4a55-b4a6-8efaf190f734</Key>
      <Name>Flex Direction</Name>
      <Alias>flexDirection</Alias>
      <Definition>a1bb3d8c-7b11-4a00-8f5e-b06edf94ca55</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Dirección del eje principal: "row" (default horizontal), "row-reverse", "column", "column-reverse". Mapea a flex-direction vía clase syn-flex--dir-{value}. Variations=Nothing.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="layout">Layout</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>eda57524-bf3d-43ce-9909-d53859c05fd8</Key>
      <Name>Flex Wrap</Name>
      <Alias>flexWrap</Alias>
      <Definition>76e729ce-1c96-42f7-b1ff-9285c05c1f9c</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Comportamiento cuando los items no caben en una sola línea: "nowrap" (default, todos en una línea), "wrap" (envuelve a nuevas líneas), "wrap-reverse" (envuelve hacia arriba). Mapea a flex-wrap vía clase syn-flex--wrap-{value}. Variations=Nothing.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="layout">Layout</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>7470f6d0-3e4e-4963-94ef-399047a2b41b</Key>
      <Name>Justify Content</Name>
      <Alias>justifyContent</Alias>
      <Definition>1a4530ba-cd81-4fea-a30a-8eca7a85b6c3</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Distribución de los items en el eje principal: "flex-start", "center", "flex-end", "space-between", "space-around", "space-evenly". Mapea a justify-content vía clase syn-flex--justify-{value}. Variations=Nothing.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="layout">Layout</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>7b849e15-3f5e-4692-90cc-d9571b57cc1d</Key>
      <Name>Flex Align Items</Name>
      <Alias>flexAlignItems</Alias>
      <Definition>367fdad2-46c9-4da8-a38d-10e1a5511de2</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Alineación de los items en el eje cruzado: "stretch", "flex-start", "center", "flex-end", "baseline". Mapea a align-items vía clase syn-flex--align-items-{value}. Alias prefijado flexAlignItems para no colisionar con compDomGrid.gridAlignItems en elementos que opten por ambas. Variations=Nothing.]]></Description>
      <SortOrder>30</SortOrder>
      <Tab Alias="layout">Layout</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>d7bc54dd-dcb2-446f-bc62-788f0884f459</Key>
      <Name>Align Content</Name>
      <Alias>alignContent</Alias>
      <Definition>88df9fb5-107e-4ed1-813f-c48cf60ed8bd</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Distribución de múltiples líneas cuando flexWrap!=nowrap: "stretch", "flex-start", "center", "flex-end", "space-between", "space-around". Sólo aplica si hay wrap activo. Mapea a align-content vía clase syn-flex--align-content-{value}. Variations=Nothing.]]></Description>
      <SortOrder>40</SortOrder>
      <Tab Alias="layout">Layout</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>ef713030-4f0c-4c51-b15e-18dddc8fabb3</Key>
      <Name>Flex Gap</Name>
      <Alias>flexGap</Alias>
      <Definition>579a0499-f1ba-487b-9f55-d40b5cf3e415</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Espacio entre items del flex container (ambas direcciones): "none", "xs", "sm", "md", "lg", "xl", "2xl". Mapea a gap con tokens del design system vía clase syn-flex--gap-{value}. Alias prefijado flexGap para no colisionar con compDomGrid.gridGap. Variations=Nothing.]]></Description>
      <SortOrder>50</SortOrder>
      <Tab Alias="layout">Layout</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>89b322e5-736e-49ca-9c50-8e167e4e9f76</Key>
      <Caption>Layout</Caption>
      <Alias>layout</Alias>
      <Type>Tab</Type>
      <SortOrder>20</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
