<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="a651afde-3d2c-4ad4-ad49-7e4b8912f9ad" Alias="elementFormField" Level="2">
  <Info>
    <Name>Form — Field</Name>
    <Icon>icon-document color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native atómico para un único campo de formulario.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Form</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>0423b5b0-1830-444d-b9d1-89e5fdefbe99</Key>
      <Name>Field Label</Name>
      <Alias>fieldLabel</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Etiqueta visible del campo (ej. "Nombre completo").]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>La etiqueta del campo es obligatoria.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>68ef914c-45a9-4b6b-9b46-c3f4a1a33cd6</Key>
      <Name>Field Name</Name>
      <Alias>fieldName</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation>^[a-z][a-zA-Z0-9_-]*$</Validation>
      <Description><![CDATA[Atributo name del <input> (ej. "full_name", "email"). Debe ser único dentro del form container. Formato técnico (slug-like).]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>El nombre técnico del campo es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage>Debe empezar con letra minúscula y contener solo letras, números, guión bajo o guión.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>b94a424d-7cd2-485d-aacc-42cc6601fe78</Key>
      <Name>Field Type</Name>
      <Alias>fieldType</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation>^(text|email|tel|number|textarea|date|url)$</Validation>
      <Description><![CDATA[Tipo de input HTML.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>El tipo de campo es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage>Tipo no permitido. Use: text, email, tel, number, textarea, date, url.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>e0acf3e6-d237-4c0a-b942-77c42c824ba0</Key>
      <Name>Required</Name>
      <Alias>fieldRequired</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Si activo, el renderer emite atributo required y aria-required="true".]]></Description>
      <SortOrder>30</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>5610cb43-4184-406f-ba54-f0d7d7df3f3e</Key>
      <Name>Placeholder</Name>
      <Alias>fieldPlaceholder</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Texto placeholder del input (opcional).]]></Description>
      <SortOrder>40</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>5785af88-cd44-4934-a254-da1c5ffdc26e</Key>
      <Name>Help Text</Name>
      <Alias>fieldHelpText</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Texto auxiliar bajo el input (ej. "Nunca compartiremos tu email"). aria-describedby apunta a este <small>.]]></Description>
      <SortOrder>50</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
