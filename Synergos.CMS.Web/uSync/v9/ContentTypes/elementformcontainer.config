<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="15a5e7b3-b97c-491b-91de-fa7c934e4bc6" Alias="elementFormContainer" Level="2">
  <Info>
    <Name>Form — Container</Name>
    <Icon>icon-notepad color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Bloque para formulario custom construido a partir de N elementFormField.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Blocks/Form</Folder>
    <Compositions>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
    <Composition Key="7a383458-6ea6-4784-a4d1-17f8d4b01073">compDomVisibility</Composition><Composition Key="1d5bafbb-59af-4002-8709-ebade1be0392">compDomAttributes</Composition></Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>203426fb-4d52-4b7c-9f47-0deeabea0594</Key>
      <Name>Form Title</Name>
      <Alias>formTitle</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Título visible del formulario (ej. "Contáctanos"). Opcional.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>034da489-abc1-4651-9cda-51c94456b521</Key>
      <Name>Form Endpoint (external)</Name>
      <Alias>formEndpoint</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation>^https?:\/\/.+$</Validation>
      <Description><![CDATA[URL externa que procesa el form submit (Formspree, Netlify Forms, Mailchimp, etc.). Si dejas Form Internal Key vacío, este campo es obligatorio.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>URL debe empezar con http:// o https://</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>e4564dc8-95f2-4820-b4de-4afe1eeb3d3f</Key>
      <Name>Form Internal Key</Name>
      <Alias>formInternalKey</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation>^[a-z][a-z0-9-]*$</Validation>
      <Description><![CDATA[Identificador slug (ej. "contacto", "newsletter"). Si se completa, el form envía a /api/forms/{key}/submit (manejado por el CMS). Tiene prioridad sobre Form Endpoint.]]></Description>
      <SortOrder>15</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>slug lowercase con guiones (ej. contact-form).</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>36ba6f51-a0c0-4835-9cf6-9e57a8d1556e</Key>
      <Name>Submit Label</Name>
      <Alias>submitLabel</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Texto del botón submit. Default "Enviar".]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>26f8e267-8f0c-490c-8703-976219c0b6cf</Key>
      <Name>Fields</Name>
      <Alias>fields</Alias>
      <Definition>9ca3dab9-57cf-405e-93a4-5aa3f0cd5a51</Definition>
      <Type>Umbraco.BlockList</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Campos del formulario (1+). Cada item es elementFormField. El orden define el orden visual.]]></Description>
      <SortOrder>30</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El form debe contener al menos un campo.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>e4284cf4-2591-4053-b520-f6ee3db0db49</Key>
      <Caption>Contenido</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>10</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
