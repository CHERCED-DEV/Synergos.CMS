      <Composition Key="63495f65-0246-4d64-b5c1-6df3308bfeda">compSiteChrome</Composition>
      <Composition Key="1a5430f1-195a-41d3-bcaa-dfdd2108167a">compTransversalSelectors</Composition>
    </Compositions>
    <DefaultTemplate>SiteRoot</DefaultTemplate>
    <AllowedTemplates>
      <Template Key="d8b7f751-815b-49a4-abb7-944c228d5778">SiteRoot</Template>
    </AllowedTemplates>
  </Info>
  <Structure>
