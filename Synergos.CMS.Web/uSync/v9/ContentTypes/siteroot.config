<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="03d85835-06e4-4d8b-bd18-6088a529cf57" Alias="siteRoot" Level="2">
  <Info>
    <Name>Site Root</Name>
    <Icon>icon-home color-green</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Nodo raíz del árbol de contenido. Único por brand/deployment (Multi-brand en olas futuras expondrá múltiples siteRoot hermanos o hijos de un PlatformRoot). Contiene la identidad del sitio (nombre mostrado, hostname canónico) y actúa como contenedor de todas las páginas publicables. Composiciones: compCoreBase (notas internas) + compSeo (título SEO del sitio, fallback global) + el stack de layout de página (Ola 42: compDomDisplay + compDomFlex + compDomGrid + compDomSpacing — el home del sitio puede cuadrar su topología con dropdowns). Variations=Culture: el nombre del sitio se traduce por idioma.]]></Description>
    <AllowAtRoot>True</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Pages</Folder>
    <Compositions>
      <Composition Key="5e2ec6b8-7f65-4c26-8c20-1b9a72bed2f8">compCoreBase</Composition>
      <Composition Key="85e75635-b950-4583-b5ca-2a51c08892e3">compSeo</Composition>
      <Composition Key="f79a6dcc-aecd-4a2b-bd1e-0de3e08eb800">compDomDisplay</Composition>
      <Composition Key="610e39a0-bfd1-4786-9ddb-697884da5d4b">compDomFlex</Composition>
      <Composition Key="b0bed49d-e17d-4da3-a0ec-453dcb9948f7">compDomGrid</Composition>
      <Composition Key="0a2edb7e-8555-4044-bebc-bf0fe37662f2">compDomSpacing</Composition>
    </Compositions>
    <DefaultTemplate>SiteRoot</DefaultTemplate>
    <AllowedTemplates>
      <Template Key="d8b7f751-815b-49a4-abb7-944c228d5778">SiteRoot</Template>
    </AllowedTemplates>
  </Info>
  <Structure>
    <ContentType Key="b4df602f-1c16-4ad7-8b57-69aa64ff6ad1" SortOrder="0">pageBase</ContentType>
    <ContentType Key="0bd9379d-07eb-49de-802a-e68483322582" SortOrder="1">pageBare</ContentType>
    <ContentType Key="95fef9ef-a6b2-454d-af54-b58d03b2a88e" SortOrder="2">pageBasic</ContentType>
  </Structure>
  <GenericProperties>
    <GenericProperty>
      <Key>a15730c0-3e67-44a9-9007-8e435b9f08d6</Key>
      <Name>Site Display Name</Name>
      <Alias>siteDisplayName</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Nombre humano del sitio mostrado en header, breadcrumbs, emails transaccionales y metadatos og:site_name. Ejemplo: "Acme Colombia" (es-CO) / "Acme North America" (en-US). Requerido. Cap recomendado 50 caracteres. Variations=Culture: se traduce por idioma.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="identity">Identity</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El nombre mostrado del sitio es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>ec7307ca-3e5f-4243-8222-a498ae92678e</Key>
      <Name>Canonical Hostname</Name>
      <Alias>canonicalHostname</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Hostname canónico de producción del sitio (ej. "www.acme.co"). Usado por templates Razor para construir URLs canónicas en <link rel="canonical">, og:url y sitemap.xml. NO se renderiza como texto visible. Variations=Nothing: el hostname es compartido entre idiomas del mismo sitio; i18n se maneja con path prefix (/es-co/, /en-us/), no con hostname distinto.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="identity">Identity</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>f82e7fbf-3fe8-4d06-9f82-41f7196522f1</Key>
      <Caption>Identity</Caption>
      <Alias>identity</Alias>
      <Type>Tab</Type>
      <SortOrder>0</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
