<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="06de133e-ab5f-4c56-970d-5aa8266e6334" Alias="compDomLayout" Level="2">
  <Info>
    <Name>Composition — DOM Layout</Name>
    <Icon>icon-layout color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[LEGACY (Ola 42 — deprecada). Composición original de Ola 12 con layoutAlign + layoutDirection como TextBox libres. Subsumida por compDomFlex + compDomGrid (con dropdowns cerrados contra DT.Select.*). Se mantiene en el schema para backward-compat de Content editorial que la haya consumido; el renderer lee primero las nuevas composiciones y cae a layoutAlign/layoutDirection sólo si las nuevas están vacías. No se añade a nuevos elementos — usar compDomFlex/compDomGrid. Variations=Nothing.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Nothing</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Dom</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
