  <GenericProperties>
    <GenericProperty><Key>6ab2c942-b736-4882-833a-9c99cea18b52</Key><Name>Event Slug</Name><Alias>eventSlug</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Identificador único del evento en minúsculas con guiones. Ej: festival-estereo-2026.]]></Description><SortOrder>0</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage>Slug obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>333e2f4a-028b-4551-9dff-70ee046b7631</Key><Name>Event Title</Name><Alias>eventTitle</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Nombre del evento tal como se anuncia.]]></Description><SortOrder>10</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Culture</Variations><MandatoryMessage>Obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>12532564-e473-41f4-b125-6ec0e7843568</Key><Name>Event Category</Name><Alias>eventCategory</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Categoría del evento (Música, Teatro, Conferencia). Alimenta el filtro: escríbela igual en todos.]]></Description><SortOrder>30</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>6baaac34-273b-416c-bb5b-92c025c6e839</Key><Name>Event City</Name><Alias>eventCity</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Ciudad donde ocurre el evento. Alimenta el filtro de ciudad: escríbela igual en todos.]]></Description><SortOrder>40</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>6203b163-62f7-4467-a109-19de946b16b6</Key><Name>Event Venue</Name><Alias>eventVenue</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Nombre del recinto o sede. Ej: Parque Simón Bolívar.]]></Description><SortOrder>50</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>2fec461e-ddfb-4840-aabe-3bdb997c96ca</Key><Name>Event Start</Name><Alias>eventStart</Alias><Definition>e4d66c0f-b935-4200-81f0-025f7256b89a</Definition><Type>Umbraco.DateTime</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Fecha y hora de inicio, en hora de Colombia. Ordena la agenda: lo próximo va primero.]]></Description><SortOrder>60</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage>Fecha y hora obligatorias.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
