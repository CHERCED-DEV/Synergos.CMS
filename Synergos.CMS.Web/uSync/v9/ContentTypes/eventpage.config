    <GenericProperty><Key>443888de-91f3-4283-afc7-ffa71e9b6061</Key><Name>Price From</Name><Alias>eventPriceFrom</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Precio desde, SOLO DÍGITOS y sin puntos ni símbolos. Escribe 180000, nunca 180.000.]]></Description><SortOrder>80</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>52b8a612-5498-4a43-ad2b-770be87da9b4</Key><Name>Event Mode</Name><Alias>eventMode</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Escribe general (cupo por cantidad) o reserved (asiento numerado). Vacío se trata como general.]]></Description><SortOrder>90</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>834326fe-62bd-43ef-b8d2-d99d5b381371</Key><Name>Venue Latitude</Name><Alias>eventLat</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Latitud del recinto en grados decimales. Ej: 4.6584. Sin ella el evento no sale en el mapa.]]></Description><SortOrder>100</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>d138dac9-5e7e-4d62-be79-4a4b2a995ad3</Key><Name>Venue Longitude</Name><Alias>eventLng</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Longitud del recinto en grados decimales. Ej: -74.0936. Sin ella el evento no sale en el mapa.]]></Description><SortOrder>110</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>4c1c2686-dbe9-4d2f-b751-c0dbf5ec3e37</Key><Name>Descripción</Name><Alias>eventDescription</Alias><Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition><Type>Umbraco.TextArea</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[De qué se trata el evento. Es el cuerpo de la ficha, debajo del título.]]></Description><SortOrder>0</SortOrder><Tab Alias="ficha">Ficha</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>7c420e58-2802-424e-bb5e-502b13d9f8b3</Key><Name>Organiza</Name><Alias>eventOrganizer</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Quién organiza el evento, tal como debe aparecer en la ficha.]]></Description><SortOrder>10</SortOrder><Tab Alias="ficha">Ficha</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>3655fd7d-a01d-4995-9971-775087dcd8c5</Key><Name>Por qué asistir</Name><Alias>eventHighlights</Alias><Definition>08f6ca50-4c60-42a3-a05f-4a33f9727a3f</Definition><Type>Umbraco.MultipleTextstring</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Razones para ir, una por línea. Cada una aporta un dato distinto; vacío oculta la sección.]]></Description><SortOrder>20</SortOrder><Tab Alias="ficha">Ficha</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>19d1131a-6227-4f0f-a16c-fb8d321b220b</Key><Name>Artista o ponente</Name><Alias>eventArtistName</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[El acto protagonista: headliner, keynote o compañía. Vacío oculta el bloque de perfil.]]></Description><SortOrder>30</SortOrder><Tab Alias="ficha">Ficha</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>96bdee90-d0ca-4dc0-aee6-5c124752b15b</Key><Name>Descriptor del artista</Name><Alias>eventArtistHeadline</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Una línea que sitúe al acto. Ej: Headliner · fusión andina y electrónica en vivo.]]></Description><SortOrder>40</SortOrder><Tab Alias="ficha">Ficha</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>91a0cfa2-b54c-4e76-b0d0-554e3c2aee53</Key><Name>Seguidores</Name><Alias>eventArtistFollowers</Alias><Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition><Type>Umbraco.Integer</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Seguimiento social aproximado del acto. 0 o vacío oculta el dato en vez de mostrar cero.]]></Description><SortOrder>50</SortOrder><Tab Alias="ficha">Ficha</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
