<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="60ec9a0d-cb4c-468b-a1da-d69395067fb6" Alias="elementEventTier" Level="2">
  <Info>
    <Name>Evento — Localidad</Name>
    <Icon>icon-ticket color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Una localidad a la venta de un evento: nombre, precio, aforo y qué incluye.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Blocks/Eventos</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>722bbe11-3e04-4309-9cd6-335d81f1b6a3</Key>
      <Name>Código</Name>
      <Alias>tierCode</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Identificador corto y único dentro del evento, en minúsculas. Ej: general, vip, early-bird.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>El código de la localidad es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>bae53712-8b9f-42ae-8d91-c8c2855825fc</Key>
      <Name>Nombre</Name>
      <Alias>tierName</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Nombre visible de la localidad. Ej: Platea VIP, Entrada general.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El nombre de la localidad es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>074181ab-1c7b-4f07-ae3f-bfa3bf54e285</Key>
      <Name>Precio (COP)</Name>
      <Alias>tierPrice</Alias>
      <Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition>
      <Type>Umbraco.Integer</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Precio en pesos colombianos enteros, sin puntos ni símbolos. Escribe 180000, no 180.000. 0 es gratis.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>El precio es obligatorio. Usa 0 si la localidad es gratuita.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>1e75b2b4-77d5-4d4b-95a4-aa62adcd19f6</Key>
      <Name>Aforo</Name>
      <Alias>tierCapacity</Alias>
      <Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition>
      <Type>Umbraco.Integer</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Cuántas entradas de esta localidad hay en total. Si es 0 la localidad no se pone a la venta.]]></Description>
      <SortOrder>30</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>El aforo es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>abbc354a-4f4a-4b22-bf8d-d7d43ebe3ef6</Key>
      <Name>Máximo por compra</Name>
      <Alias>tierMaxPerOrder</Alias>
      <Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition>
      <Type>Umbraco.Integer</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Cuántas entradas puede llevar una misma persona en una compra. Vacío o 0 aplica el tope por defecto de 10.]]></Description>
      <SortOrder>40</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>be0f78ef-7680-4cd9-a574-c41b60bcf79c</Key>
      <Name>Qué incluye</Name>
      <Alias>tierDescription</Alias>
      <Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition>
      <Type>Umbraco.TextArea</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Una línea que explique qué da esta localidad. Sale en el cuerpo de la tarjeta.]]></Description>
      <SortOrder>50</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>63a28596-dab7-46a5-8029-4bbe6536d1ad</Key>
      <Name>Beneficios</Name>
      <Alias>tierPerks</Alias>
      <Definition>08f6ca50-4c60-42a3-a05f-4a33f9727a3f</Definition>
      <Type>Umbraco.MultipleTextstring</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Inclusiones en viñetas, una por línea. Con 2 a 4 la tarjeta se lee bien; vacío oculta la lista.]]></Description>
      <SortOrder>60</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>ffab884e-a2e2-4079-bd74-8f2ad5aefd6a</Key>
      <Name>Ventana de venta</Name>
      <Alias>tierSaleWindow</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Hasta cuándo se vende, tal como quieres que se lea. Ej: Hasta el 12 de julio. Es texto, no cierra la venta.]]></Description>
      <SortOrder>70</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>8378695e-960f-411f-a7c9-beeb9642811a</Key>
      <Name>Recomendada</Name>
      <Alias>tierFeatured</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Destaca esta localidad en la ficha. Marca solo una por evento: si marcas varias se respeta la primera.]]></Description>
      <SortOrder>80</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>3c884432-a7ae-4010-9900-930706569047</Key>
      <Name>Zona del mapa</Name>
      <Alias>tierZoneId</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Solo en eventos con asiento numerado: el código de la zona que cubre esta localidad. Ej: platea.]]></Description>
      <SortOrder>90</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>dc46b167-6d4d-43fb-a667-816a24b7dd46</Key>
      <Caption>Contenido</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>10</SortOrder>
    </Tab>
