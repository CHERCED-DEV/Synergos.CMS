<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="0bd9379d-07eb-49de-802a-e68483322582" Alias="pageBare" Level="1">
  <Info>
    <Name>Page — Bare</Name>
    <Icon>icon-document-dashed-line color-grey</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Documento sin chrome compartido (sin header/footer/nav del layout del sitio). Usar para landings custom, páginas de campaña con branding aislado, iframes embebibles, o flujos donde el layout estándar no aplica. Compone compCoreBase y compSeo (NO compCoreLifecycle porque bare suele ser one-shot sin workflow editorial). El template PageBare renderiza HTML mínimo sin wrapper. AllowAtRoot=false (va bajo siteRoot). Variations=Culture.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Compositions>
      <Composition Key="5e2ec6b8-7f65-4c26-8c20-1b9a72bed2f8">compCoreBase</Composition>
      <Composition Key="85e75635-b950-4583-b5ca-2a51c08892e3">compSeo</Composition>
    </Compositions>
    <DefaultTemplate>PageBare</DefaultTemplate>
    <AllowedTemplates>
      <Template Key="4550e754-adaa-4e8b-8245-29471cd7bbf5">PageBare</Template>
    </AllowedTemplates>
  </Info>
  <Structure>
    <ContentType Key="b4df602f-1c16-4ad7-8b57-69aa64ff6ad1" SortOrder="0">pageBase</ContentType>
    <ContentType Key="0bd9379d-07eb-49de-802a-e68483322582" SortOrder="1">pageBare</ContentType>
    <ContentType Key="95fef9ef-a6b2-454d-af54-b58d03b2a88e" SortOrder="2">pageBasic</ContentType>
  </Structure>
  <GenericProperties>
    <GenericProperty>
      <Key>669ce8d7-8813-42c4-8536-ccf85a97cb6a</Key>
      <Name>Body</Name>
      <Alias>body</Alias>
      <Definition>ca90c950-0aff-4e72-b976-a30b1ac57dad</Definition>
      <Type>Umbraco.TinyMCE</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Contenido HTML único de la página bare. Sanitizado por TinyMCE pipeline. El template PageBare lo emite directamente en el body sin chrome. Útil para landings donde el HTML del body debe ser la totalidad de la página. Variations=Culture.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>6e1efa7f-bca2-4ddc-bbe9-46aece487b55</Key>
      <Caption>Content</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>0</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
