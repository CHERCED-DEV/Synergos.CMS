<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="c646696c-8819-4630-bc7a-121f0839bb16" Alias="elementCompCard" Level="2">
  <Info>
    <Name>Comp — Card</Name>
    <Icon>icon-article color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native composite atómico tipo tarjeta. Sin props propias — reusa compContentHeading (title + subtitle) + compContentText (body opcional) + compContentMedia (imagen/icono opcional) + compContentCta (CTA opcional) + compDomClass + compDomVariant. Renderiza <article class="syn-card"> con header + media + body + cta. Ideal para product cards, team member cards, feature cards standalone. Variations=Culture.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Comp</Folder>
    <Compositions>
      <Composition Key="eb4bd93f-f9d1-44dd-b85e-d64b2084a3ad">compContentHeading</Composition>
      <Composition Key="71d74897-c807-452c-83c3-04c94fd1414b">compContentText</Composition>
      <Composition Key="e2a29901-8155-4d36-80ab-f42b2452a45b">compContentMedia</Composition>
      <Composition Key="92cb0070-0f4d-43a0-84a7-102f60dc41b4">compContentCta</Composition>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
    </Compositions>
