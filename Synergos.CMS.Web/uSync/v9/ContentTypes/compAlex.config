  <Info>
    <Name>Composition — Alex (Top Ribbon)</Name>
    <Icon>icon-alert color-yellow</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Cintilla superior contextual por página: anuncios, alertas, promos. Configurable por variante, tono, visibilidad y horario.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
