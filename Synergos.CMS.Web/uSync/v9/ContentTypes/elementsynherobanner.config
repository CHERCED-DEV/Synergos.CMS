  <Info>
    <Name>Syn — Hero Banner</Name>
    <Icon>icon-movie-alt color-red</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[SynHost block — hero rich con media de fondo, título/subtítulo, CTA, animaciones/parallax del design system. DOM: <synergos-hero-banner>. Diferente de elementCompHero SSR: el CDN block maneja motion (parallax, scroll-linked animations) que requieren JS. Variations=Culture para textos.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
