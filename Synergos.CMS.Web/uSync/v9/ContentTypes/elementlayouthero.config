<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="fef510f5-59c8-4ae8-b499-2188017df5c1" Alias="elementLayoutHero" Level="2">
  <Info>
    <Name>Layout — Hero (Full-Bleed)</Name>
    <Icon>icon-picture color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Layout Composer Ola 42.7 — Preset "Hero full-bleed". Franja superior de página con ancho 100% viewport (sin max-width del container), ideal para el primer impacto visual de una landing: imagen de fondo + eyebrow/heading/cta centrados, o video hero, o animación CDN. Topología: 1 area "content" (12 cols). El renderer emite containerType="full-bleed" por default (el chrome del preset sigue editable). Opt-in: compDomClass + compDomVariant + compDomSpacing + compDomPresetChrome. Variations=Culture. Renderer: Views/Partials/blockgrid/Components/elementLayoutHero.cshtml. Backoffice preview: App_Plugins/LayoutComposer/views/block-layout-hero.html.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Layout</Folder>
    <Compositions>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
      <Composition Key="0a2edb7e-8555-4044-bebc-bf0fe37662f2">compDomSpacing</Composition>
      <Composition Key="7ae5dcf3-5ed1-4ea1-a4e1-cc3a4a474138">compDomPresetChrome</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
