<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="7ae5dcf3-5ed1-4ea1-a4e1-cc3a4a474138" Alias="compDomPresetChrome" Level="2">
  <Info>
    <Name>Composition — DOM Preset Chrome</Name>
    <Icon>icon-item-arrangement color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición exclusiva de los Layout Preset ElementTypes del Layout Composer (Ola 42.5). Controla el chrome del preset: containerType (dropdown — full-bleed/normal/narrow/ultra-narrow, decide el max-width del wrapper), theme (dropdown — light/dark/brand/accent, aplica paleta de color contextual del design system) y cuatro toggles de eliminación granular de spacing (noPaddingTop, noPaddingBottom, noMarginTop, noMarginBottom — útiles cuando un bloque adjacente ya provee separación visual). El renderer SSR y la custom view del backoffice consumen los mismos valores. Opt-in exclusivo de layoutPreset*/elementLayout* — no se añade a elementos generales. Variations=Nothing: decisión visual.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Nothing</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Dom</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>42070d05-2a09-450c-a257-2a132a86d61d</Key>
      <Name>Container Type</Name>
      <Alias>containerType</Alias>
      <Definition>36e49d15-9269-44bb-bd4f-bf04e5e7c7a7</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Ancho del wrapper del preset: "full-bleed" (sin constraint, 100% viewport), "normal" (max-width del design system, default), "narrow" (lectura, ~65ch), "ultra-narrow" (forms/checkout, ~40ch). Mapea a clase syn-preset--container-{value}. Vacío = normal. Variations=Nothing.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="dom">DOM</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>a8a696b7-7ecf-45fd-8b9a-f1dc71114600</Key>
      <Name>Theme</Name>
      <Alias>theme</Alias>
      <Definition>7e753ea1-52d0-41a2-94fc-52c69d3d4438</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Paleta de color contextual del preset: "light" (fondo claro), "dark" (fondo oscuro, invierte contraste), "brand" (color primario del brand vigente via IBrandThemeProvider), "accent" (color secundario). Mapea a clase syn-preset--theme-{value}. Variations=Nothing.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="dom">DOM</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>35968f5e-72e2-4f6c-8794-e8993ae4cbd7</Key>
      <Name>No Padding Top</Name>
      <Alias>noPaddingTop</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Elimina el padding-top del preset. Útil cuando el bloque anterior ya provee separación visual (ej. hero que termina contra el siguiente preset). Mapea a clase syn-preset--no-pad-top. Variations=Nothing.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="dom">DOM</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>9068c4b5-4f36-4704-bcba-b06a2a59a7d0</Key>
      <Name>No Padding Bottom</Name>
      <Alias>noPaddingBottom</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Elimina el padding-bottom del preset. Útil cuando el bloque siguiente ya provee separación. Mapea a clase syn-preset--no-pad-bottom. Variations=Nothing.]]></Description>
      <SortOrder>30</SortOrder>
      <Tab Alias="dom">DOM</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>32ff947e-4b5b-4ba0-b6f1-4a77df314369</Key>
      <Name>No Margin Top</Name>
      <Alias>noMarginTop</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Elimina el margin-top del preset. Combinado con noPaddingTop colapsa la separación superior completa — útil para presets que deben tocar al precedente. Mapea a clase syn-preset--no-mar-top. Variations=Nothing.]]></Description>
      <SortOrder>40</SortOrder>
      <Tab Alias="dom">DOM</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>9ce35dd0-c5b9-491d-9222-39faec051e2b</Key>
      <Name>No Margin Bottom</Name>
      <Alias>noMarginBottom</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Elimina el margin-bottom del preset. Útil para ajuste fino contra el preset siguiente. Mapea a clase syn-preset--no-mar-bottom. Variations=Nothing.]]></Description>
      <SortOrder>50</SortOrder>
      <Tab Alias="dom">DOM</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
