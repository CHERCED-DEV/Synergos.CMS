<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="77440708-6cce-4a20-8679-212aaadd92eb" Alias="compCoreLifecycle" Level="2">
  <Info>
    <Name>Composition — Core Lifecycle</Name>
    <Icon>icon-time color-orange</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición de metadatos de ciclo de vida editorial. Complementa los timestamps nativos de Umbraco (createDate/updateDate/expireDate) con contexto editorial: razón de publicación, aprobador, notas para el siguiente revisor. Variations=Nothing porque el contexto editorial es técnico/interno, no traducible. Componer en DocTypes que requieran trazabilidad editorial formal.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Nothing</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Core</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>2acad371-0b81-4ca3-a4a2-7759c0814736</Key>
      <Name>Publishing Notes</Name>
      <Alias>publishingNotes</Alias>
      <Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition>
      <Type>Umbraco.TextArea</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Contexto editorial para la publicación actual: razón del publish, aprobador, fecha objetivo, TODOs pendientes para revisión. NO se renderiza públicamente. Complementa createDate/updateDate/expireDate nativas de Umbraco con información decisional que queda en el árbol de auditoría del contenido. Variations=Nothing.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="meta">Meta</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
