<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="7152def0-2ea8-4cfc-bca3-792bd3ace8b2" Alias="elementInfoFaqItem" Level="2">
  <Info>
    <Name>Info — FAQ Item</Name>
    <Icon>icon-help color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native para una pregunta+respuesta dentro de una sección FAQ. Compone compContentHeading (pregunta como título) + compContentText (respuesta como richtext body) + compDomClass + compDomVariant. Sin props propias. Renderiza como <details>/<summary>/<div> semántico con soporte accordion via CSS. Agrupar múltiples FAQItems dentro de un container (Ola 16 BlockList). Variations=Culture. Renderer: Views/Partials/Elements/Info/FaqItem.cshtml.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Info</Folder>
    <Compositions>
      <Composition Key="eb4bd93f-f9d1-44dd-b85e-d64b2084a3ad">compContentHeading</Composition>
      <Composition Key="71d74897-c807-452c-83c3-04c94fd1414b">compContentText</Composition>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties />
  <Tabs />
</ContentType>
