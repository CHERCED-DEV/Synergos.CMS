<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="1923996b-f282-49ac-89c5-25f31bcda9d9" Alias="elementSynTag" Level="2">
  <Info>
    <Name>Syn — Tag</Name>
    <Icon>icon-tag color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[SynHost block — chip/tag categórico con color customizable. DOM: <synergos-tag>. Distinto de elementInfoBadge (SSR atómico): Tag es CDN-hosted con capacidad de animación on-hover y color dinámico. Props: tagLabel (Culture), tagColor (Nothing, clave del token de color o hex ej. "primary", "#ff6600"). Variations mixto.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Syn Blocks</Folder>
    <Compositions>
      <Composition Key="84fe7a74-faa4-434f-acf1-b1ae1a50a90f">compIntegration</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>7f96dd17-f625-4dde-8962-ff646eddfee6</Key>
      <Name>Tag Label</Name>
      <Alias>tagLabel</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Texto del tag. Variations=Culture.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El texto del tag es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>6bd9f616-79d6-4770-b4da-a7768c8dea72</Key>
      <Name>Tag Color</Name>
      <Alias>tagColor</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Color del tag. Puede ser clave del token del design system (ej. "primary", "success", "warning") o valor hex (ej. "#ff6600"). Si vacío, el CDN usa default neutral. Variations=Nothing.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
