<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="85e75635-b950-4583-b5ca-2a51c08892e3" Alias="compSeo" Level="2">
  <Info>
    <Name>Composition — SEO</Name>
    <Icon>icon-search color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición de metadatos de optimización para motores de búsqueda. Provee seoTitle (y campos SEO futuros: seoDescription, canonicalUrl, ogImage) a cualquier Document Type que la componga. Variations=Culture: SEO debe localizarse por idioma — Google indexa cada cultura como documento distinto.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>42fb7d9a-124f-41ce-aa9e-696451cfda2c</Key>
      <Name>SEO Title</Name>
      <Alias>seoTitle</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Título que aparece en la pestaña del navegador y como <title> en HTML. Cap recomendado 60 caracteres para no truncarse en SERPs de Google. Consumido por templates Razor (PageBasic, PageBase, SiteRoot en olas siguientes) y como fallback de og:title si no hay override explícito. Se traduce por idioma: cada cultura publicada tendrá su propio seoTitle.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="seo">SEO</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>89277ad8-592d-43fc-a0b9-51631365f134</Key>
      <Caption>SEO</Caption>
      <Alias>seo</Alias>
      <Type>Tab</Type>
      <SortOrder>0</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
