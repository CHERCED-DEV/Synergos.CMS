<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="0084598b-a3cb-4aa3-a15d-a7bcb594e11d" Alias="elementMediaIcon" Level="2">
  <Info>
    <Name>Media — Icon</Name>
    <Icon>icon-pictures-alt color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native para icono decorativo (SVG inline o bitmap). mediaReference de compContentMedia apunta al asset del icono en Media. Si el icono es meramente decorativo, el renderer emite aria-hidden="true" y puede omitir el alt; si conlleva información, mediaAlt es obligatorio. Composiciones: compContentMedia + compDomClass + compDomVariant. Variations=Culture (iconos pueden variar por cultura si tienen texto integrado). Renderer: Views/Partials/Elements/Media/Icon.cshtml.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Media</Folder>
    <Compositions>
      <Composition Key="e2a29901-8155-4d36-80ab-f42b2452a45b">compContentMedia</Composition>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties />
  <Tabs />
</ContentType>
