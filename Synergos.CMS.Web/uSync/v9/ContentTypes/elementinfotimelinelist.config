<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="e3765317-f0b9-4ff3-9699-f17ccbb190d3" Alias="elementInfoTimelineList" Level="2">
  <Info>
    <Name>Info — Timeline List</Name>
    <Icon>icon-activity color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native container para una línea de tiempo vertical u horizontal (hitos históricos, fases de proceso, roadmap). Agrupa 1+ elementInfoTimelineItem via DT.BlockList.TimelineItems. El orden del BlockList define el orden cronológico visual. Props propias: timelineTitle (opcional, Culture) + timelineItems (BlockList mandatory). Composiciones: compDomClass + compDomVariant. Renderer: Views/Partials/Elements/Info/TimelineList.cshtml.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Info</Folder>
    <Compositions>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>68c5e0c0-c2e5-48bd-bead-639be9fad9ec</Key>
      <Name>Timeline Title</Name>
      <Alias>timelineTitle</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Heading opcional del timeline (ej. "Nuestra historia", "Fases del proyecto"). Variations=Culture.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>c64db73e-6777-44dd-918a-2fbbd3e9e55f</Key>
      <Name>Timeline Items</Name>
      <Alias>timelineItems</Alias>
      <Definition>78fec9c6-ff38-48c6-9a42-2078415d674c</Definition>
      <Type>Umbraco.BlockList</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Hitos de la línea de tiempo (1+). Cada item es elementInfoTimelineItem con fecha + título + subtítulo + descripción opcional. El orden del BlockList define el orden cronológico (el editor arrastra). Variations=Culture.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El timeline debe contener al menos un hito.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>cf4164d7-daa6-4287-ac8a-2d266612bc6c</Key>
      <Caption>Content</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>10</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
