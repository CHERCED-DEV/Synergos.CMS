<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="4a23719f-d73b-49b3-8509-da108a7c5a92" Alias="flowDefinition" Level="2">
  <Info>
    <Name>Flow Definition</Name>
    <Icon>icon-directions color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[DocType para definir un flujo editorial (survey, wizard, campaign, onboarding). Child posible de siteRoot o sharedContentFolder. IsListView para exponer steps. Structure allows flowStep children. Props: flowKey (Nothing slug identificador), flowTitle (Culture), flowDescription (Culture), maxSteps (Nothing numeric). Runtime C# flow engine pendiente para ola Flow runtime.]]></Description>
    <AllowAtRoot>False</AllowAtRoot><IsListView>True</IsListView><Variations>Culture</Variations><IsElement>false</IsElement>
    <HistoryCleanup><PreventCleanup>False</PreventCleanup><KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays><KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays></HistoryCleanup>
    <Folder>Flow</Folder>
    <Compositions>
      <Composition Key="5e2ec6b8-7f65-4c26-8c20-1b9a72bed2f8">compCoreBase</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate><AllowedTemplates />
  </Info>
  <Structure>
    <ContentType SortOrder="0">flowStep</ContentType>
  </Structure>
  <GenericProperties>
    <GenericProperty><Key>a82fc8f9-1008-4bda-8e70-82afec0d8506</Key><Name>Flow Key</Name><Alias>flowKey</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation>^[a-z][a-z0-9-]*$</Validation><Description><![CDATA[Identificador técnico del flow (ej. "onboarding-2026", "nps-q4"). slug lowercase. Variations=Nothing.]]></Description><SortOrder>0</SortOrder><Tab Alias="content">Content</Tab><Variations>Nothing</Variations><MandatoryMessage>Obligatorio.</MandatoryMessage><ValidationRegExpMessage>slug lowercase-hyphen.</ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>5e2a3d74-0228-4303-8cc0-15655eef1b7a</Key><Name>Flow Title</Name><Alias>flowTitle</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Título visible del flow. Variations=Culture.]]></Description><SortOrder>10</SortOrder><Tab Alias="content">Content</Tab><Variations>Culture</Variations><MandatoryMessage>Obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>319d5272-76d9-4f46-8c79-f1c6fd15778c</Key><Name>Flow Description</Name><Alias>flowDescription</Alias><Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition><Type>Umbraco.TextArea</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Descripción del flow. Variations=Culture.]]></Description><SortOrder>20</SortOrder><Tab Alias="content">Content</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>feeeea95-d385-4828-9373-aa1c1cb727b4</Key><Name>Max Steps</Name><Alias>maxSteps</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation>^\d+$</Validation><Description><![CDATA[Máximo de steps permitidos en este flow. Variations=Nothing.]]></Description><SortOrder>30</SortOrder><Tab Alias="content">Content</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage>Entero.</ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
  </GenericProperties>
  <Tabs>
