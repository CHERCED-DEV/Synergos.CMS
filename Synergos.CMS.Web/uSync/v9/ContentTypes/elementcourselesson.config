<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="d20c7245-d417-4ed7-97ca-df61236d1473" Alias="elementCourseLesson" Level="2">
  <Info>
    <Name>Curso — Lección</Name>
    <Icon>icon-play color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Una lección del currículum: qué se ve, cuánto dura, su video y su material.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Blocks/Educacion</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>29cd87f8-e210-4dca-8b73-ec4fa2cf92ad</Key>
      <Name>Identificador</Name>
      <Alias>lessonId</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Nombre técnico en minúsculas. Ej: flujo-de-caja. Vacío se genera solo; una vez publicado no lo cambies.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>80c09a61-ce02-404c-99f3-f173bfe2be1f</Key>
      <Name>Título</Name>
      <Alias>lessonTitle</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Qué se ve en esta lección, tal como lo lee el alumno. Ej: Construir el flujo de caja.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El título de la lección es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>46f20249-34a5-419d-af08-9369a4fbb5e8</Key>
      <Name>Duración (minutos)</Name>
      <Alias>lessonDurationMinutes</Alias>
      <Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition>
      <Type>Umbraco.Integer</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Cuánto dura en MINUTOS, no en horas. Una lección de hora y media son 90. Suma al total del curso.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>a4cfdb78-eaae-4537-844c-06016a19f40c</Key>
      <Name>Video</Name>
      <Alias>lessonVideo</Alias>
      <Definition>49391109-580c-46d8-8408-f496b43b6409</Definition>
