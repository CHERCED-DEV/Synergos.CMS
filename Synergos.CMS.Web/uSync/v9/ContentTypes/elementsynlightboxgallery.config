<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="bc1dedcf-a91c-4db6-a65c-fa6bf48dec53" Alias="elementSynLightboxGallery" Level="2">
  <Info>
    <Name>Syn — Lightbox Gallery</Name>
    <Icon>icon-pictures-alt color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[SynHost block — gallery grid con lightbox modal on click. DOM: <synergos-lightbox-gallery>. Distinto de elementMediaGallery SSR (grid estático sin modal). CDN block implementa modal focus-trap + swipe + keyboard navigation. Props: imagesJson (array), columns (1-6).]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Syn Blocks</Folder>
    <Compositions>
      <Composition Key="84fe7a74-faa4-434f-acf1-b1ae1a50a90f">compIntegration</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>39217696-3ccb-4c27-a27b-6d57a9228e16</Key>
      <Name>Images JSON</Name>
      <Alias>imagesJson</Alias>
      <Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition>
      <Type>Umbraco.TextArea</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Array JSON: [{"thumbUrl":"...","fullUrl":"...","alt":"...","caption":"..."}, ...]. Variations=Culture.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>Al menos una imagen es obligatoria.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>3b43d4a8-df23-4fde-90c6-a45cb008b690</Key>
      <Name>Columns</Name>
      <Alias>columns</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation>^[1-6]$</Validation>
      <Description><![CDATA[Número de columnas del grid (1-6). Default 3. Responsive — el CDN block ajusta en viewports pequeños. Variations=Nothing.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>Use 1-6.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>f8fc1736-ab24-48d0-8a0f-62fe4d39907f</Key>
      <Caption>Integration</Caption>
      <Alias>integration</Alias>
      <Type>Tab</Type>
      <SortOrder>50</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
