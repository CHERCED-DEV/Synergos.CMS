<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="fb92f569-2a4e-4ac3-a114-6f62e460abfd" Alias="elementCorpMapEmbed" Level="2">
  <Info>
    <Name>Corp — Map Embed</Name>
    <Icon>icon-map-location color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native para embebir mapa via iframe (Google Maps Embed, OpenStreetMap, Mapbox).]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Corp</Folder>
    <Compositions>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
    <Composition Key="7a383458-6ea6-4784-a4d1-17f8d4b01073">compDomVisibility</Composition></Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>3ac4f342-e34b-429e-b6f5-757aeb195fa6</Key>
      <Name>Map URL</Name>
      <Alias>mapUrl</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation>^https?:\/\/.+$</Validation>
      <Description><![CDATA[URL del embed del mapa (ej. Google Maps /maps/embed?pb=..., OSM /export/embed.html?bbox=...). Mandatory https.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>La URL del mapa es obligatoria.</MandatoryMessage>
      <ValidationRegExpMessage>URL debe empezar con http:// o https://</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>da261363-8453-4df0-8366-461bd407c5fc</Key>
      <Name>Map Title</Name>
      <Alias>mapTitle</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Descripción accesible del mapa (ej. "Mapa de nuestras oficinas en Bogotá"). Mandatory por WCAG 4.1.2 (iframe title).]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El título accesible del mapa es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>d8bb22ef-61f6-4f92-8370-8786637cccc7</Key>
      <Name>Map Height</Name>
      <Alias>mapHeight</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation>^\d{2,4}$</Validation>
      <Description><![CDATA[Altura del iframe en píxeles. Default 450.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>Valor debe ser número entre 2 y 4 dígitos (ej. 450).</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>40e07f0e-2373-4afc-8e96-70de25556003</Key>
      <Caption>Contenido</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>10</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
