      <Alias>bannerCtaLink</Alias>
      <Definition>49391109-580c-46d8-8408-f496b43b6409</Definition>
      <Type>Umbraco.MultiUrlPicker</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Destino del botón. Acepta nodo interno o URL externa.]]></Description>
      <SortOrder>40</SortOrder>
      <Tab Alias="banner">Banner</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
