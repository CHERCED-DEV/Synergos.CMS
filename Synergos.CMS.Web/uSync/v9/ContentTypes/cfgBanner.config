<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="27d804e8-de26-4c46-a2e1-e9e33cb0c21b" Alias="cfgBanner" Level="2">
  <Info>
    <Name>Banner global</Name>
    <Icon>icon-flag color-orange</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Banner promocional global del sitio (campañas, ofertas, anuncios destacados). Aparece automáticamente en todas las páginas.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Settings/Components</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>93cd98d0-ffe2-4fdc-a4bd-0d541b6040c8</Key>
      <Name>Activo</Name>
      <Alias>bannerActive</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Si está apagado, el banner no se muestra. Útil para preparar campañas con anticipación.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="banner">Banner</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>cdd60738-52b4-4ec7-a07e-ea1edce59c26</Key>
      <Name>Mensaje</Name>
      <Alias>bannerMessage</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Texto principal del banner. Recomendado bajo 120 caracteres.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="banner">Banner</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El mensaje del banner es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>60db8263-0426-4619-bee8-1cec995b5bee</Key>
      <Name>Imagen de fondo</Name>
      <Alias>bannerImage</Alias>
      <Definition>ad9f0cf2-bda2-45d5-9ea1-a63cfc873fd3</Definition>
      <Type>Umbraco.MediaPicker3</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Imagen opcional de fondo (1920x300 recomendado). Vacío = banner sólido.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="banner">Banner</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>c9f7658a-fdb1-4be7-9986-58dd06aad0b2</Key>
      <Name>Texto del botón</Name>
      <Alias>bannerCtaLabel</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Etiqueta del botón opcional (ej. "Comprar ahora"). Vacío = sin botón.]]></Description>
      <SortOrder>30</SortOrder>
      <Tab Alias="banner">Banner</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
