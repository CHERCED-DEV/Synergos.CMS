<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="eb4bd93f-f9d1-44dd-b85e-d64b2084a3ad" Alias="compContentHeading" Level="2">
  <Info>
    <Name>Composition — Content Heading</Name>
    <Icon>icon-heading color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición reutilizable para cualquier Element Type o Document Type que necesite un encabezado: título + subtítulo opcional. Se compone típicamente en Hero, Card, Section, Feature, Testimonial y similares. Variations=Culture: los textos del encabezado se traducen por idioma. Para definir el nivel semántico del título (h1/h2/h3) el renderer del tipo composante decide según contexto; esta composición no lo expone como prop al editor por diseño KISS — si un caso real requiere override explícito, se añade la prop con un Dropdown custom en la ola que lo necesite.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Content</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>d9f7a691-4c3e-4955-8167-7af387b35dc0</Key>
      <Name>Heading Title</Name>
      <Alias>headingTitle</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Texto principal del encabezado del bloque. Se renderiza como el heading visible (nivel HTML lo decide el renderer del tipo composante: Hero suele usar h1 en su primera aparición, Section h2, Card h3, etc.). Cap recomendado 120 caracteres. Variations=Culture.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El título del encabezado es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>de8f374f-2091-46b6-a09e-5a9885645f7a</Key>
      <Name>Heading Subtitle</Name>
      <Alias>headingSubtitle</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Texto secundario que acompaña al título (tagline, eyebrow, lead-in). Opcional. Cap recomendado 160 caracteres. El renderer típicamente lo ubica sobre o debajo del título según diseño del bloque; el editor no decide posición. Variations=Culture.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>646f397a-ef06-4530-ac0f-418ee505ee04</Key>
      <Caption>Content</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>10</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
