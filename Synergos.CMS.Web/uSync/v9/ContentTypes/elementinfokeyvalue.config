<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="974cb4b8-0e13-4d26-9d57-0af23d827daa" Alias="elementInfoKeyValue" Level="2">
  <Info>
    <Name>Info — Key Value</Name>
    <Icon>icon-info color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native para un par etiqueta + valor (especificación técnica, dato corto). Ej. "Precio: $199", "Duración: 3 meses", "Garantía: 2 años". Props propias: keyLabel + valueLabel ambos Culture mandatory. Renderiza como <dl><dt>key</dt><dd>value</dd></dl>. Agrupar múltiples dentro de un container (Ola 16 BlockList) para tablas de specs. Composiciones: compDomClass + compDomVariant. Variations=Culture. Renderer: Views/Partials/Elements/Info/KeyValue.cshtml.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Info</Folder>
    <Compositions>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>b2adc47e-4067-4503-a9d4-6bf5bad1b68e</Key>
      <Name>Key Label</Name>
      <Alias>keyLabel</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Etiqueta descriptiva del par (ej. "Precio", "Duración", "Garantía"). Cap recomendado 40 caracteres. Variations=Culture.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>La etiqueta (key) es obligatoria.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>0f1072e8-5359-4b1a-ac22-f4e1f3f8d5cf</Key>
      <Name>Value Label</Name>
      <Alias>valueLabel</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Valor asociado a la etiqueta (ej. "$199 USD", "3 meses", "2 años con soporte 24/7"). Cap recomendado 80 caracteres. Variations=Culture (los valores pueden diferir por mercado local: moneda, tiempo, unidades).]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El valor es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>ef6baf7b-a416-42cc-a5db-c54d9e8a4666</Key>
      <Caption>Content</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>10</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
