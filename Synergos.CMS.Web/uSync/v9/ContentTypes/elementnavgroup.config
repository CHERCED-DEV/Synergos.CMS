    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>50512130-5896-49c5-af32-baabb0f83e88</Key>
      <Name>Nav Heading</Name>
      <Alias>navHeading</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Título opcional del grupo de navegación (ej. "Recursos", "Legal"). Si presente, el renderer emite <h3>. Si vacío, emite <nav aria-label="...">.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>137c68b5-2ad2-4035-b88e-ab894c6e1a2e</Key>
      <Name>Nav Items</Name>
      <Alias>navItems</Alias>
      <Definition>5e4e9abf-2bbd-4331-a92b-11765a653c9c</Definition>
      <Type>Umbraco.BlockList</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Links del grupo (1+). Cada item es elementNavItem. Orden = orden visual.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El grupo debe contener al menos un link.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
