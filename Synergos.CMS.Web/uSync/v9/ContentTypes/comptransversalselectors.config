<ContentType Key="1a5430f1-195a-41d3-bcaa-dfdd2108167a" Alias="compTransversalSelectors" Level="2">
  <Info>
    <Name>Composition — Transversal Selectors</Name>
    <Icon>icon-target color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Selectores explícitos: elige cuál alerta, banner, modal y nota de footer del repositorio están activos en este sitio. Si no eliges, el sistema busca la primera activa del repositorio (legacy fallback).]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
