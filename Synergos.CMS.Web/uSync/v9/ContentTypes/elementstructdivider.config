<ContentType Key="0b6e8259-6a03-4be2-ae28-af59f1987f16" Alias="elementStructDivider" Level="2">
  <Info>
    <Name>Struct — Divider</Name>
    <Icon>icon-bars color-grey</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native atómico para separador horizontal entre secciones. Distinto de elementSynDivider (CDN-hosted web component): este es SSR puro, cero JS. Prop propia: dividerStyle (line | dashed | dotted | gradient | shadow). Composiciones: compDomClass + compDomVariant + compDomSpacing + compDomVisibility. Renderiza <hr class="syn-divider syn-divider--<style>"> semántico. Variations=Nothing (decoración pura).]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Nothing</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Struct</Folder>
    <Compositions>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
