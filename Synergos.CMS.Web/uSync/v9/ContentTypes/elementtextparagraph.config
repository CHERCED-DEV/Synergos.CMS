<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="034b4d6c-44ff-4ba6-bdc4-ad9325cd191b" Alias="elementTextParagraph" Level="2">
  <Info>
    <Name>Text — Paragraph</Name>
    <Icon>icon-article color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native para texto plano multi-línea SIN formato rich (TextArea). Usar cuando el editor necesita párrafo simple sin negritas/enlaces inline — forzar sobriedad visual. Para texto con formato rich, usar elementTextRichtext. Props propias: paragraphText (TextArea Culture). Composiciones: compDomClass, compDomVariant, compDomSpacing. Variations=Culture. Renderer: Views/Partials/Elements/Text/Paragraph.cshtml.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Text</Folder>
    <Compositions>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
      <Composition Key="0a2edb7e-8555-4044-bebc-bf0fe37662f2">compDomSpacing</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>49037216-e989-4292-b7c8-2d1c2aa6e252</Key>
      <Name>Paragraph Text</Name>
      <Alias>paragraphText</Alias>
      <Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition>
      <Type>Umbraco.TextArea</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Párrafo de texto plano multi-línea. NO admite formato (para formato usar elementTextRichtext). El renderer preserva line-breaks como <br> dentro de un <p>. Cap sugerido 500 caracteres; para más extenso considerar elementTextRichtext para mejor UX editorial. Variations=Culture.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El texto del párrafo es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>af9cfc32-46be-4637-a8bd-857fc364206f</Key>
      <Caption>Content</Caption>
      <Alias>content</Alias>
