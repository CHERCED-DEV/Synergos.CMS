<ContentType Key="6fac54b2-6604-4863-8929-cd6b1a09c5f2" Alias="compTenant" Level="2">
  <Info>
    <Name>Composition — Tenant</Name>
    <Icon>icon-server color-grey</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición para identificar tenant en multi-tenancy (una instancia Umbraco sirviendo N clientes aislados). Distinto de compBranding (brands son variaciones estéticas del mismo tenant). Props: tenantKey (Nothing slug mandatory) + tenantDisplayName (Culture). Runtime multi-tenancy routing middleware resolverá por subdomain/path/header. Variations=Culture.]]></Description>
    <AllowAtRoot>False</AllowAtRoot><IsListView>False</IsListView><Variations>Culture</Variations><IsElement>false</IsElement>
    <HistoryCleanup><PreventCleanup>False</PreventCleanup><KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays><KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays></HistoryCleanup>
    <Folder>Compositions/Platform</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate><AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty><Key>9927f536-f711-4266-8c62-7209e0fec75b</Key><Name>Tenant Key</Name><Alias>tenantKey</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation>^[a-z][a-z0-9-]*$</Validation><Description><![CDATA[Identificador técnico del tenant. Ej. "default", "tenant-a". Variations=Nothing.]]></Description><SortOrder>0</SortOrder><Tab Alias="tenant">Tenant</Tab><Variations>Nothing</Variations><MandatoryMessage>Obligatorio.</MandatoryMessage><ValidationRegExpMessage>slug lowercase-hyphen.</ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>126b2e99-c2f8-4adf-97e2-9192cbfffea1</Key><Name>Tenant Display Name</Name><Alias>tenantDisplayName</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Nombre legible del tenant. Variations=Culture.]]></Description><SortOrder>10</SortOrder><Tab Alias="tenant">Tenant</Tab><Variations>Culture</Variations><MandatoryMessage>Obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
  </GenericProperties>
