<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="b0bed49d-e17d-4da3-a0ec-453dcb9948f7" Alias="compDomGrid" Level="2">
  <Info>
    <Name>Composition — DOM Grid</Name>
    <Icon>icon-grid color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición con los 7 ejes de un contenedor CSS Grid afinados a dropdowns cerrados. Sólo tiene efecto cuando compDomDisplay.displayMode="grid" (o el bloque es grid por default). Siete claves — aliases prefijados "grid*" para que un elemento pueda opt-in a compDomFlex y compDomGrid simultáneamente: gridTemplate (columnas predefinidas: 1col/2col-even/2col-8-4/4-8/3col/4col/main-sidebar/sidebar-main/holy-grail), gridRows, justifyItems, gridAlignItems, gridGap, gridColumnGap (override opcional), gridRowGap (override opcional). Opt-in: container elements que quieran grid layouts (Grid, Section, Container, Gallery). Variations=Nothing.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Nothing</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Dom</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>651db898-00b5-4960-a4f2-bd25b8b1826b</Key>
      <Name>Grid Template</Name>
      <Alias>gridTemplate</Alias>
      <Definition>1b465dd0-9797-49c6-b348-f0649fb5d616</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Layout de columnas predefinido. Opciones: "1col" (1 columna full-width), "2col-even" (50/50), "2col-8-4" (67/33), "2col-4-8" (33/67), "3col" (33/33/33), "4col" (25 cada una), "main-sidebar" (2/3 + 1/3), "sidebar-main" (1/3 + 2/3), "holy-grail" (nav + main + aside). Mapea a grid-template-columns vía clase syn-grid--tpl-{value}. Variations=Nothing.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="layout">Layout</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>80ed282e-3931-4cfa-850b-bc85e83d07a2</Key>
      <Name>Grid Rows</Name>
      <Alias>gridRows</Alias>
      <Definition>0cf14574-e367-42e0-b165-6d0c97ee18ff</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Cantidad de filas: "auto" (default, filas implícitas por contenido), "2-rows", "3-rows". Mapea a grid-template-rows vía clase syn-grid--rows-{value}. Variations=Nothing.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="layout">Layout</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>02da78bc-065a-4da9-a034-b408072266e2</Key>
      <Name>Justify Items</Name>
      <Alias>justifyItems</Alias>
      <Definition>aa001a0f-b58e-40df-9095-70a8eaa293bd</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Alineación horizontal de cada item dentro de su celda: "stretch" (default, llena la celda), "start", "center", "end". Mapea a justify-items vía clase syn-grid--justify-items-{value}. Variations=Nothing.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="layout">Layout</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>82178a5d-2454-4a28-a9a8-4dbafcb80e94</Key>
      <Name>Grid Align Items</Name>
      <Alias>gridAlignItems</Alias>
      <Definition>367fdad2-46c9-4da8-a38d-10e1a5511de2</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Alineación vertical de cada item dentro de su celda: "stretch", "flex-start", "center", "flex-end", "baseline". Mapea a align-items vía clase syn-grid--align-items-{value}. Alias prefijado gridAlignItems para no colisionar con compDomFlex.flexAlignItems. Variations=Nothing.]]></Description>
      <SortOrder>30</SortOrder>
      <Tab Alias="layout">Layout</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>636c74cc-b68a-4470-9206-805d3cf09a8c</Key>
      <Name>Grid Gap</Name>
      <Alias>gridGap</Alias>
      <Definition>579a0499-f1ba-487b-9f55-d40b5cf3e415</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Espacio uniforme entre celdas (ambas direcciones): "none", "xs", "sm", "md", "lg", "xl", "2xl". Si se necesita asimetría, usar gridColumnGap + gridRowGap en su lugar. Mapea a gap con tokens del design system vía clase syn-grid--gap-{value}. Alias prefijado gridGap para no colisionar con compDomFlex.flexGap. Variations=Nothing.]]></Description>
      <SortOrder>40</SortOrder>
      <Tab Alias="layout">Layout</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>c9176a72-00d2-4fd5-90f8-df73e956e5a8</Key>
      <Name>Grid Column Gap</Name>
      <Alias>gridColumnGap</Alias>
      <Definition>579a0499-f1ba-487b-9f55-d40b5cf3e415</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Override del gap entre columnas (ignora el gap simétrico si está definido). "none", "xs", "sm", "md", "lg", "xl", "2xl". Útil para grids asimétricos. Mapea a column-gap vía clase syn-grid--col-gap-{value}. Variations=Nothing.]]></Description>
      <SortOrder>50</SortOrder>
      <Tab Alias="layout">Layout</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>b22e0df1-6e45-42fd-aa83-99ae9c9ddaf8</Key>
      <Name>Grid Row Gap</Name>
      <Alias>gridRowGap</Alias>
      <Definition>579a0499-f1ba-487b-9f55-d40b5cf3e415</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Override del gap entre filas (ignora el gap simétrico si está definido). "none", "xs", "sm", "md", "lg", "xl", "2xl". Útil para grids densos verticalmente. Mapea a row-gap vía clase syn-grid--row-gap-{value}. Variations=Nothing.]]></Description>
      <SortOrder>60</SortOrder>
      <Tab Alias="layout">Layout</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>e1f85f5c-ac38-45ae-ab26-16d4f7b5798a</Key>
      <Caption>Layout</Caption>
      <Alias>layout</Alias>
      <Type>Tab</Type>
      <SortOrder>20</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
