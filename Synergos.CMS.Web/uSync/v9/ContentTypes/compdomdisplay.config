<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="f79a6dcc-aecd-4a2b-bd1e-0de3e08eb800" Alias="compDomDisplay" Level="2">
  <Info>
    <Name>Composition — DOM Display</Name>
    <Icon>icon-layout color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición que decide el modelo de display raíz del bloque: "block" (default del navegador), "flex" (activa compDomFlex) o "grid" (activa compDomGrid). Una sola clave: displayMode, dropdown cerrado contra DT.Select.DisplayMode. Opt-in: container elements (Section, Container, Grid, Stack) donde el editor debe poder decidir la topología del layout. El renderer emite la clase BEM syn-display--{value}; los modifiers de flex/grid los aportan las otras composiciones en cascada. Variations=Nothing: decisión visual.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Nothing</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Dom</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>5ac35cc2-462c-49be-8d51-e2b73a77a72d</Key>
      <Name>Display Mode</Name>
      <Alias>displayMode</Alias>
      <Definition>61eda881-37fb-4733-b187-1471c2cb1990</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Modelo de display raíz del bloque: "block" (flujo normal del navegador, default del bloque si no se selecciona), "flex" (ejes principales horizontal/vertical, usa compDomFlex para afinar) o "grid" (matriz 2D, usa compDomGrid). Renderer mapea a clase syn-display--{value}. Vacío = default del bloque. Variations=Nothing.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="dom">DOM</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
