<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="65a8b66a-be4f-4722-a5b2-42fc57a73ebb" Alias="elementCompHero" Level="2">
  <Info>
    <Name>Comp — Hero</Name>
    <Icon>icon-movie-alt color-red</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native composite para sección hero de landing/homepage. Compone compContentHeading (title + subtitle) + compContentText (body opcional) + compContentMedia (imagen/video de fondo) + compDomClass + compDomVariant + compDomSpacing. Prop propia: ctaItems (BlockList, backing reutilizado DT.BlockList.CtaItems, 1-4 CTAs — típicamente primary + secondary). Renderiza <section class="syn-hero"> full-width con media de fondo + overlay de contenido. Variations=Culture.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Comp</Folder>
    <Compositions>
      <Composition Key="eb4bd93f-f9d1-44dd-b85e-d64b2084a3ad">compContentHeading</Composition>
      <Composition Key="71d74897-c807-452c-83c3-04c94fd1414b">compContentText</Composition>
      <Composition Key="e2a29901-8155-4d36-80ab-f42b2452a45b">compContentMedia</Composition>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
      <Composition Key="0a2edb7e-8555-4044-bebc-bf0fe37662f2">compDomSpacing</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
