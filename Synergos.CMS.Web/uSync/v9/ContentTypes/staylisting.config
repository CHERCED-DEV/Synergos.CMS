  <GenericProperties>
    <GenericProperty><Key>b9c8dcfa-357b-4cfe-b54c-91e05d71d370</Key><Name>Slug</Name><Alias>staySlug</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Identificador único de la propiedad en minúsculas con guiones. Ej: ctg-getsemani.]]></Description><SortOrder>0</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage>Slug obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>73165ed8-a703-41a9-9ddd-204b9c1715e5</Key><Name>Nombre</Name><Alias>stayName</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Cómo se anuncia la propiedad. Ej: Casa Getsemaní Boutique.]]></Description><SortOrder>10</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Culture</Variations><MandatoryMessage>Obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>4847b412-5cf8-4d72-baa9-0c56f901db97</Key><Name>Ciudad</Name><Alias>stayCity</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Ciudad de la propiedad. Escríbela igual en todas: es lo que agrupa los resultados.]]></Description><SortOrder>20</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage>La ciudad es obligatoria.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>9ef0078a-bda0-4bad-946f-5afd0ac7ed76</Key><Name>Departamento</Name><Alias>stayRegion</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Departamento donde queda. Ej: Bolívar. Si lo dejas vacío la ficha muestra solo la ciudad.]]></Description><SortOrder>30</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>a70a194c-f97b-4c88-bc8d-d46c13e20c29</Key><Name>Tipos de habitación</Name><Alias>stayRoomTypeCodes</Alias><Definition>08f6ca50-4c60-42a3-a05f-4a33f9727a3f</Definition><Type>Umbraco.MultipleTextstring</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Códigos de tipo de habitación que vende, uno por línea. Ej: DLX. Vacío: solo ficha, sin ofertas.]]></Description><SortOrder>40</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>12fa5d0e-c136-4e3c-a77f-9946f8d02090</Key><Name>Descripción</Name><Alias>stayDescription</Alias><Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition><Type>Umbraco.TextArea</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[El texto de la ficha. Cuenta lo que las características no dicen: entorno, vista, ambiente.]]></Description><SortOrder>0</SortOrder><Tab Alias="ficha">Ficha</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
