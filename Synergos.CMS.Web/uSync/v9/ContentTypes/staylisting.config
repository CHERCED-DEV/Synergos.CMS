    <GenericProperty><Key>ef69e614-a7cd-49a2-991d-351c7feb2606</Key><Name>Amenidades</Name><Alias>stayAmenities</Alias><Definition>08f6ca50-4c60-42a3-a05f-4a33f9727a3f</Definition><Type>Umbraco.MultipleTextstring</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Lo que incluye la propiedad, una por línea. Ej: Wifi, Piscina exterior, Desayuno incluido.]]></Description><SortOrder>20</SortOrder><Tab Alias="ficha">Ficha</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
