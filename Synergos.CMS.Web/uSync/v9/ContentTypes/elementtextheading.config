<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="6ad6f181-661a-48c9-8c36-22f8280f1a22" Alias="elementTextHeading" Level="2">
  <Info>
    <Name>Text — Heading</Name>
    <Icon>icon-font color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native para un heading standalone (h1-h3 según contexto del editor). Sin props propias — todo viene de las compositions. Compone compContentHeading (headingTitle + headingSubtitle), compDomClass, compDomVariant, compDomAttributes (ariaRole/Label cuando la semántica visual no basta). El renderer decide el nivel HTML según contexto (primer heading de la página → h1; heading de sección → h2; heading de card → h3). Variations=Culture. Renderer: Views/Partials/Elements/Text/Heading.cshtml.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Text</Folder>
    <Compositions>
      <Composition Key="eb4bd93f-f9d1-44dd-b85e-d64b2084a3ad">compContentHeading</Composition>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
      <Composition Key="1d5bafbb-59af-4002-8709-ebade1be0392">compDomAttributes</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties />
  <Tabs />
</ContentType>
