<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="ed531586-b8a0-4c8c-be13-a7311017270e" Alias="compBehaviorFeatureFlag" Level="2">
  <Info>
    <Name>Composition — Behavior Feature Flag</Name>
    <Icon>icon-flag color-orange</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición para gate editorial por feature flag (ADR 0011). El editor especifica una clave de feature flag; el renderer consulta IFeatureGate y oculta el bloque si el flag está off. Puente directo entre schema editorial y el sistema de feature flags tipado del appsettings (Synergos:FeatureFlags). Variations=Nothing: la clave del flag es técnica, universal entre idiomas. Un flag específico se define en appsettings.json y se lee via IFeatureGate desde runtime.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Nothing</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Behavior</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>0162e67a-2f11-428f-b74b-a6611362ae98</Key>
      <Name>Feature Flag Key</Name>
      <Alias>featureFlagKey</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Clave del feature flag definido en appsettings.json bajo Synergos:FeatureFlags. Ejemplo: "NewCheckout", "ExperimentalHero2026". Si vacía → el bloque siempre se renderiza (sin gating). Si presente → el renderer consulta IFeatureGate.IsEnabled(key) y oculta el bloque cuando devuelve false. Las claves son gestionadas por el equipo dev/ops, no por editores. En olas futuras se expondrá un Dropdown custom que liste las claves disponibles del appsettings. Variations=Nothing.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="behavior">Behavior</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>4841d636-e4af-4bc2-a9e8-09e23bd69619</Key>
      <Caption>Behavior</Caption>
      <Alias>behavior</Alias>
      <Type>Tab</Type>
      <SortOrder>30</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
