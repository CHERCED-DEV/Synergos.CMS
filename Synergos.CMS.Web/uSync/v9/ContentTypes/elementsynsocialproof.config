<ContentType Key="ea816762-376c-436c-8be6-4700cdfb9db9" Alias="elementSynSocialProof" Level="2">
  <Info>
    <Name>Syn — Social Proof</Name>
    <Icon>icon-users color-green</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[SynHost block — social proof counter live ("X personas están viendo", "Y compras en las últimas 24h"). DOM: <synergos-social-proof>. Rota mensajes según dataSource. Props: template (con tokens {count}, {name}), dataSource (URL GET JSON), rotationInterval (ms).]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup><PreventCleanup>False</PreventCleanup><KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays><KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays></HistoryCleanup>
    <Folder>Syn Blocks</Folder>
    <Compositions><Composition Key="84fe7a74-faa4-434f-acf1-b1ae1a50a90f">compIntegration</Composition></Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty><Key>44b6636b-45aa-450e-8a52-ac487090a3f2</Key><Name>Template</Name><Alias>template</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Template del mensaje con tokens (ej. "{count} personas están viendo esto"). Variations=Culture.]]></Description><SortOrder>0</SortOrder><Tab Alias="integration">Integration</Tab><Variations>Culture</Variations><MandatoryMessage>El template es obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>8dc5debf-95d1-40fc-bcbc-3a9349aa0b0d</Key><Name>Data Source</Name><Alias>dataSource</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation>^https?:\/\/.+|^\/.+$</Validation><Description><![CDATA[URL GET que devuelve datos para el template. Variations=Nothing.]]></Description><SortOrder>10</SortOrder><Tab Alias="integration">Integration</Tab><Variations>Nothing</Variations><MandatoryMessage>El data source es obligatorio.</MandatoryMessage><ValidationRegExpMessage>URL absoluta o path relativo.</ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>d4b57dcb-5c13-48a5-a245-5b57a53263f0</Key><Name>Rotation Interval (ms)</Name><Alias>rotationInterval</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation>^\d+$</Validation><Description><![CDATA[Rotación entre mensajes en ms. Default 8000. Variations=Nothing.]]></Description><SortOrder>20</SortOrder><Tab Alias="integration">Integration</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage>Debe ser entero.</ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
