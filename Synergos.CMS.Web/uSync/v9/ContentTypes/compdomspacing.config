<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="0a2edb7e-8555-4044-bebc-bf0fe37662f2" Alias="compDomSpacing" Level="2">
  <Info>
    <Name>Composition — DOM Spacing</Name>
    <Icon>icon-ruler color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición para espaciado alrededor del bloque: top, bottom, inline (horizontal interno). Tres claves con scale tokens del design system (none/xs/sm/md/lg/xl/2xl) — Ola 42: dropdowns cerrados contra DT.Select.SpacingScale, antes TextBox libre. El renderer mapea a padding/margin utilitarias. Opt-in: solo elementos donde el editor debe ajustar espacio (Hero, Section, Container); elementos atómicos (Button, Badge) no la necesitan. Variations=Nothing: espaciado es decisión visual, no traduce.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Nothing</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Dom</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>52fd5cb7-37ec-419f-b5b4-c79b2292e5e1</Key>
      <Name>Spacing Top</Name>
      <Alias>spacingTop</Alias>
      <Definition>579a0499-f1ba-487b-9f55-d40b5cf3e415</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Scale del espacio superior del bloque: dropdown DT.Select.SpacingScale (none/xs/sm/md/lg/xl/2xl). Vacío = default del diseño. Mapea a margin-top o padding-top según la convención del bloque. Variations=Nothing.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="spacing">Espaciado</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>d42c6826-03a9-4487-bc37-8de1a692aae4</Key>
      <Name>Spacing Bottom</Name>
      <Alias>spacingBottom</Alias>
      <Definition>579a0499-f1ba-487b-9f55-d40b5cf3e415</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Scale del espacio inferior del bloque: dropdown DT.Select.SpacingScale con mismos valores que spacingTop. Variations=Nothing.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="spacing">Espaciado</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>f39c51f5-8e61-4385-9e08-a11cd48fe193</Key>
      <Name>Spacing Inline</Name>
      <Alias>spacingInline</Alias>
      <Definition>579a0499-f1ba-487b-9f55-d40b5cf3e415</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Scale del espacio interno horizontal (padding inline / gap entre hijos si es contenedor): dropdown DT.Select.SpacingScale. Para compDomFlex/compDomGrid usar su propio gap en su lugar; este queda para padding inline genérico. Variations=Nothing.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="spacing">Espaciado</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
