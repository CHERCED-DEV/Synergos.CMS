<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="a8b1573f-427b-493f-89dd-b818ec95816a" Alias="elementTextEyebrow" Level="2">
  <Info>
    <Name>Text — Eyebrow</Name>
    <Icon>icon-tag color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native para texto tipo "eyebrow" — caption corto que precede a un heading (ej. "Nuevo producto", "Caso de estudio"). Renderiza como <span> con clases del design system. Composiciones: compDomClass (styling), compDomVariant (variant key). Variations=Culture en el texto. Renderer: Views/Partials/Elements/Text/Eyebrow.cshtml.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Text</Folder>
    <Compositions>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>f577b137-3c27-4d0f-83b4-efabe477d9e1</Key>
      <Name>Eyebrow Text</Name>
      <Alias>eyebrowText</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Texto del eyebrow. Cap recomendado 40 caracteres para que no rompa la visual jerarquía con el heading siguiente. Ejemplos: "Caso de éxito", "Novedad", "Artículo destacado". Variations=Culture.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El texto del eyebrow es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>3d9c53e8-7ae8-484d-b7d0-31a2ded5f829</Key>
      <Caption>Content</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
