<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="84383010-4c98-4a2c-b67f-a347b00cde81" Alias="compContentMetadata" Level="2">
  <Info>
    <Name>Composition — Content Metadata</Name>
    <Icon>icon-info color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición reutilizable para metadatos editoriales NO destinados a SEO (para SEO usar compSeo). Aporta keywords internas para búsqueda interna del sitio / filtrado, y un summary corto para listados (ej. preview de card en un grid). Distinto de compContentText (cuerpo principal) y compSeo (metadata SEO del motor de búsqueda). Variations=Culture.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Content/Meta</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>e1560e10-aeb8-48b7-866b-6fe013be44f5</Key>
      <Name>Meta Keywords</Name>
      <Alias>metaKeywords</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Lista de keywords internas separadas por coma para búsqueda interna del sitio y filtrado (ej. "innovación, sostenibilidad, consultoría"). NO se emite como meta tag keywords (SEO-muerto desde 2009). Cap recomendado 160 caracteres. Variations=Culture.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>a73ce75b-a783-4376-a5db-5770bd8e9a2f</Key>
      <Name>Meta Summary</Name>
      <Alias>metaSummary</Alias>
      <Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition>
      <Type>Umbraco.TextArea</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Resumen corto del contenido para listados, cards en grids, previews de newsletter. Cap sugerido 200 caracteres; no se emite como meta description (para eso usar compSeo.seoDescription cuando llegue). Útil cuando una página aparece en un blog highlight, article list, o feed donde se muestra un preview. Variations=Culture.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>ef57d2bc-fcd3-4dca-8407-fa51c630d018</Key>
      <Caption>Content</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>10</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
