<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="615c34c6-7a09-4f68-8ddf-e1264254ad76" Alias="cfgAlert" Level="2">
  <Info>
    <Name>Alerta global</Name>
    <Icon>icon-alert color-yellow</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Cintilla superior global (anuncios, alertas, promos). Aparece automáticamente en todas las páginas del sitio.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Settings/Components</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>6aeec875-870e-4ed0-94af-85c019f92ff5</Key>
      <Name>Activa</Name>
      <Alias>alertActive</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Si está apagada, la alerta no se muestra. Útil para preparar avisos con anticipación.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="alert">Alerta</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>e0af53ca-29c0-4ede-82c7-3a1df5df8819</Key>
      <Name>Mensaje</Name>
      <Alias>alertMessage</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Texto principal. Corto y claro (idealmente bajo 90 caracteres).]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="alert">Alerta</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El mensaje de la alerta es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>d45af270-b104-4a4a-951e-d693a3b83ca8</Key>
      <Name>Variante</Name>
