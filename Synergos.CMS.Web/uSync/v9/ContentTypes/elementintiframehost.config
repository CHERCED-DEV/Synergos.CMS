<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="5fe3cde6-a3b1-4afe-a5a4-a3730594ef29" Alias="elementIntIframeHost" Level="2">
  <Info>
    <Name>Int — Iframe Host</Name>
    <Icon>icon-application-window-alt color-black</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description>Element Type para embeber un iframe de un origen externo (YouTube, Vimeo, Typeform, Maps, widgets third-party). NO es el mecanismo para montar componentes de la CDN Synergos (para eso usar elementSyn*). Provee iframeSrc (URL), sandboxFlags (flags HTML5 sandbox), iframeTitle (a11y). Variations=Culture: el iframe src puede variar por idioma — ej. video localizado o form traducido. Usar en Block Grid o LayoutComposer. Renderer: Views/Partials/SynHost/IframeHost.cshtml.</Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Integrations</Folder>
    <Compositions>
      <Composition Key="84fe7a74-faa4-434f-acf1-b1ae1a50a90f">compIntegration</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>32e3a812-5b77-4d1f-8b8e-1ad5ebfaec89</Key>
      <Name>Iframe Source URL</Name>
      <Alias>iframeSrc</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation>^https?:\/\/.+$</Validation>
      <Description><![CDATA[URL absoluta del recurso a embeber (https:// requerido en producción).]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="integration">Integración</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>La URL del iframe es obligatoria.</MandatoryMessage>
      <ValidationRegExpMessage>La URL debe empezar con http:// o https://</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>0d8d27f1-8785-40f4-a33e-50bda25b5a2b</Key>
      <Name>Iframe Title (A11y)</Name>
      <Alias>iframeTitle</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Título accesible del iframe (atributo title="").]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="integration">Integración</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El título accesible es obligatorio por WCAG.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>368acec7-7c7e-4336-8bb1-532a67458153</Key>
      <Name>Sandbox Flags</Name>
      <Alias>sandboxFlags</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Flags del atributo HTML5 sandbox="" que restringen capacidades del iframe.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="integration">Integración</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>8a67604a-277f-4fd0-806d-93f1c812446c</Key>
      <Caption>Integración</Caption>
      <Alias>integration</Alias>
      <Type>Tab</Type>
      <SortOrder>50</SortOrder>
    </Tab>
  </Tabs>
</ContentType>