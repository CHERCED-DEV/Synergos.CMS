<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="965aba1a-2ea6-4ba2-98ab-a928ff4f4ee8" Alias="elementEventSession" Level="2">
  <Info>
    <Name>Evento — Punto de agenda</Name>
    <Icon>icon-time color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Una entrada de la agenda del evento: a qué hora, qué pasa y quién lo hace.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Blocks/Eventos</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>7178b773-c4ca-4a15-85b7-b73bdd0d2b75</Key>
      <Name>Hora</Name>
      <Alias>sessionTime</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation>^([01]?[0-9]|2[0-3]):[0-5][0-9]$</Validation>
      <Description><![CDATA[Hora de inicio en formato de 24 horas. Ej: 14:00. Ordena la agenda de la más temprana a la más tarde.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>La hora es obligatoria.</MandatoryMessage>
      <ValidationRegExpMessage>Escribe la hora como HH:MM en formato de 24 horas. Ej: 09:30, 14:00, 22:15.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>44b27f21-972e-4c4b-b03c-db9705a52c01</Key>
      <Name>Qué pasa</Name>
      <Alias>sessionTitle</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Qué ocurre a esa hora. Ej: Apertura de puertas, Charla de apertura.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>Escribe qué pasa a esa hora.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>586cb2d3-03e1-499d-8c0a-6bd4103928f8</Key>
      <Name>Quién</Name>
      <Alias>sessionSpeaker</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Artista, ponente o compañía a cargo. Déjalo vacío si no aplica; no inventes un nombre.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>ecbffedc-9951-4135-8944-282993de927d</Key>
      <Caption>Contenido</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>10</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
