<ContentType Key="f0b04253-d9cb-49b8-83d8-01801597daed" Alias="elementSynMapPin" Level="2">
  <Info>
    <Name>Syn — Map with Pins</Name>
    <Icon>icon-map color-green</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[mapa interactivo con pins custom (Leaflet/Mapbox/OSM).]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Syn</Folder>
    <Compositions>
      <Composition Key="84fe7a74-faa4-434f-acf1-b1ae1a50a90f">compIntegration</Composition>
    <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition><Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition><Composition Key="7a383458-6ea6-4784-a4d1-17f8d4b01073">compDomVisibility</Composition><Composition Key="0a2edb7e-8555-4044-bebc-bf0fe37662f2">compDomSpacing</Composition><Composition Key="1d5bafbb-59af-4002-8709-ebade1be0392">compDomAttributes</Composition></Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>76cfe76a-06dc-43c2-9816-74cbdb0e120f</Key>
      <Name>Center Latitude</Name>
      <Alias>centerLat</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation>^-?\d+(\.\d+)?$</Validation>
      <Description><![CDATA[Latitud del centro inicial (ej. "4.7110" para Bogotá).]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="integration">Integración</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>La latitud es obligatoria.</MandatoryMessage>
      <ValidationRegExpMessage>Debe ser decimal (ej. 4.7110 o -4.7110).</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>f39e8334-ece4-47e0-8c09-c27633823af3</Key>
      <Name>Center Longitude</Name>
      <Alias>centerLng</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation>^-?\d+(\.\d+)?$</Validation>
      <Description><![CDATA[Longitud del centro inicial (ej. "-74.0721" para Bogotá).]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="integration">Integración</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>La longitud es obligatoria.</MandatoryMessage>
      <ValidationRegExpMessage>Debe ser decimal.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>7065d0fb-cc99-4ced-b0b0-0227f10b9d89</Key>
      <Name>Zoom Level</Name>
      <Alias>zoomLevel</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation>^([1-9]|1[0-8])$</Validation>
      <Description><![CDATA[Nivel de zoom inicial (1-18). Default 13 (urbano).]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="integration">Integración</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>Rango 1-18.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>fb75fa67-1fe8-4dab-9652-8ba8a07b5c58</Key>
      <Name>Pins JSON</Name>
      <Alias>pinsJson</Alias>
      <Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition>
      <Type>Umbraco.TextArea</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Array JSON de pins: [{"lat":4.71,"lng":-74.07,"title":"Oficina Bogotá","description":"..."},...].]]></Description>
      <SortOrder>30</SortOrder>
      <Tab Alias="integration">Integración</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>Al menos un pin es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>2a457be4-6c43-4467-a6ae-b8a8940d1307</Key>
      <Caption>Integración</Caption>
