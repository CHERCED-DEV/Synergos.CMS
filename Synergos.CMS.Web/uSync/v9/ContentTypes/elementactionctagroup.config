<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="5b95cd80-a64d-4867-8fc4-42358a4c5f68" Alias="elementActionCtaGroup" Level="2">
  <Info>
    <Name>Action — CTA Group</Name>
    <Icon>icon-navigation-horizontal color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native para agrupar múltiples CTAs (botones/enlaces) en una fila o columna. Completa la familia Action (Button, Link, CtaGroup). Usa el primer container pattern del producto: un BlockList field (DT.BlockList.CtaItems) permite 1-4 items de elementActionButton o elementActionLink ordenables y editables por el editor. Composiciones: compDomClass (class), compDomVariant (estilo del grupo), compDomLayout (align + direction del contenedor). Renderer: Views/Partials/Elements/Action/CtaGroup.cshtml — itera el BlockList y renderiza cada item delegando al partial del elemento hijo. Variations=Culture (los CTAs contenidos traducen). Renderiza <div class="syn-cta-group syn-cta-group--<variant>"> con children aligned via flex utilities.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Action</Folder>
    <Compositions>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
      <Composition Key="06de133e-ab5f-4c56-970d-5aa8266e6334">compDomLayout</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>525dfd0c-6eed-4dd8-b5b0-d18a6ade0e0f</Key>
      <Name>CTA Items</Name>
      <Alias>ctaItems</Alias>
      <Definition>972ccc3d-ec95-4dd1-88f1-c9d8b8c1fc66</Definition>
      <Type>Umbraco.BlockList</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Lista de 1 a 4 CTAs. El editor añade elementActionButton (CTAs primarios con estilo botón) o elementActionLink (enlaces secundarios con estilo link). El orden define el orden visual (primer item = primary por convención). Cada CTA es un ElementType completo con su propio ctaLabel + ctaUrl + ctaOpenInNewTab + variant. El renderer itera esta lista y delega el render a los partials de cada item (Views/Partials/Elements/Action/Button.cshtml / Link.cshtml). Variations=Culture: los CTAs contenidos pueden diferir por idioma (tanto texto como URL).]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El grupo de CTAs debe contener al menos uno.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>82f1f669-d315-47b2-9e7a-86de57e4b8f6</Key>
      <Caption>Content</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>10</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
