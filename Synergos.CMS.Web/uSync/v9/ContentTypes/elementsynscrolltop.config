<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="43d984b3-6078-4cec-829b-a63d077ca9f0" Alias="elementSynScrollTop" Level="2">
  <Info>
    <Name>Syn — Scroll to Top</Name>
    <Icon>icon-arrow-up color-grey</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[SynHost block — botón "back to top" que aparece tras scrollear N px. DOM: <synergos-scroll-top>. Smooth scroll behavior, fixed position. Props: ariaLabel (Culture), scrollThreshold (px, default 400), position (bottom-right/bottom-left).]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Syn Blocks</Folder>
    <Compositions>
      <Composition Key="84fe7a74-faa4-434f-acf1-b1ae1a50a90f">compIntegration</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>879018ec-57af-430a-954f-5462d789a21c</Key>
      <Name>Aria Label</Name>
      <Alias>ariaLabel</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Label accesible (ej. "Volver arriba"). Variations=Culture.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El aria-label es obligatorio por a11y.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>3787cc52-8648-42d9-8e10-b7ee6098e701</Key>
      <Name>Scroll Threshold (px)</Name>
      <Alias>scrollThreshold</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation>^\d+$</Validation>
      <Description><![CDATA[Píxeles scrolleados antes de mostrar el botón. Default 400. Variations=Nothing.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>Debe ser entero.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>02ad7c36-ca43-4a25-bc2f-429a8bd44434</Key>
      <Name>Position</Name>
      <Alias>position</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation>^(bottom-right|bottom-left)$</Validation>
      <Description><![CDATA[Posición fija del botón. Default bottom-right. Variations=Nothing.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>Use bottom-right/bottom-left.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>0e623b0d-8d00-4630-ac45-fd5e9f9d06c3</Key>
      <Caption>Integration</Caption>
      <Alias>integration</Alias>
      <Type>Tab</Type>
      <SortOrder>50</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
