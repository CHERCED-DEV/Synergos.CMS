<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="28d5b6b8-200c-43a4-872a-d8958a392d97" Alias="elementSynAvatar" Level="2">
  <Info>
    <Name>Syn — Avatar</Name>
    <Icon>icon-user color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type para bloque SynHost "Avatar" — componente web-hosted en CDN que renderiza un avatar circular con imagen. El DOM emitido es <synergos-avatar> y el bundle se resuelve en runtime via IBundleRegistryClient (framework-agnóstico, Angular como first adapter). Provee avatarSrc (URL absoluta o relativa a CDN media). Variations=Culture: en despliegues multi-idioma pueden variar imágenes por cultura (ej. rostros localmente representativos). El editor compone este bloque en Block Grid o LayoutComposer indistintamente (ADR 0015). Renderer único: Views/Partials/SynHost/Avatar.cshtml.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Syn Blocks</Folder>
    <Compositions>
      <Composition Key="84fe7a74-faa4-434f-acf1-b1ae1a50a90f">compIntegration</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>c937aa6f-8499-44a1-8ac1-51abe063ef50</Key>
      <Name>Avatar Source URL</Name>
      <Alias>avatarSrc</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[URL de la imagen del avatar. Puede ser absoluta (https://...) o path relativo a la CDN media (ej. /media/avatars/ceo.jpg). El bundle CDN se encarga del layout circular, lazy-loading y fallback. Variations=Culture: puede variar por idioma para representación local.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>La imagen del avatar es obligatoria.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>9a78449a-ea3f-40a1-ae42-128696bd2652</Key>
      <Caption>Integration</Caption>
      <Alias>integration</Alias>
      <Type>Tab</Type>
      <SortOrder>50</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
