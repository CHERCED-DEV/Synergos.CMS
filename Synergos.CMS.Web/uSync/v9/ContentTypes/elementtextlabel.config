<ContentType Key="06590c83-bb73-4a5f-8421-ea37d884823b" Alias="elementTextLabel" Level="2">
  <Info>
    <Name>Text — Label</Name>
    <Icon>icon-tag color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native para una etiqueta muy corta (<= 24 caracteres). Diferente del eyebrow: label es categorical (ej. "Blog", "Tutorial", "Interview") mientras eyebrow es contextual ("Nuevo", "Caso de éxito"). Renderiza como <span> pequeño con estilo de chip/tag. Composiciones: compDomClass, compDomVariant. Variations=Culture. Renderer: Views/Partials/Elements/Text/Label.cshtml.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Text</Folder>
    <Compositions>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>204da6b2-e39f-484d-b9e4-5c15172bec4e</Key>
      <Name>Label Text</Name>
      <Alias>labelText</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Texto de la etiqueta. Cap 24 caracteres recomendado. Ejemplos: "Tutorial", "Entrevista", "Caso clínico", "2026". Variations=Culture.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El texto del label es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
