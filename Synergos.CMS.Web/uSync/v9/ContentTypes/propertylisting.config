    <GenericProperty><Key>aeaab85d-fadb-4012-84b5-56f806a19096</Key><Name>Slug</Name><Alias>propertySlug</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Identificador único del inmueble en minúsculas con guiones. Ej: apto-chico-norte-3h.]]></Description><SortOrder>0</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage>Slug obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
