    <GenericProperty><Key>1c48fcf6-3280-401d-ad12-58caf0b67a78</Key><Name>Operación</Name><Alias>propertyOperation</Alias><Definition>90945768-4ec6-46ab-82ff-e5baa124c9d2</Definition><Type>Umbraco.DropDown.Flexible</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Si el inmueble se vende o se arrienda. Alimenta el filtro principal del portal.]]></Description><SortOrder>20</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage>Elige venta o arriendo.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
