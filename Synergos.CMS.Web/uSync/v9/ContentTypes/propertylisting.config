    <GenericProperty><Key>64f38ee3-33e2-4cfd-bd59-70dcc498eb3c</Key><Name>Destacado</Name><Alias>propertyFeatured</Alias><Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition><Type>Umbraco.TrueFalse</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Sube el inmueble al principio de los resultados cuando el visitante no ha ordenado por otra cosa.]]></Description><SortOrder>50</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
