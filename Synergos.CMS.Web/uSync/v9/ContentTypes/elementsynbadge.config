<ContentType Key="26965c38-03f5-44b2-a3e8-8daa5288143c" Alias="elementSynBadge" Level="2">
  <Info>
    <Name>Syn — Badge</Name>
    <Icon>icon-tag color-green</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type para bloque SynHost "Badge" — etiqueta semántica pequeña (estado, categoría, tag). El DOM emitido es <synergos-badge>. Provee label (texto mostrado). Variations=Culture: el texto se traduce por idioma. El editor lo compone en Block Grid o LayoutComposer (ADR 0015). Renderer: Views/Partials/SynHost/Badge.cshtml.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Syn Blocks</Folder>
    <Compositions>
      <Composition Key="84fe7a74-faa4-434f-acf1-b1ae1a50a90f">compIntegration</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>94f90694-8e03-426c-ac62-ecf769a4f895</Key>
      <Name>Label</Name>
      <Alias>label</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Texto que aparece dentro del badge. Cap recomendado 24 caracteres para que el layout no se rompa. Ejemplos: "Nuevo", "Premium", "Oferta". Variations=Culture: traduce por idioma.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El texto del badge es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
