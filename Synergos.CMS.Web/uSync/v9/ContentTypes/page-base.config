<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="b4df602f-1c16-4ad7-8b57-69aa64ff6ad1" Alias="pageBase" Level="2">
  <Info>
    <Name>Page — Base</Name>
    <Icon>icon-document color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Documento canónico para páginas de contenido del sitio. Se monta con el layout compartido (header/footer/nav cuando exista en ola posterior). Compone compCoreBase (notas técnicas), compCoreLifecycle (contexto editorial), compSeo (metadatos SEO) y el stack de layout de página (Ola 42: compDomDisplay + compDomFlex + compDomGrid + compDomSpacing — el editor cuadra la topología del <main> con dropdowns). Contiene un campo body richtext como contenido principal. Usar para páginas editoriales estándar: about, services, contact, landings. AllowAtRoot=false (va bajo siteRoot). Variations=Culture.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Pages</Folder>
    <Compositions>
      <Composition Key="5e2ec6b8-7f65-4c26-8c20-1b9a72bed2f8">compCoreBase</Composition>
      <Composition Key="77440708-6cce-4a20-8679-212aaadd92eb">compCoreLifecycle</Composition>
      <Composition Key="85e75635-b950-4583-b5ca-2a51c08892e3">compSeo</Composition>
      <Composition Key="f79a6dcc-aecd-4a2b-bd1e-0de3e08eb800">compDomDisplay</Composition>
      <Composition Key="610e39a0-bfd1-4786-9ddb-697884da5d4b">compDomFlex</Composition>
      <Composition Key="b0bed49d-e17d-4da3-a0ec-453dcb9948f7">compDomGrid</Composition>
      <Composition Key="0a2edb7e-8555-4044-bebc-bf0fe37662f2">compDomSpacing</Composition>
    </Compositions>
    <DefaultTemplate>PageBase</DefaultTemplate>
    <AllowedTemplates>
      <Template Key="e5b27298-f249-44bd-91d6-1f0c6169c190">PageBase</Template>
    </AllowedTemplates>
  </Info>
  <Structure>
    <ContentType Key="b4df602f-1c16-4ad7-8b57-69aa64ff6ad1" SortOrder="0">pageBase</ContentType>
    <ContentType Key="0bd9379d-07eb-49de-802a-e68483322582" SortOrder="1">pageBare</ContentType>
    <ContentType Key="95fef9ef-a6b2-454d-af54-b58d03b2a88e" SortOrder="2">pageBasic</ContentType>
  </Structure>
  <GenericProperties>
    <GenericProperty>
      <Key>d3b23bca-e792-43fa-8e33-12fac52c67d6</Key>
      <Name>Body</Name>
      <Alias>body</Alias>
      <Definition>ca90c950-0aff-4e72-b976-a30b1ac57dad</Definition>
      <Type>Umbraco.TinyMCE</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Contenido HTML corto/introducción de la página (richtext). Opcional. Sanitizado por la pipeline TinyMCE de Umbraco (SanitizeTinyMce=true) — el template lo renderiza con @Html.Raw. Para contenido editorial extenso con layout visual usar bodyBlocks (Block Grid Editorial). Variations=Culture.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>7dfc6f52-e65f-4e0d-a06d-2bf10a5bc4c4</Key>
      <Name>Body Blocks</Name>
      <Alias>bodyBlocks</Alias>
      <Definition>f975c194-5696-4d7c-9829-ff018fb6995a</Definition>
      <Type>Umbraco.BlockGrid</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Grid de bloques editoriales. El editor compone la página arrastrando elementos de las 4 familias disponibles (Text, Action, Media, Info). Renderizado por PageBase.cshtml vía @Html.GetBlockGridHtmlAsync, que delega a los partials Razor en Views/Partials/blockgrid/Components/*.cshtml (Ola 13-15). Cada bloque compone compDom*, compContent* y otros según su tipo. Variations=Culture: editor puede ajustar contenido por idioma manteniendo layout. Es el campo principal para páginas editoriales; usar body richtext solo para pequeños intros/fallbacks.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>4c650df3-2560-47aa-9d69-8b35bb3f9987</Key>
      <Caption>Content</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>0</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
