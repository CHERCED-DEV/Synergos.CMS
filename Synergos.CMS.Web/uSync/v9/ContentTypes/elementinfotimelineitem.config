<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="f845c403-0300-45e6-aa4f-1f1aa00cbdb4" Alias="elementInfoTimelineItem" Level="2">
  <Info>
    <Name>Info — Timeline Item</Name>
    <Icon>icon-activity color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native para entrada de una línea de tiempo (hito histórico, fase de proceso, milestone). Compone compContentDate (fecha + label opcional), compContentHeading (título del hito), compContentText (descripción opcional), compDomClass, compDomVariant. Sin props propias. Renderiza <li class="syn-timeline-item"> con <time> semántico. Agrupar múltiples dentro de un container Timeline (Ola 16 BlockList). Variations=Culture. Renderer: Views/Partials/Elements/Info/TimelineItem.cshtml.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Info</Folder>
    <Compositions>
      <Composition Key="986da42d-9203-4270-8234-3f8255abdbdf">compContentDate</Composition>
      <Composition Key="eb4bd93f-f9d1-44dd-b85e-d64b2084a3ad">compContentHeading</Composition>
      <Composition Key="71d74897-c807-452c-83c3-04c94fd1414b">compContentText</Composition>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties />
  <Tabs />
</ContentType>
