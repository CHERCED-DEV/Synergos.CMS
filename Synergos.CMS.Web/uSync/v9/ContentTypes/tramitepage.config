  <GenericProperties>
    <GenericProperty><Key>f4338c9f-2d4f-4917-bcb8-71010e3f5703</Key><Name>Slug</Name><Alias>tramiteSlug</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Identificador único del trámite en minúsculas con guiones. Ej: renovacion-cedula.]]></Description><SortOrder>0</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage>Slug obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>d56b098c-117e-4c22-a169-b7024ecf372f</Key><Name>Nombre</Name><Alias>tramiteName</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[El nombre oficial del trámite. Ej: Renovación de cédula de ciudadanía.]]></Description><SortOrder>10</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Culture</Variations><MandatoryMessage>El nombre del trámite es obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>0e254bbf-0f34-424b-8a7e-b84e1aeaee7a</Key><Name>Resumen</Name><Alias>tramiteSummary</Alias><Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition><Type>Umbraco.TextArea</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Una o dos líneas que salen en la tarjeta del buscador. Vacío, la tarjeta sale sin texto.]]></Description><SortOrder>20</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>aea0a823-539b-41cc-932c-6e8a7913e770</Key><Name>Categoría</Name><Alias>tramiteCategory</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Categoría del trámite. Ej: Identidad, Salud, Empresa. Vacía, no sale en ningún filtro.]]></Description><SortOrder>30</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>3e931ff5-c489-4ff4-a960-1fe289dc1114</Key><Name>Entidad</Name><Alias>tramiteAgency</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Quién presta el trámite. Ej: Registraduría Nacional. Vacía, el ciudadano no sabe a quién acudir.]]></Description><SortOrder>40</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>3a529a15-633f-4334-aa13-af27db554dad</Key><Name>Canal de atención</Name><Alias>tramiteChannel</Alias><Definition>ac69d857-e064-4510-a78b-3eedf80a9fd4</Definition><Type>Umbraco.DropDown.Flexible</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Dónde se atiende: presencial, en línea o mixto. Sin elegir, se anuncia como presencial.]]></Description><SortOrder>50</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>3649d67b-0f1b-45b0-a435-d8eda70c4091</Key><Name>Descripción</Name><Alias>tramiteDescription</Alias><Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition><Type>Umbraco.TextArea</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[El texto de la ficha en lenguaje claro: qué resuelve el trámite y para quién es.]]></Description><SortOrder>0</SortOrder><Tab Alias="ficha">Ficha</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>7458e0fc-e064-4904-bd76-3f6225eb073a</Key><Name>Quién puede</Name><Alias>tramiteEligibility</Alias><Definition>08f6ca50-4c60-42a3-a05f-4a33f9727a3f</Definition><Type>Umbraco.MultipleTextstring</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Condiciones para poder radicar, una por línea. Vacía, la ficha no muestra la lista.]]></Description><SortOrder>10</SortOrder><Tab Alias="ficha">Ficha</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>6cf03631-991b-4f39-9de1-525d79f383f2</Key><Name>Documentos requeridos</Name><Alias>tramiteRequired</Alias><Definition>08f6ca50-4c60-42a3-a05f-4a33f9727a3f</Definition><Type>Umbraco.MultipleTextstring</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Qué debe adjuntar o llevar el ciudadano, uno por línea. Vacía, llegará sin los papeles.]]></Description><SortOrder>20</SortOrder><Tab Alias="ficha">Ficha</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>b6b62329-bbde-4a29-a55d-bcb4fbe902ce</Key><Name>Normativa</Name><Alias>tramiteNormativa</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[La norma que sustenta el trámite. Ej: Decreto 1010 de 2000. Vacía, la ficha no la muestra.]]></Description><SortOrder>30</SortOrder><Tab Alias="ficha">Ficha</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>a18ee684-ae9a-4fe7-9be8-09373e8ff7be</Key><Name>Trámite gratuito</Name><Alias>tramiteIsFree</Alias><Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition><Type>Umbraco.TrueFalse</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Márcalo si el trámite no cobra. Sin marcar y con la tasa en 0 el trámite NO se publica.]]></Description><SortOrder>0</SortOrder><Tab Alias="tasa">Tasa y tiempos</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>e4b9a8ee-24e2-4967-8622-d22153fb26f8</Key><Name>Tasa (COP)</Name><Alias>tramiteFee</Alias><Definition>2a6fb12c-a780-4e02-9ae8-0a156c4be576</Definition><Type>Umbraco.Decimal</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Lo que cobra el trámite, sin puntos ni símbolos. Escribe 65500, no 65.500. Si no cobra, marca gratuito.]]></Description><SortOrder>10</SortOrder><Tab Alias="tasa">Tasa y tiempos</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>43ab890e-45c0-4150-af16-62359e05698e</Key><Name>Días estimados</Name><Alias>tramiteEstimatedDays</Alias><Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition><Type>Umbraco.Integer</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Cuántos días hábiles tarda la respuesta. En 0 la ficha no promete ningún plazo.]]></Description><SortOrder>20</SortOrder><Tab Alias="tasa">Tasa y tiempos</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>0171c5dc-9785-40d8-b690-a998e3d7c0b8</Key><Name>Requiere cita</Name><Alias>tramiteRequiresAppointment</Alias><Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition><Type>Umbraco.TrueFalse</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Márcalo si hay que agendar antes de ir. Sin marcar, la ficha no pide cita.]]></Description><SortOrder>30</SortOrder><Tab Alias="tasa">Tasa y tiempos</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>6504a298-3eb1-4f88-8ed4-48ccf22c42c5</Key><Name>Secciones del formulario</Name><Alias>tramiteFormSections</Alias><Definition>21b9cc26-9c42-47dc-b1a0-1c41329b7af3</Definition><Type>Umbraco.BlockList</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Los pasos del formulario de radicación, en orden. Sin secciones el trámite sale pero no se puede radicar.]]></Description><SortOrder>0</SortOrder><Tab Alias="formulario">Formulario</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
  </GenericProperties>
