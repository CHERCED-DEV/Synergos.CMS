<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="92cb0070-0f4d-43a0-84a7-102f60dc41b4" Alias="compContentCta" Level="2">
  <Info>
    <Name>Composition — Content CTA</Name>
    <Icon>icon-target color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición reutilizable para Call-To-Action: un label + una URL + flag de apertura en nueva pestaña. Se compone en Hero, Card, FeatureJourney, Banner, AlertBar, etc. donde el bloque invita a una acción. Para múltiples CTAs por bloque (ej. ctaGroup con botones primario + secundario) se compone más de una vez o se usa el Element Type elementActionCtaGroup (Ola 12). Este patrón single-CTA cubre el 80% de los casos.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Content/Action</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>f76ecdd5-c687-421c-bed3-63011219f0e2</Key>
      <Name>CTA Label</Name>
      <Alias>ctaLabel</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Texto visible del botón o enlace (ej. "Ver más", "Contactar", "Descargar PDF"). Cap recomendado 40 caracteres para que el layout no se rompa. Variations=Culture: se traduce por idioma. Si queda vacío, el renderer del tipo composante decide si omite el CTA completo (comportamiento recomendado) o muestra un fallback desde Dictionary.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>a0507dc6-ae91-4cf9-a63d-ac208d31dea0</Key>
      <Name>CTA URL</Name>
      <Alias>ctaUrl</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Destino del CTA. Acepta: path relativo (/contacto), URL absoluta (https://...), ancla (#section), protocolo (mailto:, tel:). En olas siguientes se reemplaza por un DataType LinkPicker custom que permita elegir contenido interno. Variations=Culture: el URL puede variar por idioma (ej. /es-co/contacto vs /en-us/contact). Si queda vacío, el renderer omite el CTA junto con el label.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>5cb167a7-ffa8-4504-88aa-443a90d7f90a</Key>
      <Name>Open in New Tab</Name>
      <Alias>ctaOpenInNewTab</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Si está activo, el renderer emite target="_blank" + rel="noopener noreferrer" en el enlace (WCAG 2.1 G201). Úsese solo para URLs externas al sitio — para links internos deja false (mantiene el flujo de navegación). Variations=Nothing: la decisión técnica de target no traduce por idioma.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>7ca289dc-68cf-4901-a3d4-ba280fdb4225</Key>
      <Caption>Content</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>10</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
