<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="a1a1878f-2acc-4d2b-a577-3258720c30d2" Alias="cfgFooterNote" Level="2">
  <Info>
    <Name>Aviso del footer</Name>
    <Icon>icon-document-dashed-line color-grey</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Aviso breve en el footer del sitio (legal, copyright extendido, mensaje regulatorio). Aparece automáticamente en todas las páginas.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Settings/Components</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
