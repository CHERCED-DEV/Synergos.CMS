<ContentType Key="6fc1c083-69d7-4367-a629-cc2d80cd9998" Alias="elementEquipmentRate" Level="2">
  <Info>
    <Name>Alquiler — Tarifa</Name>
    <Icon>icon-tag color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Un tramo de tarifa del equipo: a partir de cuántos días aplica y cuánto vale el día.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Blocks/Alquiler</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty><Key>ea85cecf-dd6d-4f7b-be5e-aa53a38be5a8</Key><Name>Código</Name><Alias>rateCode</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Identificador corto y único dentro del equipo, en minúsculas. Ej: dia, semana, mes.]]></Description><SortOrder>0</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage>El código de la tarifa es obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>e06ebf39-8334-48a2-8b6b-f2b9e55cab90</Key><Name>Nombre</Name><Alias>rateLabel</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Nombre visible del tramo. Ej: Por día, Semana completa.]]></Description><SortOrder>10</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Culture</Variations><MandatoryMessage>El nombre de la tarifa es obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>17c73aa3-4e6d-4f24-920a-5801e048ff0d</Key><Name>Desde (días)</Name><Alias>rateMinDays</Alias><Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition><Type>Umbraco.Integer</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[A partir de cuántos días de alquiler aplica este tramo. El tramo de 1 día es el que se usa por defecto.]]></Description><SortOrder>20</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage>Obligatorio. Usa 1 para la tarifa base.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>197087f3-bc44-4659-a701-5047b2ffe942</Key><Name>Valor del día (COP)</Name><Alias>rateAmount</Alias><Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition><Type>Umbraco.Integer</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Cuánto vale UN día dentro de este tramo, en pesos enteros. Es un entero a propósito: un TextBox deja escribir 49.000, que se lee como 49.]]></Description><SortOrder>30</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage>El valor del día es obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>aca2ef44-a721-41c7-88db-f753a4ccc3c9</Key><Name>Qué incluye</Name><Alias>rateDescription</Alias><Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition><Type>Umbraco.TextArea</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Una línea que explique qué cubre este tramo. Vacío oculta la fila.]]></Description><SortOrder>40</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
  </GenericProperties>
