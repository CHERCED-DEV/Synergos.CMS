  <Structure />
  <GenericProperties>
    <GenericProperty><Key>d275819c-7699-48c0-be59-88ef8abde00b</Key><Name>Slug</Name><Alias>equipmentSlug</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Identificador único del equipo en minúsculas con guiones. Ej: andamio-multidireccional-2m.]]></Description><SortOrder>0</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage>Slug obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>a96da39a-5578-4dbf-9ccb-1e2a905aa810</Key><Name>Nombre</Name><Alias>equipmentName</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Nombre del equipo tal como se anuncia.]]></Description><SortOrder>10</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Culture</Variations><MandatoryMessage>Obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>0ddd5c7a-d70e-4395-bbe7-060bee894e3a</Key><Name>Categoría</Name><Alias>equipmentCategory</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Familia del equipo (Andamios, Audiovisual, Jardinería). Alimenta el filtro: escríbela igual en todos.]]></Description><SortOrder>20</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>90cca53f-79aa-49df-bf89-2086afd131ba</Key><Name>Resumen</Name><Alias>equipmentSummary</Alias><Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition><Type>Umbraco.TextArea</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Una o dos líneas para la tarjeta del listado.]]></Description><SortOrder>30</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>c43d39d8-fc8a-48c8-a4a9-298891efbaee</Key><Name>Foto principal</Name><Alias>equipmentCover</Alias><Definition>4309a3ea-0d78-4329-a06c-c80b036af19a</Definition><Type>Umbraco.MediaPicker3</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Imagen del equipo para la tarjeta y la cabecera de la ficha.]]></Description><SortOrder>40</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>a197ad3f-a76a-4606-81ba-b1bf7a21c6ba</Key><Name>Unidades</Name><Alias>equipmentUnits</Alias><Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition><Type>Umbraco.Integer</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Cuántas unidades de este equipo hay para alquilar. Es el cupo de la ventana: con 0 el equipo se anuncia y no se puede reservar.]]></Description><SortOrder>50</SortOrder><Tab Alias="content">Contenido</Tab><Variations>Nothing</Variations><MandatoryMessage>Obligatorio. Usa 0 para anunciarlo sin alquilarlo.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>6cfd587a-3eba-4b17-97d1-df405449773d</Key><Name>Descripción</Name><Alias>equipmentDescription</Alias><Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition><Type>Umbraco.TextArea</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[De qué sirve el equipo y para qué trabajo. Es el cuerpo de la ficha.]]></Description><SortOrder>0</SortOrder><Tab Alias="ficha">Ficha</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>50c64a52-b004-44a2-8b4e-0c88cd74b527</Key><Name>Galería</Name><Alias>equipmentGallery</Alias><Definition>4309a3ea-0d78-4329-a06c-c80b036af19a</Definition><Type>Umbraco.MediaPicker3</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Fotos del estado real del equipo. Son las que alguien mira cuando discute un daño.]]></Description><SortOrder>10</SortOrder><Tab Alias="ficha">Ficha</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>4c90073b-bea9-45b0-a49c-aad65cd02da8</Key><Name>Qué incluye</Name><Alias>equipmentIncludes</Alias><Definition>08f6ca50-4c60-42a3-a05f-4a33f9727a3f</Definition><Type>Umbraco.MultipleTextstring</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Lo que va con el equipo, uno por línea. Ej: dos baterías · maletín. Vacío oculta la lista.]]></Description><SortOrder>20</SortOrder><Tab Alias="ficha">Ficha</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>c0b862a0-f72f-4b2c-8731-71bf1e733e02</Key><Name>Requisitos</Name><Alias>equipmentRequirements</Alias><Definition>08f6ca50-4c60-42a3-a05f-4a33f9727a3f</Definition><Type>Umbraco.MultipleTextstring</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Lo que tiene que traer o cumplir quien lo alquila, uno por línea. Ej: licencia vigente.]]></Description><SortOrder>30</SortOrder><Tab Alias="ficha">Ficha</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>16466d9b-6a5a-478f-8fae-588d3422e439</Key><Name>Ficha técnica</Name><Alias>equipmentSpecs</Alias><Definition>fa0e1610-f9bf-4119-9750-03d0c59d7cbe</Definition><Type>Umbraco.BlockList</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Las filas de la ficha técnica. Vacío oculta la tabla.]]></Description><SortOrder>40</SortOrder><Tab Alias="ficha">Ficha</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>4ea805c6-a19d-433b-96d6-a94ef9005668</Key><Name>Valor del día (COP)</Name><Alias>equipmentDailyRate</Alias><Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition><Type>Umbraco.Integer</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Tarifa base por día en pesos enteros. Es un entero a propósito: un TextBox deja escribir 49.000, que se lee como 49.]]></Description><SortOrder>0</SortOrder><Tab Alias="alquiler">Alquiler</Tab><Variations>Nothing</Variations><MandatoryMessage>El valor del día es obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>8cd23bca-ec8e-4c26-bf61-d465776d4762</Key><Name>Garantía (COP)</Name><Alias>equipmentDepositAmount</Alias><Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition><Type>Umbraco.Integer</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Cuánto se RETIENE mientras el equipo está fuera. No es un cobro: se libera al devolverlo. 0 significa sin garantía.]]></Description><SortOrder>10</SortOrder><Tab Alias="alquiler">Alquiler</Tab><Variations>Nothing</Variations><MandatoryMessage>Obligatorio. Usa 0 si este equipo no lleva garantía.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>27c43912-3452-46e5-86e5-5c4f77173db2</Key><Name>Mínimo de días</Name><Alias>equipmentMinDays</Alias><Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition><Type>Umbraco.Integer</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Alquiler mínimo. Vacío o 0 se trata como 1 día.]]></Description><SortOrder>20</SortOrder><Tab Alias="alquiler">Alquiler</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>d3a6c202-78c3-4e76-bd9f-0be6062aad9b</Key><Name>Máximo de días</Name><Alias>equipmentMaxDays</Alias><Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition><Type>Umbraco.Integer</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Alquiler máximo. Vacío o 0 aplica el tope del despliegue (Synergos:Alquiler:MaxRentalDays), que existe porque una autorización de garantía no dura para siempre.]]></Description><SortOrder>30</SortOrder><Tab Alias="alquiler">Alquiler</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>b35da215-aa24-4ebc-bc2e-058929d04800</Key><Name>Tarifas por tramo</Name><Alias>equipmentRates</Alias><Definition>83a483ea-96dd-4da2-ba5d-dca2268a7612</Definition><Type>Umbraco.BlockList</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Tramos de descuento por duración. Vacío cobra el valor del día para todos los días.]]></Description><SortOrder>40</SortOrder><Tab Alias="alquiler">Alquiler</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
  </GenericProperties>
