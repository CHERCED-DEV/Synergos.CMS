<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="71d74897-c807-452c-83c3-04c94fd1414b" Alias="compContentText" Level="2">
  <Info>
    <Name>Composition — Content Text</Name>
    <Icon>icon-article color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición reutilizable para cualquier tipo que necesite un cuerpo de texto richtext. Distinto del campo body de pageBase: compContentText se compone en Element Types (Hero, Card, FeatureItem, AccordionItem, etc.) para que cualquier bloque pueda tener su propio párrafo tipado. Variations=Culture: el texto se traduce. HTML sanitizado por la pipeline TinyMCE de Umbraco (SanitizeTinyMce=true).]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Content/Text</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>4fc9dd32-56a3-462c-8fc3-2e98e0a41494</Key>
      <Name>Text Body</Name>
      <Alias>textBody</Alias>
      <Definition>ca90c950-0aff-4e72-b976-a30b1ac57dad</Definition>
      <Type>Umbraco.TinyMCE</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Cuerpo de texto richtext del bloque. Editor escribe párrafos, listas, enlaces; Umbraco sanitiza HTML (SanitizeTinyMce=true) antes de persistir. El renderer típicamente lo emite con @Html.Raw dentro del bloque. Consumido por Hero.cshtml, Card.cshtml y similares en olas siguientes. Variations=Culture.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>f67b27ae-4246-4fb6-83d9-39a34c4e7a81</Key>
      <Caption>Content</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>10</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
