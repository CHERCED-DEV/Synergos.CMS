<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="436bafd1-1ba9-4826-b5ab-77359c5eebc8" Alias="transversalErrorPage" Level="2">
  <Info>
    <Name>Página de error</Name>
    <Icon>icon-alert-alt color-red</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Una página de error reusable (ej. 404, 500). El status code determina cuándo se muestra. Hereda compCoreBase + compSeo (para meta robots noindex automático).]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Platform/Transversals</Folder>
    <Compositions>
      <Composition Key="5e2ec6b8-7f65-4c26-8c20-1b9a72bed2f8">compCoreBase</Composition>
      <Composition Key="85e75635-b950-4583-b5ca-2a51c08892e3">compSeo</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>2e93b027-0315-4f62-92e0-79c3d1f4c5bf</Key>
      <Name>Código de status HTTP</Name>
      <Alias>statusCode</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation>^[1-5]\d{2}$</Validation>
      <Description><![CDATA[Código HTTP que esta página resuelve (ej. 404, 500, 503). Solo se usa una página por código por sitio.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="error">Error</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>El código HTTP es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage>3 dígitos entre 100 y 599 (ej. 404).</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>6fdb6a6e-517e-42bb-a26b-28e737b5b92b</Key>
      <Name>Título</Name>
      <Alias>errorTitle</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Título visible (ej. "Página no encontrada", "Algo salió mal").]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="error">Error</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El título es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>ef472578-7c1a-41be-82f4-1cda73d2ae96</Key>
      <Name>Cuerpo</Name>
      <Alias>errorBody</Alias>
      <Definition>ca90c950-0aff-4e72-b976-a30b1ac57dad</Definition>
      <Type>Umbraco.TinyMCE</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Mensaje explicativo para el visitante. Puede incluir links, formato, sugerencias.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="error">Error</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>b2dc8796-d6d6-4bda-8acb-eaf497cbb154</Key>
      <Name>Mostrar buscador</Name>
      <Alias>showSearchBox</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Incluye un buscador para que el visitante encuentre lo que buscaba. Útil en 404.]]></Description>
      <SortOrder>30</SortOrder>
      <Tab Alias="error">Error</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>bc15f9e8-0877-4ace-b88f-63ddc6206a29</Key>
      <Name>Mostrar botón "volver al inicio"</Name>
      <Alias>showHomeLink</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Botón que lleva al home del sitio (URL del Site Root).]]></Description>
      <SortOrder>40</SortOrder>
      <Tab Alias="error">Error</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>5b4c2f1a-8e3d-4c9f-bb78-2a5b7f9c1e3d</Key>
      <Caption>Error</Caption>
      <Alias>error</Alias>
      <Type>Tab</Type>
      <SortOrder>0</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
