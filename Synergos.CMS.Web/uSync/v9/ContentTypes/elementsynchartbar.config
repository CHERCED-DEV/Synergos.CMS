<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="d94ca296-8867-4cab-8f08-75ef1cb4455a" Alias="elementSynChartBar" Level="2">
  <Info>
    <Name>Syn — Chart Bar</Name>
    <Icon>icon-chart color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[SynHost block — bar chart render client-side (Chart.js / D3) con tooltips + accessible table fallback. DOM: <synergos-chart-bar>. Props: chartTitle, dataJson (array), orientation (vertical/horizontal). Para charts más complejos (multi-series, stacked) usar configOverride.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Syn Blocks</Folder>
    <Compositions>
      <Composition Key="84fe7a74-faa4-434f-acf1-b1ae1a50a90f">compIntegration</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>c8f8ff21-34b4-4935-b925-b51f56e9d0cd</Key>
      <Name>Chart Title</Name>
      <Alias>chartTitle</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Título del chart (aria-label + heading visible). Variations=Culture.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El título es obligatorio por a11y.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>8f2d7807-588e-47c4-831b-085b13038b41</Key>
      <Name>Data JSON</Name>
      <Alias>dataJson</Alias>
      <Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition>
      <Type>Umbraco.TextArea</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Array JSON: [{"label":"Ene","value":120},{"label":"Feb","value":180},...]. Variations=Culture (labels traducibles).]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>Los datos son obligatorios.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>d232c4f9-17f5-4cfd-a0ce-99cb07a0ef61</Key>
      <Name>Orientation</Name>
      <Alias>orientation</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation>^(vertical|horizontal)$</Validation>
      <Description><![CDATA[Orientación de las barras. Default vertical. Variations=Nothing.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>Use vertical/horizontal.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>ec487f7b-1116-4ac4-9d09-b9b7353c33a9</Key>
      <Caption>Integration</Caption>
      <Alias>integration</Alias>
      <Type>Tab</Type>
      <SortOrder>50</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
