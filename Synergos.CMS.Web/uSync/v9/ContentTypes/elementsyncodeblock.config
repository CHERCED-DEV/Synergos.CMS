<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="baee0724-4cd4-4a2e-bf96-c9bf570b5e78" Alias="elementSynCodeBlock" Level="2">
  <Info>
    <Name>Syn — Code Block</Name>
    <Icon>icon-code color-grey</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[SynHost block — code block con syntax highlighting (Prism/Shiki), copy button, line numbers opcional. DOM: <synergos-code-block>. Props: code (TextArea raw), language (ej. "javascript", "csharp", "bash"), showLineNumbers (bool).]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Nothing</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Syn Blocks</Folder>
    <Compositions>
      <Composition Key="84fe7a74-faa4-434f-acf1-b1ae1a50a90f">compIntegration</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>dbcf8be8-afb2-484b-9c5d-5fe3aa6965b7</Key>
      <Name>Code</Name>
      <Alias>code</Alias>
      <Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition>
      <Type>Umbraco.TextArea</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Código raw (sin escapar). El CDN block hace syntax highlighting según language. Variations=Nothing (código es técnico, no traduce).]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>El código es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>108fedb3-60b8-4ff7-bff6-7a42d8db89a7</Key>
      <Name>Language</Name>
      <Alias>language</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation>^[a-z][a-z0-9+-]*$</Validation>
      <Description><![CDATA[Clave del lenguaje (ej. "javascript", "typescript", "csharp", "bash", "json", "yaml"). Matches con Prism/Shiki grammar. Variations=Nothing.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>El lenguaje es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage>Use slug lowercase.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>92481d71-7a74-455e-ba02-3673613bdfb1</Key>
      <Name>Show Line Numbers</Name>
      <Alias>showLineNumbers</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Si activo, muestra números de línea a la izquierda. Variations=Nothing.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>11eff4be-b04d-4c51-817d-2cafd186c7f7</Key>
      <Caption>Integration</Caption>
      <Alias>integration</Alias>
      <Type>Tab</Type>
      <SortOrder>50</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
