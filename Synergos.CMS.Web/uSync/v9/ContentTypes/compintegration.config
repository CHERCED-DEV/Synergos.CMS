<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="84fe7a74-faa4-434f-acf1-b1ae1a50a90f" Alias="compIntegration" Level="2">
  <Info>
    <Name>Composition — Integration</Name>
    <Icon>icon-plugin color-orange</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición base para cualquier Element Type o Document Type que integre un artefacto externo al CMS: bloque hosteado en CDN (SynHost*), iframe embebido de tercero (IframeHost), o script allowlisted (ScriptHost). Aporta un campo configOverride para que el editor inyecte JSON de configuración específico de instancia que complementa o sobrescribe los defaults técnicos. Variations=Nothing: configuración técnica compartida entre culturas (traducciones viajan por otros mecanismos — Dictionary o props culture-variant del elemento compuesto).]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Nothing</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Integration</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>5253512c-2bb0-40c3-8830-570d935ab630</Key>
      <Name>Config Override</Name>
      <Alias>configOverride</Alias>
      <Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition>
      <Type>Umbraco.TextArea</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[JSON opcional con configuración específica de instancia que se hace merge sobre los defaults del bundle antes de montar el componente. Ejemplo: {"size":"large","variant":"outlined","debug":true}. Si queda vacío, el bundle usa sus defaults. NO incluir secrets, tokens ni paths absolutos a CDN (eso lo resuelve el runtime via ISynHostEmitter). Variations=Nothing: configuración técnica sin traducción.]]></Description>
      <SortOrder>100</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>3eb83e19-6114-482a-951c-858267f6139c</Key>
      <Caption>Integration</Caption>
      <Alias>integration</Alias>
      <Type>Tab</Type>
      <SortOrder>50</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
