  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>7b4122a0-e0c6-4825-9479-6567aeb5bf0f</Key>
      <Name>Placeholder</Name>
      <Alias>searchPlaceholder</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Placeholder del input (ej. "Buscar productos..."). Default del CDN si vacío.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="integration">Integración</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>4d4c35a8-ac80-4561-aa48-dab280fcf83f</Key>
      <Name>Endpoint</Name>
      <Alias>searchEndpoint</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation>^https?:\/\/.+|^\/.+$</Validation>
      <Description><![CDATA[URL del backend que responde queries (absoluta o relativa /api/search).]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="integration">Integración</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>El endpoint de búsqueda es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage>URL absoluta (https://) o path relativo (/...).</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>9cfa7c57-7c37-412a-81a7-ef59680d3a5e</Key>
      <Name>Param Name</Name>
      <Alias>searchParamName</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation>^[a-zA-Z][a-zA-Z0-9_]*$</Validation>
      <Description><![CDATA[Nombre del query string param (default "q"). Ej. si endpoint es /api/search y paramName es "query", el bloque hace GET /api/search?query=foo.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="integration">Integración</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>Use identifier válido (letras/números/underscore).</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
