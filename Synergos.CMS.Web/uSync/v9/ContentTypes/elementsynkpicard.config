<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="51b3896b-0b23-4a83-8993-0efee9cd5fe8" Alias="elementSynKpiCard" Level="2">
  <Info>
    <Name>Syn — KPI Card</Name>
    <Icon>icon-chart-curve color-green</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[KPI card con valor actual + trend indicator (up/down/neutral) + delta + período.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Syn</Folder>
    <Compositions>
      <Composition Key="84fe7a74-faa4-434f-acf1-b1ae1a50a90f">compIntegration</Composition>
    <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition><Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition><Composition Key="7a383458-6ea6-4784-a4d1-17f8d4b01073">compDomVisibility</Composition><Composition Key="0a2edb7e-8555-4044-bebc-bf0fe37662f2">compDomSpacing</Composition><Composition Key="1d5bafbb-59af-4002-8709-ebade1be0392">compDomAttributes</Composition></Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>5811e08a-1ef3-44ea-a7c3-ea3b95a702fe</Key>
      <Name>KPI Label</Name>
      <Alias>kpiLabel</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Descripción del KPI (ej. "Ingresos mensuales").]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="integration">Integración</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El label es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>9e9017c7-1c38-49f4-b9a4-41d18962bd84</Key>
      <Name>KPI Value</Name>
      <Alias>kpiValue</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Valor del KPI formateado (ej. "$2.4M", "1,250", "95%"). Libre.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="integration">Integración</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El valor es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>d905ed0e-acf8-419b-8db8-640e1f23974d</Key>
      <Name>KPI Trend</Name>
      <Alias>kpiTrend</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation>^(up|down|neutral)$</Validation>
      <Description><![CDATA[Dirección del trend: up (verde ↑) / down (rojo ↓) / neutral (gris →).]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="integration">Integración</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>Use up/down/neutral.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>70234fc4-ada0-457e-b724-a38d9b257b2c</Key>
      <Name>KPI Delta</Name>
      <Alias>kpiDelta</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Variación mostrada junto al trend (ej. "+12%", "-3.5%", "+$120K").]]></Description>
      <SortOrder>30</SortOrder>
      <Tab Alias="integration">Integración</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>b785b77d-1ade-4d59-96b2-7c3a4d8edf69</Key>
      <Name>KPI Period</Name>
      <Alias>kpiPeriod</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Contexto de período (ej. "vs. mes pasado", "YoY").]]></Description>
      <SortOrder>40</SortOrder>
      <Tab Alias="integration">Integración</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>ec349522-3c58-4a9e-bae9-998844f59187</Key>
