<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="907840c2-4bd1-4ef8-8181-c4abea0e8a9a" Alias="reusableBlock" Level="2">
  <Info>
    <Name>Reusable Block</Name>
    <Icon>icon-layers color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Bloque de contenido reutilizable (ej. "Hero Home Q4 2026", "CTA Newsletter Footer"). Child exclusivo de sharedContentFolder. Compone compCoreBase. Props: blockTitle (Culture) + blockNotes (Culture) + bodyBlocks (BlockGrid reusing DT.BlockGrid.Editorial para armar el contenido). Consumido desde otros pages vía elementCompReusableEmbed (Ola posterior) o directo en template.]]></Description>
    <AllowAtRoot>False</AllowAtRoot><IsListView>False</IsListView><Variations>Culture</Variations><IsElement>false</IsElement>
    <HistoryCleanup><PreventCleanup>False</PreventCleanup><KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays><KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays></HistoryCleanup>
    <Folder>Shared</Folder>
    <Compositions>
      <Composition Key="5e2ec6b8-7f65-4c26-8c20-1b9a72bed2f8">compCoreBase</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate><AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty><Key>a5a6f896-e950-45d4-9d43-bc137df9f491</Key><Name>Block Title</Name><Alias>blockTitle</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Título editorial para identificar el bloque (ej. "Hero Home Q4 2026").]]></Description><SortOrder>0</SortOrder><Tab Alias="content">Content</Tab><Variations>Culture</Variations><MandatoryMessage>Obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>00b98239-0961-492a-a4a7-d0bb42486835</Key><Name>Block Notes</Name><Alias>blockNotes</Alias><Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition><Type>Umbraco.TextArea</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Notas editoriales (dónde se usa, fechas de campaña, etc). No se renderiza en frontend.]]></Description><SortOrder>10</SortOrder><Tab Alias="content">Content</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>f13d8336-718a-45fb-9f8f-e42c617ebd8d</Key><Name>Body Blocks</Name><Alias>bodyBlocks</Alias><Definition>f975c194-5696-4d7c-9829-ff018fb6995a</Definition><Type>Umbraco.BlockGrid</Type><Mandatory>true</Mandatory><Validation></Validation><Description><![CDATA[Contenido del bloque reutilizable. Reusa DT.BlockGrid.Editorial (misma capacidad que pageBase.bodyBlocks).]]></Description><SortOrder>20</SortOrder><Tab Alias="content">Content</Tab><Variations>Culture</Variations><MandatoryMessage>Obligatorio.</MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab><Key>165a9ce0-da06-424f-aad9-2bb8de2081b7</Key><Caption>Content</Caption><Alias>content</Alias><Type>Tab</Type><SortOrder>10</SortOrder></Tab>
  </Tabs>
</ContentType>
