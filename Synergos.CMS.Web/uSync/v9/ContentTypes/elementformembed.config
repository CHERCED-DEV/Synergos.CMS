<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="9009d554-cafa-4d15-b177-13bc02650aaa" Alias="elementFormEmbed" Level="2">
  <Info>
    <Name>Form — Embed</Name>
    <Icon>icon-frame color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native para embebir un formulario externo via iframe (Typeform, Jotform, Google Forms, Umbraco.Forms via render endpoint).]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Form</Folder>
    <Compositions>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
    <Composition Key="7a383458-6ea6-4784-a4d1-17f8d4b01073">compDomVisibility</Composition><Composition Key="1d5bafbb-59af-4002-8709-ebade1be0392">compDomAttributes</Composition></Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>2414d65b-303f-4f97-8c1a-15905c771731</Key>
      <Name>Embed URL</Name>
      <Alias>embedUrl</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation>^https?:\/\/.+$</Validation>
      <Description><![CDATA[URL del formulario a embeber via iframe. Mandatory. Validación: debe ser https:// idealmente (cumple mixed content).]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>La URL del embed es obligatoria.</MandatoryMessage>
      <ValidationRegExpMessage>URL debe empezar con http:// o https://</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>0b41a48e-60b3-4f80-84cd-32f107c309cf</Key>
      <Name>Embed Title</Name>
      <Alias>embedTitle</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Título accesible del iframe (a11y aria-label + title attr). Mandatory por WCAG 4.1.2.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El título accesible del iframe es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>2d3fc606-2519-4a0b-b09f-fb79607694bb</Key>
      <Name>Embed Height</Name>
      <Alias>embedHeight</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation>^\d{2,4}$</Validation>
      <Description><![CDATA[Altura del iframe en píxeles (ej. "600"). Default 600. El renderer emite height attr + CSS min-height.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>Valor debe ser número entre 2 y 4 dígitos (ej. 600).</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>7f40ed78-13b7-4795-8f1e-cc996d98ec9b</Key>
      <Caption>Contenido</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>10</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
