<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="3e85c495-9fa5-430a-b982-b4bdeda74452" Alias="compContentBadge" Level="2">
  <Info>
    <Name>Composition — Content Badge</Name>
    <Icon>icon-badge-count color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Composición reutilizable para un badge/etiqueta corta de estado o categoría asociada a contenido (ej. "Nuevo", "Popular", "Oferta"). Distinto de elementSynBadge: este es un campo agregable a cualquier tipo; el ElementType es un bloque standalone. Incluye label (texto) + variant (estilo: primary/success/warning/etc.). Variations=Culture en label, Nothing en variant (la clave del estilo es técnica).]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Compositions/Content/Info</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>92c53ac6-8fa7-40ac-bc69-054d2d3f39fa</Key>
      <Name>Badge Label</Name>
      <Alias>badgeLabel</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Texto visible del badge. Cap recomendado 24 caracteres para que el layout no se rompa. Ejemplos: "Nuevo", "Premium", "Oferta", "Agotado". Variations=Culture. Si queda vacío, el renderer no emite el badge (comportamiento recomendado del tipo composante).]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>c74f1d68-df0d-47c0-8322-301b56523338</Key>
      <Name>Badge Variant</Name>
      <Alias>badgeVariant</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Clave del estilo visual del badge: "primary", "success", "warning", "error", "neutral". El renderer mapea la clave a la clase CSS correspondiente del design system. En olas siguientes se reemplaza por un Dropdown custom con las opciones enumeradas. Variations=Nothing: la clave es técnica y universal entre idiomas.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>626a6259-e657-43f5-b557-b9da83991c40</Key>
      <Caption>Content</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>10</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
