<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="7c9b40d5-61f5-4b61-a4e3-79f14e9c7ef6" Alias="elementIntScriptHost" Level="2">
  <Info>
    <Name>Int — Script Host</Name>
    <Icon>icon-code color-red</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type para inyectar un <script> con src externo desde una lista blanca (allowlist) configurada en appsettings (Synergos:Cdn:AllowedScriptOrigins).]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Nothing</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Integrations</Folder>
    <Compositions>
      <Composition Key="84fe7a74-faa4-434f-acf1-b1ae1a50a90f">compIntegration</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>5e9d8f95-572d-4fee-a719-b50b17f0b45b</Key>
      <Name>Script Source URL</Name>
      <Alias>scriptSrc</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[URL absoluta del script a inyectar.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>La URL del script es obligatoria.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>6dfed270-78dd-4cd8-9781-84fb11c81770</Key>
      <Name>Load Async</Name>
      <Alias>scriptAsync</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Si está activado, el <script> se emite con el atributo async (carga no bloqueante).]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
