<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="a58bb4ad-d222-4e90-95b1-48408d516bf4" Alias="elementCompArticleList" Level="2">
  <Info>
    <Name>Comp — Article List</Name>
    <Icon>icon-list color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native composite para listar posts editoriales. C# renderer consulta IPublishedContentQuery por postPage descendants filtrando por categoryFilter (category alias) y tagsFilter (CSV). Props: listTitle (Culture), maxItems (Nothing default 6), categoryFilter (Nothing alias de postCategoryPage), tagsFilter (Culture CSV). Compose compDomClass + compDomVariant + compDomSpacing.]]></Description>
    <AllowAtRoot>False</AllowAtRoot><IsListView>False</IsListView><Variations>Culture</Variations><IsElement>true</IsElement>
    <HistoryCleanup><PreventCleanup>False</PreventCleanup><KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays><KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays></HistoryCleanup>
    <Folder>Elements/Comp</Folder>
    <Compositions>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
      <Composition Key="0a2edb7e-8555-4044-bebc-bf0fe37662f2">compDomSpacing</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate><AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty><Key>ddc73e6c-368a-4707-aa74-89a1a3cc18fa</Key><Name>List Title</Name><Alias>listTitle</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Título del listado (ej. "Últimos posts"). Variations=Culture.]]></Description><SortOrder>0</SortOrder><Tab Alias="content">Content</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>7663318a-8e78-4a56-a4c3-da14dbd334f1</Key><Name>Max Items</Name><Alias>maxItems</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation>^\d+$</Validation><Description><![CDATA[Máximo de items. Default 6. Variations=Nothing.]]></Description><SortOrder>10</SortOrder><Tab Alias="content">Content</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage>Entero.</ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>2d0327d1-d58c-4d7e-b376-30895766c09a</Key><Name>Category Filter</Name><Alias>categoryFilter</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Alias/name de postCategoryPage para filtrar. Vacío = todas las categorías. Variations=Nothing.]]></Description><SortOrder>20</SortOrder><Tab Alias="content">Content</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>7addf925-d669-4846-9963-6c943183ccd3</Key><Name>Tags Filter</Name><Alias>tagsFilter</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[CSV de tags para filtrar (OR semántico: match si post tiene cualquiera). Vacío = sin filtro. Variations=Culture.]]></Description><SortOrder>30</SortOrder><Tab Alias="content">Content</Tab><Variations>Culture</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
  </GenericProperties>
