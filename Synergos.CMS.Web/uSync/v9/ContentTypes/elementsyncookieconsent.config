      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Texto del botón aceptar (ej. "Aceptar todo"). Variations=Culture.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El label de aceptar es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>dd540910-76d7-42f8-9fad-937c0141cca8</Key>
