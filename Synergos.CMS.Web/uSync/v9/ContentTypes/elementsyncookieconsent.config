<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="23efc1d2-9f83-4ba4-a61e-e545b0852110" Alias="elementSynCookieConsent" Level="2">
  <Info>
    <Name>Syn — Cookie Consent</Name>
    <Icon>icon-lock color-orange</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[SynHost block — banner GDPR/LGPD de consentimiento de cookies. DOM: <synergos-cookie-consent>. Maneja 3 niveles (essential/analytics/marketing), localStorage persistence, settings modal. Props: bannerText, acceptLabel, rejectLabel, settingsLabel, policyUrl (link a política de privacidad).]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Syn Blocks</Folder>
    <Compositions>
      <Composition Key="84fe7a74-faa4-434f-acf1-b1ae1a50a90f">compIntegration</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>a39416ae-8981-467a-872f-b58d04b30c37</Key>
      <Name>Banner Text</Name>
      <Alias>bannerText</Alias>
      <Definition>c6bac0dd-4ab9-45b1-8e30-e4b619ee5da3</Definition>
      <Type>Umbraco.TextArea</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Texto del banner (ej. "Usamos cookies para mejorar tu experiencia..."). Variations=Culture.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El texto del banner es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>cdcbb6e4-f9ed-4884-b18d-7c36d86af722</Key>
      <Name>Accept Label</Name>
      <Alias>acceptLabel</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
