      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Texto del botón rechazar (ej. "Rechazar"). Variations=Culture.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="integration">Integration</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>El label de rechazar es obligatorio.</MandatoryMessage>
