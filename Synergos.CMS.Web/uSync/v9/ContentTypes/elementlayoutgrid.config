<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="8247e825-1210-495a-a735-5ce8928fef07" Alias="elementLayoutGrid" Level="2">
  <Info>
    <Name>Layout — Grid (Custom Columns)</Name>
    <Icon>icon-grid color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Layout Composer Ola 42.5 — Preset "Grid a medida". Contenedor CSS Grid con columnas configurables por el editor: cada child es un elementLayoutColumn con columnSpan custom (de 1 a 12). Topología: 1 area "gridColumns" (12 cols) que solo acepta elementLayoutColumn como hijos (specifiedAllowance locked). Distinto de los presets N-col: Grid es cuando el editor necesita proporciones no convencionales (ej. 7+5 o 9+3 o 3+3+6 etc). Opt-in: compDomClass + compDomVariant + compDomSpacing + compDomPresetChrome. Variations=Culture. Renderer: Views/Partials/blockgrid/Components/elementLayoutGrid.cshtml. Backoffice preview: App_Plugins/LayoutComposer/views/block-grid.html.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Layout</Folder>
    <Compositions>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
      <Composition Key="0a2edb7e-8555-4044-bebc-bf0fe37662f2">compDomSpacing</Composition>
      <Composition Key="7ae5dcf3-5ed1-4ea1-a4e1-cc3a4a474138">compDomPresetChrome</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties />
  <Tabs />
</ContentType>
