<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="2fa2ee67-27d2-46ab-927e-8b2bd99067e5" Alias="elementMediaGallery" Level="2">
  <Info>
    <Name>Media — Gallery</Name>
    <Icon>icon-pictures color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Element Type SSR-native container para una galería de imágenes (grid/masonry/lightbox). Agrupa 1+ elementMediaGalleryItem via DT.BlockList.GalleryItems. Props propias: galleryItems (BlockList mandatory) + gridColumns (TextBox Nothing — número de columnas "2", "3", "4"; default del renderer = 3). Composiciones: compDomClass + compDomVariant + compDomLayout. Renderer itera y delega cada item a GalleryItem.cshtml (que ya incluye data-syn-gallery-lightbox attr para hidratación futura). Variations=Culture. Renderer: Views/Partials/Elements/Media/Gallery.cshtml.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Elements/Media</Folder>
    <Compositions>
      <Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition>
      <Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition>
      <Composition Key="06de133e-ab5f-4c56-970d-5aa8266e6334">compDomLayout</Composition>
    </Compositions>
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>303cebe2-ead8-48dc-b109-09d36c8036f6</Key>
      <Name>Gallery Items</Name>
      <Alias>galleryItems</Alias>
      <Definition>d1decddc-cda8-4d1a-bdbb-0cd9b80edeb6</Definition>
      <Type>Umbraco.BlockList</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Imágenes de la galería (1+). Cada item es elementMediaGalleryItem con mediaReference + alt + caption. Variations=Culture.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>La galería debe contener al menos una imagen.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>51a4f94c-9b38-4bd0-8598-b488b3aaa72d</Key>
      <Name>Grid Columns</Name>
      <Alias>gridColumns</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation>^[2-6]$</Validation>
      <Description><![CDATA[Número de columnas del grid desktop: "2", "3", "4", "5", "6". Si vacío, renderer default = 3. El mobile colapsa a 1-2 columnas vía CSS del design system. Variations=Nothing (decisión técnica/visual).]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Content</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage>Solo un dígito entre 2 y 6.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>24b022a4-2f8b-4546-99d8-31e9c7937c9f</Key>
      <Caption>Content</Caption>
      <Alias>content</Alias>
      <Type>Tab</Type>
      <SortOrder>10</SortOrder>
    </Tab>
  </Tabs>
</ContentType>
