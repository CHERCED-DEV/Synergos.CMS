<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="a699a693-049b-49a1-9b85-db334271e9f9" Alias="elementTramiteFormField" Level="2">
  <Info>
    <Name>Trámite — Campo del formulario</Name>
    <Icon>icon-checkbox color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Una pregunta del formulario de radicación: etiqueta, tipo de dato y si es obligatoria.]]></Description>
    <AllowAtRoot>False</AllowAtRoot>
    <IsListView>False</IsListView>
    <Variations>Culture</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Blocks/Gobierno</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>6fb1902e-9b43-4f27-ad8f-21faca7f5177</Key>
      <Name>Identificador</Name>
      <Alias>tramiteFieldId</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Nombre técnico con el que se guarda la respuesta. Único en todo el trámite. Ej: nombreCompleto.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>El identificador del campo es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>bffcc2bb-2b57-47b9-a64f-709a90a55cff</Key>
      <Name>Etiqueta</Name>
      <Alias>tramiteFieldLabel</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[La pregunta como la lee el ciudadano. Ej: Número de cédula actual.]]></Description>
      <SortOrder>10</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage>La etiqueta del campo es obligatoria.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>13cd588c-8f8d-4841-9051-6ae6f10a021d</Key>
      <Name>Tipo de dato</Name>
      <Alias>tramiteFieldType</Alias>
      <Definition>6ebf0b7d-34f1-4fbc-9f21-a9792e166812</Definition>
      <Type>Umbraco.DropDown.Flexible</Type>
      <Mandatory>true</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Qué se le pide al ciudadano. Si lo dejas vacío el campo se pinta como texto libre.]]></Description>
      <SortOrder>20</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>El tipo de dato es obligatorio.</MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>744bb554-9464-4885-8207-a683bf597e85</Key>
      <Name>Obligatorio</Name>
      <Alias>tramiteFieldRequired</Alias>
      <Definition>92897bc6-a5f3-4ffe-ae27-f2e7e33dda49</Definition>
      <Type>Umbraco.TrueFalse</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Si lo marcas, el ciudadano no puede radicar sin diligenciarlo. Sin marcar el campo es opcional.]]></Description>
      <SortOrder>30</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>ad34a742-c9bb-4d0e-8712-f14fa516dc79</Key>
      <Name>Texto de ayuda</Name>
      <Alias>tramiteFieldHelp</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Una línea bajo el campo que evita el error típico. Ej: Solo números, sin puntos.]]></Description>
      <SortOrder>40</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>dea5f2b0-2fc1-4273-8641-15bff6606272</Key>
      <Name>Opciones</Name>
      <Alias>tramiteFieldOptions</Alias>
      <Definition>08f6ca50-4c60-42a3-a05f-4a33f9727a3f</Definition>
      <Type>Umbraco.MultipleTextstring</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Solo para lista o botones: una opción por línea. Sin opciones el campo se pinta como texto libre.]]></Description>
      <SortOrder>50</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Culture</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>325b16b3-976f-45bf-b9a2-a89c0264ef84</Key>
      <Name>Formato exigido</Name>
      <Alias>tramiteFieldPattern</Alias>
      <Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Expresión regular que debe cumplir la respuesta. Déjalo vacío si aceptas cualquier valor.]]></Description>
      <SortOrder>60</SortOrder>
      <Tab Alias="content">Contenido</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
