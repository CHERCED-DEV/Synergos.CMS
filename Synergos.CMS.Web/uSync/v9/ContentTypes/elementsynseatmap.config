<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="0ba42eac-8237-4c8a-81fe-9c911a69464e" Alias="elementSynSeatMap" Level="2">
  <Info>
    <Name>Syn — Seat Map</Name>
    <Icon>icon-grid color-blue</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description><![CDATA[Mapa de asientos. Solo CONFIGURA el bloque: el inventario de butacas (cuáles existen, cuáles están libres y a qué precio) lo publica el proveedor y NO se autora aquí. DOM: <synergos-seat-map>. Props: mapRef, maxSelectable, currency.]]></Description>
    <AllowAtRoot>False</AllowAtRoot><IsListView>False</IsListView><Variations>Culture</Variations><IsElement>true</IsElement>
    <HistoryCleanup><PreventCleanup>False</PreventCleanup><KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays><KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays></HistoryCleanup>
    <Folder>Blocks/Syn</Folder>
    <Compositions><Composition Key="84fe7a74-faa4-434f-acf1-b1ae1a50a90f">compIntegration</Composition><Composition Key="46367d43-269b-418d-b54d-075fcf6d658b">compDomClass</Composition><Composition Key="e11a9feb-fa1c-4740-9481-3dce56748473">compDomVariant</Composition><Composition Key="7a383458-6ea6-4784-a4d1-17f8d4b01073">compDomVisibility</Composition><Composition Key="0a2edb7e-8555-4044-bebc-bf0fe37662f2">compDomSpacing</Composition><Composition Key="1d5bafbb-59af-4002-8709-ebade1be0392">compDomAttributes</Composition></Compositions>
    <DefaultTemplate></DefaultTemplate><AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty><Key>d3e921b7-e376-4eef-82ad-0753d48d7a34</Key><Name>Mapa</Name><Alias>mapRef</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Referencia de la cabina o el recinto que resuelve el proveedor. En blanco, el bloque sale sin asientos.]]></Description><SortOrder>0</SortOrder><Tab Alias="integration">Integración</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>01324ef6-1ce4-4253-ac6c-e2e269976cdf</Key><Name>Asientos por persona</Name><Alias>maxSelectable</Alias><Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition><Type>Umbraco.Integer</Type><Mandatory>false</Mandatory><Validation></Validation><Description><![CDATA[Cuántos asientos puede elegir una persona. En blanco o 0, se permite uno.]]></Description><SortOrder>10</SortOrder><Tab Alias="integration">Integración</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage></ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
    <GenericProperty><Key>0e70b854-5710-467d-bbf1-29cffdc18dcd</Key><Name>Moneda</Name><Alias>currency</Alias><Definition>0cc0eba1-9960-42c9-bf9b-60e150b429ae</Definition><Type>Umbraco.TextBox</Type><Mandatory>false</Mandatory><Validation>^[A-Za-z]{3}$</Validation><Description><![CDATA[Moneda de los precios en ISO (ej. COP). En blanco, se usa la del mapa; si tampoco viene, COP.]]></Description><SortOrder>20</SortOrder><Tab Alias="integration">Integración</Tab><Variations>Nothing</Variations><MandatoryMessage></MandatoryMessage><ValidationRegExpMessage>Código ISO de 3 letras (ej. COP).</ValidationRegExpMessage><LabelOnTop>false</LabelOnTop></GenericProperty>
  </GenericProperties>
