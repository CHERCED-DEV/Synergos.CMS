  <Translations>
    <Translation Language="en-US">You've tried too many codes that don't work. Wait a few minutes to try again, or continue without a code.</Translation>
    <Translation Language="es-CO">Probaste demasiados códigos que no sirven. Espera unos minutos para volver a intentarlo, o sigue sin código.</Translation>
  </Translations>
</Dictionary>