  <Translations>
    <Translation Language="en-US">With {total} hours' notice or more the whole copay is refunded; from {parcial} hours, {porcentaje}%; with less, nothing.</Translation>
    <Translation Language="es-CO">Con {total} horas o más de antelación se devuelve todo el copago; desde {parcial} horas, el {porcentaje} %; con menos, nada.</Translation>
  </Translations>
