<?xml version="1.0" encoding="utf-8"?>
<Dictionary Key="4b0a1298-126a-4994-b6e7-71f20eaa1057" Alias="Health.Consent.Retention" Level="1">
  <Info>
    <Parent>Health</Parent>
  </Info>
  <Translations>
    <Translation Language="en-US">Your medical record is kept for as long as the law requires (today, at least fifteen years from your last visit), even if you delete your account or ask us to erase your data. In that case the account is deleted and the record is no longer linked to it; it stays encrypted and is used only for what the law requires.</Translation>
    <Translation Language="es-CO">Tu historia clínica se conserva el tiempo que la ley obliga (hoy, al menos quince años desde tu última atención), aunque borres tu cuenta o pidas suprimir tus datos. En ese caso la cuenta se borra y la historia deja de estar ligada a ella; sigue cifrada y sólo se usa para lo que la ley pide.</Translation>
  </Translations>
</Dictionary>
