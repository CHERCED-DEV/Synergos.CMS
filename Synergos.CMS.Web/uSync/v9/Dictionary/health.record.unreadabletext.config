  <Translations>
    <Translation Language="en-US">We don't know which conditions or allergies you have on record. This doesn't mean you have none.</Translation>
    <Translation Language="es-CO">No sabemos qué condiciones ni qué alergias tienes registradas. Esto no quiere decir que no tengas ninguna.</Translation>
  </Translations>
</Dictionary>