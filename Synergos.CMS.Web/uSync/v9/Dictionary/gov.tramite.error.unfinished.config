<?xml version="1.0" encoding="utf-8"?>
<Dictionary Key="043c2776-5221-42eb-acfa-b012cc643661" Alias="Gov.Tramite.Error.Unfinished" Level="1">
  <Info>
    <Parent>Gov</Parent>
  </Info>
  <Translations>
    <Translation Language="en-US">We couldn't finish filing your application. Try again: you won't be charged twice and, if it isn't completed, whatever you were charged will be refunded.</Translation>
    <Translation Language="es-CO">No pudimos terminar la radicación. Vuelva a intentarlo: no se le cobra dos veces y, si no se completa, se le devuelve lo que se le haya cobrado.</Translation>
  </Translations>
</Dictionary>