<?xml version="1.0" encoding="utf-8"?>
<Dictionary Key="1dc01b92-075a-491a-ad16-d7070f90e535" Alias="Storefront.Purchase.ConfirmPending" Level="1">
  <Info>
    <Parent>Storefront</Parent>
  </Info>
  <Translations>
    <Translation Language="en-US">Your payment was authorized (reference {referencia}), but we couldn't finish the purchase. Try again: you won't be charged twice.</Translation>
    <Translation Language="es-CO">Tu pago quedó autorizado (referencia {referencia}), pero no pudimos terminar la compra. Vuelve a intentarlo: no se te cobrará dos veces.</Translation>
  </Translations>
</Dictionary>