<?xml version="1.0" encoding="utf-8"?>
<Dictionary Key="5af586d8-c245-4942-b5da-6f0f5d6bb438" Alias="Events.Purchase.RefundInProgress" Level="1">
  <Info>
    <Parent>Events</Parent>
  </Info>
  <Translations>
    <Translation Language="en-US">Your purchase (reference {referencia}) didn't complete, but we had already charged it: we're already processing the refund of that money. You can choose your tickets again.</Translation>
    <Translation Language="es-CO">Tu compra (referencia {referencia}) no se completó, pero alcanzamos a cobrarla: ya estamos tramitando la devolución de ese dinero. Puedes elegir tus entradas otra vez.</Translation>
  </Translations>
</Dictionary>