  <Translations>
    <Translation Language="en-US">We don't know yet how your purchase ended (reference {referencia}). Check «My purchases» in a few minutes before buying again.</Translation>
    <Translation Language="es-CO">Todavía no sabemos en qué quedó tu compra (referencia {referencia}). Revisa «Mis compras» en unos minutos antes de volver a comprar.</Translation>
  </Translations>
</Dictionary>