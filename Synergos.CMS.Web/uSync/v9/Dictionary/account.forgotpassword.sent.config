  <Translations>
    <Translation Language="en-US">If the email is registered, we sent you a link to reset your password. Check your inbox (and your spam folder).</Translation>
    <Translation Language="es-CO">Si el email está registrado, te enviamos un link para restablecer tu contraseña. Revisa tu bandeja de entrada (y la carpeta de spam).</Translation>
  </Translations>
</Dictionary>