<?xml version="1.0" encoding="utf-8"?>
<Dictionary Key="f8376888-20f8-4047-9c78-709bbfeda612" Alias="Health.Record.ValidateNoConsent" Level="1">
  <Info>
    <Parent>Health</Parent>
  </Info>
  <Translations>
    <Translation Language="en-US">Without the patient's permission for the practice, their record can't be seen or validated. They give it with the &quot;I authorize&quot; of their appointment or check-in.</Translation>
    <Translation Language="es-CO">Sin el permiso del paciente para el consultorio no se ve ni se valida su historia. Lo da él, con el «Autorizo» de su cita o de su pre-registro.</Translation>
  </Translations>
</Dictionary>