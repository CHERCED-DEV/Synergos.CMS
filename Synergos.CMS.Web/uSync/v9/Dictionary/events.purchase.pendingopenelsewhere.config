<Dictionary Key="9d2b9b34-633e-4f2e-82ba-67f1c3c3b506" Alias="Events.Purchase.PendingOpenElsewhere" Level="1">
  <Info>
    <Parent>Events</Parent>
  </Info>
  <Translations>
    <Translation Language="en-US">You have another purchase in progress for this event (reference {referencia}) that you didn't start here. Finish it where you started it, or cancel it here, before choosing other tickets.</Translation>
    <Translation Language="es-CO">Tienes otra compra en curso para este evento (referencia {referencia}) que no empezaste aquí. Termínala donde la empezaste, o cancélala aquí, antes de elegir otras entradas.</Translation>
  </Translations>
</Dictionary>