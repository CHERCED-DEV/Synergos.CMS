  <Translations>
    <Translation Language="en-US">This doesn't mean you have no allergies or conditions. Declare them when you check in and your doctor will validate them.</Translation>
    <Translation Language="es-CO">Esto no quiere decir que no tengas alergias ni condiciones. Decláralas en tu pre-registro y el médico las validará.</Translation>
  </Translations>
</Dictionary>