<?xml version="1.0" encoding="utf-8"?>
<Dictionary Key="779c89ce-98ce-4233-a773-0d00aefdf9ce" Alias="Alquiler.Quote.Undone" Level="1">
  <Info>
    <Parent>Alquiler</Parent>
  </Info>
  <Translations>
    <Translation Language="en-US">The rental could not be confirmed and was undone: nothing stays charged or held.</Translation>
    <Translation Language="es-CO">El alquiler no se pudo confirmar y se deshizo: no queda nada cobrado ni apartado.</Translation>
  </Translations>
</Dictionary>