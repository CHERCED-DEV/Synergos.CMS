  <Translations>
    <Translation Language="en-US">You are signed in, but this account does not have permission for this section. If you think it should, ask whoever manages roles.</Translation>
    <Translation Language="es-CO">Tu sesión está iniciada, pero esta cuenta no tiene permiso para esta sección. Si crees que debería tenerlo, pídelo a quien administre los roles.</Translation>
  </Translations>
</Dictionary>