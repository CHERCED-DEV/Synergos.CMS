  <Translations>
    <Translation Language="en-US">Your slot expired before you confirmed. If it was charged, it is refunded in full. Pick another time.</Translation>
    <Translation Language="es-CO">Tu franja venció antes de confirmar. Si se alcanzó a cobrar, se devuelve entero. Elige otra hora.</Translation>
  </Translations>
