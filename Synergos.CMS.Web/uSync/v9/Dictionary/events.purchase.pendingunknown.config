  <Translations>
    <Translation Language="en-US">We couldn't check how your previous purchase ended (reference {referencia}). Try again in a moment: we won't open another one meanwhile.</Translation>
    <Translation Language="es-CO">No pudimos comprobar cómo quedó tu compra anterior (referencia {referencia}). Vuelve a intentarlo en un momento: mientras tanto no abrimos otra.</Translation>
  </Translations>
</Dictionary>