      "columns": "3",
      "contentTypeKey": "9cea6ea5-b582-4a1e-954d-692a850221d7",
      "headingText": "Por qué reservar con nosotros",
      "itemsJson": [
        {
          "heading": "Disponibilidad en tiempo real",
          "body": "Sin sorpresas — El asistente muestra los cupos libres al instante; reservas el que te sirve."
        },
        {
          "heading": "Confirmación inmediata",
          "body": "Cero esperas — Recibes tu confirmación y recordatorios por correo automáticamente."
        },
        {
          "heading": "Mejor precio garantizado",
          "body": "Sin intermediarios — Reservas directo con el alojamiento — más claridad y mejores tarifas."
        }
      ],
      "spacingBottom": [],
      "spacingInline": [],
      "spacingTop": [],
      "udi": "umb://element/b3e5cd9d2d5e4235b9768268213424da",
