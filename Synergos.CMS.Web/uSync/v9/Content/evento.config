      "columns": "4",
      "contentTypeKey": "9cea6ea5-b582-4a1e-954d-692a850221d7",
      "headingText": "Lineup de speakers",
      "itemsJson": [
        {
          "heading": "Andrés Gómez",
          "body": "Ingeniero de plataforma — 12 años construyendo productos componibles a escala."
        },
        {
          "heading": "Laura Méndez",
          "body": "CTO, Grupo Andino — Lideró la consolidación de cuatro verticales sobre un solo core."
        },
        {
          "heading": "Diego Restrepo",
          "body": "Líder de Producto — Especialista en composición visual y sistemas de diseño."
        },
        {
          "heading": "Sofía Cardona",
          "body": "Directora Digital — Estrategia multi-marca y multi-dominio sobre un mismo motor."
        }
      ],
      "spacingBottom": [],
      "spacingInline": [],
      "spacingTop": [],
