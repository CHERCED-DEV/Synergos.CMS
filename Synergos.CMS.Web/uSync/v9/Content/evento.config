      "contentTypeKey": "346fe0eb-b88f-4e93-8944-5d9748191b2c",
      "headingText": "Antes de registrarte",
      "itemsJson": [
        {
          "question": "¿Qué incluye la entrada?",
          "answer": "Acceso a los dos días, kit del asistente, almuerzos y espacios de networking. Premium y VIP suman beneficios extra."
        },
        {
          "question": "¿Habrá grabaciones?",
          "answer": "Sí. Los registrados reciben acceso a las grabaciones de las keynotes y tracks principales."
        },
        {
          "question": "¿Puedo facturar a mi empresa?",
          "answer": "Sí. Indica los datos de tu empresa en el registro y te enviamos la factura."
        }
      ],
