      "mediaReference": [],
      "spacingBottom": [],
      "spacingInline": [],
      "spacingTop": [],
      "textBody": "<p>Completa tu registro para asegurar tu cupo. Elige tu tipo de entrada y déjanos tus datos; recibes la confirmación y tu acceso por correo al instante.</p>",
      "udi": "umb://element/62a4240e6e8d413bb702ed98a9b6d85b",
      "variantKey": []
    },
