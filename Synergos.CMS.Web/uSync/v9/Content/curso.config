      "headingText": "Antes de inscribirte",
      "itemsJson": [
        {
          "question": "¿Cuánto dura?",
          "answer": "Tres lecciones cortas, de 11 a 17 minutos cada una. Avanzas a tu ritmo."
        },
        {
          "question": "¿Recibo certificado?",
          "answer": "Sí, al completar el curso."
        },
        {
          "question": "¿Necesito experiencia previa?",
          "answer": "No. Es un curso de nivel principiante."
