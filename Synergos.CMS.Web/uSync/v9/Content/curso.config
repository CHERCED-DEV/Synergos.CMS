    {
      "ariaRole": [],
      "contentTypeKey": "346fe0eb-b88f-4e93-8944-5d9748191b2c",
      "headingText": "Antes de inscribirte",
      "itemsJson": [
        {
          "question": "¿Cuánto dura el acceso?",
          "answer": "El acceso al curso es de por vida; puedes repasarlo cuando quieras."
        },
        {
          "question": "¿Recibo certificado?",
          "answer": "Sí, al completar el proyecto final obtienes un certificado verificable."
        },
        {
          "question": "¿Hay devolución?",
          "answer": "Tienes 14 días de garantía: si el curso no es para ti, te devolvemos tu dinero."
        }
      ],
