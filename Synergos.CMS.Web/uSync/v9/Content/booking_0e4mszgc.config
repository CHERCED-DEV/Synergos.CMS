      },
      "headingSubtitle": "La agenda en línea, disponible 24/7",
      "headingTitle": "Booking — reservas y citas sin fricción",
      "mediaAlt": "Preview de la app Booking",
      "mediaReference": [
        {
          "key": "67c9f20f-2f61-43de-9961-f4c8032a4073",
          "mediaKey": "b36929c6-41cd-471f-9c56-48beb3e9d672",
          "crops": [],
