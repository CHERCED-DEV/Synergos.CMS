      "headingText": "Sobre tu reserva",
      "itemsJson": [
        {
          "question": "¿Puedo cambiar o cancelar mi cita?",
          "answer": "Sí. Escríbenos o llámanos y la cambiamos o cancelamos según las reglas del servicio."
        },
        {
          "question": "¿Recibo recordatorios?",
          "answer": "Por ahora no enviamos recordatorios automáticos: al reservar, te contactamos para confirmar tu cita."
        },
        {
          "question": "¿Qué pasa si llego tarde?",
          "answer": "Cada servicio define su tolerancia; te la contamos al confirmar tu cita."
        }
