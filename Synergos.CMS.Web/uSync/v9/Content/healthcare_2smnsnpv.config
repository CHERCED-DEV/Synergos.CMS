      "contentTypeKey": "2717b9e7-debe-4354-8dfd-780f88f1842c",
      "headingSubtitle": "",
      "headingTitle": "Demo en vivo — el recorrido del paciente",
      "mediaAlt": "SynergosLabs",
      "mediaReference": [],
      "spacingBottom": [],
      "spacingInline": [],
      "spacingTop": [],
      "textBody": "<p>Desliza la línea de tiempo: así fluye una atención de punta a punta dentro de la app.</p>",
      "udi": "umb://element/d01149d079be41be9bbf349925fee2b9",
      "variantKey": []
    },
