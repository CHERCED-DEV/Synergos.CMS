      "headingSubtitle": "Historia clínica, agenda y recetas en un solo lugar",
      "headingTitle": "Healthcare — el consultorio en orden",
      "mediaAlt": "Preview de la app Healthcare",
      "mediaReference": [
        {
          "key": "457ca456-944a-4cea-a637-6aaae352f91e",
          "mediaKey": "b0700680-6748-4e64-9c5e-548359c76d90",
