      "eventsJson": [
        {
          "date": "Paso 1",
          "title": "Agenda tu cita",
          "description": "Eliges especialista y horario con disponibilidad real — sin sobrecupos."
        },
        {
          "date": "Paso 2",
          "title": "Check-in",
          "description": "Confirmas tus datos y el motivo de consulta antes de llegar."
        },
        {
          "date": "Paso 3",
          "title": "Consulta",
          "description": "El profesional registra la atención en la historia clínica versionada."
        },
        {
          "date": "Paso 4",
          "title": "Receta",
          "description": "La receta queda emitida y vinculada a tu historia — el sistema registra, el profesional decide."
        },
        {
          "date": "Paso 5",
          "title": "Seguimiento",
          "description": "Controles y resultados quedan en tu historia, con acceso auditado por consentimiento."
