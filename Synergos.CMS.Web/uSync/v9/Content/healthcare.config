    {
      "ariaRole": [],
      "contentTypeKey": "346fe0eb-b88f-4e93-8944-5d9748191b2c",
      "headingText": "Preguntas frecuentes",
      "itemsJson": [
        {
          "question": "¿Cómo agendo una cita?",
          "answer": "Llená el formulario de abajo o llamanos; te confirmamos en minutos."
        },
        {
          "question": "¿Mis datos están seguros?",
          "answer": "Sí: la información clínica va cifrada y con acceso auditado por consentimiento."
        },
        {
          "question": "¿Atienden urgencias?",
          "answer": "Para urgencias acudí al servicio de emergencias; acá agendamos consultas y controles."
        }
      ],
      "spacingBottom": [],
      "spacingInline": [],
      "spacingTop": [],
      "udi": "umb://element/a564ae02c46444b7badfbc66e8e9000b",
