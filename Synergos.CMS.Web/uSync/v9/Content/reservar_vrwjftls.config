      "headingText": "Sobre tu reserva",
      "itemsJson": [
        {
          "question": "¿Puedo modificar mi reserva?",
          "answer": "Sí, desde el enlace que te enviamos por correo, según la política del alojamiento."
        },
        {
          "question": "¿Recibo recordatorios?",
          "answer": "Sí. Te enviamos la confirmación al reservar y un recordatorio antes de tu llegada."
