      "variantKey": []
    },
    {
      "ariaRole": [],
      "columns": "3",
      "contentTypeKey": "9cea6ea5-b582-4a1e-954d-692a850221d7",
      "headingText": "Qué demuestra del motor",
      "itemsJson": [
        {
          "heading": "Catálogo filtrable",
          "body": "Cursos como contenido — Cada curso es contenido componible; el catálogo se busca y filtra en vivo."
        },
        {
          "heading": "Aula con temario",
          "body": "Lecciones interactivas — El temario se navega por módulos expandibles — el aula, sin salir del navegador."
        },
        {
          "heading": "Inscripción sobre el motor",
          "body": "Checkout compartido — Inscribirse usa el mismo motor transaccional que la Tienda y Booking."
        }
      ],
      "spacingBottom": [],
      "spacingInline": [],
      "spacingTop": [],
      "udi": "umb://element/1d757dcec55047238561d5fe6af7c42b",
      "variantKey": []
    },
