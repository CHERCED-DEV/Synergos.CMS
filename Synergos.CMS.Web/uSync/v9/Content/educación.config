      "headingSubtitle": "",
      "headingTitle": "Demo en vivo — el temario interactivo",
      "mediaAlt": "SynergosLabs",
      "mediaReference": [],
      "spacingBottom": [],
      "spacingInline": [],
      "spacingTop": [],
      "textBody": "<p>Expande los módulos: es el mismo organismo de temario que usa el aula de la app real.</p>",
      "udi": "umb://element/ddd2e2d2b98c4c7ebd9d97b258faf86f",
