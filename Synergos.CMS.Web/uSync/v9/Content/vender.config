      "headingText": "Qué haces desde la consola",
      "itemsJson": [
        {
          "heading": "Panel",
          "body": "Las ventas, las publicaciones activas, pausadas o agotadas, y las devoluciones por revisar."
        },
        {
          "heading": "Publicar",
          "body": "Un producto nuevo en cuatro pasos: datos, fotos, precio y stock, y una revisión antes de que quede visible en la tienda."
        },
        {
          "heading": "Mensajes y preguntas",
          "body": "Respondes a los compradores desde el mismo panel."
        },
        {
          "heading": "Reputación",
          "body": "Entregas a tiempo, órdenes con reclamo y preguntas respondidas."
        }
