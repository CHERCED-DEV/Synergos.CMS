      "headingText": "Qué demuestra del motor",
      "itemsJson": [
        {
          "heading": "Ficha inmersiva",
          "body": "Galería lightbox — Cada propiedad se recorre en una galería a pantalla completa, con specs y ubicación."
        },
        {
          "heading": "Precios reales es-CO",
          "body": "Cero hardcode — Cada propiedad es contenido con precio numérico formateado al render."
        },
        {
          "heading": "Visita = reserva",
          "body": "Pago apagable — Agendar una visita usa el motor transaccional con el paso de pago en OFF."
        }
      ],
