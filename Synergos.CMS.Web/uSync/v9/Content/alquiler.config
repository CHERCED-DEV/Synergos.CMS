      "headingText": "Cómo funciona",
      "itemsJson": [
        {
          "heading": "Elige y calcula",
          "body": "Escoge el equipo, las fechas y las unidades, y ve el valor antes de reservar."
        },
        {
          "heading": "Reserva y paga",
          "body": "Apartamos tus unidades unos minutos; al confirmar pagas el alquiler y se retiene la garantía."
        },
        {
          "heading": "Tu contrato",
          "body": "En «Mis alquileres» queda tu contrato sellado, con la fecha hasta la que puedes cancelar."
        },
        {
          "heading": "Devuelve",
          "body": "Al entregar el equipo declaras la devolución; el personal la revisa y libera la garantía."
        }
      ],
      "spacingBottom": [],
      "spacingInline": [],
      "spacingTop": [],
