      "headingText": "Lo que ofrecemos",
      "itemsJson": [
        {
          "heading": "Consulta médica",
          "body": "Presencial o virtual — Agenda, atiende y registra la consulta con historia clínica versionada."
        },
        {
          "heading": "Controles y seguimiento",
          "body": "Continuidad del cuidado — Citas de control con acceso al historial completo del paciente."
        },
        {
          "heading": "Recetas",
          "body": "Registro formal — Emisión y consulta de recetas, vinculadas al paciente."
        },
        {
          "heading": "Consentimiento informado",
          "body": "Transparencia — El paciente controla quién accede a su información clínica."
        }
      ],
