    },
    {
      "ariaRole": [],
      "columns": "3",
      "contentTypeKey": "9cea6ea5-b582-4a1e-954d-692a850221d7",
      "headingText": "Cómo funciona",
      "itemsJson": [
        {
          "heading": "1 · Busca",
          "body": "Elige el destino, las fechas y cuántos viajan."
        },
        {
          "heading": "2 · Arma tu viaje",
          "body": "Compara las opciones y agrega al carrito la estadía, el vuelo o el auto."
        },
        {
          "heading": "3 · Confirma",
          "body": "Completa los datos del viajero y recibe la referencia de tu reserva."
        }
      ],
      "spacingBottom": [],
      "spacingInline": [],
      "spacingTop": [],
      "udi": "umb://element/bf7e7c7af91a46769c561a5397f9f515",
      "variantKey": []
    },
    {
      "ariaRole": [],
