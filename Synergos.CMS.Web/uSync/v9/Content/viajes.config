      "udi": "umb://element/bd2368f8b1db42ec832992ed1ada6b8d",
      "variantKey": []
    },
    {
      "ariaRole": [],
      "contentTypeKey": "346fe0eb-b88f-4e93-8944-5d9748191b2c",
      "headingText": "Preguntas frecuentes",
      "itemsJson": [
        {
          "question": "¿En qué moneda se muestran los precios?",
          "answer": "En pesos colombianos, con el total de la estadía según las noches y los huéspedes que elegiste."
        },
        {
          "question": "¿Puedo cancelar una reserva?",
          "answer": "Sí, desde «Mis viajes». Si la tarifa es reembolsable lo verás indicado antes de reservar."
        },
        {
          "question": "¿Puedo combinar estadía, vuelo y auto?",
          "answer": "Sí. Todo lo que agregas queda en el mismo carrito y se confirma en un solo paso."
        },
        {
          "question": "¿Se realizan cobros?",
          "answer": "No. Este es un sitio de demostración: las reservas no generan cobros ni compromisos con los alojamientos."
        }
      ],
      "spacingBottom": [],
