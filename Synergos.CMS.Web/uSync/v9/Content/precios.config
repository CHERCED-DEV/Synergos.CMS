      "contentTypeKey": "9cea6ea5-b582-4a1e-954d-692a850221d7",
      "headingText": "Todos los planes incluyen",
      "itemsJson": [
        {
          "heading": "El mismo motor",
          "body": "Sin versiones capadas — Todos los planes corren sobre el mismo core: cambias capacidad y soporte, nunca la tecnología."
        },
        {
          "heading": "SSR + SEO técnico",
          "body": "Rápido y encontrable — Render server-side, sitemap, robots y datos estructurados incluidos desde el plan gratis."
        },
        {
          "heading": "Tu marca con tokens",
          "body": "Identidad de fábrica — Color, tipografía y logo por tokens — tu sitio luce propio en cualquier plan."
        }
      ],
      "spacingBottom": [],
      "spacingInline": [],
      "spacingTop": [],
      "udi": "umb://element/8ba2bdf4b71544b7a64769e5838998c2",
