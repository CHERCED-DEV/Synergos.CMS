      "headingSubtitle": "Andamios, energía, sonido y herramienta, sobre el mismo motor",
      "headingTitle": "Alquiler — equipos por días",
      "mediaAlt": "Preview de la app Alquiler",
      "mediaReference": [
        {
          "key": "fa0a5a68-16b8-4d91-90bb-408b6fd5522b",
          "mediaKey": "f1ad570b-fa9a-41d3-95d7-30a08911dc66",
          "crops": [],
