        "lg"
      ],
      "spacingTop": [
        "2xl"
      ],
      "theme": [],
      "udi": "umb://element/af332d90310f4aca895a072be2f23d71",
      "variantKey": []
    },
    {
      "ariaRole": [],
      "columns": "3",
      "contentTypeKey": "9cea6ea5-b582-4a1e-954d-692a850221d7",
      "headingText": "Así se alquila",
      "itemsJson": [
        {
          "heading": "1 · Elige el equipo",
          "body": "Catálogo por categoría — Ves el precio por día, la garantía y las unidades antes de pedir nada."
        },
        {
          "heading": "2 · Cotiza tus fechas",
          "body": "Precio exacto — Eliges desde y hasta, y la cotización te dice el total, el tramo y lo retenido."
        },
        {
          "heading": "3 · Reserva y devuelve",
          "body": "Mis alquileres — Sigues cada alquiler y, al devolver, ves qué se liberó de la garantía."
        }
      ],
      "spacingBottom": [],
      "spacingInline": [],
      "spacingTop": [],
