      "spacingBottom": [],
      "spacingInline": [],
      "spacingTop": [],
      "textBody": "<p>La app Eventos demuestra el motor bajo presión: cupos limitados, retención del ticket mientras te registras y confirmación con acceso al instante. Para organizadores de conferencias, conciertos y experiencias premium.</p>",
      "udi": "umb://element/edac687f43094136a6e123bf4d682fd9",
      "variantKey": []
    },
    {
      "ariaRole": [],
      "containerType": [],
      "contentTypeKey": "1c68f4a9-24e9-49ac-9efa-05b3d4b1404a",
      "mobileCollapseMode": [],
