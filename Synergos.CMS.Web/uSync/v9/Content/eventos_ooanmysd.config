      "headingSubtitle": "Cartelera, tickets y agenda sobre el mismo motor",
      "headingTitle": "Eventos — experiencias que se agotan",
      "mediaAlt": "Preview de la app Eventos",
      "mediaReference": [
        {
          "key": "69df30b0-5b4f-4599-8a79-0ed956627547",
          "mediaKey": "0b3b9e76-8dad-41cc-997d-64324a88a642",
