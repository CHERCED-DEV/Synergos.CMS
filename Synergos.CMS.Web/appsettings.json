{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "2c0db938-5b6a-4f77-8c93-0614294d42c6",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeAuto",
        "ModelsNamespace": "Synergos.CMS.Web.PublishedModels",
        "ModelsDirectory": "~/umbraco/models",
        "FlagOutOfDateModels": true
      }
    }
  },
  "uSync": {
    "Sets": {
      "Default": {
        "Handlers": {
          "ContentHandler": {
            "Enabled": true
          },
          "MediaHandler": {
            "Enabled": true
          }
        }
      }
    }
  },
  "Synergos": {
    "Branding": {
      "Key": "default",
      "DisplayName": "Synergos"
    },
    "FeatureFlags": {
      "Gates": {}
    },
    "Puerta": {
      "Flujos": {
        "eventos.compra": {
          "Acceso": "Miembro",
          "SujetoKind": "eventos.comprador",
          "Negocio": {
            "Seccion": "Eventos",
            "Campos": [ "FeePercent" ]
          },
          "Aviso": {
            "Ruta": "/eventos/?compra={id}"
          }
        },
        "salud.cita": {
          "Acceso": "Miembro",
          "SujetoKind": "salud.paciente",
          "Negocio": {
            "Seccion": "Ehr",
            "Campos": [ "Servicio" ]
          },
          "Aviso": {
            "Ruta": "/healthcare/?cita={id}"
          }
        },
        "tienda.compra": {
          "Acceso": "Miembro",
          "SujetoKind": "tienda.comprador",
          "Negocio": {
            "Seccion": "Storefront",
            "Campos": [ "Carrier" ]
          },
          "Aviso": {
            "Ruta": "/tienda/?compra={id}"
          }
        },
        "tienda.devolucion": {
          "Acceso": "Personal",
          "Roles": [ "admin" ],
          "SujetoKind": "tienda.personal"
        },
        "alquiler.renta": {
          "Acceso": "Miembro",
          "SujetoKind": "alquiler.arrendatario",
          "Aviso": {
            "Ruta": "/alquiler/?alquiler={id}"
          }
        },
        "reservas.servicio": {
          "Acceso": "Miembro",
          "SujetoKind": "reservas.cliente",
          "Invitado": [ "disponibilidad" ],
          "FrenoPorMinuto": 30,
          "Aviso": {
            "Ruta": "/booking/reservar/?reserva={id}"
          }
        },
        "propiedades.visita": {
          "Acceso": "Miembro",
          "SujetoKind": "propiedades.interesado",
          "Invitado": [ "disponibilidad" ],
          "Aviso": {
            "Ruta": "/propiedades/?visita={id}"
          }
        },
        "propiedades.visita-cancelacion": {
          "Acceso": "Miembro",
          "SujetoKind": "propiedades.interesado"
        },
        "viajes.reserva": {
          "Acceso": "Miembro",
          "SujetoKind": "viajes.viajero",
          "Aviso": {
            "Ruta": "/viajes/?viaje={id}",
            "Seccion": "BookingWizard",
            "Campo": "AvisoRuta"
          }
        },
        "viajes.devolucion": {
          "Acceso": "Personal",
          "Roles": [ "admin" ],
          "SujetoKind": "viajes.personal"
        },
        "viajes.cancelacion": {
          "Acceso": "Personal",
          "Roles": [ "admin" ],
          "SujetoKind": "viajes.personal"
        },
        "educacion.matricula": {
          "Acceso": "Miembro",
          "SujetoKind": "educacion.alumno",
          "Aviso": {
            "Ruta": "/educacion/?matricula={id}"
          }
        },
        "educacion.devolucion": {
          "Acceso": "Personal",
          "Roles": [ "admin" ],
          "SujetoKind": "educacion.personal"
        }
      }
    }
  }
}
