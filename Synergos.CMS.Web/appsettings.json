{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "2c0db938-5b6a-4f77-8c93-0614294d42c6",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeAuto",
        "ModelsNamespace": "Synergos.CMS.Web.PublishedModels",
        "ModelsDirectory": "~/umbraco/models",
        "FlagOutOfDateModels": true
      }
    }
  },
  "Synergos": {
    "Branding": {
      "Key": "default",
      "DisplayName": "Synergos"
    },
    "FeatureFlags": {
      "Gates": {}
    }
  }
}
