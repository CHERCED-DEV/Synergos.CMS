{
  "$schema": "appsettings-schema.json",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Umbraco.Cms.Core.Services.LocalizedTextService": "Error",
        "Umbraco.Cms.Web.Common.ModelsBuilder.InMemoryAuto.InMemoryModelFactory": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": { "configure": [ { "Name": "Console" } ] }
      }
    ]
  },

  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },

  "Umbraco": {
    "CMS": {
      "Global": {
        "UmbracoApplicationUrl": "http://localhost:8080/",
        "TimeOut": "1.00:00:00",
        "Smtp": {
          "From": "no-reply@synergos.local",
          "DeliveryMethod": "SpecifiedPickupDirectory",
          "PickupDirectoryLocation": "/app/App_Data/maildrop"
        }
      },
      "RuntimeMode": "BackofficeDevelopment",
      "Security": {
        "KeepUserLoggedIn": true
      },
      "Unattended": {
        "InstallUnattended": true,
        "UpgradeUnattended": true,
        "UnattendedUserName": "admin",
        "UnattendedUserEmail": "admin@synergos.local",
        "UnattendedUserPassword": "Synergos2026!"
      },
      "ModelsBuilder": {
        "ModelsMode": "InMemoryAuto"
      },
      "Content": {
        "MacroErrors": "Throw"
      },
      "Hosting": {
        "Debug": true
      },
      "RuntimeMinification": {
        "UseInMemoryCache": true,
        "CacheBuster": "Timestamp"
      }
    }
  },

  "Synergos": {
    "DevCss": {
      "Enabled": true
    },
    "DevSeed": {
      "Enabled": true
    },
    "LocalCdn": {
      "Enabled": true,
      "LocalPath": "/cdn",
      "RoutePath": "/cdn-bundles",
      "CacheControlMaxAgeSeconds": 31536000
    },
    "BundleRegistry": {
      "Mode": "FileSystem",
      "LocalPath": "/cdn",
      "BundlesNamespace": "synergos",
      "RegistryFileName": "registry.json",
      "PublicBaseUrl": "/cdn-bundles",
      "DefaultFramework": "angular",
      "DefaultSlot": "latest",
      "StripFolderPrefix": false,
      "ComputeIntegrityIfMissing": true,
      "HotReloadEnabled": true,
      "HotReloadDebounceMilliseconds": 500
    },
    "Notifications": {
      "Enabled": true,
      "PublicBaseUrl": "http://localhost:8080"
    },
    "Catalog": {
      "Sources": {
        "Shop": "cms",
        "Events": "demo"
      },
      "Scopes": {
        "Shop": "ecommerce",
        "Events": "eventos"
      }
    }
  }
}
