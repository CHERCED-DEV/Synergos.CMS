@*
    Template del Document Type `pageBase` (perfil Standard).
    Renderiza:
    - <h1> con el heading editorial (o el nombre del nodo) si
      showTitle está activo
    - sections (Layout Composer principal)
    - sectionsAfterBody (cierre opcional)

    El chrome (header/footer/breadcrumbs/alerta global) lo aplica
    _Layout vía IPageRenderContextResolver + IGlobalComponentResolver.
    El hero/intro/featured image se arman como bloques arrastrables
    dentro de sections, no son props del page.
*@
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Synergos.CMS.Application.Dto.Responses.PageBaseResponse>
@inject Synergos.CMS.Interfaces.IPageRenderContextResolver PageRenderContextResolver
@using Umbraco.Cms.Core.Models.Blocks
@{
    Layout = "_Layout";
    var currentContent = UmbracoContext.PublishedRequest?.PublishedContent;
    var sections = currentContent?.Value<BlockGridModel>("sections");
    var sectionsAfter = currentContent?.Value<BlockGridModel>("sectionsAfterBody");
    var renderCtx = PageRenderContextResolver.Resolve();
    var heading = currentContent?.Value<string>("heading");
    if (string.IsNullOrWhiteSpace(heading)) { heading = currentContent?.Name; }
}
<article class="syn-page syn-page-standard">
    @if (renderCtx.ShowTitle && !string.IsNullOrWhiteSpace(heading))
    {
        <header class="syn-page__header">
            <h1 class="syn-page__title">@heading</h1>
        </header>
    }
    @if (sections != null && sections.Any())
    {
        <div class="syn-page__body">
            @await Html.GetBlockGridHtmlAsync(sections)
        </div>
    }
    @if (sectionsAfter != null && sectionsAfter.Any())
    {
        <div class="syn-page__after-body">
            @await Html.GetBlockGridHtmlAsync(sectionsAfter)
        </div>
    }
</article>
