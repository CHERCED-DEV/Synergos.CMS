@*
    Template del Document Type `pageBase` (Ola 8 + bodyBlocks Ola 16 +
    shared layout Ola 18). Ahora hereda chrome de _Layout.cshtml
    (header con brand/nav + main + footer). Solo emite el contenido
    del <main>.

    Modelo:
    - SeoTitle + BodyHtml de PageBaseResponse DTO.
    - bodyBlocks (BlockGrid Editorial) leído directo de
      UmbracoContext.PublishedRequest (tipo complejo Umbraco-native;
      no fluye por el DTO para no romper DIP).
*@
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Synergos.CMS.Application.Dto.Responses.PageBaseResponse>
@using Umbraco.Cms.Core.Models.Blocks
@{
    Layout = "_Layout";
    var currentContent = UmbracoContext.PublishedRequest?.PublishedContent;
    var blocks = currentContent?.Value<BlockGridModel>("bodyBlocks");
}
<article class="syn-page-base">
    @if (!string.IsNullOrWhiteSpace(Model.SeoTitle))
    {
        <h1 class="syn-page-base__title">@Model.SeoTitle</h1>
    }
    @if (!string.IsNullOrWhiteSpace(Model.BodyHtml))
    {
        <div class="syn-page-base__intro">@Html.Raw(Model.BodyHtml)</div>
    }
    @if (blocks != null && blocks.Any())
    {
        <div class="syn-page-base__blocks">
            @await Html.GetBlockGridHtmlAsync(blocks)
        </div>
    }
</article>
