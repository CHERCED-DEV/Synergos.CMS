@*
    Partial reusable para los <head> de Admin/* views (Layout=null).
    Inyecta meta + Manrope + bundle CSS (tokens + base + admin).
    Cada view también provee su propio <title> tras llamar a este partial.
*@
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@@300;400;500;600;700&display=swap" />
<link rel="stylesheet" href="~/css/syn-tokens.css" />
<link rel="stylesheet" href="~/css/syn-base.css" />
<link rel="stylesheet" href="~/css/syn-admin.css" />
