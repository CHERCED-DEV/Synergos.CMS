@*
    Vista del AdminController.Members (Olas 144-145). Listing read-only
    del Member roster con paginación + filter por role.
*@
@using Synergos.CMS.Interfaces
@{
    Layout = null;
    var roster = (MemberRosterPage)ViewData["Roster"]!;
    var allRoles = ViewData["AllRoles"] as IReadOnlyList<string> ?? Array.Empty<string>();
    var roleFilter = ViewData["RoleFilter"] as string;
    var twoFactorStatus = ViewData["TwoFactorStatus"] as Dictionary<Guid, bool> ?? new();

    bool RoleSelected(MemberRosterItem m, string role) =>
        m.Roles.Any(r => string.Equals(r, role, StringComparison.OrdinalIgnoreCase));

    string PageHref(int p)
    {
        var q = $"?page={p}";
        if (!string.IsNullOrWhiteSpace(roleFilter))
        {
            q += $"&role={Uri.EscapeDataString(roleFilter)}";
        }
        return "/admin/members" + q;
    }
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    @await Html.PartialAsync("_AdminHead")
    <title>@Umbraco.GetDictionaryValue("admin.nav.members", "Miembros") · Synergos</title>
</head>
<body class="syn-admin">
    @await Html.PartialAsync("_AdminTopbar")

    <main class="syn-admin__main">
        <div class="syn-admin__container">
            <header class="syn-admin__page-header">
                <h1 class="syn-admin__page-title">
                    @Umbraco.GetDictionaryValue("admin.nav.members", "Miembros")
                    <small class="syn-admin__page-count">· @roster.TotalCount</small>
                </h1>
                <p class="syn-admin__page-subtitle">
                    Listing read-only de Members registrados. Filtrable por role.
                    Edición vía backoffice de Umbraco.
                </p>
            </header>

            @if (allRoles.Count > 0)
            {
                <form method="get" action="/admin/members" class="syn-admin__filters">
                    <label class="syn-admin__filter">
                        <span class="syn-admin__filter-label">Role</span>
                        <select name="role" class="syn-admin__filter-select">
                            <option value="">— @Umbraco.GetDictionaryValue("admin.action.clear", "Limpiar") —</option>
                            @foreach (var role in allRoles)
                            {
                                var sel = string.Equals(role, roleFilter, StringComparison.OrdinalIgnoreCase);
                                <option value="@role" selected="@sel">@role</option>
                            }
                        </select>
                    </label>
                    <button type="submit" class="syn-admin__filter-submit">@Umbraco.GetDictionaryValue("admin.action.applyfilters", "Aplicar filtros")</button>
                    @if (!string.IsNullOrWhiteSpace(roleFilter))
                    {
                        <a href="/admin/members" class="syn-admin__filter-clear">@Umbraco.GetDictionaryValue("admin.action.clear", "Limpiar")</a>
                    }
                </form>
            }

            @if (roster.Items.Count == 0)
            {
                <div class="syn-admin__empty">
                    <p>No hay Members que coincidan con el filtro actual.</p>
                </div>
            }
            else
            {
                <table class="syn-admin__table">
                    <thead>
                        <tr>
                            <th>@Umbraco.GetDictionaryValue("admin.col.email", "Email")</th>
                            <th>@Umbraco.GetDictionaryValue("admin.col.name", "Nombre")</th>
                            <th>@Umbraco.GetDictionaryValue("admin.col.roles", "Roles")</th>
                            <th class="syn-admin__col-num">@Umbraco.GetDictionaryValue("admin.col.lastlogin", "Último login")</th>
                            <th class="syn-admin__col-num">@Umbraco.GetDictionaryValue("admin.col.created", "Creado")</th>
                            <th>@Umbraco.GetDictionaryValue("admin.col.state", "Estado")</th>
                            <th>@Umbraco.GetDictionaryValue("admin.col.actions", "Acciones")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in roster.Items)
                        {
                            <tr>
                                <td><code>@m.Email</code></td>
                                <td>@m.DisplayName</td>
                                <td>
                                    @if (m.Roles.Count == 0)
                                    {
                                        <span class="syn-admin__role-empty">—</span>
                                    }
                                    else
                                    {
                                        foreach (var r in m.Roles)
                                        {
                                            <span class="syn-admin__role">@r</span>
                                        }
                                    }
                                </td>
                                <td class="syn-admin__col-num">
                                    @(m.LastLoginUtc.HasValue ? m.LastLoginUtc.Value.ToString("yyyy-MM-dd HH:mm") + " UTC" : "—")
                                </td>
                                <td class="syn-admin__col-num">
                                    @m.CreatedUtc.ToString("yyyy-MM-dd")
                                </td>
                                <td>
                                    @if (m.IsLockedOut)
                                    {
                                        <span class="syn-admin__status syn-admin__status--danger">@Umbraco.GetDictionaryValue("admin.status.locked", "Bloqueado")</span>
                                    }
                                    else if (!m.IsApproved)
                                    {
                                        <span class="syn-admin__status syn-admin__status--warn">@Umbraco.GetDictionaryValue("admin.status.unconfirmed", "Sin confirmar")</span>
                                    }
                                    else
                                    {
                                        <span class="syn-admin__status syn-admin__status--ok">@Umbraco.GetDictionaryValue("admin.status.ok", "OK")</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var lockLabel = Umbraco.GetDictionaryValue("admin.action.lock", "Bloquear");
                                        var unlockLabel = Umbraco.GetDictionaryValue("admin.action.unlock", "Desbloquear");
                                    }
                                    @if (m.IsLockedOut)
                                    {
                                        <form method="post" action="/admin/members/@m.Key/unlock" class="syn-admin__item-form">
                                            <button type="submit" class="syn-admin__action syn-admin__action--approve" aria-label="@($"{unlockLabel} {m.Email}")">🔓 @unlockLabel</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" action="/admin/members/@m.Key/lock" class="syn-admin__item-form">
                                            <button type="submit" class="syn-admin__action syn-admin__action--reject" aria-label="@($"{lockLabel} {m.Email}")">🔒 @lockLabel</button>
                                        </form>
                                    }
                                    @if (twoFactorStatus.TryGetValue(m.Key, out var has2fa) && has2fa)
                                    {
                                        <form method="post" action="/admin/members/@m.Key/2fa-reset" class="syn-admin__item-form" style="margin-top:var(--syn-space-xs);">
                                            <button type="submit" class="syn-admin__action syn-admin__action--ghost" title="Disable 2FA — Member tendrá que re-enroll" aria-label="@($"Reset 2FA {m.Email}")">🔑 Reset 2FA</button>
                                        </form>
                                    }
                                    <form method="post" action="/admin/members/@m.Key/password-reset" class="syn-admin__item-form" style="margin-top:var(--syn-space-xs);">
                                        <button type="submit" class="syn-admin__action syn-admin__action--ghost" title="Send password reset email" aria-label="@($"Reset password {m.Email}")">📧 Reset password</button>
                                    </form>
                                    <button type="button" class="syn-admin__action syn-admin__action--reject" style="margin-top:var(--syn-space-xs);"
                                            data-member-delete="@m.Key" data-member-email="@m.Email"
                                            aria-label="@($"Eliminar {m.Email}")">
                                        🗑 Eliminar
                                    </button>
                                </td>
                            </tr>
                            @if (allRoles.Count > 0)
                            {
                                <tr class="syn-admin__row-extra">
                                    <td colspan="7">
                                        <form method="post" action="/admin/members/@m.Key/roles" class="syn-admin__roles-form">
                                            <span class="syn-admin__roles-label">Roles:</span>
                                            @foreach (var role in allRoles)
                                            {
                                                <label class="syn-admin__role-chip">
                                                    <input type="checkbox" name="roles" value="@role" checked="@RoleSelected(m, role)" />
                                                    <span>@role</span>
                                                </label>
                                            }
                                            <button type="submit" class="syn-admin__action syn-admin__action--ghost">Aplicar</button>
                                        </form>
                                    </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (roster.TotalPages > 1)
                {
                    var prevLabel = "← " + Umbraco.GetDictionaryValue("admin.page.previous", "Anterior");
                    var nextLabel = Umbraco.GetDictionaryValue("admin.page.next", "Siguiente") + " →";
                    <nav class="syn-admin__pagination" aria-label="Paginación">
                        @if (roster.HasPrev)
                        {
                            <a class="syn-admin__page-link" rel="prev" href="@PageHref(roster.Page - 1)">@prevLabel</a>
                        }
                        else
                        {
                            <span class="syn-admin__page-link syn-admin__page-link--disabled">@prevLabel</span>
                        }
                        <span class="syn-admin__page-current">@roster.Page / @roster.TotalPages</span>
                        @if (roster.HasNext)
                        {
                            <a class="syn-admin__page-link" rel="next" href="@PageHref(roster.Page + 1)">@nextLabel</a>
                        }
                        else
                        {
                            <span class="syn-admin__page-link syn-admin__page-link--disabled">@nextLabel</span>
                        }
                    </nav>
                }
            }
        </div>
    </main>

    @* Native <dialog> confirm for hard-delete (irreversible). Olas 181-184. *@
    <dialog id="member-delete-confirm" class="syn-admin__dialog">
        <form id="member-delete-form" method="post" class="syn-admin__dialog-form">
            <h2 class="syn-admin__dialog-title">Eliminar Member <span class="syn-admin__danger">irreversible</span></h2>
            <p class="syn-admin__dialog-body">
                Vas a eliminar el Member <code id="member-delete-email"></code> de forma <strong>irreversible</strong>.
                Comments / form submissions previos persisten con author orphan.
                El Member 2FA secret + recovery codes se borran.
            </p>
            <div class="syn-admin__dialog-actions">
                <button type="button" data-dialog-cancel class="syn-admin__action syn-admin__action--ghost">@Umbraco.GetDictionaryValue("admin.action.cancel", "Cancelar")</button>
                <button type="submit" class="syn-admin__action syn-admin__action--reject">🗑 @Umbraco.GetDictionaryValue("admin.action.delete", "Eliminar")</button>
            </div>
        </form>
    </dialog>

    <script>
        (function () {
            var dialog = document.getElementById('member-delete-confirm');
            var form = document.getElementById('member-delete-form');
            var emailSpan = document.getElementById('member-delete-email');
            if (!dialog || !form) return;

            document.querySelectorAll('[data-member-delete]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var memberKey = btn.getAttribute('data-member-delete');
                    var memberEmail = btn.getAttribute('data-member-email') || '';
                    form.action = '/admin/members/' + memberKey + '/delete';
                    if (emailSpan) emailSpan.textContent = memberEmail;
                    dialog.showModal();
                });
            });

            dialog.querySelectorAll('[data-dialog-cancel]').forEach(function (cancel) {
                cancel.addEventListener('click', function () {
                    dialog.close();
                });
            });
        })();
    </script>
</body>
</html>
