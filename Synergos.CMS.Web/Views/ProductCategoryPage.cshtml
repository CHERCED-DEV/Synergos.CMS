@*
    Template del Document Type `productCategoryPage`. Renderiza la
    landing de una categoría de producto: nombre + descripción +
    listado paginado de productos hijos vía IShopQuery.

    Page size hardcoded 12. Sort default "name", configurable via
    querystring `?sort=price-asc|price-desc|newest|name`.
    Paginación via querystring `?page=N`.
*@
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Synergos.CMS.Web.PublishedModels.ProductCategoryPage>
@using System.Globalization
@using Umbraco.Extensions
@inject Synergos.CMS.Interfaces.IShopQuery ShopQuery
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = "_Layout";
    if (Model is null) { return; }

    const int PageSize = 12;
    var pageRaw = HttpContextAccessor.HttpContext?.Request?.Query["page"].ToString();
    var pageNumber = int.TryParse(pageRaw, out var pn) && pn > 0 ? pn : 1;
    var skip = (pageNumber - 1) * PageSize;

    var sortRaw = HttpContextAccessor.HttpContext?.Request?.Query["sort"].ToString();
    var sortBy = string.IsNullOrWhiteSpace(sortRaw) ? "name" : sortRaw;

    var categoryName = !string.IsNullOrWhiteSpace(Model.CategoryName) ? Model.CategoryName : Model.Name;
    var description = Model.CategoryDescription;

    var products = ShopQuery.GetProducts(new Synergos.CMS.Interfaces.ShopQueryRequest(
        MaxItems: PageSize + 1,
        Skip: skip,
        CategoryAliasOrName: Model.Name,
        SortBy: sortBy));

    var hasNext = products.Count > PageSize;
    var visible = hasNext ? products.Take(PageSize).ToArray() : products;
    var hasPrev = pageNumber > 1;
    var baseUrl = Model.Url();
    var coCulture = CultureInfo.GetCultureInfo("es-CO");
}
<section class="syn-product-category">
    <header class="syn-product-category__header">
        <h1 class="syn-product-category__title">@categoryName</h1>
        @if (!string.IsNullOrWhiteSpace(description))
        {
            <p class="syn-product-category__description">@description</p>
        }
    </header>

    <nav class="syn-product-category__sort" aria-label="@Umbraco.GetDictionaryValue("shop.sort", "Ordenar por")">
        <a href="@baseUrl?sort=name" class="@(sortBy == "name" ? "is-active" : "")">@Umbraco.GetDictionaryValue("shop.sort.name", "Nombre")</a>
        <a href="@baseUrl?sort=price-asc" class="@(sortBy == "price-asc" ? "is-active" : "")">@Umbraco.GetDictionaryValue("shop.sort.priceAsc", "Precio: menor a mayor")</a>
        <a href="@baseUrl?sort=price-desc" class="@(sortBy == "price-desc" ? "is-active" : "")">@Umbraco.GetDictionaryValue("shop.sort.priceDesc", "Precio: mayor a menor")</a>
        <a href="@baseUrl?sort=newest" class="@(sortBy == "newest" ? "is-active" : "")">@Umbraco.GetDictionaryValue("shop.sort.newest", "Más recientes")</a>
    </nav>

    @if (visible.Count == 0)
    {
        <p class="syn-product-category__empty">@Umbraco.GetDictionaryValue("shop.empty", "Aún no hay productos en esta categoría.")</p>
    }
    else
    {
        <ul class="syn-product-category__items">
            @foreach (var product in visible)
            {
                @* Card rica (paridad de markup con ProductCard.cshtml /
                   elementShopProductCard) para heredar de una sola fuente
                   de estilo .syn-product-card*. *@
                <li class="syn-product-category__item-cell">
                    <article class="syn-product-card syn-product-card--standard" data-sku="@product.Sku">
                        <a class="syn-product-card__link" href="@product.Url">
                            <div class="syn-product-card__media">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img class="syn-product-card__image" src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                                }
                            </div>
                            <div class="syn-product-card__body">
                                <h2 class="syn-product-card__name">@product.Name</h2>
                                <span class="syn-product-card__price">
                                    @product.Price.ToString("N0", coCulture) @product.Currency
                                </span>
                                @if (!product.InStock)
                                {
                                    <span class="syn-product-card__out-of-stock">@Umbraco.GetDictionaryValue("shop.outOfStock", "Agotado")</span>
                                }
                            </div>
                        </a>
                        @if (product.InStock)
                        {
                            <div class="syn-product-card__body syn-product-card__actions">
                                <button type="button"
                                        class="syn-product-card__add-to-cart"
                                        data-action="add-to-cart"
                                        data-sku="@product.Sku"
                                        data-price="@product.Price.ToString(CultureInfo.InvariantCulture)">
                                    @Umbraco.GetDictionaryValue("shop.addToCart", "Agregar al carrito")
                                </button>
                            </div>
                        }
                    </article>
                </li>
            }
        </ul>

        @if (hasPrev || hasNext)
        {
            <nav class="syn-product-category__pagination" aria-label="@Umbraco.GetDictionaryValue("shop.pagination", "Paginación")">
                @if (hasPrev)
                {
                    <a class="syn-product-category__pagination-prev" href="@baseUrl?page=@(pageNumber - 1)&sort=@sortBy" rel="prev">
                        @Umbraco.GetDictionaryValue("shop.previous", "Anteriores")
                    </a>
                }
                <span class="syn-product-category__pagination-current">@pageNumber</span>
                @if (hasNext)
                {
                    <a class="syn-product-category__pagination-next" href="@baseUrl?page=@(pageNumber + 1)&sort=@sortBy" rel="next">
                        @Umbraco.GetDictionaryValue("shop.next", "Siguientes")
                    </a>
                }
            </nav>
        }
    }
</section>
