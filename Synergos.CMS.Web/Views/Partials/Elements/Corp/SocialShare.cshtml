@*
    elementCorpSocialShare renderer (Ola 21). SSR-native atomic.
    Botonera de compartir en RRSS. Usa URL + title de la página actual
    (via UmbracoContext). enabledPlatforms filtra qué plataformas mostrar.
    Keys soportados: facebook, twitter, linkedin, whatsapp, telegram, reddit, pinterest y email:
    los que ofrece DTSelectSharePlatform (#192, caso 20; telegram, reddit y pinterest se ofrecían
    y no se pintaban).
*@
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement>
@inject Umbraco.Cms.Core.Web.IUmbracoContextAccessor UmbracoContextAccessor
@{
    var platforms = Model.Value<IEnumerable<string>>("platforms");
    var enabled = (platforms is null || !platforms.Any()
            ? new[] { "facebook", "twitter", "linkedin", "email" }
            : platforms.Select(s => s.ToLowerInvariant()).ToArray());
    var variant = Model.Value<string>("variantKey");
    var cssClass = Model.Value<string>("cssClass");
    var classes = string.Join(" ", new[]
    {
        "syn-social-share",
        string.IsNullOrWhiteSpace(variant) ? null : $"syn-social-share--{variant}",
        string.IsNullOrWhiteSpace(cssClass) ? null : cssClass,
    }.Where(s => !string.IsNullOrWhiteSpace(s)));

    string pageUrl = "";
    string pageTitle = "";
    if (UmbracoContextAccessor.TryGetUmbracoContext(out var ctx) && ctx.PublishedRequest?.PublishedContent != null)
    {
        var current = ctx.PublishedRequest.PublishedContent;
        pageUrl = current.Url(mode: UrlMode.Absolute);
        pageTitle = current.Name ?? "";
    }
    var encUrl = Uri.EscapeDataString(pageUrl);
    var encTitle = Uri.EscapeDataString(pageTitle);

#nullable enable
    string? BuildShareUrl(string platform) => platform switch
    {
        "facebook" => $"https://www.facebook.com/sharer/sharer.php?u={encUrl}",
        "twitter"  => $"https://twitter.com/intent/tweet?url={encUrl}&text={encTitle}",
        "linkedin" => $"https://www.linkedin.com/sharing/share-offsite/?url={encUrl}",
        "whatsapp" => $"https://wa.me/?text={encTitle}%20{encUrl}",
        "telegram" => $"https://t.me/share/url?url={encUrl}&text={encTitle}",
        "reddit"   => $"https://www.reddit.com/submit?url={encUrl}&title={encTitle}",
        "pinterest" => $"https://www.pinterest.com/pin/create/button/?url={encUrl}&description={encTitle}",
        "email"    => $"mailto:?subject={encTitle}&body={encUrl}",
        _ => null
    };

    // Lo que se lee en cada botón (012-blogs-social, D-012-V9): antes, la clave de la plataforma («facebook»). Una marca
    // no va al diccionario y la pone el elemento (CLAUDE.md, criterio (i)); «Correo» sí, porque se traduce.
    string Nombre(string platform) => platform switch
    {
        "facebook"  => "Facebook",
        "twitter"   => "X",
        "linkedin"  => "LinkedIn",
        "whatsapp"  => "WhatsApp",
        "telegram"  => "Telegram",
        "reddit"    => "Reddit",
        "pinterest" => "Pinterest",
        "email"     => Umbraco.GetDictionaryValueOrDefault("Share.Mail", "Correo"),
        _ => platform
    };

    // La etiqueta accesible: «Compartir en Facebook», o «Compartir por correo».
    string Etiqueta(string platform) => platform == "email"
        ? Umbraco.GetDictionaryValueOrDefault("Share.Email", "Compartir por correo")
        : Umbraco.GetDictionaryValueOrDefault("Share.On", "Compartir en {network}").Replace("{network}", Nombre(platform));
}
<nav class="@classes" aria-label="@Umbraco.GetDictionaryValueOrDefault("Share.Label", "Compartir")">
    @foreach (var platform in enabled)
    {
        var href = BuildShareUrl(platform);
        if (href == null) { continue; }
        var isMail = platform == "email";
        <a class="syn-social-share__link syn-social-share__link--@platform"
           href="@href"
           aria-label="@Etiqueta(platform)"
           target="@(isMail ? null : "_blank")"
           rel="@(isMail ? null : "noopener noreferrer")">@Nombre(platform)</a>
    }
</nav>
