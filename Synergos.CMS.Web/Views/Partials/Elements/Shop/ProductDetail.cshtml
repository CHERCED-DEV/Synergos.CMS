@*
    elementShopProductDetail renderer (Ola 33 schema + Ola 39 runtime).

    PDP-1 (Ola 3): converge con `Views/ProductPage.cshtml`. Ambos
    renderizan la PDP a través del núcleo compartido
    `Elements/Shop/_ProductDetailCore`, de modo que el bloque editor-drop
    y el template canónico emiten la MISMA estructura `.syn-product`
    (gallery / info / pricing / stock / variants / add-to-cart / trust)
    con el mismo IPriceFormatter y la misma moneda. Una sola fuente
    visual de PDP.

    El bloque resuelve por SKU el IPublishedContent del `productPage`
    (el record ProductSummary de IShopQuery no expone imágenes múltiples,
    descripción ni variantsJson — el core necesita el content tipado), y
    delega el render al core. El wrapper conserva las clases del bloque
    (variant / cssClass) y los placeholders de reviews / related para
    hidratación JS (sin entidades review/related en el schema todavía).
*@
@model Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement
@using System.Globalization
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Web
@inject IUmbracoContextAccessor UmbracoContextAccessor
@{
    var sku = Model.Value<string>("productSku");
    if (string.IsNullOrWhiteSpace(sku)) { return; }
    var showVariantPicker = Model.Value<bool>("showVariantPicker");
    var showReviews = Model.Value<bool>("showReviews");
    var showRelated = Model.Value<bool>("showRelated");
    var variant = Model.Value<string>("variantKey");
    var cssClass = Model.Value<string>("cssClass");
    var classes = string.Join(" ", new[]
    {
        "syn-product",
        string.IsNullOrWhiteSpace(variant) ? null : $"syn-product--{variant}",
        string.IsNullOrWhiteSpace(cssClass) ? null : cssClass,
    }.Where(s => !string.IsNullOrWhiteSpace(s)));

    // Resolver el IPublishedContent del producto por SKU. Mismo patrón que
    // DefaultShopQuery (la seam IShopQuery devuelve ProductSummary, sin el
    // content tipado que el core consume). Sin tree-walk si no hay contexto.
    IPublishedContent? product = null;
    if (UmbracoContextAccessor.TryGetUmbracoContext(out var umbracoContext) && umbracoContext.Content is not null)
    {
        product = umbracoContext.Content.GetAtRoot()
            .SelectMany(r => r.DescendantsOrSelfOfType("productPage"))
            .FirstOrDefault(pp => string.Equals(pp.Value<string>("productSku"), sku, StringComparison.OrdinalIgnoreCase));
    }
}
<article class="@classes"
         data-sku="@sku"
         data-show-variant-picker="@showVariantPicker"
         data-show-reviews="@showReviews"
         data-show-related="@showRelated">
    @if (product is null)
    {
        <p class="syn-product__empty">@Umbraco.GetDictionaryValue("Shop.Filter.NoResults") <code>@sku</code></p>
    }
    else
    {
        @await Html.PartialAsync("Elements/Shop/_ProductDetailCore", product)

        @if (showReviews)
        {
            <section class="syn-product__reviews"
                     data-pending="reviews-integration"
                     data-sku="@sku"
                     aria-label="@Umbraco.GetDictionaryValue("Shop.Product.Rating")">
                <!-- Reviews se cargan via endpoint externo (provider TBD) — hidratación JS. -->
            </section>
        }
        @if (showRelated)
        {
            <section class="syn-product__related"
                     data-pending="related-query"
                     data-sku="@sku">
                <!-- Related products resueltos por categoría/tags comunes — hidratación JS. -->
            </section>
        }
    }
</article>
