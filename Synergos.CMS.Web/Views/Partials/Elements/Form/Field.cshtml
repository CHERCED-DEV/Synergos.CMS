@*
    elementFormField renderer (Ola 23). SSR-native atomic.
    Emite <label> + <input|textarea> + <small> helpText. Se invoca
    únicamente desde FormContainer.cshtml (no tiene wrapper BG).
*@
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement>
@{
    var label = Model.Value<string>("fieldLabel");
    var name = Model.Value<string>("fieldName");
    if (string.IsNullOrWhiteSpace(label) || string.IsNullOrWhiteSpace(name)) { return; }
    var type = Model.Value<string>("fieldType");
    if (string.IsNullOrWhiteSpace(type)) { type = "text"; }
    var required = Model.Value<bool>("fieldRequired");
    var placeholder = Model.Value<string>("fieldPlaceholder");
    var helpText = Model.Value<string>("fieldHelpText");
    var inputId = $"syn-field-{Model.Key}-{name}";
    var helpId = string.IsNullOrWhiteSpace(helpText) ? null : $"{inputId}-help";
    var isTextarea = type == "textarea";
    // Un select sin opciones se pinta como texto: la descripción del campo lo promete así (#196).
    var options = type == "select"
        ? (Model.Value<IEnumerable<string>>("fieldOptions") ?? Enumerable.Empty<string>())
            .Where(o => !string.IsNullOrWhiteSpace(o)).Select(o => o.Trim()).ToList()
        : new List<string>();
    var isSelect = options.Count > 0;
    if (type == "select" && !isSelect) { type = "text"; }
}
<div class="syn-form-field syn-form-field--@type">
    <label class="syn-form-field__label" for="@inputId">
        @label@if (required) { <span class="syn-form-field__required" aria-hidden="true">*</span> }
    </label>
    @if (isSelect)
    {
        <select id="@inputId"
                class="syn-form-field__input"
                name="@name"
                required="@(required ? "required" : null)"
                aria-required="@(required ? "true" : null)"
                aria-describedby="@helpId">
            <option value="" disabled selected>@(string.IsNullOrWhiteSpace(placeholder) ? Umbraco.GetDictionaryValueOrDefault("Form.Placeholders.SelectOption", "Selecciona una opción") : placeholder)</option>
            @foreach (var option in options)
            {
                <option value="@option">@option</option>
            }
        </select>
    }
    else if (isTextarea)
    {
        <textarea id="@inputId"
                  class="syn-form-field__input"
                  name="@name"
                  rows="4"
                  placeholder="@(placeholder ?? "")"
                  required="@(required ? "required" : null)"
                  aria-required="@(required ? "true" : null)"
                  aria-describedby="@helpId"></textarea>
    }
    else
    {
        <input id="@inputId"
               class="syn-form-field__input"
               type="@type"
               name="@name"
               placeholder="@(placeholder ?? "")"
               required="@(required ? "required" : null)"
               aria-required="@(required ? "true" : null)"
               aria-describedby="@helpId" />
    }
    @if (!string.IsNullOrWhiteSpace(helpText))
    {
        <small id="@helpId" class="syn-form-field__help">@helpText</small>
    }
</div>
