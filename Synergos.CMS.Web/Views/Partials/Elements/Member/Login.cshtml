@*
    elementMemberLogin renderer (Ola 35). SSR skeleton.
    Middleware C# Members auth wiring pendiente.
*@
@using Umbraco.Cms.Core.Models
@model Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement
@{
    var endpoint = Model.Value<string>("loginEndpoint");
    if (string.IsNullOrWhiteSpace(endpoint)) { return; }
    var redirectLink = Model.Value<Link>("redirectLink");
    var redirect = redirectLink?.Url;
    var variant = Model.Value<string>("variantKey");
    var cssClass = Model.Value<string>("cssClass");
    var classes = string.Join(" ", new[]
    {
        "syn-member-login",
        string.IsNullOrWhiteSpace(variant) ? null : $"syn-member-login--{variant}",
        string.IsNullOrWhiteSpace(cssClass) ? null : cssClass,
    }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
<form class="@classes" action="@endpoint" method="post">
    @if (!string.IsNullOrWhiteSpace(redirect))
    {
        <input type="hidden" name="returnUrl" value="@redirect" />
    }
    <div class="syn-member-login__field">
        <label class="syn-member-login__label" for="syn-login-email-@Model.Key">Email</label>
        <input id="syn-login-email-@Model.Key" type="email" name="email" required autocomplete="username" />
    </div>
    <div class="syn-member-login__field">
        <label class="syn-member-login__label" for="syn-login-password-@Model.Key">Contraseña</label>
        <input id="syn-login-password-@Model.Key" type="password" name="password" required autocomplete="current-password" />
    </div>
    <button type="submit" class="syn-member-login__submit">@("Iniciar sesión")</button>
</form>
