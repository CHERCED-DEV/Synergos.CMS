@*
    elementStructStack renderer (Ola 20 schema + Ola 42 layout).
    1D flex container. Direction/wrap/justify/align/gap resueltos
    por LayoutCssBuilder a partir de compDomFlex (Ola 42) con fallback
    al legacy compDomLayout cuando las props nuevas están vacías.
*@
@model Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement
@using Umbraco.Cms.Core.Models.Blocks
@using Synergos.CMS.Web.Services
@{
    var children = Model.Value<BlockGridModel>("children");
    if (children == null || !children.Any()) { return; }
    var variant = Model.Value<string>("variantKey");
    var cssClass = Model.Value<string>("cssClass");
    var classes = string.Join(" ", new[]
    {
        "syn-stack",
        string.IsNullOrWhiteSpace(variant) ? null : $"syn-stack--{variant}",
        string.IsNullOrWhiteSpace(cssClass) ? null : cssClass,
    }.Concat(LayoutCssBuilder.Build(Model)).Where(s => !string.IsNullOrWhiteSpace(s)));
}
<div class="@classes">
    @await Html.GetBlockGridHtmlAsync(children)
</div>
