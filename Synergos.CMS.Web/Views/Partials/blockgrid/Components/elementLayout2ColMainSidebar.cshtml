@*
    elementLayout2ColMainSidebar renderer (Ola 42.5 + semantic HTML
    en Ola 42.7). 2 areas main (8) + sidebar (4). Sidebar emite
    <aside> para landmark semántico; main emite <main>.
    Backoffice preview: App_Plugins/LayoutComposer/views/block-layout-main-sidebar.html
*@
@model Umbraco.Cms.Core.Models.Blocks.BlockGridItem
@using Synergos.CMS.Web.Services
@{
    var element = Model.Content;
    var variant = element.Value<string>("variantKey");
    var cssClass = element.Value<string>("cssClass");
    var classes = string.Join(" ", new[]
    {
        "syn-layout",
        "syn-layout--main-sidebar",
        string.IsNullOrWhiteSpace(variant) ? null : $"syn-layout--v-{variant}",
        string.IsNullOrWhiteSpace(cssClass) ? null : cssClass,
    }.Concat(LayoutCssBuilder.Build(element)).Where(s => !string.IsNullOrWhiteSpace(s)));
}
<div class="@classes">
    @foreach (var area in Model.Areas)
    {
        var areaClasses = $"syn-layout__area syn-layout__area--{area.Alias}";
        if (area.Alias == "main")
        {
            <main class="@areaClasses">
                @await Html.GetBlockGridItemsHtmlAsync(area)
            </main>
        }
        else if (area.Alias == "sidebar")
        {
            <aside class="@areaClasses">
                @await Html.GetBlockGridItemsHtmlAsync(area)
            </aside>
        }
        else
        {
            <div class="@areaClasses">
                @await Html.GetBlockGridItemsHtmlAsync(area)
            </div>
        }
    }
</div>
