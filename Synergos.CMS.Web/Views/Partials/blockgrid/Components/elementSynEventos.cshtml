@model Umbraco.Cms.Core.Models.Blocks.BlockGridItem
@inject Synergos.CMS.Web.Services.Puerta.FlujosColocables Colocables
@*
    <synergos-flujo> envuelve la funcionalidad de Eventos (ADR 0140, decisión 6 · F4): el coordinador
    sin render de la compra, que la lleva a la puerta. La CLAVE del flujo la pone el servidor y no el
    bundle —nada en el DOM es frontera de confianza, y el atributo es una clave, nunca una ruta—.
    Desde el núcleo N3 la elige el editor (la propiedad «flujo» de compFlujo), de la lista cerrada que
    cruza FlujosColocables: lo que la puerta expone y el sitio declara. Sin elección, o con una que ya no
    vale, queda el por defecto de siempre, eventos.compra, y CoordinadorDelFlujoEnLasVistasTests lo cruza
    con la tabla de la puerta y con Synergos:Puerta:Flujos. El style en línea es para antes de que el
    bundle defina la etiqueta: un elemento desconocido es inline y cambiaría el layout del ítem del BlockGrid.
*@
@{
    var flujo = Colocables.Elegir(Model.Content.Value<string>("flujo"), porDefecto: "eventos.compra");
}
<synergos-flujo flujo="@flujo" style="display:contents">
    @await Html.PartialAsync("SynHost/Eventos", Model.Content)
</synergos-flujo>
