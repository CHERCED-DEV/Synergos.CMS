@*
    SynHost renderer — <synergos-video-player>. Custom video with chapters + analytics.
*@
@model Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement
@inject Synergos.CMS.Interfaces.ISynHostEmitter Emitter
@{
    var videoFile = Model.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("videoFile");
    var posterImage = Model.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("posterImage");
    var props = new Dictionary<string, object?>(StringComparer.Ordinal)
    {
        ["videoUrl"] = videoFile?.Url(mode: Umbraco.Cms.Core.Models.UrlMode.Absolute),
        ["posterUrl"] = posterImage?.Url(mode: Umbraco.Cms.Core.Models.UrlMode.Absolute),
        ["chaptersJson"] = Model.Value<string>("chaptersJson"),
        ["enableAnalytics"] = Model.Value<bool>("enableAnalytics"),
    };
    var request = new Synergos.CMS.Interfaces.SynHostEmitRequest(
        BlockAlias: "video-player",
        Props: props,
        ConfigOverrideJson: Model.Value<string>("configOverride"),
        Culture: System.Globalization.CultureInfo.CurrentUICulture);
    var result = await Emitter.EmitAsync(request);
}
@await Html.PartialAsync("SynHost/_Wrapper", (Model, result.ScriptHtml, result.ElementHtml))