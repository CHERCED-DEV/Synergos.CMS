@model Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement
@inject Synergos.CMS.Interfaces.ISynHostEmitter Emitter
@{
    // apiBase: default /api/gov si el editor no lo setea (NO mandatory).
    var apiBase = Model.Value<string>("apiBase");
    if (string.IsNullOrWhiteSpace(apiBase)) { apiBase = "/api/gov"; }

    // config: JSON opcional autorado por el editor; el emitter lo fusiona sobre
    // los props base (rol inicial, defaults). Si está vacío o malformado,
    // el componente Angular resuelve sus defaults (degrada con grace).
    var config = Model.Value<string>("config");

    // Aquí NO se manda quién es el ciudadano, y es el punto entero de T2. Había un
    // `citizen` (que además ni existía en el schema: se hardcodeaba un correo sembrado)
    // y el cliente lo mandaba como `?citizen=<email>` — o sea, la identidad la ponía el
    // navegador. Ahora la resuelve el servidor desde la cookie de sesión, que viaja sola
    // porque la app se monta en esta misma página. Si no hay sesión, el API responde 401
    // y la app ofrece iniciar sesión.

    var props = new Dictionary<string, object?>(StringComparer.Ordinal)
    {
        ["apiBase"] = apiBase,
        ["heading"] = Model.Value<string>("heading"),
        ["subheading"] = Model.Value<string>("subheading"),
    };
    // BlockAlias DEBE ser el name kebab del registry = "gov" (el emitter resuelve
    // el bundle por ese alias; camelCase no matchearía y no hidrataría).
    var request = new Synergos.CMS.Interfaces.SynHostEmitRequest("gov", props, config, System.Globalization.CultureInfo.CurrentUICulture);
    var result = await Emitter.EmitAsync(request);
}
@await Html.PartialAsync("SynHost/_Wrapper", (Model, result.ScriptHtml, result.ElementHtml))
