@*
    SynHost renderer — info-block. Monta <synergos-info-block>.
    `ctaUrl` es un MultiUrlPicker (ADR 0021: URLs por picker, no texto libre),
    asi que aca se extrae `.Url` — el elemento espera una cadena.
*@
@model Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement
@using Umbraco.Cms.Core.Models
@inject Synergos.CMS.Interfaces.ISynHostEmitter Emitter
@{
    var ctaLink = Model.Value<Link>("ctaUrl");
    var props = new Dictionary<string, object?>(StringComparer.Ordinal)
    {
        ["title"] = Model.Value<string>("title"),
        ["body"] = Model.Value<string>("body"),
        ["ctaLabel"] = Model.Value<string>("ctaLabel"),
        ["ctaUrl"] = ctaLink?.Url,
        ["variant"] = Model.Value<string>("variant"),
        ["theme"] = Model.Value<string>("theme"),
    };
    var request = new Synergos.CMS.Interfaces.SynHostEmitRequest("info-block", props, Model.Value<string>("configOverride"), System.Globalization.CultureInfo.CurrentUICulture);
    var result = await Emitter.EmitAsync(request);
}
@await Html.PartialAsync("SynHost/_Wrapper", (Model, result.ScriptHtml, result.ElementHtml))
