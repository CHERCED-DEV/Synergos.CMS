@*
    Shared wrapper partial que SynHost partials invocan para aplicar
    los props compDom* al DOM emitido. Si el editor no setea ninguno
    de esos props, el wrapper se omite y el custom element se emite
    directo — evita DOM pollution con <div> vacío.
*@
@using Synergos.CMS.Web.Services
@model (Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement Element, string ScriptHtml, string ElementHtml)
@{
    var wrap = SynHostWrapperBuilder.Build(Model.Element);
}
@Html.Raw(Model.ScriptHtml)
@if (wrap.IsNoOp)
{
    @Html.Raw(Model.ElementHtml)
}
else
{
    <div class="@wrap.Classes"@Html.Raw(wrap.Attributes)>@Html.Raw(Model.ElementHtml)</div>
}
