@model Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement
@inject Synergos.CMS.Interfaces.ISynHostEmitter Emitter
@{
    // apps: JSON array de dominios. Se DESERIALIZA a JsonElement (como FeatureGrid
    // con itemsJson) para que el emitter lo serialice como array anidado en config
    // — el componente Angular (normalizeApps) requiere un array, no un string.
    object? apps = null;
    var appsJson = Model.Value<string>("apps");
    if (!string.IsNullOrWhiteSpace(appsJson))
    {
        try { apps = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(appsJson); }
        catch (System.Text.Json.JsonException) { apps = null; }
    }

    var props = new Dictionary<string, object?>(StringComparer.Ordinal)
    {
        ["apps"] = apps,
        // La clave se llama `title`, NO `heading`: el sanitizer del componente
        // (app-launcher.ts, sanitizeAppLauncherConfig) reconstruye el config clave por
        // clave y descarta en silencio todo lo que no liste. Mandando `heading` el
        // título autorado se perdía en la frontera y el Hub pintaba su fallback
        // ('Galería de aplicaciones') — un título hardcodeado en la portada del
        // producto, que es exactamente lo que el principio rector nº1 llama bug.
        // El alias del ElementType sigue siendo `heading` (schema, ADR 0008): la
        // traducción de nombre vive aquí, que es la frontera CMS↔componente.
        ["title"] = Model.Value<string>("heading"),
        // `subheading` NO se manda: el header del Hub es <syn-heading> + contador y no
        // tiene subtítulo donde pintarlo. Añadir uno sería inventar UI que el diseño no
        // contempla sólo para tener destino del prop. Se retira el Set() muerto.
        // ⚠️ El ElementType conserva la propiedad `subheading` y el editor la ve: es
        // schema y lo posee el arquitecto (ADR 0008). Queda anotado para él.
    };
    var request = new Synergos.CMS.Interfaces.SynHostEmitRequest("app-launcher", props, Model.Value<string>("configOverride"), System.Globalization.CultureInfo.CurrentUICulture);
    var result = await Emitter.EmitAsync(request);
}
@await Html.PartialAsync("SynHost/_Wrapper", (Model, result.ScriptHtml, result.ElementHtml))
