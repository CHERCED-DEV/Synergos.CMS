@*
    SynHost renderer — <synergos-ehr>. El portal clínico: paciente, médico y enfermería.

    Host tonto (ADR 0135): el resolver arma el record que viaja (EhrProps) con lo que escribe
    el editor y dónde vive la API para el sitio de la petición (Synergos:Features:Ehr, ADR 0137).
    Es una FUNCIONALIDAD (ADR 0134): no recibe JSON libre del editor.

    Sin sesión (vuelta de valor de 003, receta de D-012-V11): el elemento lleva dentro el panel «Inicia sesión» que la
    app va a pintar, y la app lo sabe (SinSesion) para arrancar ahí. Antes el elemento estaba vacío hasta que llegaba
    su bundle y, al montar, empujaba los bloques de abajo. Con sesión no hay reserva: lo que se vería es la historia de
    alguien, y eso no lo pinta el servidor.
*@
@using Synergos.CMS.Web.Services
@using Synergos.CMS.Web.Services.SynHost
@model Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement
@inject IResolutorSynHost<Synergos.CMS.Interfaces.SynHost.EhrProps> Resolutor
@inject Synergos.CMS.Interfaces.ISynHostEmitter Emitter
@inject Umbraco.Cms.Core.Security.IMemberManager Miembros
@{
    var resuelto = Resolutor.Resolver(Model);
    if (!Miembros.IsLoggedIn())
    {
        var aqui = Context.Request.Path.ToString() + Context.Request.QueryString.ToString();
        resuelto = resuelto with
        {
            Props = resuelto.Props with { SinSesion = true },
            RespaldoHtml = SynHostFallbackBuilder.EhrSinSesion(aqui),
        };
    }
    var result = await Emitter.EmitAsync(SolicitudSynHost.Para(resuelto, null, System.Globalization.CultureInfo.CurrentUICulture));
}
@await Html.PartialAsync("SynHost/_Wrapper", (Model, result.ScriptHtml, result.ElementHtml))
