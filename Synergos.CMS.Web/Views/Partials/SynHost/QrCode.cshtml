@model Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement
@inject Synergos.CMS.Interfaces.ISynHostEmitter Emitter
@{
// El runtime compila las vistas SIN contexto nullable; ver Views/_ViewImports.cshtml.
#nullable enable
    var props = new Dictionary<string, object?>(StringComparer.Ordinal)
    {
        ["data"] = Model.Value<string>("data"),
        ["size"] = Model.Value<string>("size"),
        ["ecLevel"] = Model.Value<string>("ecLevel"),
    };
    var request = new Synergos.CMS.Interfaces.SynHostEmitRequest("qr-code", props, Model.Value<string>("configOverride"), System.Globalization.CultureInfo.CurrentUICulture);
    var result = await Emitter.EmitAsync(request);
}
@await Html.PartialAsync("SynHost/_Wrapper", (Model, result.ScriptHtml, result.ElementHtml))