@model Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement
@inject Synergos.CMS.Interfaces.ISynHostEmitter Emitter
@{
    var props = new Dictionary<string, object?>(StringComparer.Ordinal)
    {
        ["endDateTime"] = Model.Value<string>("endDateTime"),
        ["showLabels"] = Model.Value<bool>("showLabels"),
        ["style"] = Model.Value<string>("style"),
    };
    var request = new Synergos.CMS.Interfaces.SynHostEmitRequest("countdown-digital", props, Model.Value<string>("configOverride"), System.Globalization.CultureInfo.CurrentUICulture);
    var result = await Emitter.EmitAsync(request);
}
@Html.Raw(result.ScriptHtml)
@Html.Raw(result.ElementHtml)
