@*
    SynHost renderer — <synergos-share-bar>. Social share with Web Share API.

    Host tonto (ADR 0135): el resolver arma el record que viaja (ShareBarProps) —las redes como
    lista y el destino del enlace— y la vista resuelve y emite. Antes mandaba platformsCsv y
    shareUrl, el elemento lee platforms y shareLink: la barra pintaba las redes de fábrica y
    compartía la página actual (D1).
*@
@using Synergos.CMS.Web.Services.SynHost
@model Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement
@inject IResolutorSynHost<Synergos.CMS.Interfaces.SynHost.ShareBarProps> Resolutor
@inject Synergos.CMS.Interfaces.ISynHostEmitter Emitter
@{
    var resuelto = Resolutor.Resolver(Model);
    var result = await Emitter.EmitAsync(SolicitudSynHost.Para(resuelto, Model.Value<string>("configOverride"), System.Globalization.CultureInfo.CurrentUICulture));
}
@await Html.PartialAsync("SynHost/_Wrapper", (Model, result.ScriptHtml, result.ElementHtml))
