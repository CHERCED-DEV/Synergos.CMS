@model Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement
@inject Synergos.CMS.Interfaces.ISynHostEmitter Emitter
@{
    var props = new Dictionary<string, object?>(StringComparer.Ordinal)
    {
        ["quote"] = Model.Value<string>("quote"),
        ["attribution"] = Model.Value<string>("attribution"),
        ["animationMode"] = Model.Value<string>("animationMode"),
    };
    var request = new Synergos.CMS.Interfaces.SynHostEmitRequest("quote-animated", props, Model.Value<string>("configOverride"), System.Globalization.CultureInfo.CurrentUICulture);
    var result = await Emitter.EmitAsync(request);
}
@Html.Raw(result.ScriptHtml)
@Html.Raw(result.ElementHtml)
