@*
    AccountController.ConfirmEmail (Ola 83). Solo se renderiza cuando
    el confirmEmail FALLA (token inválido/expirado/email inexistente).
    El path success redirige a /account/login?msg=email-confirmed.
*@
@{
    Layout = null;
    var errorCode = ViewData["ErrorCode"] as string;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    @await Html.PartialAsync("_AccountHead")
    <title>@Umbraco.GetDictionaryValue("Account.ConfirmEmail.Title", "Confirmación de email")</title>
</head>
<body class="syn-account">
    <main class="syn-account__main">
        <h1 class="syn-account__heading">
            @Umbraco.GetDictionaryValue("Account.ConfirmEmail.Title", "Confirmación de email")
        </h1>
        <p class="syn-account__error" role="alert" aria-live="polite">
            @{
                var msg = errorCode switch
                {
                    "invalid-link" => Umbraco.GetDictionaryValue("Account.ConfirmEmail.InvalidLink",
                        "El link de confirmación está incompleto. Verifica que el URL no se haya cortado al copiarlo."),
                    "invalid-token" => Umbraco.GetDictionaryValue("Account.ConfirmEmail.InvalidToken",
                        "El link de confirmación no es válido o ya expiró."),
                    _ => Umbraco.GetDictionaryValue("Account.ConfirmEmail.Error.Unknown",
                        "Ocurrió un error confirmando tu email. Inténtalo de nuevo."),
                };
            }
            @msg
        </p>
        <p class="syn-account__alt">
            <a href="/account/login">
                @Umbraco.GetDictionaryValue("Account.BackToLogin", "Volver al login")
            </a>
        </p>
    </main>
</body>
</html>
