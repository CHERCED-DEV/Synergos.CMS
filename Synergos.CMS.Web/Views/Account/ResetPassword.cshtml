@*
    AccountController.ResetPassword (Ola 80). Form que valida token +
    permite escribir nueva contraseña. El email + token vienen en el
    querystring desde el link del email.
*@
@{
    Layout = null;
    var email = ViewData["Email"] as string ?? string.Empty;
    var token = ViewData["Token"] as string ?? string.Empty;
    var errorCode = ViewData["ErrorCode"] as string;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@Umbraco.GetDictionaryValue("Account.ResetPassword.Title", "Nueva contraseña")</title>
</head>
<body class="syn-account">
    <main class="syn-account__main">
        <h1 class="syn-account__heading">@Umbraco.GetDictionaryValue("Account.ResetPassword.Title", "Nueva contraseña")</h1>

        @if (!string.IsNullOrWhiteSpace(errorCode))
        {
            var msg = errorCode switch
            {
                "invalid-token" => Umbraco.GetDictionaryValue("Account.ResetPassword.InvalidToken",
                    "El link de reset no es válido o ya expiró. Solicita uno nuevo."),
                "weak-password" => Umbraco.GetDictionaryValue("Account.ResetPassword.WeakPassword",
                    "La contraseña no cumple los requisitos mínimos."),
                "invalid-input" => Umbraco.GetDictionaryValue("Account.ResetPassword.InvalidInput",
                    "Email, token y nueva contraseña son obligatorios."),
                _ => Umbraco.GetDictionaryValue("Account.ResetPassword.Error.Unknown",
                    "Ocurrió un error. Inténtalo de nuevo."),
            };
            <p class="syn-account__error" role="alert" aria-live="polite">@msg</p>
        }

        <form class="syn-account__form" action="/account/reset-password" method="post" novalidate>
            <input type="hidden" name="email" value="@email" />
            <input type="hidden" name="token" value="@token" />

            <p class="syn-account__intro">
                @string.Format(
                    Umbraco.GetDictionaryValue("Account.ResetPassword.Intro",
                        "Restableciendo contraseña para <strong>{0}</strong>."),
                    email)
            </p>

            <div class="syn-account__field">
                <label for="syn-reset-password">@Umbraco.GetDictionaryValue("Account.ResetPassword.NewPasswordLabel", "Nueva contraseña")</label>
                <input id="syn-reset-password"
                       type="password"
                       name="newPassword"
                       autocomplete="new-password"
                       minlength="8"
                       required
                       aria-required="true" />
                <small>@Umbraco.GetDictionaryValue("Account.Register.PasswordHelp", "Mínimo 8 caracteres.")</small>
            </div>

            <button type="submit" class="syn-account__submit">
                @Umbraco.GetDictionaryValue("Account.ResetPassword.Submit", "Cambiar contraseña")
            </button>
        </form>

        <p class="syn-account__alt">
            <a href="/account/forgot-password">@Umbraco.GetDictionaryValue("Account.RequestNewLink", "Solicitar nuevo link")</a>
        </p>
    </main>
</body>
</html>
