@*
    AccountController.ResetPassword (Ola 80). Form que valida token +
    permite escribir nueva contraseña. El email + token vienen en el
    querystring desde el link del email. Frame "launcher / PS3".
    Campos hidden email/token + newPassword sin cambios.
*@
@{
    Layout = null;
    var email = ViewData["Email"] as string ?? string.Empty;
    var token = ViewData["Token"] as string ?? string.Empty;
    var errorCode = ViewData["ErrorCode"] as string;
    var title = Umbraco.GetDictionaryValueOrDefault("Account.ResetPassword.Title", "Nueva contraseña");
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="dark">
<head>
    @await Html.PartialAsync("_AccountHead")
    <title>@title</title>
</head>
<body class="syn-account syn-launcher">
    <main class="syn-launcher__main">
        @await Html.PartialAsync("_AccountHero", (object)title)

        <div class="syn-account__card">
            @if (!string.IsNullOrWhiteSpace(errorCode))
            {
                var msg = errorCode switch
                {
                    "invalid-token" => Umbraco.GetDictionaryValueOrDefault("Account.ResetPassword.InvalidToken",
                        "El link de reset no es válido o ya expiró. Solicita uno nuevo."),
                    "weak-password" => Umbraco.GetDictionaryValueOrDefault("Account.ResetPassword.WeakPassword",
                        "La contraseña no cumple los requisitos mínimos."),
                    "invalid-input" => Umbraco.GetDictionaryValueOrDefault("Account.ResetPassword.InvalidInput",
                        "Email, token y nueva contraseña son obligatorios."),
                    _ => Umbraco.GetDictionaryValueOrDefault("Account.ResetPassword.Error.Unknown",
                        "Ocurrió un error. Inténtalo de nuevo."),
                };
                <p class="syn-account__error" role="alert" aria-live="polite">@msg</p>
            }

            <form class="syn-account__form" action="/account/reset-password" method="post" novalidate>
                <input type="hidden" name="email" value="@email" />
                <input type="hidden" name="token" value="@token" />

                <p class="syn-account__intro">
                    @Synergos.CMS.Web.Services.Diccionario.FraseConDato.Resaltado(
                        Umbraco.GetDictionaryValueOrDefault("Account.ResetPassword.Intro",
                            "Restableciendo contraseña para {0}."),
                        email)
                </p>

                <div class="syn-account__field">
                    <label for="syn-reset-password">@Umbraco.GetDictionaryValueOrDefault("Account.ResetPassword.NewPasswordLabel", "Nueva contraseña")</label>
                    <input id="syn-reset-password"
                           type="password"
                           name="newPassword"
                           autocomplete="new-password"
                           minlength="8"
                           required
                           aria-required="true" />
                    <small>@Umbraco.GetDictionaryValueOrDefault("Account.Register.PasswordHelp", "Mínimo 8 caracteres.")</small>
                </div>

                <button type="submit" class="syn-account__submit">
                    @Umbraco.GetDictionaryValueOrDefault("Account.ResetPassword.Submit", "Cambiar contraseña")
                </button>
            </form>

            <p class="syn-account__alt">
                <a href="/account/forgot-password">@Umbraco.GetDictionaryValueOrDefault("Account.RequestNewLink", "Solicitar nuevo link")</a>
            </p>
        </div>
    </main>
    <script src="~/js/platform-root.js" asp-append-version="true" defer></script>
</body>
</html>
