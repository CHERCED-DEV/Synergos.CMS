@*
    Vista del AccountController.Register (Ola 64). Form POST nativo a
    /account/register. Sin Layout.
*@
@{
    Layout = null;
    var errorCode = ViewData["ErrorCode"] as string;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@Umbraco.GetDictionaryValue("Account.Register.Title", "Crear cuenta")</title>
</head>
<body class="syn-account">
    <main class="syn-account__main">
        <h1 class="syn-account__heading">@Umbraco.GetDictionaryValue("Account.Register.Title", "Crear cuenta")</h1>

        @if (!string.IsNullOrWhiteSpace(errorCode))
        {
            var msg = errorCode switch
            {
                "email-taken" => Umbraco.GetDictionaryValue("Account.Register.Error.EmailTaken", "Este email ya está registrado."),
                "weak-password" => Umbraco.GetDictionaryValue("Account.Register.Error.WeakPassword", "La contraseña no cumple los requisitos mínimos."),
                "invalid-input" => Umbraco.GetDictionaryValue("Account.Register.Error.InvalidInput", "Email, contraseña y nombre son obligatorios."),
                _ => Umbraco.GetDictionaryValue("Account.Register.Error.Unknown", "Ocurrió un error. Inténtalo de nuevo."),
            };
            <p class="syn-account__error" role="alert" aria-live="polite">@msg</p>
        }

        <form class="syn-account__form" action="/account/register" method="post" novalidate>
            <div class="syn-account__field">
                <label for="syn-reg-name">@Umbraco.GetDictionaryValue("Account.Register.NameLabel", "Nombre")</label>
                <input id="syn-reg-name"
                       type="text"
                       name="displayName"
                       autocomplete="name"
                       required
                       aria-required="true" />
            </div>

            <div class="syn-account__field">
                <label for="syn-reg-email">@Umbraco.GetDictionaryValue("Account.Register.EmailLabel", "Email")</label>
                <input id="syn-reg-email"
                       type="email"
                       name="email"
                       autocomplete="email"
                       required
                       aria-required="true" />
            </div>

            <div class="syn-account__field">
                <label for="syn-reg-password">@Umbraco.GetDictionaryValue("Account.Register.PasswordLabel", "Contraseña")</label>
                <input id="syn-reg-password"
                       type="password"
                       name="password"
                       autocomplete="new-password"
                       required
                       aria-required="true"
                       minlength="8" />
                <small>@Umbraco.GetDictionaryValue("Account.Register.PasswordHelp", "Mínimo 8 caracteres.")</small>
            </div>

            <button type="submit" class="syn-account__submit">
                @Umbraco.GetDictionaryValue("Account.Register.Submit", "Crear cuenta")
            </button>
        </form>

        <p class="syn-account__alt">
            <a href="/account/login">
                @Umbraco.GetDictionaryValue("Account.Register.HaveAccount", "¿Ya tienes cuenta? Iniciar sesión")
            </a>
        </p>
    </main>
</body>
</html>
