@*
    Partial reusable para los <head> de Account/* views (Layout=null).
    Inyecta el meta + el bundle de CSS necesario (tokens + base + account).
    Cada view también provee su propio <title> tras llamar a este partial.
*@
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<link rel="stylesheet" href="~/css/syn-tokens.css" />
<link rel="stylesheet" href="~/css/syn-base.css" />
<link rel="stylesheet" href="~/css/syn-account.css" />
