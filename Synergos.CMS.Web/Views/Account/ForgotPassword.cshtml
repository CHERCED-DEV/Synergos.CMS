@*
    AccountController.ForgotPassword (Ola 80). Form sencillo que pide
    email + envia link de reset si el email corresponde a un member.
    Anti-enumeration: respondemos "email enviado" aunque no exista.
    Frame "launcher / PS3" (ver Login). Campo `email` sin cambios.
*@
@{
    Layout = null;
    var messageCode = ViewData["MessageCode"] as string;
    var title = Umbraco.GetDictionaryValue("Account.ForgotPassword.Title", "Recuperar contraseña");
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="dark">
<head>
    @await Html.PartialAsync("_AccountHead")
    <title>@title</title>
</head>
<body class="syn-account syn-launcher">
    <main class="syn-launcher__main">
        @await Html.PartialAsync("_AccountHero", (object)title)

        <div class="syn-account__card">
            @if (string.Equals(messageCode, "sent", StringComparison.Ordinal))
            {
                <p class="syn-account__success" role="status" aria-live="polite">
                    @Umbraco.GetDictionaryValue("Account.ForgotPassword.Sent",
                        "Si el email está registrado, te enviamos un link para restablecer tu contraseña. Revisa tu bandeja de entrada (y la carpeta de spam).")
                </p>
                <p class="syn-account__alt"><a href="/account/login">@Umbraco.GetDictionaryValue("Account.BackToLogin", "Volver al login")</a></p>
            }
            else
            {
                @if (string.Equals(messageCode, "invalid-link", StringComparison.Ordinal))
                {
                    <p class="syn-account__error" role="alert" aria-live="polite">
                        @Umbraco.GetDictionaryValue("Account.ForgotPassword.InvalidLink",
                            "El enlace que abriste no es válido o ya fue usado. Solicita uno nuevo.")
                    </p>
                }

                <p class="syn-account__intro">
                    @Umbraco.GetDictionaryValue("Account.ForgotPassword.Intro",
                        "Ingresa tu email y te enviaremos un link para restablecer tu contraseña.")
                </p>

                <form class="syn-account__form" action="/account/forgot-password" method="post" novalidate>
                    <div class="syn-account__field">
                        <label for="syn-forgot-email">@Umbraco.GetDictionaryValue("Account.Login.EmailLabel", "Email")</label>
                        <input id="syn-forgot-email"
                               type="email"
                               name="email"
                               autocomplete="email"
                               required
                               aria-required="true" />
                    </div>

                    <button type="submit" class="syn-account__submit">
                        @Umbraco.GetDictionaryValue("Account.ForgotPassword.Submit", "Enviar link")
                    </button>
                </form>

                <p class="syn-account__alt">
                    <a href="/account/login">@Umbraco.GetDictionaryValue("Account.BackToLogin", "Volver al login")</a>
                </p>
            }
        </div>
    </main>
    <script src="~/js/platform-root.js" asp-append-version="true" defer></script>
</body>
</html>
