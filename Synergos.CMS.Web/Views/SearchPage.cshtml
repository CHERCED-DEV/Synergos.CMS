@*
    Template del Document Type `searchPage` (Ola 62).

    Renderiza el formulario GET con input ?q= y, cuando el query tiene
    valor, los hits resultantes vía ISearchQuery. Paginación via ?page=N
    (1-based en UI). Filter opcional ?docType=alias.

    Sin auto-submit JS — formulario nativo HTML, accesible sin JS.
*@
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject Synergos.CMS.Interfaces.ISearchQuery SearchQuery
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = "_Layout";
    var page = UmbracoContext.PublishedRequest?.PublishedContent;
    if (page is null) { return; }

    var query = HttpContextAccessor.HttpContext?.Request.Query;
    var q = query?["q"].ToString() ?? string.Empty;
    var docTypeFilter = query?["docType"].ToString();
    var pageRaw = query?["page"].ToString();
    var pageNumber = int.TryParse(pageRaw, out var pn) && pn > 0 ? pn : 1;

    var itemsPerPageRaw = page.Value<string>("itemsPerPage");
    var itemsPerPage = int.TryParse(itemsPerPageRaw, out var ipp) && ipp > 0 ? ipp : 20;
    var skip = (pageNumber - 1) * itemsPerPage;

    var heading = page.Value<string>("pageHeading")
        ?? Umbraco.GetDictionaryValue("Search.Heading", "Buscar");
    var intro = page.Value<string>("pageIntro");

    Synergos.CMS.Interfaces.SearchResponse? response = null;
    if (!string.IsNullOrWhiteSpace(q))
    {
        response = SearchQuery.Search(new Synergos.CMS.Interfaces.SearchRequest(
            Query: q,
            MaxItems: itemsPerPage,
            Skip: skip,
            DocTypeAliasFilter: string.IsNullOrWhiteSpace(docTypeFilter) ? null : docTypeFilter));
    }

    var totalPages = response is not null && response.TotalEstimated > 0
        ? (int)Math.Ceiling((double)response.TotalEstimated / itemsPerPage)
        : 0;
    var basePath = page.Url();

    string PaginationHref(int targetPage) =>
        $"{basePath}?q={Uri.EscapeDataString(q)}&page={targetPage}" +
        (string.IsNullOrWhiteSpace(docTypeFilter) ? "" : $"&docType={Uri.EscapeDataString(docTypeFilter)}");
}
<section class="syn-search">
    <header class="syn-search__header">
        <h1 class="syn-search__heading">@heading</h1>
        @if (!string.IsNullOrWhiteSpace(intro))
        {
            <p class="syn-search__intro">@intro</p>
        }
    </header>

    <form class="syn-search__form" action="@basePath" method="get" role="search">
        <label for="syn-search-input" class="syn-search__label">
            @Umbraco.GetDictionaryValue("Search.Label", "Buscar en el sitio")
        </label>
        <input id="syn-search-input"
               class="syn-search__input"
               type="search"
               name="q"
               value="@q"
               placeholder="@Umbraco.GetDictionaryValue("Search.Placeholder", "Buscar…")"
               autocomplete="off" />
        @if (!string.IsNullOrWhiteSpace(docTypeFilter))
        {
            <input type="hidden" name="docType" value="@docTypeFilter" />
        }
        <button type="submit" class="syn-search__submit">
            @Umbraco.GetDictionaryValue("Search.Button", "Buscar")
        </button>
    </form>

    @if (response is not null)
    {
        <div class="syn-search__meta" aria-live="polite">
            @if (response.TotalEstimated == 0)
            {
                <p class="syn-search__no-results">
                    @Umbraco.GetDictionaryValue("Search.NoResults", "Sin resultados para \"{query}\".")
                        .Replace("{query}", q)
                </p>
            }
            else
            {
                var resultCountTemplate = Umbraco.GetDictionaryValue("Search.ResultCount", "{n} resultados");
                <p class="syn-search__count">
                    @resultCountTemplate.Replace("{n}", response.TotalEstimated.ToString())
                    <span class="syn-search__elapsed">(@response.ElapsedMilliseconds ms)</span>
                </p>
            }
        </div>

        @if (response.Hits.Count > 0)
        {
            <ul class="syn-search__results">
                @foreach (var hit in response.Hits)
                {
                    <li class="syn-search__result" data-doc-type="@hit.DocTypeAlias">
                        <a class="syn-search__result-link" href="@hit.Url">
                            <h2 class="syn-search__result-title">@hit.Title</h2>
                            <span class="syn-search__result-type">@hit.DocTypeAlias</span>
                            @if (!string.IsNullOrWhiteSpace(hit.Excerpt))
                            {
                                <p class="syn-search__result-excerpt">@hit.Excerpt</p>
                            }
                        </a>
                    </li>
                }
            </ul>

            @if (totalPages > 1)
            {
                <nav class="syn-search__pagination" aria-label="@Umbraco.GetDictionaryValue("Search.Pagination", "Paginación de resultados")">
                    @if (pageNumber > 1)
                    {
                        <a class="syn-search__pagination-prev" rel="prev" href="@PaginationHref(pageNumber - 1)">
                            @Umbraco.GetDictionaryValue("Search.Previous", "Anteriores")
                        </a>
                    }
                    <span class="syn-search__pagination-current">@pageNumber / @totalPages</span>
                    @if (pageNumber < totalPages)
                    {
                        <a class="syn-search__pagination-next" rel="next" href="@PaginationHref(pageNumber + 1)">
                            @Umbraco.GetDictionaryValue("Search.Next", "Siguientes")
                        </a>
                    }
                </nav>
            }
        }
    }
</section>
