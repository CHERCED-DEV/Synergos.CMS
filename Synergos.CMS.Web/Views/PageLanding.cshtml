@*
    Template del Document Type `pageLanding` (Ola 49). Página de
    conversión: heading + summary + featuredImage opcionales encima
    del Layout Composer. Sin sectionsAfterBody (Landing es lineal:
    abre fuerte y cierra con CTA directo).

    El chrome lo aplica _Layout vía IPageRenderContextResolver. Los
    landings típicamente sobreescriben chromeMode=minimal y
    showBreadcrumbs=false.
*@
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject Synergos.CMS.Interfaces.IPageRenderContextResolver PageRenderContextResolver
@using Umbraco.Cms.Core.Models.Blocks
@{
    Layout = "_Layout";
    var currentContent = UmbracoContext.PublishedRequest?.PublishedContent;
    var sections = currentContent?.Value<BlockGridModel>("sections");
    var renderCtx = PageRenderContextResolver.Resolve();
    var showIntroBlock = renderCtx.ShowTitle || renderCtx.ShowIntro;
}
<article class="syn-page syn-page-landing">
    @if (showIntroBlock && currentContent != null)
    {
        @await Html.PartialAsync("_PageIntro", currentContent)
    }
    @if (sections != null && sections.Any())
    {
        <div class="syn-page__body">
            @await Html.GetBlockGridHtmlAsync(sections)
        </div>
    }
</article>
