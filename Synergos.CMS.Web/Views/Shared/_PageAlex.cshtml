@*
    Cintilla superior contextual (Alex) — Ola 49. Render condicional ya
    aplicado por _Layout vía IPageRenderContextResolver.ShowAlex; este
    partial solo proyecta los campos editoriales y aplica las reglas de
    visibilidad temporal (scheduled). Las reglas de auth se diferirán a
    una ola siguiente cuando entren los miembros.
*@
@model Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent
@using Umbraco.Extensions
@{
    if (Model is null) { return; }
    var alexText = Model.Value<string>("alexText");
    if (string.IsNullOrWhiteSpace(alexText)) { return; }

    var visibilityMode = Model.Value<string>("alexVisibilityMode");
    if (string.Equals(visibilityMode, "scheduled", StringComparison.OrdinalIgnoreCase))
    {
        var nowUtc = DateTime.UtcNow;
        var start = Model.Value<DateTime?>("alexScheduleStart");
        var end = Model.Value<DateTime?>("alexScheduleEnd");
        if (start.HasValue && nowUtc < start.Value.ToUniversalTime()) { return; }
        if (end.HasValue && nowUtc > end.Value.ToUniversalTime()) { return; }
    }

    var variant = Model.Value<string>("alexVariant");
    if (string.IsNullOrWhiteSpace(variant)) { variant = "neutral"; }
    var tone = Model.Value<string>("alexTone");
    if (string.IsNullOrWhiteSpace(tone)) { tone = "soft"; }

    var ctaLabel = Model.Value<string>("alexCtaLabel");
    var ctaLink = Model.Value<Umbraco.Cms.Core.Models.Link>("alexCtaLink");
    var icon = Model.Value<string>("alexIcon");
    var dismissible = Model.Value<bool>("alexDismissible");
}
<aside class="syn-alex syn-alex--@variant syn-alex--@tone@(dismissible ? " syn-alex--dismissible" : "")"
       role="region"
       aria-label="@Umbraco.GetDictionaryValue("alex.aria.label", "Site notice")">
    <div class="syn-alex__inner">
        @if (!string.IsNullOrWhiteSpace(icon))
        {
            <span class="syn-alex__icon" data-icon="@icon" aria-hidden="true"></span>
        }
        <span class="syn-alex__text">@alexText</span>
        @if (!string.IsNullOrWhiteSpace(ctaLabel) && ctaLink is not null && !string.IsNullOrWhiteSpace(ctaLink.Url))
        {
            <a class="syn-alex__cta"
               href="@ctaLink.Url"
               @(ctaLink.Target == "_blank" ? Html.Raw("target=\"_blank\" rel=\"noopener\"") : null)>@ctaLabel</a>
        }
        @if (dismissible)
        {
            <button type="button"
                    class="syn-alex__close"
                    aria-label="@Umbraco.GetDictionaryValue("alex.aria.dismiss", "Dismiss")">&times;</button>
        }
    </div>
</aside>
