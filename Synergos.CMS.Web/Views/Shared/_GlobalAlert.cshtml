@*
    Renderer de la cintilla superior global del sitio (Ola 50).
    Consume un CfgAlert ya resuelto por IGlobalComponentResolver — el
    partial NO toma decisiones de visibilidad, solo proyecta el snapshot.
    Las decisiones (activo, schedule, suppress por página) viven en el
    resolver para mantener una sola fuente de verdad.
*@
@* `@inherits`, NO `@model` (ADR 0059): con `@model` la vista no hereda de UmbracoViewPage y
   `Umbraco.GetDictionaryValueOrDefault` es CS0234 en caliente — el día que un editor
   activara un aviso, toda página que lo pintara contestaba 500 (#184). *@
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Synergos.CMS.Interfaces.CfgAlert>
@{
    if (Model is null) { return; }
    var variant = string.IsNullOrWhiteSpace(Model.Variant) ? "neutral" : Model.Variant;
    var tone = string.IsNullOrWhiteSpace(Model.Tone) ? "soft" : Model.Tone;
    var hasCta = !string.IsNullOrWhiteSpace(Model.CtaLabel) && !string.IsNullOrWhiteSpace(Model.CtaUrl);
}
<aside class="syn-global-alert syn-global-alert--@variant syn-global-alert--@tone@(Model.Dismissible ? " syn-global-alert--dismissible" : "")"
       role="region"
       aria-label="@Umbraco.GetDictionaryValueOrDefault("alert.aria.label", "Aviso del sitio")">
    <div class="syn-global-alert__inner">
        @if (!string.IsNullOrWhiteSpace(Model.Icon))
        {
            <span class="syn-global-alert__icon" data-icon="@Model.Icon" aria-hidden="true"></span>
        }
        <span class="syn-global-alert__message">@Model.Message</span>
        @if (hasCta)
        {
            <a class="syn-global-alert__cta"
               href="@Model.CtaUrl"
               @(Model.CtaOpenInNewTab ? Html.Raw("target=\"_blank\" rel=\"noopener\"") : null)>@Model.CtaLabel</a>
        }
        @if (Model.Dismissible)
        {
            <button type="button"
                    class="syn-global-alert__close"
                    aria-label="@Umbraco.GetDictionaryValueOrDefault("alert.aria.dismiss", "Cerrar aviso")">&times;</button>
        }
    </div>
</aside>
