@*
    Heading + subheading + summary + featuredImage del perfil Standard /
    Landing. _Layout/page templates deciden vía PageRenderContext si
    invocan este partial. Si la página no tiene los campos
    correspondientes (Canvas, Bare) los Value<> devuelven null y el
    partial degrada a no-op.
*@
@model Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models
@{
    if (Model is null) { return; }
    var heading = Model.Value<string>("heading");
    if (string.IsNullOrWhiteSpace(heading)) { heading = Model.Name; }
    var subheading = Model.Value<string>("subheading");
    var summary = Model.Value<string>("summary");
    var featured = Model.Value<MediaWithCrops>("featuredImage");
    var showSubheading = !string.IsNullOrWhiteSpace(subheading);
    var showSummary = !string.IsNullOrWhiteSpace(summary);
    var showFeatured = featured is not null;
}
<header class="syn-page-intro">
    @if (showSubheading)
    {
        <p class="syn-page-intro__kicker">@subheading</p>
    }
    <h1 class="syn-page-intro__title">@heading</h1>
    @if (showSummary)
    {
        <p class="syn-page-intro__summary">@summary</p>
    }
    @if (showFeatured)
    {
        <figure class="syn-page-intro__media">
            <img src="@featured.Url()" alt="@(featured.Value<string>("altText") ?? heading)" loading="lazy" />
        </figure>
    }
</header>
