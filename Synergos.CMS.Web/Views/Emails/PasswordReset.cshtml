@*
    Email template — password reset.
    Modelo: Synergos.CMS.Web.Services.PasswordResetEmailModel
*@
@model Synergos.CMS.Web.Services.PasswordResetEmailModel
@{
    Layout = "_Layout";
    ViewBag.Title = "Restablece tu contraseña";
    ViewBag.SiteName = Model.SiteName;
    ViewBag.PreheaderText = "Solicitaste restablecer tu contraseña. Hazlo en menos de 1 hora.";
}
<h2 style="font-size:20px;color:#111;margin:0 0 16px;">
    Hola @Model.DisplayName,
</h2>
<p style="font-size:14px;line-height:1.6;color:#333;margin:0 0 16px;">
    Recibimos una solicitud para restablecer tu contraseña. Para continuar, haz clic en el siguiente botón:
</p>
<p style="margin:24px 0;text-align:center;">
    <a href="@Model.ResetUrl"
       style="display:inline-block;padding:12px 24px;background:#111;color:#ffffff;text-decoration:none;border-radius:6px;font-size:14px;font-weight:600;">
        Restablecer contraseña
    </a>
</p>
<p style="font-size:13px;line-height:1.6;color:#666;margin:0 0 8px;">
    Si el botón no funciona, copia y pega este link en tu navegador:
</p>
<p style="font-size:12px;line-height:1.4;color:#888;margin:0 0 24px;word-break:break-all;">
    @Model.ResetUrl
</p>
<p style="font-size:13px;line-height:1.6;color:#666;margin:0;">
    Si tú no solicitaste esto, puedes ignorar este email — tu contraseña no cambiará. El enlace expira en 1 hora.
</p>
