@*
    Email template — comment pending moderation notification (Ola 89).
    Modelo: Synergos.CMS.Web.Services.CommentPendingModerationEmailModel
*@
@model Synergos.CMS.Web.Services.CommentPendingModerationEmailModel
@{
    Layout = "_Layout";
    ViewBag.Title = "Comentario pendiente de moderación";
    ViewBag.SiteName = Model.SiteName;
    ViewBag.PreheaderText = $"Comentario nuevo de {Model.AuthorName} esperando aprobación.";
}
<h2 style="font-size:20px;color:#0f172a;margin:0 0 16px;">
    Comentario pendiente
</h2>
<p style="font-size:14px;line-height:1.5;color:#475569;margin:0 0 16px;">
    Un visitante envió un comentario que requiere aprobación antes de ser publicado.
</p>

<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background:#f8fafc;border-radius:6px;margin:0 0 24px;">
    <tr>
        <td style="padding:16px;font-size:13px;color:#475569;">
            <div><strong>Autor:</strong> @Model.AuthorName</div>
            <div><strong>Nodo:</strong> #@Model.NodeId</div>
            <div><strong>Recibido:</strong> @Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</div>
            <div><strong>ID:</strong> <code>@Model.CommentId</code></div>
        </td>
    </tr>
</table>

<div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:6px;padding:16px;margin:0 0 24px;">
    <p style="margin:0 0 8px;font-size:12px;font-weight:600;color:#475569;text-transform:uppercase;letter-spacing:0.5px;">Cuerpo del comentario</p>
    <p style="margin:0;font-size:14px;color:#0f172a;line-height:1.5;white-space:pre-wrap;">@Model.Body</p>
</div>

<table role="presentation" cellspacing="0" cellpadding="0" border="0">
    <tr>
        <td style="background:#4f6ef7;border-radius:4px;padding:16px 24px;">
            <a href="@Model.ModerationQueueUrl" style="color:#ffffff;text-decoration:none;font-size:14px;font-weight:600;">
                Abrir cola de moderación
            </a>
        </td>
    </tr>
</table>
