@*
    Email template — registration confirmation (Ola 83).
    Modelo: Synergos.CMS.Web.Services.EmailConfirmationEmailModel
*@
@model Synergos.CMS.Web.Services.EmailConfirmationEmailModel
@{
    Layout = "~/Views/Emails/_Layout.cshtml";   // ruta EXPLÍCITA: "_Layout" resolvía al layout del SITIO
    ViewBag.Title = "Confirma tu email";
    ViewBag.SiteName = Model.SiteName;
    ViewBag.PreheaderText = "Activa tu cuenta haciendo click en el siguiente enlace.";
}
<h2 style="font-size:20px;color:#0f172a;margin:0 0 16px;">
    ¡Bienvenido @Model.DisplayName!
</h2>
<p style="font-size:14px;line-height:1.6;color:#475569;margin:0 0 16px;">
    Gracias por registrarte. Para activar tu cuenta y poder iniciar sesión, confirma tu email haciendo clic en el siguiente botón:
</p>
<p style="margin:24px 0;text-align:center;">
    <a href="@Model.ConfirmUrl"
       style="display:inline-block;padding:16px 24px;background:#22c55e;color:#ffffff;text-decoration:none;border-radius:6px;font-size:14px;font-weight:600;">
        Confirmar email
    </a>
</p>
<p style="font-size:13px;line-height:1.6;color:#475569;margin:0 0 8px;">
    Si el botón no funciona, copia y pega este link en tu navegador:
</p>
<p style="font-size:12px;line-height:1.4;color:#475569;margin:0 0 24px;word-break:break-all;">
    @Model.ConfirmUrl
</p>
<p style="font-size:13px;line-height:1.6;color:#475569;margin:0;">
    Si tú no creaste esta cuenta, puedes ignorar este email.
</p>
