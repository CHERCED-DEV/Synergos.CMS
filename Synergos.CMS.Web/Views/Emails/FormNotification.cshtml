@*
    Email template — form submission notification.
    Modelo: Synergos.CMS.Web.Services.FormNotificationEmailModel
*@
@model Synergos.CMS.Web.Services.FormNotificationEmailModel
@{
    Layout = "_Layout";
    ViewBag.Title = $"Nueva submission: {Model.FormKey}";
    ViewBag.SiteName = Model.SiteName;
    ViewBag.PreheaderText = $"Recibiste una nueva submission del formulario {Model.FormKey}.";
}
<h2 style="font-size:20px;color:#111;margin:0 0 16px;">
    Nueva submission del formulario <code>@Model.FormKey</code>
</h2>
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background:#f7f7fa;border-radius:6px;margin:0 0 24px;">
    <tr>
        <td style="padding:12px 16px;font-size:13px;color:#444;">
            <div><strong>Recibido:</strong> @Model.ReceivedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</div>
            <div><strong>Origen:</strong> @Model.Referrer</div>
            <div><strong>IP:</strong> @Model.ClientIp</div>
        </td>
    </tr>
</table>

<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="border-collapse:collapse;">
    <thead>
        <tr>
            <th colspan="2" style="padding:8px 12px;text-align:left;font-size:12px;font-weight:600;color:#888;text-transform:uppercase;letter-spacing:0.5px;border-bottom:2px solid #eaeaea;">
                Campos
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var (key, value) in Model.Fields)
        {
            <tr>
                <th style="padding:10px 12px;text-align:left;font-size:13px;font-weight:600;color:#111;border-bottom:1px solid #eaeaea;width:30%;vertical-align:top;">
                    @key
                </th>
                <td style="padding:10px 12px;font-size:13px;color:#333;border-bottom:1px solid #eaeaea;white-space:pre-wrap;">
                    @value
                </td>
            </tr>
        }
    </tbody>
</table>
