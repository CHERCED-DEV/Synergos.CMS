@*
    Template del Document Type `pageBare`. Sin chrome compartido —
    landings custom. El contenido editorial se compone via Layout
    Composer (sections — Ola 48). Sin shell html, _Layout=null.
*@
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Synergos.CMS.Application.Dto.Responses.PageBareResponse>
@using Umbraco.Cms.Core.Models.Blocks
@{
    Layout = null;
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var currentContent = UmbracoContext.PublishedRequest?.PublishedContent;
    var sections = currentContent?.Value<BlockGridModel>("sections");
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.SeoTitle</title>
</head>
<body>
@if (sections != null && sections.Any())
{
    @await Html.GetBlockGridHtmlAsync(sections)
}
</body>
</html>
