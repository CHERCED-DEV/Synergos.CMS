@*
    Template del Document Type `pageBare` (Ola 8 + Layout Composer
    Ola 42.7). Sin chrome compartido — el body del modelo se emite
    como la totalidad del contenido. Útil para landings custom.

    Precedencia:
      - Si sections (BlockGrid Layout Composer) tiene bloques,
        ellos son la página.
      - Si no, el body richtext (TinyMCE) es la página (fallback).
*@
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Synergos.CMS.Application.Dto.Responses.PageBareResponse>
@using Umbraco.Cms.Core.Models.Blocks
@{
    Layout = null;
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var currentContent = UmbracoContext.PublishedRequest?.PublishedContent;
    var sections = currentContent?.Value<BlockGridModel>("sections");
    var hasSections = sections != null && sections.Any();
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.SeoTitle</title>
</head>
<body>
@if (hasSections)
{
    @await Html.GetBlockGridHtmlAsync(sections)
}
else
{
    @Html.Raw(Model.BodyHtml)
}
</body>
</html>
