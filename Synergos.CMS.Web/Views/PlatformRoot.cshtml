@*
    Template del Document Type `platformRoot` — shell genérico del entry point.

    El launcher (PS3) ya NO está hardcodeado: el contenido (cards de dominio)
    se compone en el Layout Composer (introBody) y se estila con clases custom
    (.syn-launcher*) vía el tab Estilo de cada bloque — creado + publicado por
    IContentService (ver DevContentFiller.SeedPlatformLauncher).

    Aquí solo vive el frame del design system: el tema oscuro, el hero (lee los
    campos editables Name + welcomeMessage) y el render de introBody. El chrome
    animado (onda, partículas, ribbon, reloj, flash) lo INYECTA platform-root.js
    sobre cualquier elemento .syn-launcher.

    Layout=null por diseño (el platform root no es un sitio, no tiene chrome del
    siteRoot).
*@
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Synergos.CMS.Web.PublishedModels.PlatformRoot>
@using Umbraco.Extensions
@{
    Layout = null;
    if (Model is null) { return; }

    var welcomeMessage = !string.IsNullOrWhiteSpace(Model.WelcomeMessage)
        ? Model.WelcomeMessage
        : Umbraco.GetDictionaryValue("Platform.WelcomeFallback",
            "Un solo motor, un solo schema — múltiples productos sobre el mismo core.");

    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
<!DOCTYPE html>
<html lang="@culture" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow" />
    <title>@Model.Name</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/syn-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/syn-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/syn-utilities.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/syn-primitives.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/syn-pages.css" asp-append-version="true" />
</head>
<body class="syn-launcher">
    <div class="syn-launcher__main">
        <header class="syn-launcher__hero">
            <span class="syn-launcher__eyebrow">Plataforma Synergos</span>
            <h1 class="syn-launcher__title">@Model.Name</h1>
            <p class="syn-launcher__intro">@welcomeMessage</p>
        </header>

        @if (Model.IntroBody is { Count: > 0 })
        {
            @await Html.GetBlockGridHtmlAsync(Model.IntroBody!)
        }
    </div>
    <script src="~/js/platform-root.js" asp-append-version="true" defer></script>
</body>
</html>
