            "type": "number",
            "format": "decimal"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "PriceResponse": {
        "required": [
          "id",
          "subjectKind",
          "subjectId",
          "amount",
          "taxRateBasisPoints",
          "updatedAtUtc"
