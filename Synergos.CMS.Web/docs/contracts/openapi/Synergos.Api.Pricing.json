          "subtotal": {
            "$ref": "#/components/schemas/MoneyDto"
          },
          "discount": {
            "$ref": "#/components/schemas/MoneyDto"
          },
          "tax": {
            "$ref": "#/components/schemas/MoneyDto"
          },
          "total": {
            "$ref": "#/components/schemas/MoneyDto"
          }
        }
      },
      "Rechazo": {
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "transient"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "enum": [
              "Invalid",
              "NotFound",
              "Conflict",
              "Forbidden",
              "Expired",
              "Unavailable"
            ],
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "transient": {
            "type": "boolean"
          }
