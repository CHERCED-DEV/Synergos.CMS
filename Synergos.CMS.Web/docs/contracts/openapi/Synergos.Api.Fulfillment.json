  "components": {
    "schemas": {
      "AddressDto": {
        "type": "object",
        "properties": {
          "line1": {
            "type": [
              "null",
              "string"
            ]
          },
          "line2": {
            "type": [
              "null",
              "string"
            ]
          },
          "city": {
            "type": [
              "null",
              "string"
            ]
          },
          "region": {
            "type": [
              "null",
              "string"
            ]
          },
          "postalCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "country": {
            "type": [
              "null",
              "string"
            ]
          },
          "contact": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateShipmentRequest": {
        "type": "object",
        "properties": {
          "forKind": {
            "type": [
              "null",
              "string"
            ]
          },
          "forId": {
            "type": [
              "null",
              "string"
            ]
          },
          "to": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AddressDto"
              }
            ]
          },
          "carrier": {
            "type": [
              "null",
              "string"
            ]
          },
          "trackingCode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PageResponseOfShipmentResponse": {
        "required": [
          "items",
          "total",
          "offset",
          "hasMore"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShipmentResponse"
            }
          },
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "offset": {
            "type": "integer",
            "format": "int32"
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "Rechazo": {
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "transient"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "enum": [
              "Invalid",
              "NotFound",
              "Conflict",
              "Forbidden",
              "Expired",
              "Unavailable"
            ],
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "transient": {
            "type": "boolean"
          }
        }
      },
      "ShipmentResponse": {
        "required": [
          "id",
          "forKind",
          "forId",
          "to",
          "carrier",
          "trackingCode",
          "status",
          "events",
          "createdAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "forKind": {
            "type": "string"
          },
          "forId": {
            "type": "string"
          },
          "to": {
            "$ref": "#/components/schemas/AddressDto"
          },
          "carrier": {
            "type": "string"
          },
          "trackingCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrackingEventResponse"
            }
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TrackingEventResponse": {
        "required": [
          "status",
          "note",
          "atUtc"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          },
          "atUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TrackRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "llaveCompartida": {
        "type": "apiKey",
        "name": "X-Synergos-Key",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "llaveCompartida": [ ]
    }
