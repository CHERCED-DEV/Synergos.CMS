  "components": {
    "schemas": {
      "MoneyDto": {
        "required": [
          "amount",
          "currency"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "OrderLineRequest": {
        "type": "object",
        "properties": {
          "subjectKind": {
            "type": [
              "null",
              "string"
            ]
          },
          "subjectId": {
            "type": [
              "null",
              "string"
            ]
          },
          "quantity": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "unitPrice": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MoneyDto"
              }
            ]
          }
        }
      },
      "OrderLineResponse": {
        "required": [
          "subjectKind",
          "subjectId",
          "quantity",
          "unitPrice",
          "subtotal"
        ],
        "type": "object",
        "properties": {
          "subjectKind": {
            "type": "string"
          },
          "subjectId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "unitPrice": {
            "$ref": "#/components/schemas/MoneyDto"
          },
          "subtotal": {
            "$ref": "#/components/schemas/MoneyDto"
          }
        }
      },
      "OrderResponse": {
        "required": [
          "id",
          "buyerKind",
          "buyerId",
          "lines",
          "total",
          "status",
          "placedAtUtc",
          "closedAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "buyerKind": {
            "type": "string"
          },
          "buyerId": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLineResponse"
            }
          },
          "total": {
            "$ref": "#/components/schemas/MoneyDto"
          },
          "status": {
            "type": "string"
          },
          "placedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "closedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "PageResponseOfOrderResponse": {
        "required": [
          "items",
          "total",
          "offset",
          "hasMore"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderResponse"
            }
          },
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "offset": {
            "type": "integer",
            "format": "int32"
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "PlaceOrderRequest": {
        "type": "object",
        "properties": {
          "buyerKind": {
            "type": [
              "null",
              "string"
            ]
          },
          "buyerId": {
            "type": [
              "null",
              "string"
            ]
          },
          "lines": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/OrderLineRequest"
            }
          },
          "total": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MoneyDto"
              }
            ]
          }
        }
      },
      "Rechazo": {
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "transient"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "enum": [
              "Invalid",
              "NotFound",
              "Conflict",
              "Forbidden",
              "Expired",
              "Unavailable"
            ],
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "transient": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "llaveCompartida": {
        "type": "apiKey",
        "name": "X-Synergos-Key",
        "in": "header"
      }
    }
  },
  "security": [
    {
