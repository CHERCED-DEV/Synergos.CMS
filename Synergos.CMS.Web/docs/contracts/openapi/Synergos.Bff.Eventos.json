  "components": {
    "schemas": {
      "BuyTicketsRequest": {
        "required": [
          "eventId",
          "buyerKind",
          "buyerId",
          "lines"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "null",
              "string"
            ]
          },
          "buyerKind": {
            "type": [
              "null",
              "string"
            ]
          },
          "buyerId": {
            "type": [
              "null",
              "string"
            ]
          },
          "lines": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/TicketLineRequest"
            }
          },
          "serviceFeePercent": {
            "type": [
              "null",
              "number"
            ],
            "format": "decimal"
          }
        }
      },
      "HeldSeatResponse": {
        "required": [
          "tier",
          "seat",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "tier": {
            "type": "string"
          },
          "seat": {
            "type": [
              "null",
              "string"
            ]
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "MoneyDto": {
        "required": [
          "amount",
          "currency"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "Rechazo": {
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "transient"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "enum": [
              "Invalid",
              "NotFound",
              "Conflict",
              "Forbidden",
              "Expired",
              "Unavailable"
            ],
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "transient": {
            "type": "boolean"
          }
        }
      },
      "TicketLineRequest": {
        "required": [
          "tier",
          "seat",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "tier": {
            "type": [
              "null",
              "string"
            ]
          },
          "seat": {
            "type": [
              "null",
              "string"
            ]
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "TicketPurchaseResponse": {
        "required": [
          "id",
          "buyerKind",
          "buyerId",
          "eventId",
          "status",
          "total",
          "held",
          "pendingCompensations",
          "lastError"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "buyerKind": {
            "type": "string"
          },
          "buyerId": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "total": {
            "$ref": "#/components/schemas/MoneyDto"
          },
          "held": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HeldSeatResponse"
            }
          },
          "pendingCompensations": {
            "type": "integer",
            "format": "int32"
          },
          "lastError": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "llaveCompartida": {
        "type": "apiKey",
