@using Umbraco.Extensions
@model Synergos.CMS.Application.Output.AuthorPageView
@inject Synergos.CMS.Domain.Services.IThemeService ThemeService
@inject Synergos.CMS.Domain.Services.IDictionaryCache Dict
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.Name;

    var pageCfg = ThemeService.GetPageLayoutConfig(Model.Content);
    if (!string.IsNullOrWhiteSpace(pageCfg.MainWrapperStyle))
        ViewData[LayoutViewData.MainWrapperStyle] = pageCfg.MainWrapperStyle;

    var seoTitle = Model.Seo.Title ?? Model.Profile.Name;
    ViewData[LayoutViewData.BodyId]    = Model.PageCssId;
    ViewData[LayoutViewData.BodyClass] = string.IsNullOrWhiteSpace(Model.PageCssClass)
        ? "sg-page sg-page--author"
        : $"sg-page sg-page--author {Model.PageCssClass}";

    var postsLabel  = Dict.Get("Blog.AuthorPosts",     culture, "Posts by this author");
    var noPosts     = Dict.Get("Blog.NoAuthorPosts",   culture, "This author hasn't published yet.");
    var emailLabel  = Dict.Get("Blog.AuthorEmail",     culture, "Email");
    var liLabel     = Dict.Get("Blog.AuthorLinkedIn",  culture, "LinkedIn");
    var twLabel     = Dict.Get("Blog.AuthorTwitter",   culture, "Twitter");
    var socialAria  = Dict.Get("Blog.AuthorSocial",    culture, "Author social profiles");
}

@section HeadMeta {
    @await Html.PartialAsync("SeoMeta", Model.Seo, new ViewDataDictionary(ViewData) { { LayoutViewData.SeoTitle, seoTitle } })
    <meta property="og:type" content="profile" />
    <meta property="profile:first_name" content="@Model.Profile.Name" />
    @if (Model.Posts.Count > 0)
    {
        @await Html.PartialAsync("Shared/Partials/PreloadHints", (IReadOnlyList<string>)new[] { "card" })
    }
}

<article class="sg-author">
    <header class="sg-author__header" itemscope itemtype="https://schema.org/Person">
        @if (!string.IsNullOrEmpty(Model.Profile.PhotoUrl))
        {
            <img class="sg-author__photo"
                 src="@Model.Profile.PhotoUrl"
                 alt="@Model.Profile.Name"
                 itemprop="image"
                 loading="eager" />
        }
        <div class="sg-author__identity">
            <h1 class="sg-author__name" itemprop="name">@Model.Profile.Name</h1>
            @if (!string.IsNullOrEmpty(Model.Profile.Role))
            {
                <p class="sg-author__role" itemprop="jobTitle">@Model.Profile.Role</p>
            }
            @if (!string.IsNullOrEmpty(Model.Profile.Bio))
            {
                <p class="sg-author__bio" itemprop="description">@Model.Profile.Bio</p>
            }

            <nav class="sg-author__social" aria-label="@socialAria">
                @if (!string.IsNullOrEmpty(Model.Profile.LinkedInUrl))
                {
                    <a href="@Model.Profile.LinkedInUrl" target="_blank" rel="noopener noreferrer me"
                       aria-label="@liLabel — @Model.Profile.Name">@liLabel</a>
                }
                @if (!string.IsNullOrEmpty(Model.Profile.TwitterUrl))
                {
                    <a href="@Model.Profile.TwitterUrl" target="_blank" rel="noopener noreferrer me"
                       aria-label="@twLabel — @Model.Profile.Name">@twLabel</a>
                }
                @if (!string.IsNullOrEmpty(Model.Profile.Email))
                {
                    <a href="mailto:@Model.Profile.Email" aria-label="@emailLabel — @Model.Profile.Name">@emailLabel</a>
                }
            </nav>
        </div>
    </header>

    <section class="sg-author__feed" aria-label="@postsLabel">
        <h2 class="sg-author__section-heading">@postsLabel</h2>
        @if (Model.Posts.Count == 0)
        {
            <p class="sg-author__empty">@noPosts</p>
        }
        else
        {
            <div class="sg-author__posts-grid">
                @foreach (var post in Model.Posts)
                {
                    @await Html.PartialAsync("Blog/PostCard", post)
                }
            </div>
        }
    </section>
</article>
