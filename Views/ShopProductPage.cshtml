@using System.Text.Json
@using System.Text.Json.Serialization
@using Synergos.CMS.Application.Cdn.Configs
@inject Synergos.CMS.Application.Rendering.IElementUrlResolver ElementUrl
@inject Synergos.CMS.Domain.Services.IDictionaryCache Dict
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var productSku            = Model.Value<string>("productSku") ?? string.Empty;
    var showVariantPicker     = Model.Value<bool?>("showVariantPicker");
    var showQuantitySelector  = Model.Value<bool?>("showQuantitySelector");
    var showRating            = Model.Value<bool?>("showRating");
    var layout                = Model.Value<string>("layout");
    var relatedSections       = Model.Value<Umbraco.Cms.Core.Models.Blocks.BlockGridModel>("relatedSections");

    var opt = new JsonSerializerOptions { DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull, PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var translations = Dict.GetAll();

    var detailCfg = JsonSerializer.Serialize(new ProductDetailCdnConfig(
        ProductSku:           productSku,
        ShowVariantPicker:    showVariantPicker,
        ShowQuantitySelector: showQuantitySelector,
        ShowRating:           showRating,
        Layout:               layout,
        Translations:         translations
    ), opt);

    var shopRoot = Model.AncestorsOrSelf().FirstOrDefault(x => x.ContentType.Alias == "shopRoot");
    var cartCfg  = JsonSerializer.Serialize(new CartSummaryCdnConfig(
        CheckoutUrl:  shopRoot?.Value<string>("checkoutUrl"),
        Translations: translations
    ), opt);
}
<div class="sg-shop-product">
    <script src="@ElementUrl.ResolveBundle("product-detail")" type="module" defer></script>
    <synergos-product-detail config='@detailCfg' class="sg-cdn sg-cdn--product-detail"></synergos-product-detail>

    @if (relatedSections is not null && relatedSections.Count > 0)
    {
        <div class="sg-shop-product__related">
            @await Html.GetBlockGridHtmlAsync(relatedSections)
        </div>
    }

    <script src="@ElementUrl.ResolveBundle("cart-summary")" type="module" defer></script>
    <synergos-cart-summary config='@cartCfg' class="sg-cdn sg-cdn--cart-summary"></synergos-cart-summary>
</div>
