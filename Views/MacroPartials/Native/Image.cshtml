@inherits Umbraco.Cms.Web.Common.Macros.PartialViewMacroPage
@{
    var src     = Model.MacroParameters.ContainsKey("mediaSrc") ? Model.MacroParameters["mediaSrc"]?.ToString() : "";
    var altText = Model.MacroParameters.ContainsKey("altText")  ? Model.MacroParameters["altText"]?.ToString()  : "";
    var caption = Model.MacroParameters.ContainsKey("caption")  ? Model.MacroParameters["caption"]?.ToString()  : null;
    var width   = Model.MacroParameters.ContainsKey("width")    ? Model.MacroParameters["width"]?.ToString()    : null;
}

<div class="sg-macro sg-macro--image">
    <figure class="sg-image">
        @if (!string.IsNullOrEmpty(src))
        {
            <img class="sg-image__media"
                 src="@src"
                 alt="@altText"
                 loading="lazy"
                 @(width is not null ? $"width=\"{width}\"" : "") />
        }
        @if (caption is not null)
        {
            <figcaption class="sg-image__caption">@caption</figcaption>
        }
    </figure>
</div>
