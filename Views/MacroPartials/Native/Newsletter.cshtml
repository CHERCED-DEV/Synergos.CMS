@inherits Umbraco.Cms.Web.Common.Macros.PartialViewMacroPage
@inject Synergos.CMS.Domain.Services.IDictionaryCache Dict
@{
    var culture     = System.Globalization.CultureInfo.CurrentUICulture.Name;

    // Editor-provided values override the dictionary defaults.
    var title       = Model.MacroParameters.ContainsKey("title")
                       ? Model.MacroParameters["title"]?.ToString()
                       : Dict.Get("Footer.NewsletterTitle", culture, "Suscríbete");
    var buttonLabel = Model.MacroParameters.ContainsKey("buttonLabel")
                       ? Model.MacroParameters["buttonLabel"]?.ToString()
                       : Dict.Get("Form.Actions.Send", culture, "Enviar");
    var apiEndpoint = Model.MacroParameters.ContainsKey("apiEndpoint")
                       ? Model.MacroParameters["apiEndpoint"]?.ToString() : "";

    var emailPlaceholder = Dict.Get("Form.Placeholders.Email", culture, "tu@email.com");
    var emailAria        = Dict.Get("Blog.AuthorEmail",        culture, "Email");
}

<div class="sg-macro sg-macro--newsletter">
    <div class="sg-newsletter">
        <h4 class="sg-newsletter__title">@title</h4>
        <form class="sg-newsletter__form"
              action="@apiEndpoint"
              method="post"
              data-sg-behavior="newsletter">
            <input class="sg-newsletter__input"
                   type="email"
                   name="email"
                   placeholder="@emailPlaceholder"
                   required
                   aria-label="@emailAria" />
            <button class="sg-newsletter__button" type="submit">@buttonLabel</button>
        </form>
    </div>
</div>
