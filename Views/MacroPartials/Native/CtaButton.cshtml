@inherits Umbraco.Cms.Web.Common.Macros.PartialViewMacroPage
@{
    var label   = Model.MacroParameters.ContainsKey("label")   ? Model.MacroParameters["label"]?.ToString()   : "";
    var url     = Model.MacroParameters.ContainsKey("url")     ? Model.MacroParameters["url"]?.ToString()     : "#";
    var target  = Model.MacroParameters.ContainsKey("target")  ? Model.MacroParameters["target"]?.ToString()  : "_self";
    var variant = Model.MacroParameters.ContainsKey("variant") ? Model.MacroParameters["variant"]?.ToString() : "primary";
}

<div class="sg-macro sg-macro--cta-button">
    <a class="sg-button sg-button--@variant"
       href="@url"
       target="@target">
        @label
    </a>
</div>
