@inherits Umbraco.Cms.Web.Common.Macros.PartialViewMacroPage
@{
    var text   = Model.MacroParameters.ContainsKey("text")   ? Model.MacroParameters["text"]?.ToString()   : "";
    var author = Model.MacroParameters.ContainsKey("author") ? Model.MacroParameters["author"]?.ToString() : null;
    var role   = Model.MacroParameters.ContainsKey("role")   ? Model.MacroParameters["role"]?.ToString()   : null;
}

<div class="sg-macro sg-macro--quote">
    <blockquote class="sg-quote">
        <p class="sg-quote__text">@text</p>
        @if (author is not null)
        {
            <footer class="sg-quote__footer">
                <cite class="sg-quote__author">@author</cite>
                @if (role is not null)
                {
                    <span class="sg-quote__role">@role</span>
                }
            </footer>
        }
    </blockquote>
</div>
