@inherits Umbraco.Cms.Web.Common.Macros.PartialViewMacroPage
@{
    var url   = Model.MacroParameters.ContainsKey("url")   ? Model.MacroParameters["url"]?.ToString()   : "";
    var title = Model.MacroParameters.ContainsKey("title") ? Model.MacroParameters["title"]?.ToString() : "Video";
}

<div class="sg-macro sg-macro--video-embed">
    <div class="sg-video">
        @if (!string.IsNullOrEmpty(url))
        {
            <iframe class="sg-video__iframe"
                    src="@url"
                    title="@title"
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
        }
    </div>
</div>
