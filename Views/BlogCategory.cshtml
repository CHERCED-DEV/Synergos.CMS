@using Umbraco.Extensions
@using Synergos.CMS.Application.Output
@model BlogCategoryPageView
@inject Synergos.CMS.Domain.Services.IThemeService ThemeService
@inject Synergos.CMS.Domain.Services.IDictionaryCache Dict
@{
    var pageCfg = ThemeService.GetPageLayoutConfig(Model.Content);
    if (!string.IsNullOrWhiteSpace(pageCfg.MainWrapperStyle))
        ViewData[LayoutViewData.MainWrapperStyle] = pageCfg.MainWrapperStyle;

    var culture             = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var breadcrumbAria      = Dict.Get("Nav.Breadcrumb",            culture, "Breadcrumb");
    var paginationAria      = Dict.Get("Pagination.AriaCategory",   culture, "Category pagination");

    var seoTitle = Model.Seo.Title ?? Model.CategoryName;
    ViewData[LayoutViewData.BodyId] = Model.PageCssId;
    ViewData[LayoutViewData.BodyClass] = string.IsNullOrWhiteSpace(Model.PageCssClass)
        ? "sg-page sg-page--blog-category"
        : $"sg-page sg-page--blog-category {Model.PageCssClass}";
    var gridSkip = Model.CurrentPage == 1 ? 1 : 0;
}
@section HeadMeta {
    @await Html.PartialAsync("SeoMeta", Model.Seo, new ViewDataDictionary(ViewData) { { LayoutViewData.SeoTitle, seoTitle } })
}

<div class="sg-blog-layout">

    @* ── Main column ── *@
    <main class="sg-blog-layout__main">

        @* ── Back navigation ── *@
        @{
            var blogHome = Model.Content.Parent;
            var backLabel = Dict.Get("Blog.BackToBlog", culture, "Volver al Blog");
        }
        @if (blogHome is not null)
        {
            <nav class="sg-blog-breadcrumb" aria-label="@breadcrumbAria">
                <a href="@blogHome.Url()" class="sg-blog-breadcrumb__back">
                    <span class="sg-blog-breadcrumb__icon" aria-hidden="true">←</span>
                    @backLabel
                </a>
            </nav>
        }

        @* ── Category header ── *@
        <header class="sg-blog-category-header">
            @if (!string.IsNullOrEmpty(Model.CategoryColor))
            {
                <span class="sg-blog-category-header__badge"
                      style="background-color: @Model.CategoryColor">@Model.CategoryName</span>
            }
            else
            {
                <span class="sg-blog-category-header__badge">@Model.CategoryName</span>
            }
            @if (!string.IsNullOrEmpty(Model.CategoryDescription))
            {
                <p class="sg-blog-category-header__description">@Model.CategoryDescription</p>
            }
            @if (!string.IsNullOrEmpty(Model.CategoryImageUrl))
            {
                <img class="sg-blog-category-header__image"
                     src="@Model.CategoryImageUrl"
                     alt="@Model.CategoryName"
                     loading="eager" />
            }
        </header>

        @* ── Posts ── *@
        @if (Model.Posts.Count > 0)
        {
            var articleCount = Model.TotalPosts;
            var countLabel = Dict.Get("Blog.ArticleCount", culture, "artículos");
            <div class="sg-blog-listing__count">@articleCount @countLabel</div>

            @* First post on page 1 gets featured (media-text) treatment *@
            @if (Model.CurrentPage == 1)
            {
                var featured = Model.Posts[0];
                <section class="sg-blog-featured">
                    @await Html.PartialAsync("Blog/FeaturedPostCard", featured)
                </section>
            }

            @* Remaining posts as card grid *@
            @if (Model.Posts.Skip(gridSkip).Any())
            {
                <section class="sg-blog-listing">
                    <div class="sg-blog-listing__grid">
                        @foreach (var post in Model.Posts.Skip(gridSkip))
                        {
                            @await Html.PartialAsync("Blog/PostCard", post)
                        }
                    </div>
                </section>
            }
        }
        else
        {
            <p class="sg-blog-listing__empty">@(Dict.Get("Blog.NoArticles", culture, "No hay artículos en esta categoría."))</p>
        }

        @* ── Pagination ── *@
        @if (Model.TotalPages > 1)
        {
            <nav class="sg-blog-pagination" aria-label="@paginationAria">
                @if (Model.CurrentPage > 1)
                {
                    <a href="?page=@(Model.CurrentPage - 1)" class="sg-blog-pagination__prev" rel="prev">
                        @(Dict.Get("Blog.Prev", culture, "Anterior"))
                    </a>
                }
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.CurrentPage)
                    {
                        <span class="sg-blog-pagination__current" aria-current="page">@i</span>
                    }
                    else
                    {
                        <a href="?page=@i" class="sg-blog-pagination__page">@i</a>
                    }
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="?page=@(Model.CurrentPage + 1)" class="sg-blog-pagination__next" rel="next">
                        @(Dict.Get("Blog.Next", culture, "Siguiente"))
                    </a>
                }
            </nav>
        }

    </main>

    @* ── Sidebar ── *@
    <aside class="sg-blog-layout__sidebar">

        @* ── "Otros temas" ── *@
        @if (Model.OtherCategories.Count > 0)
        {
            var otherTitle  = Dict.Get("Blog.OtherTopics", culture, "Otros temas");
            var seeAllLabel = Dict.Get("Blog.SeeAll", culture, "Ver todos");
            <section class="sg-blog-sidebar__section">
                <h3 class="sg-blog-sidebar__title">@otherTitle</h3>
                <nav class="sg-blog-sidebar__categories" aria-label="@otherTitle">
                    <ul class="sg-blog-sidebar__category-list">
                        @foreach (var cat in Model.OtherCategories)
                        {
                            <li class="sg-blog-sidebar__category-item">
                                <a href="@cat.Url" class="sg-blog-sidebar__category-link">
                                    @if (!string.IsNullOrEmpty(cat.IconUrl))
                                    {
                                        <img class="sg-blog-sidebar__category-icon"
                                             src="@cat.IconUrl"
                                             alt=""
                                             aria-hidden="true" />
                                    }
                                    @cat.Name
                                    <span class="sg-blog-sidebar__category-arrow" aria-hidden="true">→</span>
                                </a>
                            </li>
                        }
                    </ul>
                    <a href="@Model.Content.Parent?.Url()" class="sg-blog-sidebar__ver-todos">@seeAllLabel →</a>
                </nav>
            </section>
        }

    </aside>

</div>
