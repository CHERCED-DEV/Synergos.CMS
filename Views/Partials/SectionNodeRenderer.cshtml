@using Synergos.CMS.Application.Components
@using Synergos.CMS.Application.Output
@inject Microsoft.Extensions.Logging.ILoggerFactory _loggerFactory
@model Synergos.CMS.Application.Output.SectionNode
@* ─────────────────────────────────────────────────────────────────────────
   Renderiza un nodo del árbol de secciones recursivamente.

   Bloques estructurales (Section, Grid, Column, Container, Stack):
     Emiten un container HTML y renderizan hijos recursivamente.

   Bloques de contenido (leaf):
     Se renderizan via su partial SSR en Partials/Ssr/.

   Convención de partials:
     Ssr/Components/{Name}.cshtml → elementos compuestos/integración
     Ssr/Foundation/{Name}.cshtml → elementos atómicos (text, media, action)
   ───────────────────────────────────────────────────────────────────────── *@
@{
    var section = Model.View.Section;
    if (section is not ComponentSection cs) return;

    var vm       = cs.ViewModel;
    var alias    = vm.Alias;
    var domId    = vm.DomAttributes?.ElementId;
    var domClass = vm.DomClass?.ClassList;
    var theme    = vm.DomVariant?.Theme;
    var variant  = vm.DomVariant?.Variant;
    var eventNm  = vm.Tracking?.EventName;
    var hasChildren = Model.Children.Count > 0;
}

@if (alias == "elementStructSection")
{
    var sLayout  = vm.DomLayout;
    var sSpacing = vm.DomSpacing;
    <section class="sg-block @cs.BlockClass @domClass"
             @Html.Raw(domId is not null ? $"id=\"{domId}\"" : "")
             @Html.Raw(sLayout?.ContainerType is not null ? $"data-container-type=\"{sLayout.ContainerType}\"" : "")
             @Html.Raw(sLayout?.Alignment     is not null ? $"data-alignment=\"{sLayout.Alignment}\""         : "")
             @Html.Raw(sLayout?.Direction     is not null ? $"data-direction=\"{sLayout.Direction}\""         : "")
             @Html.Raw(sSpacing?.Padding      is not null ? $"data-padding=\"{sSpacing.Padding}\""            : "")
             @Html.Raw(sSpacing?.Margin       is not null ? $"data-margin=\"{sSpacing.Margin}\""              : "")
             @Html.Raw(sSpacing?.Gap          is not null ? $"data-gap=\"{sSpacing.Gap}\""                    : "")
             data-sg-element="struct-section">
        @foreach (var child in Model.Children)
        {
            @await Html.PartialAsync("SectionNodeRenderer", child)
        }
    </section>
}
else if (alias == "elementStructGrid")
{
    <div class="sg-block sg-grid @cs.BlockClass @domClass"
         @Html.Raw(theme is not null ? $"data-theme=\"{theme}\"" : "")
         data-sg-element="struct-grid">
        @foreach (var child in Model.Children)
        {
            @await Html.PartialAsync("SectionNodeRenderer", child)
        }
    </div>
}
else if (alias == "elementStructColumn")
{
    <div class="sg-block sg-column @cs.BlockClass @domClass"
         style="grid-column: span @Model.ColumnSpan"
         data-sg-element="struct-column">
        @foreach (var child in Model.Children)
        {
            @await Html.PartialAsync("SectionNodeRenderer", child)
        }
    </div>
}
else if (alias is "elementStructContainer" or "elementStructStack")
{
    var tag      = alias == "elementStructContainer" ? "struct-container" : "struct-stack";
    var cLayout  = vm.DomLayout;
    var cSpacing = vm.DomSpacing;
    <div class="sg-block @cs.BlockClass @variant @domClass"
         @Html.Raw(domId is not null ? $"id=\"{domId}\"" : "")
         @Html.Raw(theme   is not null ? $"data-theme=\"{theme}\""     : "")
         @Html.Raw(variant is not null ? $"data-variant=\"{variant}\"" : "")
         @Html.Raw(cLayout?.ContainerType is not null ? $"data-container-type=\"{cLayout.ContainerType}\"" : "")
         @Html.Raw(cLayout?.Alignment     is not null ? $"data-alignment=\"{cLayout.Alignment}\""         : "")
         @Html.Raw(cLayout?.Direction     is not null ? $"data-direction=\"{cLayout.Direction}\""         : "")
         @Html.Raw(cSpacing?.Padding      is not null ? $"data-padding=\"{cSpacing.Padding}\""            : "")
         @Html.Raw(cSpacing?.Margin       is not null ? $"data-margin=\"{cSpacing.Margin}\""              : "")
         @Html.Raw(cSpacing?.Gap          is not null ? $"data-gap=\"{cSpacing.Gap}\""                    : "")
         data-sg-element="@tag">
        @foreach (var child in Model.Children)
        {
            @await Html.PartialAsync("SectionNodeRenderer", child)
        }
    </div>
}
else
{
    @* ── Leaf content block ── *@
    <div class="sg-block @cs.BlockClass @variant @domClass"
         @Html.Raw(domId   is not null ? $"id=\"{domId}\""                : "")
         @Html.Raw(theme   is not null ? $"data-theme=\"{theme}\""        : "")
         @Html.Raw(eventNm is not null ? $"data-event-name=\"{eventNm}\"" : "")
         style="grid-column: span @Model.ColumnSpan">
        @try
        {
            @await Html.PartialAsync(ResolvePartialPath(alias), vm)
        }
        catch (Exception ex)
        {
            _loggerFactory.CreateLogger("Synergos.CMS.Rendering.SectionNodeRenderer")
                .LogError(ex, "Render failed for alias '{Alias}' ({ExType})", alias, ex.GetType().Name);
            @await Html.PartialAsync("Partials/Ssr/Components/_Unknown", vm)
        }
    </div>
}

@functions {
    static string ResolvePartialPath(string alias) => alias switch
    {
        // Textual
        "elementTextHeading"   => "Partials/Ssr/Foundation/Heading",
        "elementTextParagraph" => "Partials/Ssr/Foundation/Paragraph",
        "elementTextRichText"  => "Partials/Ssr/Foundation/RichText",
        "elementTextEyebrow"   => "Partials/Ssr/Foundation/Eyebrow",
        "elementTextQuote"     => "Partials/Ssr/Foundation/Quote",
        "elementTextLabel"     => "Partials/Ssr/Foundation/Label",
        // Action
        "elementActionButton"  => "Partials/Ssr/Foundation/Button",
        "elementActionLink"    => "Partials/Ssr/Foundation/Link",
        // Media
        "elementMediaImage"    => "Partials/Ssr/Foundation/Image",
        "elementMediaVideo"    => "Partials/Ssr/Foundation/Video",
        "elementMediaIcon"     => "Partials/Ssr/Foundation/Icon",
        "elementMediaAvatar"   => "Partials/Ssr/Foundation/Avatar",
        // Info
        "elementInfoBadge"     => "Partials/Ssr/Foundation/Badge",
        // Structural leaves
        "elementStructDivider" => "Partials/Ssr/Foundation/Divider",
        "elementStructSpacer"  => "Partials/Ssr/Foundation/Spacer",
        // Everything else → Components/
        _ => $"Partials/Ssr/Components/{StripAliasPrefix(alias)}"
    };

    static string StripAliasPrefix(string alias)
    {
        string[] prefixes = ["element", "experience"];
        string[] families = ["Struct", "Text", "Action", "Media", "Info", "Comp", "Int", "Corp", "Form", "Nav"];

        foreach (var prefix in prefixes)
        {
            if (!alias.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                continue;

            var rest = alias.Substring(prefix.Length);
            foreach (var f in families)
            {
                if (rest.StartsWith(f, StringComparison.OrdinalIgnoreCase))
                    return rest.Substring(f.Length);
            }
            return rest;
        }
        return alias;
    }
}
