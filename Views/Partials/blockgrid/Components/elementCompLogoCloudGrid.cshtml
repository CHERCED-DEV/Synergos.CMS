@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@*
   LogoCloudGrid — area-based container (SSR puro, cero scripts).
   Los hijos elementMediaLogoItem viven en el Block Grid Area "logos" y
   se renderizan independientemente vía el pipeline nativo de Umbraco.
*@
@{
    var title    = Model.Content.HasProperty("title")       ? Model.Content.Value<string>("title")       : null;
    var subtitle = Model.Content.HasProperty("subtitle")    ? Model.Content.Value<string>("subtitle")    : null;
    var columns  = Model.Content.HasProperty("gridColumns") ? Model.Content.Value<int>("gridColumns")    : 0;
    var gap      = Model.Content.HasProperty("gridGap")     ? Model.Content.Value<string>("gridGap")     : null;
    var cssCls   = Model.Content.HasProperty("classList")   ? Model.Content.Value<string>("classList")   : null;
    var variant  = Model.Content.HasProperty("variant")     ? Model.Content.Value<string>("variant")     : null;

    var style = new List<string>();
    if (columns > 0) style.Add($"--sg-logo-cloud-columns:{columns}");
    if (!string.IsNullOrWhiteSpace(gap)) style.Add($"--sg-logo-cloud-gap:{gap}");
}
<section class="sg-logo-cloud @(variant is not null ? $"sg-logo-cloud--{variant}" : "") @cssCls"
         data-sg-element="comp-logo-cloud-grid"
         @Html.Raw(style.Count > 0 ? $"style=\"{string.Join(';', style)}\"" : "")>
    @if (!string.IsNullOrWhiteSpace(title))
    {
        <header class="sg-logo-cloud__header">
            <h2 class="sg-logo-cloud__title">@title</h2>
            @if (!string.IsNullOrWhiteSpace(subtitle))
            {
                <p class="sg-logo-cloud__subtitle">@subtitle</p>
            }
        </header>
    }
    <div class="sg-logo-cloud__items">
        @await Html.GetBlockGridItemAreasHtmlAsync(Model)
    </div>
</section>
