@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@*
   CardGrid — area-based container (SSR puro, cero scripts).
   Los hijos elementCompCard viven en el Block Grid Area "cards" y se
   renderizan independientemente vía el pipeline nativo de Umbraco.
   Esta vista solo emite el wrapper <section> + CSS grid (columnas + gap).
*@
@{
    var title    = Model.Content.HasProperty("title")       ? Model.Content.Value<string>("title")       : null;
    var subtitle = Model.Content.HasProperty("subtitle")    ? Model.Content.Value<string>("subtitle")    : null;
    var columns  = Model.Content.HasProperty("gridColumns") ? Model.Content.Value<int>("gridColumns")    : 0;
    var gap      = Model.Content.HasProperty("gridGap")     ? Model.Content.Value<string>("gridGap")     : null;
    var cssCls   = Model.Content.HasProperty("classList")   ? Model.Content.Value<string>("classList")   : null;
    var variant  = Model.Content.HasProperty("variant")     ? Model.Content.Value<string>("variant")     : null;

    var style = new List<string>();
    if (columns > 0) style.Add($"--sg-card-grid-columns:{columns}");
    if (!string.IsNullOrWhiteSpace(gap)) style.Add($"--sg-card-grid-gap:{gap}");
}
<section class="sg-card-grid @(variant is not null ? $"sg-card-grid--{variant}" : "") @cssCls"
         data-sg-element="comp-card-grid"
         @Html.Raw(style.Count > 0 ? $"style=\"{string.Join(';', style)}\"" : "")>
    @if (!string.IsNullOrWhiteSpace(title))
    {
        <header class="sg-card-grid__header">
            <h2 class="sg-card-grid__title">@title</h2>
            @if (!string.IsNullOrWhiteSpace(subtitle))
            {
                <p class="sg-card-grid__subtitle">@subtitle</p>
            }
        </header>
    }
    <div class="sg-card-grid__items">
        @await Html.GetBlockGridItemAreasHtmlAsync(Model)
    </div>
</section>
