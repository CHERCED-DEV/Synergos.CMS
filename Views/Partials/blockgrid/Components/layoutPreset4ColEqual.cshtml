@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@{
    var classList       = Model.Content.HasProperty("classList")       ? Model.Content.Value<string>("classList")       : null;
    var containerType   = Model.Content.HasProperty("containerType")   ? Model.Content.Value<string>("containerType")   : null;
    var alignment       = Model.Content.HasProperty("alignment")       ? Model.Content.Value<string>("alignment")       : null;
    var margin          = Model.Content.HasProperty("margin")          ? Model.Content.Value<string>("margin")          : null;
    var padding         = Model.Content.HasProperty("padding")         ? Model.Content.Value<string>("padding")         : null;
    var gap             = Model.Content.HasProperty("gap")             ? Model.Content.Value<string>("gap")             : null;
    var variant         = Model.Content.HasProperty("variant")         ? Model.Content.Value<string>("variant")         : null;
    var noPaddingTop    = Model.Content.HasProperty("noPaddingTop")    && Model.Content.Value<bool>("noPaddingTop");
    var noPaddingBottom = Model.Content.HasProperty("noPaddingBottom") && Model.Content.Value<bool>("noPaddingBottom");
}
<div class="sg-layout sg-layout--4col-equal @classList"
     data-sg-element="layout-preset-4col-equal"
     @Html.Raw(containerType is not null ? $"data-container-type=\"{containerType}\"" : "")
     @Html.Raw(alignment     is not null ? $"data-alignment=\"{alignment}\""           : "")
     @Html.Raw(margin        is not null ? $"data-margin=\"{margin}\""                 : "")
     @Html.Raw(padding       is not null ? $"data-padding=\"{padding}\""               : "")
     @Html.Raw(gap           is not null ? $"data-gap=\"{gap}\""                       : "")
     @Html.Raw(variant       is not null ? $"data-variant=\"{variant}\""               : "")
     @Html.Raw(noPaddingTop    ? "data-no-padding-top"    : "")
     @Html.Raw(noPaddingBottom ? "data-no-padding-bottom" : "")>
    @await Html.GetBlockGridItemAreasHtmlAsync(Model)
</div>
