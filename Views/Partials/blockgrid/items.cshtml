@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Extensions
@using Synergos.CMS.Application.Mapping
@using Synergos.CMS.Application.Output
@using Synergos.CMS.Application.Components
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IEnumerable<BlockGridItem>>
@inject SectionMapperDispatcher Dispatcher
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnv
@{ var isDev = HostEnv.EnvironmentName == "Development"; }
@{
    if (Model?.Any() != true) { return; }
}

<div class="umb-block-grid__layout-container">
    @foreach (var item in Model)
    {
        var alias   = item.Content.ContentType.Alias;
        var colSpan = item.ColumnSpan > 0 ? item.ColumnSpan : 12;
        var rowSpan = item.RowSpan    > 0 ? item.RowSpan    : 1;

        <div class="umb-block-grid__layout-item"
             data-content-element-type-alias="@alias"
             data-content-element-type-key="@item.Content.ContentType.Key"
             data-element-udi="@item.ContentUdi"
             data-col-span="@colSpan"
             data-row-span="@rowSpan"
             style="--umb-block-grid--item-column-span: @colSpan; --umb-block-grid--item-row-span: @rowSpan;">

            @if (alias.StartsWith("elementStruct") || alias.StartsWith("layoutPreset"))
            {
                @* ── Structural blocks: dedicated component partial + native area recursion ── *@
                try
                {
                    @await Html.PartialAsync($"blockgrid/Components/{alias}", item)
                }
                catch (InvalidOperationException)
                {
                    @if (isDev)
                    {
                        <div style="border:2px dashed orange;padding:4px;font-size:11px;color:orange"
                             data-sg-missing-partial="blockgrid/Components/@alias">
                            [dev] Missing structural partial: <strong>blockgrid/Components/@alias</strong>
                        </div>
                    }
                }
            }
            else
            {
                @* ── Content blocks: mapper pipeline → SSR partial ── *@
                var mapper = Dispatcher.FindMapper(alias);
                if (mapper is null)
                {
                    @if (isDev)
                    {
                        <div style="border:2px dashed red;padding:4px;font-size:11px;color:red"
                             data-sg-missing-mapper="@alias">
                            [dev] No ISectionMapper registered for alias: <strong>@alias</strong>
                        </div>
                    }
                }
                else
                {
                    var section = mapper.Map(item.Content);
                    if (section is ComponentSection cs)
                    {
                        var vm      = cs.ViewModel;
                        var domId   = vm.DomAttributes?.ElementId;
                        var domClass = vm.DomClass?.ClassList;
                        var theme   = vm.DomVariant?.Theme;
                        var variant = vm.DomVariant?.Variant;
                        var eventNm = vm.Tracking?.EventName;

                        <div class="sg-block @cs.BlockClass @variant @domClass"
                             @Html.Raw(domId   is not null ? $"id=\"{domId}\""                : "")
                             @Html.Raw(theme   is not null ? $"data-theme=\"{theme}\""        : "")
                             @Html.Raw(eventNm is not null ? $"data-event-name=\"{eventNm}\"" : "")>

                            @await Html.PartialAsync(cs.ViewName, vm)
                            @await Html.GetBlockGridItemAreasHtmlAsync(item)
                        </div>
                    }
                }
            }
        </div>
    }
</div>

