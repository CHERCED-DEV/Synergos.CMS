@*
    Helper para renderizar atributos HTML opcionales de forma limpia.
    Evita concatenación manual y condiciones repetidas en cada template.

    Uso: @await Html.PartialAsync("Partials/elements/shared/_Attributes", attrList)
    Donde attrList es IEnumerable<(string Name, string? Value)>
*@
@model IEnumerable<(string Name, string? Value)>

@foreach (var (name, value) in Model)
{
    if (value is not null)
    {
        @($"{name}=\"{value}\"")
    }
}