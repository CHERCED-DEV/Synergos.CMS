@*
    Helper para renderizar data-* attributes de forma limpia.
    Uso: @await Html.PartialAsync("Partials/elements/shared/_DataAttributes", attrList)
    Donde attrList es IEnumerable<(string Key, string? Value)>
    Genera: data-key="value" solo si value no es null.
*@
@model IEnumerable<(string Key, string? Value)>

@foreach (var (key, value) in Model)
{
    if (value is not null)
    {
        @Html.Raw($"data-{key}=\"{value}\"")
    }
}