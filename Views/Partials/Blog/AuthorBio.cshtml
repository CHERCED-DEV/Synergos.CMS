@model Synergos.CMS.Application.Output.BlogAuthorInfo
@inject Synergos.CMS.Domain.Services.IDictionaryCache Dict
@{
    var culture       = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var socialAria    = Dict.Get("Blog.AuthorSocial", culture, "Author social links");
    var linkedInAria  = Dict.Get("Blog.AuthorLinkedIn", culture, "LinkedIn");
    var twitterAria   = Dict.Get("Blog.AuthorTwitter",  culture, "Twitter");
    var emailAria     = Dict.Get("Blog.AuthorEmail",    culture, "Email");
}

<aside class="sg-author-bio">
    @if (!string.IsNullOrEmpty(Model.PhotoUrl))
    {
        <img class="sg-author-bio__photo" src="@Model.PhotoUrl" alt="@Model.Name" loading="lazy" />
    }
    <div class="sg-author-bio__info">
        <strong class="sg-author-bio__name">@Model.Name</strong>
        @if (!string.IsNullOrEmpty(Model.Role))
        {
            <span class="sg-author-bio__role">@Model.Role</span>
        }
        @if (!string.IsNullOrEmpty(Model.Bio))
        {
            <p class="sg-author-bio__text">@Model.Bio</p>
        }
        <nav class="sg-author-bio__social" aria-label="@socialAria">
            @if (!string.IsNullOrEmpty(Model.LinkedInUrl))
            {
                <a href="@Model.LinkedInUrl" target="_blank" rel="noopener noreferrer" aria-label="@linkedInAria — @Model.Name">@linkedInAria</a>
            }
            @if (!string.IsNullOrEmpty(Model.TwitterUrl))
            {
                <a href="@Model.TwitterUrl" target="_blank" rel="noopener noreferrer" aria-label="@twitterAria — @Model.Name">@twitterAria</a>
            }
            @if (!string.IsNullOrEmpty(Model.Email))
            {
                <a href="mailto:@Model.Email" aria-label="@emailAria — @Model.Name">@emailAria</a>
            }
        </nav>
    </div>
</aside>
