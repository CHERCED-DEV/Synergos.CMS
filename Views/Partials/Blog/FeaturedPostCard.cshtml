@using Synergos.CMS.Domain.Shared
@model Synergos.CMS.Application.Output.BlogPostSummary
@using System.Text.Json
@using System.Text.Json.Serialization
@using Synergos.CMS.Application.Cdn.Configs
@inject Synergos.CMS.Application.Rendering.IElementUrlResolver ElementUrl
@inject Synergos.CMS.Domain.Services.IEmittedBundleTracker Bundles
@inject Synergos.CMS.Domain.Services.IDictionaryCache Dict
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var ctaLabel = Dict.Get("Blog.ReadArticle", culture, "Leer artículo");
    var postTypeAlias = Model.PostType.ToAlias();

    var opt = new JsonSerializerOptions { DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull, PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var cfg = JsonSerializer.Serialize(new MediaTextCdnConfig(
        HeadingText:   Model.Title,
        Body:          Model.Excerpt,
        ImageSrc:      Model.FeaturedImageUrl,
        CtaLabel:      ctaLabel,
        CtaUrl:        Model.Url,
        MediaPosition: "right"
    ), opt);
}
<div class="sg-blog-featured__card sg-blog-featured__card--@postTypeAlias" data-post-type="@postTypeAlias">
    @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
    {
        <span class="sg-blog-featured__badge">@Model.CategoryName</span>
    }
    <span class="sg-blog-featured__type sg-blog-featured__type--@postTypeAlias">@Dict.Get($"Blog.PostType.{postTypeAlias}", culture, postTypeAlias)</span>
    @if (Bundles.TryClaim("media-text")) { <script src="@ElementUrl.ResolveBundle("media-text")" type="module" defer></script> }
    <synergos-media-text config='@cfg' class="sg-cdn sg-cdn--media-text"></synergos-media-text>
</div>
