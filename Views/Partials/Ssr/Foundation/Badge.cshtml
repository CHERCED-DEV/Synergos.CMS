@model Synergos.CMS.Application.Elements.BadgeViewModel
@{
    var type = Model.Badge?.BadgeType ?? "info";
    var cls  = string.Join(" ", new[] { Model.BlockClass, $"sg-badge--{type}", Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
<span class="@cls" data-sg-element="info-badge">
    @Model.Badge?.BadgeText
</span>
