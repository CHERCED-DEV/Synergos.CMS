@model Synergos.CMS.Application.Elements.ImageElementViewModel
@{
    var cls = string.Join(" ", new[] { Model.BlockClass, Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var src = Model.Media?.Media?.Src;
    var alt = Model.Media?.AltText ?? Model.Media?.Media?.Alt ?? "";
}
@if (src is not null)
{
    <figure class="@cls" data-sg-element="media-image">
        <img src="@src" alt="@alt" loading="lazy" />
        @if (!string.IsNullOrWhiteSpace(Model.Media?.MediaDescription))
        {
            <figcaption>@Model.Media.MediaDescription</figcaption>
        }
    </figure>
}
