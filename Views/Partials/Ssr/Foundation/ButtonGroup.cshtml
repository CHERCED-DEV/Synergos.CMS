@model Synergos.CMS.Application.Elements.ButtonGroupViewModel
@{
    var direction = Model.DomLayout?.Direction ?? "row";
    var align     = Model.DomLayout?.Alignment;
    var cls       = string.Join(" ", new[] { Model.BlockClass, Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
<div class="@cls"
     data-sg-element="action-button-group"
     data-direction="@direction"
     @Html.Raw(align is not null ? $"data-align=\"{align}\"" : "")>
    @if (Model.Collection?.Items?.Any() == true)
    {
        foreach (var item in Model.Collection.Items)
        {
            <span class="sg-btn-group__item">@item.Title</span>
        }
    }
</div>
