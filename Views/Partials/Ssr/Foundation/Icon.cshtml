@model Synergos.CMS.Application.Elements.IconViewModel
@{
    var cls  = string.Join(" ", new[] { Model.BlockClass, Model.DomClass?.ClassList, Model.DomVariant?.Variant }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var src  = Model.Media?.Media?.Src;
    var alt  = Model.Media?.AltText ?? "";
    var key  = Model.Badge?.BadgeText;
}
<span class="@cls" data-sg-element="media-icon" @Html.Raw(key is not null ? $"data-icon-key=\"{key}\"" : "") aria-hidden="@(string.IsNullOrWhiteSpace(alt) ? "true" : "false")">
    @if (src is not null)
    {
        <img src="@src" alt="@alt" />
    }
</span>
