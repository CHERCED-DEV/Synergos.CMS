@model Synergos.CMS.Application.Elements.LinkViewModel
@{
    var cls    = string.Join(" ", new[] { Model.BlockClass, Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var href   = Model.Cta?.CtaLink?.Url ?? "#";
    var label  = Model.Cta?.CtaLabel ?? Model.Cta?.CtaLink?.Name;
    var target = Model.Cta?.CtaTarget;
    var aria   = Model.Cta?.CtaAriaLabel ?? label;
}
<a class="@cls"
   href="@href"
   @Html.Raw(target is not null ? $"target=\"{target}\"" : "")
   @Html.Raw(target == "_blank" ? "rel=\"noopener noreferrer\"" : "")
   aria-label="@aria"
   data-sg-element="action-link">
    @label
</a>
