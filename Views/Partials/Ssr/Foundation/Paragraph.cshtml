@model Synergos.CMS.Application.Elements.ParagraphViewModel
@{
    var cls = string.Join(" ", new[] { Model.BlockClass, Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var title = Model.Text?.Title;
    var body = Model.Text?.Body;
    var summary = Model.Text?.Summary;
    var subtitle = Model.Text?.Subtitle;
    var caption = Model.Text?.Caption;
    var fallback = !string.IsNullOrWhiteSpace(summary)
        ? summary
        : !string.IsNullOrWhiteSpace(subtitle)
            ? subtitle
            : !string.IsNullOrWhiteSpace(caption)
                ? caption
                : null;
}
@if (!string.IsNullOrWhiteSpace(title) || !string.IsNullOrWhiteSpace(body) || !string.IsNullOrWhiteSpace(fallback))
{
    <div class="@cls sg-paragraph" data-sg-element="text-paragraph">
        @if (!string.IsNullOrWhiteSpace(title))
        {
            <p class="sg-paragraph__title">@title</p>
        }

        @if (!string.IsNullOrWhiteSpace(body))
        {
            @Html.Raw(body)
        }
        else if (!string.IsNullOrWhiteSpace(fallback))
        {
            <p>@fallback</p>
        }
    </div>
}
