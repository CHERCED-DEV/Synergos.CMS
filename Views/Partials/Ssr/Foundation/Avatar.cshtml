@model Synergos.CMS.Application.Elements.AvatarViewModel
@{
    var src = Model.Media?.Media?.Src;
    var alt = Model.Media?.AltText ?? Model.Media?.Media?.Alt ?? "";
    var name = Model.Text?.Title;
    var role = Model.Text?.Subtitle;
}

<figure class="sg-avatar @Model.DomClass?.ClassList @Model.DomVariant?.Variant">
    @if (src is not null)
    {
        <img class="sg-avatar__image" src="@src" alt="@alt" loading="lazy" />
    }
    @if (name is not null || role is not null)
    {
        <figcaption class="sg-avatar__info">
            @if (name is not null) { <span class="sg-avatar__name">@name</span> }
            @if (role is not null) { <span class="sg-avatar__role">@role</span> }
        </figcaption>
    }
</figure>
