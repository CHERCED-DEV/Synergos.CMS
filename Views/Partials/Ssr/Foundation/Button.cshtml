@model Synergos.CMS.Application.Elements.ButtonViewModel
@{
    var variant = string.IsNullOrEmpty(Model.DomVariant?.Variant) ? "primary" : Model.DomVariant!.Variant!;
    var cls     = string.Join(" ", new[] { Model.BlockClass, $"sg-btn--{variant}", Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var href    = Model.Cta?.CtaLink?.Url;
    var label   = Model.Cta?.CtaLabel ?? Model.Cta?.CtaLink?.Name;
    var aria    = Model.Cta?.CtaAriaLabel ?? label;
    var target  = Model.Cta?.CtaTarget;
}
@if (href is not null)
{
    <a class="@cls"
       href="@href"
       @Html.Raw(target is not null ? $"target=\"{target}\"" : "")
       @Html.Raw(target == "_blank" ? "rel=\"noopener noreferrer\"" : "")
       aria-label="@aria"
       data-sg-element="action-button">
        @label
    </a>
}
else
{
    <button class="@cls"
            type="button"
            aria-label="@aria"
            data-sg-element="action-button">
        @label
    </button>
}
