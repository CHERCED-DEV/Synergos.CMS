@model Synergos.CMS.Application.Elements.TextBlockViewModel
@{
    var variant = Model.DomVariant?.Variant;
    var cls     = string.Join(" ", new[] { Model.BlockClass, Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var title   = Model.Text?.Title;
    var body    = Model.Text?.Body;
}
<div class="@cls"
     data-sg-element="text-block"
     @Html.Raw(variant is not null ? $"data-variant=\"{variant}\"" : "")>
    @if (!string.IsNullOrWhiteSpace(title))
    {
        <p class="sg-text-block__heading">@title</p>
    }
    @if (!string.IsNullOrWhiteSpace(body))
    {
        <p class="sg-text-block__body">@body</p>
    }
</div>
