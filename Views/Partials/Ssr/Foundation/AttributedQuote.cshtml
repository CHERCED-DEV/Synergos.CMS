@model Synergos.CMS.Application.Elements.AttributedQuoteViewModel
@{
    var variant = string.IsNullOrEmpty(Model.DomVariant?.Variant) ? "default" : Model.DomVariant!.Variant!;
    var cls     = string.Join(" ", new[] { Model.BlockClass, $"sg-attributed-quote--{variant}", Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
@if (!string.IsNullOrWhiteSpace(Model.QuoteText))
{
    <blockquote class="@cls" data-sg-element="text-attributed-quote">
        <p class="sg-attributed-quote__text">@Model.QuoteText</p>
        @if (!string.IsNullOrWhiteSpace(Model.QuoteAuthor))
        {
            <footer class="sg-attributed-quote__footer">
                <cite class="sg-attributed-quote__author">@Model.QuoteAuthor</cite>
                @if (!string.IsNullOrWhiteSpace(Model.QuoteRole))
                {
                    <span class="sg-attributed-quote__role">@Model.QuoteRole</span>
                }
            </footer>
        }
    </blockquote>
}
