@model Synergos.CMS.Application.Elements.VideoElementViewModel
@{
    var cls = string.Join(" ", new[] { Model.BlockClass, Model.DomClass?.ClassList, Model.DomVariant?.Variant }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var src = Model.Embed?.EmbedUrl;
    var title = Model.Embed?.EmbedTitle ?? "Video";
}
@if (src is not null)
{
    <div class="@cls" data-sg-element="media-video">
        <iframe src="@src"
                title="@title"
                loading="lazy"
                allowfullscreen
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
        </iframe>
    </div>
}
