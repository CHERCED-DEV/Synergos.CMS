@model Synergos.CMS.Application.Elements.RichTextElementViewModel
@{
    var cls = string.Join(" ", new[] { Model.BlockClass, Model.DomClass?.ClassList, Model.DomVariant?.Variant }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
<div class="@cls" data-sg-element="text-richtext">
    @Html.Raw(Model.Text?.Body)
</div>
