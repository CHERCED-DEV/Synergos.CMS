@model Synergos.CMS.Application.Elements.QuoteViewModel
@{
    var cls = string.Join(" ", new[] { Model.BlockClass, Model.DomClass?.ClassList, Model.DomVariant?.Variant }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
<blockquote class="@cls" data-sg-element="text-quote">
    <p>@Model.Text?.Body</p>
    @if (!string.IsNullOrWhiteSpace(Model.Text?.Summary))
    {
        <footer><cite>@Model.Text.Summary</cite></footer>
    }
</blockquote>
