@using System.Text.Json
@using Umbraco.Cms.Core.Models
@model Synergos.CMS.Application.Elements.MacroHostViewModel
@inject Umbraco.Cms.Core.Services.IMacroService _macroService
@inject Umbraco.Cms.Core.Web.IUmbracoContextAccessor _contextAccessor
@{
    if (string.IsNullOrWhiteSpace(Model.MacroAlias)) { return; }

    var macro = _macroService.GetByAlias(Model.MacroAlias);
    if (macro?.MacroSource == null) { return; }

    _contextAccessor.TryGetUmbracoContext(out var ctx);
    var currentPage = ctx?.PublishedRequest?.PublishedContent;

    var p = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
    if (!string.IsNullOrWhiteSpace(Model.MacroTitle))     p["title"]     = Model.MacroTitle;
    if (!string.IsNullOrWhiteSpace(Model.MacroVariant))   p["variant"]   = Model.MacroVariant;
    if (!string.IsNullOrWhiteSpace(Model.MacroTheme))     p["theme"]     = Model.MacroTheme;
    if (!string.IsNullOrWhiteSpace(Model.MacroElementId)) p["elementId"] = Model.MacroElementId;

    if (!string.IsNullOrWhiteSpace(Model.MacroParams))
    {
        try
        {
            using var doc = JsonDocument.Parse(Model.MacroParams);
            foreach (var prop in doc.RootElement.EnumerateObject())
                p[prop.Name] = prop.Value.ValueKind == JsonValueKind.String
                    ? prop.Value.GetString()
                    : (object?)prop.Value.GetRawText();
        }
        catch (JsonException) { /* invalid JSON — skip extra params */ }
    }

    var macroModel = new PartialViewMacroModel(currentPage, macro.Id, Model.MacroAlias, macro.MacroSource, p);
}
@await Html.PartialAsync("~/Views/" + macro.MacroSource, macroModel)
