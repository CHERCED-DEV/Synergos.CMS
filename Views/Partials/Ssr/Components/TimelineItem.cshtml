@model Synergos.CMS.Application.Elements.TimelineItemViewModel
@{
    var cls  = string.Join(" ", new[] { Model.BlockClass, Model.DomClass?.ClassList, Model.DomVariant?.Variant }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var date = Model.Date?.PublishDate?.ToString("yyyy-MM-dd");
}
<div class="@cls" data-sg-element="info-timeline-item">
    @if (date is not null)
    {
        <time class="sg-timeline__date" datetime="@date">@Model.Date?.PublishDate?.ToString("MMMM yyyy")</time>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Text?.Title))
    {
        <h4 class="sg-timeline__title">@Model.Text.Title</h4>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Text?.Body))
    {
        <p class="sg-timeline__body">@Html.Raw(Model.Text.Body)</p>
    }
</div>
