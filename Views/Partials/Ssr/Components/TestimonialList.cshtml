@model Synergos.CMS.Application.Elements.TestimonialListViewModel
@{
    var cls = string.Join(" ", new[] { Model.BlockClass, Model.DomClass?.ClassList, Model.DomVariant?.Variant }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
<section class="@cls" data-sg-element="comp-testimonial-list">
    @if (!string.IsNullOrWhiteSpace(Model.Collection?.CollectionTitle))
    {
        <h2 class="sg-testimonial-list__title">@Model.Collection.CollectionTitle</h2>
    }
    @if (Model.Items.Count > 0)
    {
        <div class="sg-testimonial-list__items">
            @foreach (var item in Model.Items)
            {
                @await Html.PartialAsync("Partials/Ssr/Components/TestimonialItem", item)
            }
        </div>
    }
</section>
