@model Synergos.CMS.Application.Elements.AlertBoxViewModel
@inject Synergos.CMS.Domain.Services.IDictionaryCache Dict
@{
    var alertType  = string.IsNullOrWhiteSpace(Model.AlertType) ? "info" : Model.AlertType!.ToLowerInvariant().Trim();
    var closeLabel = Dict.Get("Common.Actions.Close", fallback: "Close");
    var cls       = string.Join(" ", new[] { Model.BlockClass, $"sg-alert-box--{alertType}", Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
<div class="@cls" role="alert" data-sg-element="corp-alert-box"
     @Html.Raw(Model.Dismissible == true ? "data-dismissible" : "")>
    @if (!string.IsNullOrWhiteSpace(Model.Text?.Title))
    {
        <strong class="sg-alert-box__title">@Model.Text.Title</strong>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Text?.Body))
    {
        <p class="sg-alert-box__message">@Html.Raw(Model.Text.Body)</p>
    }
    @if (Model.Dismissible == true)
    {
        <button type="button" class="sg-alert-box__dismiss" aria-label="@closeLabel">&times;</button>
    }
</div>
