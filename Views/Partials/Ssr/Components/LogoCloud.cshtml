@model Synergos.CMS.Application.Elements.LogoCloudViewModel
@{
    var cls = string.Join(" ", new[] { Model.BlockClass, Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
<div class="@cls" data-sg-element="comp-logo-cloud">
    @if (!string.IsNullOrWhiteSpace(Model.Text?.Title))
    {
        <p class="sg-logo-cloud__label">@Model.Text.Title</p>
    }
    @if (Model.Items.Count > 0)
    {
        <div class="sg-logo-cloud__items">
            @foreach (var item in Model.Items)
            {
                @await Html.PartialAsync("Partials/Ssr/Components/LogoItem", item)
            }
        </div>
    }
</div>
