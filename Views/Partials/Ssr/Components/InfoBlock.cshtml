@model Synergos.CMS.Application.Elements.InfoBlockViewModel
@{
    var variant = string.IsNullOrEmpty(Model.DomVariant?.Variant) ? "default" : Model.DomVariant!.Variant!;
    var cls     = string.Join(" ", new[] { Model.BlockClass, $"sg-info-block--{variant}", Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
<div class="@cls" data-sg-element="comp-info-block">
    @if (!string.IsNullOrWhiteSpace(Model.Text?.Title))
    {
        <h3 class="sg-info-block__title">@Model.Text.Title</h3>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Text?.Body))
    {
        <div class="sg-info-block__body">@Html.Raw(Model.Text.Body)</div>
    }
    @if (Model.Cta?.CtaLink?.Url is not null)
    {
        <a class="sg-info-block__cta sg-btn"
           href="@Model.Cta.CtaLink.Url"
           @Html.Raw(Model.Cta.CtaTarget is not null ? $"target=\"{Model.Cta.CtaTarget}\"" : "")>
            @(Model.Cta.CtaLabel ?? Model.Cta.CtaLink.Name)
        </a>
    }
</div>
