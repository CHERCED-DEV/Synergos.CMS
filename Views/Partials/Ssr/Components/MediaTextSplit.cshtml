@model Synergos.CMS.Application.Elements.MediaTextSplitViewModel
@inject Synergos.CMS.Domain.Services.IDictionaryCache Dict
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var direction = Model.DomLayout?.Direction ?? "row";
    var variant   = Model.DomVariant?.Variant;
    var cls       = string.Join(" ", new[] { Model.BlockClass, $"sg-split--{direction}", variant }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var src       = Model.Media?.Media?.Src;
    var href      = Model.Cta?.CtaLink?.Url;
    var readMore  = Model.Cta?.CtaLabel;
    if (string.IsNullOrWhiteSpace(readMore)) readMore = Dict.Get("Common.Actions.SeeMore", culture, "Ver más");
}
<div class="@cls" data-sg-element="comp-media-text-split">
    @if (src is not null)
    {
        <div class="sg-split__media">
            <img src="@src" alt="@(Model.Media?.AltText ?? "")" loading="lazy" />
        </div>
    }
    <div class="sg-split__content">
        @if (!string.IsNullOrWhiteSpace(Model.Text?.Title))
        {
            <h2 class="sg-split__title">@Model.Text.Title</h2>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Text?.Body))
        {
            <div class="sg-split__body">@Html.Raw(Model.Text.Body)</div>
        }
        @if (href is not null)
        {
            <a class="sg-split__cta sg-btn--primary" href="@href">@readMore</a>
        }
    </div>
</div>
