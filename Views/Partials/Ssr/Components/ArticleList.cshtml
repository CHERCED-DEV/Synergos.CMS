@model Synergos.CMS.Application.Elements.ArticleListViewModel
@inject Umbraco.Cms.Web.Common.UmbracoHelper Umbraco

<section class="sg-article-list sg-article-list--@(Model.ListLayout ?? "grid")">
    @if (Model.Heading is not null && !string.IsNullOrEmpty(Model.Heading.Title))
    {
        <header class="sg-article-list__header">
            <h2 class="sg-article-list__title">@Model.Heading.Title</h2>
            @if (!string.IsNullOrEmpty(Model.Heading.Subtitle))
            {
                <p class="sg-article-list__subtitle">@Model.Heading.Subtitle</p>
            }
        </header>
    }

    @if (Model.Articles.Count > 0)
    {
        <div class="sg-article-list__grid">
            @foreach (var article in Model.Articles)
            {
                @await Html.PartialAsync("Blog/PostCard", article, new ViewDataDictionary(ViewData)
                {
                    { "showImage",   Model.ShowImage },
                    { "showExcerpt", Model.ShowExcerpt }
                })
            }
        </div>
    }
    else
    {
        <p class="sg-article-list__empty">@(Umbraco.GetDictionaryValue("Blog.NoArticles") ?? "No hay artículos seleccionados.")</p>
    }
</section>
