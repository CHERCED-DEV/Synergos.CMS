@model Synergos.CMS.Application.Elements.FormBlockViewModel
@inject Synergos.CMS.Application.Services.FormRenderService FormService
@inject Umbraco.Cms.Web.Common.UmbracoHelper Umbraco
@{
    var formAlias = Model.FormAlias;
    var formDef   = !string.IsNullOrWhiteSpace(formAlias)
        ? FormService.ResolveByAlias(formAlias)
        : null;
    var formId    = $"sg-form-{formAlias}";
}

@if (formDef is null)
{
    @* Silently skip if no form definition — allows editors to configure alias *@
    if (!string.IsNullOrWhiteSpace(formAlias))
    {
        <p class="sg-form-block__placeholder"><em>Formulario "@formAlias" no encontrado.</em></p>
    }
    return;
}

@{
    var networkErrorMsg = Umbraco.GetDictionaryValue("Form.Messages.NetworkError") ?? "Connection error. Please try again.";
    var generalErrorMsg = Umbraco.GetDictionaryValue("Form.Messages.Error") ?? "An error occurred. Please try again.";
}
<div class="sg-form-block @Model.BlockClass"
     data-sg-element="comp-form-block"
     data-msg-network-error="@networkErrorMsg"
     data-msg-general-error="@generalErrorMsg">
    @if (!string.IsNullOrWhiteSpace(Model.FormTitle))
    {
        <h2 class="sg-form-block__title">@Model.FormTitle</h2>
    }

    @{
        var successMsg = formDef.ThankYouMessage
            ?? Model.SuccessMessage
            ?? Umbraco.GetDictionaryValue("Form.Messages.Success")
            ?? "Thank you! Your message has been sent.";
        var sendingMsg = Umbraco.GetDictionaryValue("Form.Messages.Sending") ?? "Sending…";
        var selectDefault = Umbraco.GetDictionaryValue("Form.Placeholders.SelectOption") ?? "Select an option";
        var submitLabel = Model.SubmitLabel
            ?? formDef.SubmitLabel
            ?? Umbraco.GetDictionaryValue("Form.Actions.Send")
            ?? "Send message";
    }
    <div class="sg-form-block__success" id="@(formId)-success" hidden>
        <p>@successMsg</p>
    </div>

    <form class="sg-form-block__form" id="@formId" novalidate>
        @* formAlias hidden field — read by FormSubmissionController *@
        <input type="hidden" name="formAlias" value="@formAlias">
        @* Honeypot — must stay empty; bots fill it *@
        <input type="text" name="_hp" style="position:absolute;left:-9999px;width:1px;height:1px" tabindex="-1" autocomplete="off" aria-hidden="true">

        @foreach (var field in formDef.Fields)
        {
            var inputId = $"{formId}-{field.Name}";
            <div class="sg-form-block__field">
                <label class="sg-form-block__label" for="@inputId">
                    @field.Label@if (field.Required) { <span aria-hidden="true"> *</span> }
                </label>

                @switch (field.Type)
                {
                    case "textarea":
                        <textarea class="sg-form-block__input"
                                  id="@inputId"
                                  name="@field.Name"
                                  placeholder="@field.Placeholder"
                                  @(field.Required ? "required" : "")
                                  rows="4"></textarea>
                        break;
                    case "select":
                        @{
                            var selectOptions = field.Options
                                ?.Split(new[] { '\n', ',' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                                ?? [];
                        }
                        <select class="sg-form-block__input"
                                id="@inputId"
                                name="@field.Name"
                                @(field.Required ? "required" : "")>
                            <option value="">@(field.Placeholder ?? selectDefault)</option>
                            @foreach (var opt in selectOptions)
                            {
                                <option value="@opt">@opt</option>
                            }
                        </select>
                        break;
                    case "checkbox":
                        <input class="sg-form-block__checkbox"
                               type="checkbox"
                               id="@inputId"
                               name="@field.Name"
                               value="true"
                               @(field.Required ? "required" : "") />
                        break;
                    default:
                        <input class="sg-form-block__input"
                               type="@field.Type"
                               id="@inputId"
                               name="@field.Name"
                               placeholder="@field.Placeholder"
                               @(field.Required ? "required" : "") />
                        break;
                }

                <span class="sg-form-block__error" id="@(inputId)-error" role="alert" hidden></span>
            </div>
        }

        <div class="sg-form-block__actions">
            <button class="sg-form-block__submit sg-btn--primary" type="submit">
                @submitLabel
            </button>
            <span class="sg-form-block__spinner" hidden aria-live="polite">@sendingMsg</span>
        </div>
        <div class="sg-form-block__error sg-form-block__error--general" role="alert" hidden></div>
    </form>
</div>

<script>
(function () {
    var form    = document.getElementById('@formId');
    var success = document.getElementById('@(formId)-success');
    if (!form) return;

    var block          = form.closest('[data-sg-element="comp-form-block"]');
    var msgNetworkErr  = (block && block.dataset.msgNetworkError)  || 'Connection error. Please try again.';
    var msgGeneralErr  = (block && block.dataset.msgGeneralError)  || 'An error occurred. Please try again.';

    form.addEventListener('submit', async function (e) {
        e.preventDefault();

        var spinner = form.querySelector('.sg-form-block__spinner');
        var submit  = form.querySelector('.sg-form-block__submit');
        var general = form.querySelector('.sg-form-block__error--general');

        // Clear previous errors
        form.querySelectorAll('.sg-form-block__error[id]').forEach(function (el) {
            el.textContent = ''; el.hidden = true;
        });
        if (general) { general.textContent = ''; general.hidden = true; }

        if (spinner) spinner.hidden = false;
        if (submit)  submit.disabled = true;

        try {
            var res = await fetch('/api/forms/submit', {
                method:  'POST',
                headers: { 'Accept': 'application/json' },
                body:    new FormData(form)
            });
            var json = await res.json();

            if (res.ok && json.success) {
                form.hidden    = true;
                success.hidden = false;
            } else {
                if (general) { general.textContent = json.errorMessage || msgGeneralErr; general.hidden = false; }
            }
        } catch {
            if (general) { general.textContent = msgNetworkErr; general.hidden = false; }
        } finally {
            if (spinner) spinner.hidden = true;
            if (submit)  submit.disabled = false;
        }
    });
}());
</script>
