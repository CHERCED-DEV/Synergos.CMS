@model Synergos.CMS.Application.Elements.BannerViewModel
@{
    var variant = string.IsNullOrEmpty(Model.DomVariant?.Variant) ? "default" : Model.DomVariant!.Variant!;
    var cls     = string.Join(" ", new[] { Model.BlockClass, $"sg-banner--{variant}", Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
<div class="@cls" data-sg-element="comp-banner">
    @if (!string.IsNullOrWhiteSpace(Model.Text?.Title))
    {
        <h2 class="sg-banner__title">@Model.Text.Title</h2>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Text?.Body))
    {
        <div class="sg-banner__body">@Html.Raw(Model.Text.Body)</div>
    }
    @if (Model.Cta?.CtaLink?.Url is not null)
    {
        <a class="sg-banner__cta sg-btn"
           href="@Model.Cta.CtaLink.Url"
           @Html.Raw(Model.Cta.CtaTarget is not null ? $"target=\"{Model.Cta.CtaTarget}\"" : "")
           @Html.Raw(Model.Cta.CtaTarget == "_blank" ? "rel=\"noopener noreferrer\"" : "")>
            @(Model.Cta.CtaLabel ?? Model.Cta.CtaLink.Name)
        </a>
    }
</div>
