@model Synergos.CMS.Application.Elements.InsightExplorerViewModel
@{
    var cls = string.Join(" ", new[] { Model.BlockClass, Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
@* SSR fallback — Experience element served via CDN macro (SgInsightExplorer). *@
<div class="@cls" data-sg-element="exp-insight-explorer">
    @if (!string.IsNullOrWhiteSpace(Model.Text?.Title))
    {
        <h2>@Model.Text.Title</h2>
    }
    <noscript>JavaScript es necesario para este componente.</noscript>
</div>
