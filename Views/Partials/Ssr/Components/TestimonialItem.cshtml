@model Synergos.CMS.Application.Elements.TestimonialItemViewModel
@{
    var cls    = string.Join(" ", new[] { Model.BlockClass, Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var avatar = Model.Media?.Media?.Src;
}
<figure class="@cls" data-sg-element="info-testimonial-item">
    <blockquote class="sg-testimonial__quote">
        <p>@Model.Text?.Body</p>
    </blockquote>
    <figcaption class="sg-testimonial__author">
        @if (avatar is not null)
        {
            <img class="sg-testimonial__avatar" src="@avatar" alt="@(Model.Media?.AltText ?? "")" loading="lazy" />
        }
        <span class="sg-testimonial__name">@Model.Text?.Caption</span>
        @if (!string.IsNullOrWhiteSpace(Model.Badge?.BadgeText))
        {
            <span class="sg-testimonial__rating">@Model.Badge.BadgeText</span>
        }
    </figcaption>
</figure>
