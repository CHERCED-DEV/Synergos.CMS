@model Synergos.CMS.Application.Elements.LogoItemViewModel
@{
    var cls    = string.Join(" ", new[] { Model.BlockClass, Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var src    = Model.Media?.Media?.Src;
    var alt    = Model.Media?.AltText ?? Model.Text?.Title ?? "";
    var href   = Model.Cta?.CtaLink?.Url;
    var target = Model.Cta?.CtaTarget;
}
<div class="@cls" data-sg-element="media-logo-item">
    @if (href is not null)
    {
        <a href="@href" @Html.Raw(target is not null ? $"target=\"{target}\"" : "") @Html.Raw(target == "_blank" ? "rel=\"noopener noreferrer\"" : "")>
            @if (src is not null) { <img src="@src" alt="@alt" loading="lazy" /> }
        </a>
    }
    else if (src is not null)
    {
        <img src="@src" alt="@alt" loading="lazy" />
    }
</div>
