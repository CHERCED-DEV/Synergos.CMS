@model Synergos.CMS.Application.Elements.AlertBarViewModel
@inject Synergos.CMS.Domain.Services.IDictionaryCache Dict
@* Dismissible alert/notification bar. *@
@{
    var closeLabel   = Dict.Get("Common.Actions.Close",    fallback: "Close");
    var learnMore    = Dict.Get("Common.Actions.LearnMore", fallback: "Learn more");
}
<div class="sg-alert-bar" role="alert" data-sg-element="corp-alert-bar">
    @if (Model.Text?.Title is not null)
    {
        <strong class="sg-alert-bar__title">@Model.Text.Title</strong>
    }
    @if (Model.Text?.Body is not null)
    {
        <p class="sg-alert-bar__message">@Html.Raw(Model.Text.Body)</p>
    }
    @if (Model.Cta?.CtaLink?.Url is not null)
    {
        <a href="@Model.Cta.CtaLink.Url" class="sg-alert-bar__action">@(Model.Cta.CtaLabel ?? learnMore)</a>
    }
    <button type="button" class="sg-alert-bar__dismiss" aria-label="@closeLabel">&times;</button>
</div>
