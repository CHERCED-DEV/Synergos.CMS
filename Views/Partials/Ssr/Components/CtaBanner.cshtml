@model Synergos.CMS.Application.Elements.CtaBannerViewModel
@inject Umbraco.Cms.Web.Common.UmbracoHelper Umbraco
@{
    var variant  = string.IsNullOrEmpty(Model.DomVariant?.Variant) ? "primary" : Model.DomVariant!.Variant!;
    var cls      = string.Join(" ", new[] { "sg-cta-banner", $"sg-cta-banner--{variant}", Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var href     = Model.Cta?.CtaLink?.Url;
    var ctaLabel = Model.Cta?.CtaLabel;
    if (string.IsNullOrWhiteSpace(ctaLabel)) ctaLabel = Umbraco.GetDictionaryValue("Common.Actions.GetStarted") ?? "Empezar";
}
<div class="@cls" data-sg-element="comp-cta-banner">
    <div class="sg-cta-banner__content">
        @if (!string.IsNullOrWhiteSpace(Model.Text?.Title))
        {
            <h2 class="sg-cta-banner__heading">@Model.Text.Title</h2>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Text?.Subtitle))
        {
            <p class="sg-cta-banner__text">@Model.Text.Subtitle</p>
        }
    </div>
    @if (href is not null)
    {
        <a class="sg-cta-banner__btn sg-btn--primary" href="@href">@ctaLabel</a>
    }
</div>
