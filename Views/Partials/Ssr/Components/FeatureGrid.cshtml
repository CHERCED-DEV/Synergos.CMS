@model Synergos.CMS.Application.Elements.FeatureGridViewModel
@{
    var cls = string.Join(" ", new[] { "sg-feature-grid", Model.BlockClass, Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
<div class="@cls" data-sg-element="comp-feature-grid">
    @if (!string.IsNullOrWhiteSpace(Model.Collection?.CollectionTitle))
    {
        <h2 class="sg-feature-grid__title">@Model.Collection.CollectionTitle</h2>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Collection?.CollectionDescription))
    {
        <p class="sg-feature-grid__description">@Model.Collection.CollectionDescription</p>
    }
    @if (Model.Items.Count > 0)
    {
        <div class="sg-feature-grid__items">
            @foreach (var item in Model.Items)
            {
                @await Html.PartialAsync("Partials/Ssr/Components/Feature", item)
            }
        </div>
    }
</div>
