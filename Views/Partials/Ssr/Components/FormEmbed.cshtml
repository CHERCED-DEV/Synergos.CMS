@model Synergos.CMS.Application.Elements.FormEmbedViewModel
@{
    var form = Model.Form;
    if (form is null) return;
}

<div class="sg-form-embed @(Model.DomClass ?? "")">
    @if (!string.IsNullOrEmpty(Model.Heading))
    {
        <h2 class="sg-form-embed__heading">@Model.Heading</h2>
    }
    @if (!string.IsNullOrEmpty(Model.Subheading))
    {
        <p class="sg-form-embed__subheading">@Model.Subheading</p>
    }

    <form class="sg-form"
          data-form-alias="@form.FormAlias"
          method="post"
          action="/api/forms/submit"
          novalidate>

        <input type="hidden" name="formAlias" value="@form.FormAlias" />

        <div class="sg-form__fields">
            @foreach (var field in form.Fields)
            {
                <div class="sg-form__field sg-form__field--@field.Width sg-form__field--@field.Type">
                    @if (field.Type != "hidden")
                    {
                        <label class="sg-form__label" for="field-@field.Name">
                            @field.Label
                            @if (field.Required)
                            {
                                <span class="sg-form__required" aria-hidden="true">*</span>
                            }
                        </label>
                    }

                    @switch (field.Type)
                    {
                        case "textarea":
                            <textarea class="sg-form__input sg-form__textarea"
                                      id="field-@field.Name"
                                      name="@field.Name"
                                      placeholder="@field.Placeholder"
                                      @(field.Required ? "required" : "")
                                      @Html.Raw(field.ValidationPattern is not null ? $"pattern=\"{field.ValidationPattern}\"" : "")
                                      rows="4"></textarea>
                            break;

                        case "select":
                            <select class="sg-form__input sg-form__select"
                                    id="field-@field.Name"
                                    name="@field.Name"
                                    @(field.Required ? "required" : "")>
                                <option value="">@(field.Placeholder ?? "Selecciona...")</option>
                                @if (!string.IsNullOrEmpty(field.Options))
                                {
                                    @foreach (var opt in field.Options.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <option value="@opt.Trim()">@opt.Trim()</option>
                                    }
                                }
                            </select>
                            break;

                        case "checkbox":
                            <div class="sg-form__checkbox-group">
                                <input class="sg-form__checkbox"
                                       type="checkbox"
                                       id="field-@field.Name"
                                       name="@field.Name"
                                       value="true"
                                       @(field.Required ? "required" : "") />
                            </div>
                            break;

                        case "radio":
                            @if (!string.IsNullOrEmpty(field.Options))
                            {
                                <div class="sg-form__radio-group">
                                    var idx = 0;
                                    @foreach (var opt in field.Options.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <label class="sg-form__radio-label">
                                            <input class="sg-form__radio"
                                                   type="radio"
                                                   name="@field.Name"
                                                   value="@opt.Trim()"
                                                   id="field-@field.Name-@idx"
                                                   @(field.Required && idx == 0 ? "required" : "") />
                                            @opt.Trim()
                                        </label>
                                        idx++;
                                    }
                                </div>
                            }
                            break;

                        default:
                            <input class="sg-form__input"
                                   type="@field.Type"
                                   id="field-@field.Name"
                                   name="@field.Name"
                                   placeholder="@field.Placeholder"
                                   @(field.Required ? "required" : "")
                                   @Html.Raw(field.ValidationPattern is not null ? $"pattern=\"{field.ValidationPattern}\"" : "") />
                            break;
                    }
                </div>
            }
        </div>

        <div class="sg-form__actions">
            <button type="submit" class="sg-form__submit">
                @form.SubmitLabel
            </button>
        </div>

        <div class="sg-form__feedback" aria-live="polite" hidden></div>
    </form>
</div>
