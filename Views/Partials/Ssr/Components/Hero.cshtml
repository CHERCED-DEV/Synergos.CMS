@using Microsoft.AspNetCore.Mvc.Rendering
@model Synergos.CMS.Application.Elements.HeroElementViewModel
@inject Synergos.CMS.Domain.Services.IDictionaryCache Dict
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var variant = string.IsNullOrEmpty(Model.DomVariant?.Variant) ? "default" : Model.DomVariant!.Variant!;
    var cls     = string.Join(" ", new[] { "sg-hero", Model.BlockClass, $"sg-hero--{variant}", Model.DomClass?.ClassList }
                      .Where(s => !string.IsNullOrWhiteSpace(s)));
    var bgSrc   = Model.Media?.Media?.Src;
    var level   = string.IsNullOrEmpty(Model.Heading?.HeadingLevel) ? "h1" : Model.Heading!.HeadingLevel!;
    var href    = Model.Cta?.CtaLink?.Url;
    var ctaLabel = Model.Cta?.CtaLabel;
    if (string.IsNullOrWhiteSpace(ctaLabel)) ctaLabel = Dict.Get("Common.Actions.LearnMore", culture, "Conocer más");
}
<section class="@cls"
         data-sg-element="comp-hero"
         @Html.Raw(bgSrc is not null ? $"style=\"--hero-bg: url('{bgSrc}')\"" : "")>

    @if (bgSrc is not null)
    {
        <div class="sg-hero__bg" aria-hidden="true">
            <img src="@bgSrc" alt="" role="presentation" loading="eager" />
        </div>
        <div class="sg-hero__overlay" aria-hidden="true"></div>
    }

    <div class="sg-hero__inner">
        <div class="sg-hero__content">
            @if (!string.IsNullOrWhiteSpace(Model.Heading?.HeadingText))
            {
                var htb = new TagBuilder(level);
                htb.AddCssClass("sg-hero__heading");
                htb.InnerHtml.Append(Model.Heading.HeadingText);
                @htb
            }
            @if (!string.IsNullOrWhiteSpace(Model.Text?.Subtitle))
            {
                <p class="sg-hero__text">@Model.Text.Subtitle</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Text?.Body))
            {
                <div class="sg-hero__body">@Html.Raw(Model.Text.Body)</div>
            }
            @if (href is not null)
            {
                <div class="sg-hero__cta">
                    <a class="sg-btn--primary" href="@href">@ctaLabel</a>
                </div>
            }
        </div>
    </div>
</section>
