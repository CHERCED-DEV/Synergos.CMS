@model Synergos.CMS.Application.Elements.KeyValueViewModel
@{
    var cls = string.Join(" ", new[] { Model.BlockClass, Model.DomClass?.ClassList }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
<dl class="@cls" data-sg-element="info-key-value">
    @if (!string.IsNullOrWhiteSpace(Model.Text?.Title))
    {
        <dt class="sg-kv__key">@Model.Text.Title</dt>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Text?.Summary))
    {
        <dd class="sg-kv__value">@Model.Text.Summary</dd>
    }
</dl>
