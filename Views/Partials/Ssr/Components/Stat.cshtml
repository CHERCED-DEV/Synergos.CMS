@model Synergos.CMS.Application.Elements.StatViewModel
@{
    var cls = string.Join(" ", new[] { Model.BlockClass, Model.DomClass?.ClassList, Model.DomVariant?.Variant }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
<div class="@cls" data-sg-element="info-stat">
    @if (!string.IsNullOrWhiteSpace(Model.Text?.Title))
    {
        <strong class="sg-stat__value">@Model.Text.Title</strong>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Text?.Subtitle))
    {
        <span class="sg-stat__label">@Model.Text.Subtitle</span>
    }
</div>
