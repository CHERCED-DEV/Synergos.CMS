@model Synergos.CMS.Application.Elements.PricingCardViewModel
@inject Synergos.CMS.Domain.Services.IDictionaryCache Dict
@{
    var culture  = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var title    = Model.Text?.Title;
    var subtitle = Model.Text?.Subtitle;
    var body     = Model.Text?.Body;
    var badge    = Model.Badge;
    var cta      = Model.Cta;
    var pricing  = Model.Pricing;

    // Prefer compContentPricing.priceAmount; fall back to the legacy Text.Summary
    // channel that pre-10.1.0 pricing cards used. Editors upgrading a card by
    // filling the new Pricing tab should see it win automatically.
    var priceAmount = string.IsNullOrWhiteSpace(pricing?.PriceAmount)
        ? Model.Text?.Summary
        : pricing!.PriceAmount;

    var taxIncludedLabel = Dict.Get("Pricing.TaxIncluded", culture, "IVA incluido");
}

<div class="sg-pricing-card @Model.DomClass?.ClassList @Model.DomVariant?.Variant">
    @if (badge?.BadgeText is not null)
    {
        <span class="sg-pricing-card__badge sg-pricing-card__badge--@badge.BadgeType">@badge.BadgeText</span>
    }
    @if (title is not null)
    {
        <h3 class="sg-pricing-card__title">@title</h3>
    }
    @if (subtitle is not null)
    {
        <p class="sg-pricing-card__subtitle">@subtitle</p>
    }
    @if (!string.IsNullOrWhiteSpace(priceAmount))
    {
        <div class="sg-pricing-card__price">
            @if (!string.IsNullOrWhiteSpace(pricing?.PriceOriginal))
            {
                <span class="sg-pricing-card__price-original"><s>@pricing.PriceOriginal</s></span>
            }
            <span class="sg-pricing-card__price-amount">@priceAmount</span>
            @if (!string.IsNullOrWhiteSpace(pricing?.PriceCurrency))
            {
                <span class="sg-pricing-card__price-currency">@pricing.PriceCurrency</span>
            }
            @if (!string.IsNullOrWhiteSpace(pricing?.PricePeriod))
            {
                <span class="sg-pricing-card__price-period">/ @pricing.PricePeriod</span>
            }
            @if (!string.IsNullOrWhiteSpace(pricing?.PriceSuffix))
            {
                <span class="sg-pricing-card__price-suffix">@pricing.PriceSuffix</span>
            }
        </div>
        @if (pricing?.PriceTaxIncluded == true)
        {
            <span class="sg-pricing-card__tax-flag">@taxIncludedLabel</span>
        }
    }
    @if (body is not null)
    {
        <div class="sg-pricing-card__body">@Html.Raw(body)</div>
    }
    @if (cta?.CtaLabel is not null)
    {
        <a class="sg-pricing-card__cta" href="@cta.CtaLink?.Url"
           target="@(cta.CtaTarget ?? cta.CtaLink?.Target ?? "_self")"
           @Html.Raw(cta.CtaAriaLabel is not null ? $"aria-label=\"{cta.CtaAriaLabel}\"" : "")>
            @cta.CtaLabel
        </a>
    }
</div>
