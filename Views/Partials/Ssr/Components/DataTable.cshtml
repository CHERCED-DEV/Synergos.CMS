@model Synergos.CMS.Application.Elements.DataTableViewModel
@* Data table — section header from Collection; table markup authored as rich text in Text.Body. *@
@{
    var blockCls    = Model.DomClass?.CssClass is { } c ? " " + c : "";
    var variantAttr = Model.DomVariant?.VariantName is { } v
        ? Html.Raw($"data-sg-variant=\"{v}\"")
        : Html.Raw("");
}
<div class="sg-data-table @(Model.BlockClass)@blockCls" data-sg-element="corp-data-table" @variantAttr>
    @if (Model.Collection?.CollectionTitle is not null)
    {
        <div class="sg-data-table__header">
            <h2 class="sg-data-table__heading">@Model.Collection.CollectionTitle</h2>
            @if (Model.Collection.CollectionDescription is not null)
            {
                <p class="sg-data-table__subheading">@Model.Collection.CollectionDescription</p>
            }
        </div>
    }
    @if (Model.Text?.Title is not null && Model.Collection?.CollectionTitle is null)
    {
        <h3 class="sg-data-table__caption">@Model.Text.Title</h3>
    }
    @if (Model.Text?.Body is not null)
    {
        <div class="sg-data-table__wrapper">
            @Html.Raw(Model.Text.Body)
        </div>
    }
</div>
