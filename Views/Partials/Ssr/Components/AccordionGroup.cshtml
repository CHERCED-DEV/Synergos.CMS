@model Synergos.CMS.Application.Elements.AccordionGroupViewModel
@using System.Text.Json
@using System.Text.Json.Serialization
@using Synergos.CMS.Application.Cdn.Configs
@inject Synergos.CMS.Application.Rendering.IElementUrlResolver ElementUrl
@inject Synergos.CMS.Domain.Services.IEmittedBundleTracker Bundles
@inject Synergos.CMS.Domain.Services.IDictionaryCache Dict
@*
   Accordion Group container — emite UN solo <script type="module"> para el
   web component `synergos-accordion-group` que gestiona el toggle de
   todos los paneles internamente.
*@
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var variant = Model.DomVariant?.Variant;

    // FaqItem: Title = question, Body = answer. Initial-open state is driven
    // entirely by the web component from the first item (MVP: no per-item flag).
    var items = Model.Items.Select(item => new AccordionGroupItemCdnConfig(
        Question: item.Text?.Title,
        Answer:   item.Text?.Body
    )).ToList();

    var opt = new JsonSerializerOptions { DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull, PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var cfg = JsonSerializer.Serialize(new AccordionGroupCdnConfig(
        Title:        Model.Text?.Title,
        Subtitle:     Model.Text?.Subtitle,
        Variant:      variant,
        Items:        items,
        Translations: Dict.GetAll()
    ), opt);

    var cls = string.Join(" ", new[] { "sg-cdn", "sg-cdn--accordion-group",
        !string.IsNullOrEmpty(variant) ? $"sg-accordion-group--{variant}" : null,
        Model.DomClass?.ClassList
    }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
@if (Bundles.TryClaim("accordion-group")) { <script src="@ElementUrl.ResolveBundle("accordion-group")" type="module" defer></script> }
<synergos-accordion-group config='@cfg' class="@cls" data-sg-element="comp-accordion-group"></synergos-accordion-group>
