@* Fallback — shown when no template is registered for this element alias.
   Debug info is rendered only in Development; Production emits nothing. *@
@model Synergos.CMS.Application.Components.BaseComponentViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _env
@if (_env.IsDevelopment())
{
    <div class="sg-debug-unknown" style="border:2px dashed #f0a;padding:8px;font-family:monospace;font-size:12px;"
         data-sg-alias="@Model?.Alias" data-sg-block-class="@Model?.BlockClass">
        <strong>[sg] Unknown element:</strong> @Model?.Alias
    </div>
}
