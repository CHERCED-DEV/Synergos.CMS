@model Synergos.CMS.Application.Elements.FeatureViewModel
@{
    var cls  = string.Join(" ", new[] { "sg-feature", Model.BlockClass, Model.DomClass?.ClassList, Model.DomVariant?.Variant }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var src  = Model.Media?.Media?.Src;
    var href = Model.Cta?.CtaLink?.Url;
}
<div class="@cls" data-sg-element="info-feature">
    @if (src is not null)
    {
        <div class="sg-feature__icon">
            <img src="@src" alt="@(Model.Media?.AltText ?? "")" loading="lazy" />
        </div>
    }
    <div class="sg-feature__body">
        @if (!string.IsNullOrWhiteSpace(Model.Text?.Title))
        {
            <h3 class="sg-feature__title">@Model.Text.Title</h3>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Text?.Body))
        {
            <p class="sg-feature__text">@Html.Raw(Model.Text.Body)</p>
        }
        @if (href is not null)
        {
            <a href="@href" class="sg-feature__cta">@(Model.Cta?.CtaLabel ?? "Learn more")</a>
        }
    </div>
</div>
