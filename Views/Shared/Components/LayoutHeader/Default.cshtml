@model Synergos.CMS.Presentation.ViewModels.Layout.LayoutHeaderViewModel
@inject Synergos.CMS.Domain.Services.IDictionaryCache Dict
@{
    var headerStyle      = string.IsNullOrWhiteSpace(Model.Theme.HeaderBackground)
        ? null
        : $"background:{Model.Theme.HeaderBackground};";
    var mainNavLabel     = Dict.Get("Nav.MainNavLabel",    fallback: "Main navigation");
    var langLabel        = Dict.Get("Nav.LanguageSelector",fallback: "Language selector");
    var openMenuLabel    = Dict.Get("Nav.OpenMenu",        fallback: "Open menu");
    var mobileNavLabel   = Dict.Get("Nav.MobileNavLabel",  fallback: "Mobile navigation");
    var closeMenuLabel   = Dict.Get("Nav.CloseMenu",       fallback: "Close menu");
}

<header class="layout-header" style="@headerStyle">
    <div class="layout-header__inner">

        @* ── Brand ── *@
        <a class="layout-header__brand" href="@Model.Brand.HomeUrl">
            @if (!string.IsNullOrWhiteSpace(Model.Brand.LogoUrl))
            {
                <span class="layout-header__logo-wrap" aria-hidden="true">
                    <img class="layout-header__logo" src="@Model.Brand.LogoUrl" alt="" />
                </span>
            }
            <span class="layout-header__brand-copy">
                @if (!string.IsNullOrWhiteSpace(Model.Brand.SiteName))
                {
                    <strong class="layout-header__name">@Model.Brand.SiteName</strong>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Brand.SiteTagline))
                {
                    <span class="layout-header__tagline">@Model.Brand.SiteTagline</span>
                }
            </span>
        </a>

        @* ── Desktop navigation ── *@
        <nav class="layout-header__nav" aria-label="@mainNavLabel">
            @if (Model.NavigationItems.Count > 0)
            {
                <ul class="layout-nav layout-nav--header">
                    @foreach (var item in Model.NavigationItems)
                    {
                        @await Html.PartialAsync("~/Views/Shared/Components/LayoutShared/_NavigationItem.cshtml", item)
                    }
                </ul>
            }
        </nav>

        @* ── Header CTA (desktop only — shown via CSS @media) ── *@
        @if (!string.IsNullOrWhiteSpace(Model.CtaUrl) && !string.IsNullOrWhiteSpace(Model.CtaLabel))
        {
            <div class="layout-header__cta">
                <a class="sg-btn sg-btn--primary sg-btn--sm" href="@Model.CtaUrl">@Model.CtaLabel</a>
            </div>
        }

        @* ── Culture switcher ── *@
        @if (Model.CultureOptions.Count > 1)
        {
            <nav class="layout-header__cultures" aria-label="@langLabel">
                @foreach (var cult in Model.CultureOptions)
                {
                    if (cult.IsCurrent)
                    {
                        <span class="culture-switch culture-switch--active" aria-current="true">@cult.Label</span>
                    }
                    else
                    {
                        <a class="culture-switch" href="@cult.SwitchUrl" hreflang="@cult.IsoCode">@cult.Label</a>
                    }
                }
            </nav>
        }

        @* ── Mobile hamburger ── *@
        <button class="layout-header__toggle" id="nav-toggle"
                aria-expanded="false"
                aria-controls="mobile-nav"
                aria-label="@openMenuLabel"
                type="button">
            <span class="hamburger-icon" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </span>
        </button>

    </div>
</header>

@* ── Mobile navigation drawer ── *@
<nav class="mobile-nav" id="mobile-nav" aria-label="@mobileNavLabel" aria-hidden="true">
    <div class="mobile-nav__header">
        <a class="mobile-nav__header-brand" href="@Model.Brand.HomeUrl">
            @if (!string.IsNullOrWhiteSpace(Model.Brand.LogoUrl))
            {
                <span class="mobile-nav__logo-wrap" aria-hidden="true">
                    <img class="mobile-nav__logo" src="@Model.Brand.LogoUrl" alt="" height="28" />
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Brand.SiteName))
            {
                <strong>@Model.Brand.SiteName</strong>
            }
            else if (string.IsNullOrWhiteSpace(Model.Brand.LogoUrl))
            {
                <text>@openMenuLabel</text>
            }
        </a>
        <button class="mobile-nav__close" id="mobile-nav-close"
                aria-label="@closeMenuLabel" type="button">&#x2715;</button>
    </div>

    <div class="mobile-nav__nav">
        @if (Model.NavigationItems.Count > 0)
        {
            <ul class="mobile-nav__list">
                @foreach (var item in Model.NavigationItems)
                {
                    <li>
                        <a class="mobile-nav__link"
                           href="@item.Url"
                           @(item.IsActive ? "aria-current=\"page\"" : "")>@item.Title</a>
                        @if (item.Children.Count > 0)
                        {
                            <ul class="mobile-nav__sublist">
                                @foreach (var child in item.Children)
                                {
                                    <li>
                                        <a class="mobile-nav__link"
                                           href="@child.Url"
                                           @(child.IsActive ? "aria-current=\"page\"" : "")>@child.Title</a>
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        }
    </div>

    <div class="mobile-nav__footer">
        @if (!string.IsNullOrWhiteSpace(Model.CtaUrl) && !string.IsNullOrWhiteSpace(Model.CtaLabel))
        {
            <a class="sg-btn sg-btn--primary" href="@Model.CtaUrl" style="width:100%;">@Model.CtaLabel</a>
        }
        else if (!string.IsNullOrWhiteSpace(Model.Brand.SiteName))
        {
            <p>@Model.Brand.SiteName</p>
        }
    </div>
</nav>
