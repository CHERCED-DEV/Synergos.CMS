@model IReadOnlyList<Synergos.CMS.Presentation.ViewModels.Layout.LayoutNavigationItemViewModel>
@inject Synergos.CMS.Domain.Services.IDictionaryCache Dict

@if (Model.Count > 1)
{
    var ariaLabel = Dict.Get("Nav.Breadcrumb", fallback: "Breadcrumb");
    <nav class="sg-breadcrumbs" aria-label="@ariaLabel">
        <ol class="sg-breadcrumbs__list" itemscope itemtype="https://schema.org/BreadcrumbList">
            @for (var i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                var isLast = i == Model.Count - 1;
                <li class="sg-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    @if (isLast)
                    {
                        <span class="sg-breadcrumbs__current" itemprop="name" aria-current="page">@item.Title</span>
                    }
                    else
                    {
                        <a class="sg-breadcrumbs__link" href="@item.Url" itemprop="item">
                            <span itemprop="name">@item.Title</span>
                        </a>
                    }
                    <meta itemprop="position" content="@(i + 1)" />
                </li>
            }
        </ol>
    </nav>
}
