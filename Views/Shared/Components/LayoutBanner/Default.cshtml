@using Umbraco.Cms.Core.Models.PublishedContent
@inject Umbraco.Cms.Web.Common.UmbracoHelper Umbraco
@model Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent
@{
    var blockGrid = Model.Value<BlockGridModel>("blockContent");
}
@if (blockGrid is not null && blockGrid.Any())
{
    <div class="layout-banner">
        @await Umbraco.RenderBlockGridAsync(blockGrid)
    </div>
}
