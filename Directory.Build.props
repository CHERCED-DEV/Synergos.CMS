<Project>

  <!--
    MSBuild properties shared by every project in the Synergos.CMS solution.
    Changes here apply to all .csproj files unless explicitly overridden.
    Governance: modifications require an ADR entry under Synergos.CMS/docs/adr/.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      El build sale en CERO avisos desde el #134, así que tratarlos como errores es GRATIS
      hoy — y es el único trinquete que nadie puede olvidar de correr. Un contador de avisos
      contra una línea base sería el trinquete equivocado acá: se pondría rojo el día que
      alguien añade un fichero legítimo y verde sobre todo lo que ya estaba, que es
      «distinguir al revés que el defecto».

      El precio va dicho y no escondido: `global.json` pide 10.0.202 con
      `rollForward: latestFeature`, así que un SDK más nuevo con analizadores nuevos puede
      poner el build rojo en una máquina y no en otra. La salida es la de siempre en este
      fichero — entrar a `NoWarn` CON SU RAZÓN AL LADO, como 1591, 1573 y NU1902 — y es
      preferible a que el aviso entre sin que nadie lo vea, que es lo que costó 643.

      `WarningsAsErrors` se queda para que la lista de los cuatro nullability siga escrita:
      son los que NO se negocian aunque alguien apague la bandera de arriba para depurar.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>CS8600;CS8602;CS8603;CS8618</WarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      NoWarn:
        1591   missing XML doc comment (acepta sin docs en types públicos)
        1573   <param> ausente para algún parámetro de un miembro YA documentado.
               Es la misma decisión que 1591 un escalón abajo, y en un repo de
               `record` posicionales es la que decide si la documentación se lee
               o no: acá un DTO se explica en su <summary>/<remarks> —POR QUÉ
               existe el campo, qué defecto cierra— y 1573 exige además una línea
               por cada parámetro, incluida la que sólo puede decir «el id».
               Medido al arreglar el #110 de PropertyDraft: documentar UN campo
               subió la cifra de 287 a 308, porque documentar uno los exige todos.
               Trescientas líneas de ruido alrededor de la que sí dice algo es
               cómo se deja de leer la que sí dice algo. Lo que NO se acepta es
               documentación que el compilador DESCARTA —CS1587 y CS1734 siguen
               siendo errores por TreatWarningsAsErrors—, que es el defecto de
               verdad de esta familia: en el #134 había cuatro sitios con
               `///` sobre un parámetro posicional, y el compilador los tiraba.
        NU1902 Umbraco.Cms 13.13.1 vulnerabilidad moderate conocida, aceptada en
               ADR 0001 (memoria project_umbraco_version_pin). Sin patch en
               branch 13.x; upgrade a 14+ requiere ADR nuevo.
    -->
    <NoWarn>$(NoWarn);1591;1573;NU1902</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <NeutralLanguage>en</NeutralLanguage>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

</Project>
