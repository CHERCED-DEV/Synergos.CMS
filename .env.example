# Lo que `compose.prod.yml` necesita del entorno.
#
# Se copia a `.env` EN EL SERVIDOR y se rellena. Este fichero es la plantilla:
# nombres y explicaciones, cero valores.
#
# ─────────────────────────────────────────────────────────────────────────────
# NINGÚN SECRETO ENTRA AL REPO. NI UNO.
#
# Y si alguno se pega por error en un commit, en un issue o en un chat: SE
# ROTA, no se borra el mensaje. Un secreto que se vio una vez está quemado —
# borrar el rastro solo hace que nadie sepa que hay que cambiarlo.
# ─────────────────────────────────────────────────────────────────────────────

# ── De dónde salen las imágenes ──────────────────────────────────────────────

SYNERGOS_REGISTRY=ghcr.io/cherced-dev

# El SHA del commit que se despliega. NUNCA `latest`.
#
# Con `latest` no se puede saber qué está corriendo ni volver atrás — y la
# vuelta atrás del despliegue depende justo de poder nombrar la imagen
# anterior. Lo pone el action; a mano solo para desplegar algo concreto.
SYNERGOS_TAG=

# ── El dominio ───────────────────────────────────────────────────────────────

# Sin `https://` y sin barra final: `synergos.co`. Caddy le saca el
# certificado solo, y el compose construye las URLs absolutas a partir de esto.
SYNERGOS_DOMAIN=

# ── Los secretos ─────────────────────────────────────────────────────────────

# La llave compartida entre servicios. Una sola para las 22.
#
#   openssl rand -hex 32
#
# ⚠️ Sirve servicio↔servicio y NO es identidad: no contesta "quién es este
# usuario" (CLAUDE.md §11). Por eso ninguna capacidad se publica a internet.
SYNERGOS_API_KEY=

# Firma de la cookie del carrito. Cualquier cadena larga y propia; el default
# dispara un log Critical en boot fuera de Development (ADR 0028).
SYNERGOS_CART_SECRET=

# ── El CDN (ADR 0132) ────────────────────────────────────────────────────────

# `Stub` (default) · `FileSystem` · `Http`.
#
# Sin esto en `Http`, los 71 elementSyn* emiten un comentario HTML de relleno:
# degradado y VISIBLE, que es mejor que un sitio roto.
SYNERGOS_CDN_MODE=Stub

# La URL del CDN publicado, sin barra final. Solo se usa con Mode=Http.
#
# El CDN YA ESTÁ VIVO: https://synergos-ui.synergos-labs.workers.dev
# (verificado 2026-08-04: registry con 139 elementos, semver immutable 1 año,
# CORS abierto bajo /synergos/). No es secreto — va acá como valor conocido
# para que montar el servidor no exija averiguarlo. Cuando exista dominio
# propio para el CDN, se cambia acá y en Cloudflare, no en el código.
SYNERGOS_CDN_URL=

# ── La tienda: contra quién compra (HU #24) ──────────────────────────────────

# `Stub` (default) · `Bff`.
#
# Con `Stub` el CMS vende con su motor en proceso: un clon limpio arranca y
# funciona sin levantar seis servicios, y por eso el default no se mueve.
#
# Con `Bff` compra de verdad contra Synergos.Bff.Tienda, que reserva, cobra y
# crea el pedido — y lo DESHACE si algo falla a la mitad. Encenderlo sin el
# orquestador arriba degrada: no se puede comprar y lo dice, pero el catálogo y
# las fichas siguen sirviendo.
SYNERGOS_TIENDA_MODE=Stub

# Las DIRECCIONES no van acá: dentro de la red del compose son fijas y las
# pone `compose.prod.yml` por nombre de servicio. Hacerlas configurables solo
# invitaría a que alguien ponga localhost, que dentro del contenedor es el
# propio CMS. Y la llave es SYNERGOS_API_KEY, la misma de las 22.

# La transportadora con la que se despacha. Va acá y no en el checkout porque
# es una decisión del COMERCIO: quien compra elige a dónde le llega, no con qué
# empresa se despacha.
SYNERGOS_TIENDA_CARRIER=default

# ── Salud: contra quién agenda la cita (HU #25) ──────────────────────────────

# `Stub` (default) · `Bff`. Con `Bff` la cita reserva cupo de verdad contra
# Synergos.Bff.Salud, que ya ordena consentimiento → cupo → copago y compensa.
SYNERGOS_SALUD_MODE=Stub

# OJO, paso de DESPLIEGUE que no es código: cada médico necesita su recurso
# registrado en Api.Booking (POST /v1/resources con subjectKind=salud.profesional
# y subjectId = el id del médico). Sin él, agendar se rechaza con el motivo de la
# capacidad. El BFF resuelve el recurso desde el profesional, así que el CMS NO
# necesita conocer el identificador interno que Api.Booking genera.

# ── Propiedades: contra quién se aparta la visita (HU #33a) ──────────────────

# `Stub` (default) · `Api`.
#
# ⚠️ Acá dice `Api` y no `Bff`, y no es un descuido: agendar una visita toca UNA
# sola capacidad. Una visita NO SE COBRA —el motor viejo la confirmaba con una
# sesión de pago de mentira, `visit-free`— así que no hay orden que respetar ni
# nada que deshacer si un segundo paso falla. Meter un orquestador en medio sería
# una saga de un paso: la máquina de compensar sin nada que compensar.
#
# Con `Api` el cupo lo lleva Synergos.Api.Booking. Qué franjas EXISTEN lo sigue
# derivando el CMS —la agenda del agente es una decisión del negocio, no del
# cupo—; si una franja sigue LIBRE lo dice la capacidad. Encenderlo sin ella
# arriba degrada: la ficha del inmueble se ve y la agenda se ofrece; lo que falla
# es agendar, y lo dice con su motivo.
SYNERGOS_REALTY_MODE=Stub

# OJO, paso de DESPLIEGUE que no es código: cada inmueble que acepte visitas
# necesita su recurso registrado en Api.Booking (POST /v1/resources con
# subjectKind=realty.listado y subjectId = el id del listado). Sin él, la agenda
# se ve pero agendar se rechaza — y queda GRITADO en el log, porque de otro modo
# nadie relaciona las dos cosas.

# ── La llave que FIRMA los tokens de identidad (HU #14) ──────────────────────

# ⚠️ NO es SYNERGOS_API_KEY, y mezclarlas seria grave: la llave compartida dice
# «este proceso es de los nuestros» y la tienen los 22 servicios. Si con ella se
# pudieran firmar identidades, cualquiera de los 22 fabricaria personas.
#
# El `kid` va en el token desde el primer dia aunque haya UNA sola llave: rotar
# sin el obliga a invalidar todos los tokens a la vez, y anadirlo despues es el
# mismo trabajo con los tokens ya emitidos en contra. Para rotar: se anade una
# llave nueva al mapa y se mueve ACTIVE; la vieja sigue verificando hasta que
# venza el ultimo token que firmo.
#
# La MISMA llave la reciben las capacidades que verifican (hoy Api.Messaging), y
# es simetrica a proposito: verifican en local, sin llamar a Api.Identity. Hacerlo
# al reves —preguntarle en cada peticion— la convertiria en el punto unico de
# fallo de las veinte, y es la peor candidata porque corre sobre fichero JSON con
# lock de proceso. Asi, Api.Identity caida significa «no entran sesiones nuevas»,
# no «se para todo».
#
# Si se deja vacia: Api.Identity NO ARRANCA (falla al cablear, no en la primera
# peticion: un despliegue mal configurado tiene que morir antes de parecer sano).
# Quien solo verifica SI arranca —es el camino del clon limpio— pero sin poder
# verificar, y un token presentado ahi se RECHAZA con identity.token_not_verifiable
# en vez de ignorarse.
SYNERGOS_IDENTITY_SIGNING_KEY=
SYNERGOS_IDENTITY_ACTIVE_KID=k1

# Vigencia de un token y techo de la sesion, en minutos. Los dos juntos son la
# decision, no cada uno por su lado: 15 minutos solos serian un adorno si la
# renovacion no tuviera techo —un token robado se renovaria para siempre, de a
# quince minutos— y un techo solo dejaria un token robado operando ocho horas.
#
# Y el precio de los 15 minutos esta pagado a conciencia: los roles viajan
# DENTRO del token para que una capacidad pueda verificar sin llamar a nadie,
# asi que revocar un rol tarda lo que quede de vigencia. Ese es el costo de no
# convertir a Api.Identity en el punto unico de fallo de las veinte.
SYNERGOS_IDENTITY_TOKEN_MINUTES=15
SYNERGOS_IDENTITY_SESSION_MINUTES=480

# ── Contra qué se reserva un hotel (HU #36) ──────────────────────────────────

# `Stub` (default) → el motor de reservas en proceso.
# `Bff`            → contra Synergos.Bff.Viajes.
#
# Dice `Bff` porque apartar, cobrar y confirmar pueden fallar a la mitad: si el
# cobro no sale hay que soltar el cupo, y si la confirmacion falla despues de
# capturar hay que devolver la plata. Verificado con los procesos vivos: matando
# Api.Payments a mitad del cobro, la habitacion vuelve al inventario sola.
#
# SOLO la via hotel. El carrito multi-producto sigue en el motor en proceso, y
# no por falta de ganas: TravelCartItem no lleva fechas —ni el seam, ni el DTO
# HTTP— y un apartado de Api.Booking ES una ventana sobre un recurso. Cablearlo
# exigiria inventarselas.
SYNERGOS_VIAJES_MODE=Stub

# OJO, dos pasos de DESPLIEGUE que no son codigo. Cada tipo/tarifa que se venda
# necesita:
#   1. su precio en Api.Pricing (POST /v1/prices con subjectKind=viajes.tarifa
#      y subjectId = "{tipoHabitacion}/{tarifa}"), porque el precio NO lo pone
#      el buscador — si lo pusiera, cualquiera reservaria la suite al precio de
#      la estandar;
#   2. su recurso en Api.Booking (POST /v1/resources con
#      subjectKind=viajes.producto, el mismo subjectId, y capacity = cuantas
#      habitaciones de ese tipo hay). Horario VACIO = siempre abierto, que es lo
#      correcto para una noche de hotel: cruza la medianoche.
# Sin cualquiera de los dos, apartar se rechaza con el motivo puesto.

# ── Con qué se compran las entradas (HU #35) ─────────────────────────────────

# `Stub` (default) → el motor de eventos en proceso. Un clon limpio vende
# entradas sin levantar cuatro servicios.
# `Bff`            → contra Synergos.Bff.Eventos.
#
# Acá SÍ dice `Bff` y no `Api`, al revés que la visita al inmueble de arriba: la
# pregunta no es cuántas capacidades toca, es si hay algo que DESHACER cuando el
# segundo paso falla. Una visita no se cobra; una entrada sí. Si el cobro falla
# hay que soltar el aforo apartado, y si el consumo falla después de capturar hay
# que devolver la plata — y el CMS no tiene dónde anotar una compensación
# pendiente. Se verificó con los procesos vivos: matando Api.Payments a mitad de
# la confirmación, el aforo volvió al pozo solo.
#
# Lo que NO cambia al encenderlo es el ARTEFACTO. La entrada, su QR, su portador
# y el check-in se quedan en el CMS, porque el firmante vive de este lado. Con el
# orquestador caído se sigue pudiendo ver «mis entradas», transferir y escanear
# en la puerta: lo único que falla es comprar, y lo dice con su motivo.
SYNERGOS_EVENTOS_MODE=Stub

# ── Con qué se cobra (HU #27) ────────────────────────────────────────────────

# (vacío) o `logging` → LoggingPaymentProvider: dice que sí a todo y lo GRITA en
# cada operación. Es el default de desarrollo, para que un clon limpio corra el
# flujo de compra sin cuenta de pasarela.
#
# Cualquier otro nombre → se cobra de verdad con ESE. Y si le falta la
# credencial, Api.Payments arranca igual pero RECHAZA cada cobro a gritos
# (`transport_not_configured`), como hace Api.Notifications sin su llave.
#
# Lo que NO existe es la tercera opción: nombre puesto y stub sirviendo en
# silencio. El CMS ya tuvo ese defecto —`Provider=Wompi` servía el stub— y costó
# una investigación. Hay gate.
PAYMENTS_PROVIDER=logging

# La credencial del proveedor elegido.
# NINGÚN SECRETO ENTRA AL REPO. Y si se filtra uno: SE ROTA.
#
# ⚠️ Falta el adaptador real. Hoy, poner un nombre aquí hace que la capacidad
# rechace a gritos —que es lo correcto— pero todavía no cobra: la cuenta
# comercial y el adaptador son trabajo pendiente del ticket #27.
PAYMENTS_WOMPI_API_KEY=

# ── A quién se le avisa cuando una compensación se rinde ─────────────────────
#
# Tras ocho intentos, el motor de sagas deja de reintentar y AVISA. Sin esto, la
# compensación colgada queda visible en `/v1/compensations` con `alertedAtUtc`
# en nulo y un error en el log — degrada, no rompe, pero nadie se entera.
#
# La plantilla (`bff.compensacion.colgada`) hay que autorarla en
# Api.Notifications usando SOLO los marcadores {saga}, {origen}, {desde} y
# {pendientes}.
SYNERGOS_ALERTS_TO_KIND=
SYNERGOS_ALERTS_TO_ID=
SYNERGOS_ALERTS_ADDRESS=

# ── Dónde se guardan las copias (HU #31) ─────────────────────────────────────
#
# `tools/respaldo.sh` escribe acá; por defecto /var/backups/synergos.
#
# ⚠️ DEJARLAS EN EL SERVIDOR NO ES UN RESPALDO. Protege de un borrado a mano,
# no de perder la máquina — que es el caso que duele. Llevárselas fuera (un
# bucket, otra máquina, snapshots del proveedor) es un paso aparte y sin él la
# copia muere con el disco que venía a proteger.
#
# ⚠️ LLEVAN DATOS PERSONALES: direcciones de entrega, nombres de pacientes.
# Dónde viven y por cuánto tiempo es una decisión de privacidad, no de
# infraestructura, y no la toma este fichero.
SYNERGOS_BACKUP_DIR=/var/backups/synergos

# ── El barrido de las sagas (HU #29) ─────────────────────────────────────────
#
# Cada cuánto barre el motor de sagas, en segundos. Piso de 5: en cero sería un
# lazo cerrado martillando las capacidades.
SYNERGOS_SWEEP_INTERVAL_SECONDS=60

# A los cuántos MINUTOS una saga que empezó y nunca confirmó se da por muerta y
# se deshace lo que había hecho. CERO LO APAGA.
#
# ⚠️ Es un compromiso de negocio disfrazado de constante. Muy corto cancela
# compras que iban bien —un pago que tardó—; muy largo deja plata reservada en
# la tarjeta de alguien. El default de 60 min es generoso a propósito.
#
# Y no es lo que devuelve el stock: los apartados de Api.Inventory vencen solos
# a los 15 minutos por su propio TTL, mucho antes. Lo que esto rescata es lo que
# NO vence solo — la autorización del cobro.
SYNERGOS_ABANDON_AFTER_MINUTES=60

# ── El barrido de los avisos colgados (HU #29) ───────────────────────────────
#
# Cuántas veces se reintenta un aviso que quedó en `Queued` antes de darlo por
# perdido. CERO LO APAGA — y apagado no pregunta siquiera, no gasta peticiones.
#
# Al llegar al techo el envío pasa a `GivenUp` con la última causa escrita. No
# es lo mismo que rendirse en silencio: un `Queued` eterno se lee como «va en
# camino», y ésa es la forma cara de no enterarse de que el correo no sale.
#
# El default es el MISMO que el techo de las compensaciones, a propósito: son la
# misma clase de decisión —cuánto insistir contra un tercero que no contesta— y
# dos números distintos obligarían a explicar por qué.
#
# Lo levantan TODOS los orquestadores, no uno elegido a dedo: elegir uno
# obligaría a nombrarlo («el de la tienda barre los avisos de salud») y el día
# que ese host esté caído nadie barrería. Que dos coincidan sobre el mismo envío
# no manda dos correos — la capacidad rechaza el reintento simultáneo.
SYNERGOS_DELIVERY_RETRY_CEILING=8

# ── El correo (ADR 0131) ─────────────────────────────────────────────────────
#
# Sin esto, `Api.Notifications` arranca igual pero RECHAZA cada envío con
# `transport_not_configured` y lo grita en el log. Un despliegue sin
# configurar no puede parecer uno que funciona.
#
# Se sacan en resend.com tras verificar el dominio. El webhook se registra
# apuntando a https://<SYNERGOS_DOMAIN>/v1/webhooks/resend
Notifications__Resend__ApiKey=
Notifications__Resend__From=
Notifications__Resend__WebhookSecret=
