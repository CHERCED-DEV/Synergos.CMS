# Lo que `compose.prod.yml` necesita del entorno.
#
# Se copia a `.env` EN EL SERVIDOR y se rellena. Este fichero es la plantilla:
# nombres y explicaciones, cero valores.
#
# ─────────────────────────────────────────────────────────────────────────────
# NINGÚN SECRETO ENTRA AL REPO. NI UNO.
#
# Y si alguno se pega por error en un commit, en un issue o en un chat: SE
# ROTA, no se borra el mensaje. Un secreto que se vio una vez está quemado —
# borrar el rastro solo hace que nadie sepa que hay que cambiarlo.
# ─────────────────────────────────────────────────────────────────────────────

# ── De dónde salen las imágenes ──────────────────────────────────────────────

SYNERGOS_REGISTRY=ghcr.io/cherced-dev

# El SHA del commit que se despliega. NUNCA `latest`.
#
# Con `latest` no se puede saber qué está corriendo ni volver atrás — y la
# vuelta atrás del despliegue depende justo de poder nombrar la imagen
# anterior. Lo pone el action; a mano solo para desplegar algo concreto.
SYNERGOS_TAG=

# ── El dominio ───────────────────────────────────────────────────────────────

# Sin `https://` y sin barra final: `synergos.co`. Caddy le saca el
# certificado solo, y el compose construye las URLs absolutas a partir de esto.
SYNERGOS_DOMAIN=

# ── Los secretos ─────────────────────────────────────────────────────────────

# La llave compartida entre servicios. Una sola para las 22.
#
#   openssl rand -hex 32
#
# ⚠️ Sirve servicio↔servicio y NO es identidad: no contesta "quién es este
# usuario" (CLAUDE.md §11). Por eso ninguna capacidad se publica a internet.
SYNERGOS_API_KEY=

# Firma de la cookie del carrito. Cualquier cadena larga y propia; el default
# dispara un log Critical en boot fuera de Development (ADR 0028).
SYNERGOS_CART_SECRET=

# ── El CDN, cuando esté publicado (ADR 0132) ─────────────────────────────────

# `Stub` (default) · `FileSystem` · `Http`.
#
# Sin esto en `Http`, los 71 elementSyn* emiten un comentario HTML de relleno:
# degradado y VISIBLE, que es mejor que un sitio roto.
SYNERGOS_CDN_MODE=Stub

# La URL del CDN publicado, sin barra final. Solo se usa con Mode=Http.
SYNERGOS_CDN_URL=

# ── El correo (ADR 0131) ─────────────────────────────────────────────────────
#
# Sin esto, `Api.Notifications` arranca igual pero RECHAZA cada envío con
# `transport_not_configured` y lo grita en el log. Un despliegue sin
# configurar no puede parecer uno que funciona.
#
# Se sacan en resend.com tras verificar el dominio. El webhook se registra
# apuntando a https://<SYNERGOS_DOMAIN>/v1/webhooks/resend
Notifications__Resend__ApiKey=
Notifications__Resend__From=
Notifications__Resend__WebhookSecret=
