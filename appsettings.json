{
  "$schema": "appsettings-schema.json",
  "AllowedHosts": "synergos.local;*.synergos.local;localhost",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "2d17f837-b7c8-494f-8e11-69a213b21feb",
        "SanitizeTinyMce": true,
        "DefaultUILanguage": "es",
        "HideTopLevelNodeFromPath": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        },
        "Notifications": {
          "DisableHtmlEmail": false
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "KeepAlive": {
        "DisableKeepAliveTask": false
      },
      "WebRouting": {
        "TryMatchingEndpointsForAllPages": false,
        "DisableAlternativeTemplates": false,
        "DisableFindContentByIdPath": true
      }
    }
  },
  "Synergos": {
    "Runtime": {
      "WebHost": "synergos.local",
      "HttpPort": 5000,
      "HttpsPort": 5001,
      "AllowedOrigins": [
        "https://static.synergos.local"
      ]
    },
    "StaticAssets": {
      "Origin": "https://static.synergos.local",
      "UiBasePath": "/synergos",
      "UiFramework": "angular",
      "UiSlot": "latest",
      "RegistryLocalPath": "C:\\LOCAL_CDN",
      "RegistryManifest": "/synergos/registry.json",
      "ClientHosted": [
        "elementCompHero"
      ]
    },
    "ElementServers": {
      "Overrides": {}
    },
    "FlowEngine": {
      "WebhookSecret": "synergos-flow-engine-dev-secret",
      "WebhookTimeoutMs": 10000
    },
    "Security": {
      "ApiKey": ""
    },
    "Seed": {
      "PlatformName": "Synergos Platform",
      "SiteName": "Synergos",
      "SiteTagline": "Plataforma empresarial composable",
      "SiteDisplayName": "Synergos",
      "SiteTaglineExt": "Transformación digital para empresas",
      "ContactEmail": "contact@example.com",
      "ContactPhone": "+1 (555) 000-0000",
      "ContactAddress": "City, Country",
      "FacebookUrl": "https://www.facebook.com/yourpage",
      "LinkedInUrl": "https://www.linkedin.com/company/yourcompany",
      "TwitterUrl": "https://twitter.com/yourhandle",
      "YouTubeUrl": "https://www.youtube.com/@yourchannel",
      "SeoTitleSuffix": " | Synergos",
      "SeoDefaultDescription": "Plataforma empresarial composable para acelerar tu transformación digital.",
      "GlobalSeoDescription": "Soluciones digitales para transformar tu empresa. Consultoría, desarrollo y plataforma CMS empresarial.",
      "FormRecipientEmail": "contact@example.com",
      "HeaderCtaLabel": "Contáctanos"
    },
    "Cache": {
      "DictionaryMinutes": 10,
      "DictionaryMissMinutes": 1
    }
  },
  "uSync": {
    "Settings": {
      "ImportOnStartup": false,
      "ExportOnSave": false,
      "ReportDebug": false,
      "IgnoreBrokenDependencies": false,
      "CacheFolderKeys": true
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Synergos.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  }
}
