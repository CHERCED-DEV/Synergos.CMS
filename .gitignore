bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]uild/
[Ll]og/
[Ll]ogs/

# ───────────────────────── Visual Studio / Rider ─────────────────────
.vs/
.idea/
*.suo
