<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Los tests del ÁRBOL DEL CMS, y nada más. Referencia UN proyecto.

    Antes referenciaba veintiocho —las veinte capacidades, los cinco orquestadores, Core y
    Shared— y era el ÚNICO sitio del repo que unía los dos árboles: el grafo de producción ya
    estaba limpio (Synergos.CMS.Web sólo depende de Application e Interfaces), pero abrir la
    solución arrastraba el backend entero por esta vía. Los gates que de verdad necesitan ver
    los dos lados viven ahora en Synergos.Arquitectura.Tests, que es donde esa excepción está
    nombrada (#135).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Synergos.Arquitectura.Tests\SuiteCountTests.cs" Link="SuiteCountTests.cs" />
    <!-- Las convenciones de la suite (CA1707 por los nombres con guion bajo de xUnit, etc.)
         son de NIVEL DE ENSAMBLADO: viven una vez y se enlazan, o cada proyecto nuevo nace
         con mil ochocientos errores de nomenclatura y alguien los apaga por su cuenta. -->
    <Compile Include="..\Synergos.Arquitectura.Tests\GlobalSuppressions.cs" Link="GlobalSuppressions.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Synergos.CMS.Web\Synergos.CMS.Web.csproj" />
  </ItemGroup>

</Project>
