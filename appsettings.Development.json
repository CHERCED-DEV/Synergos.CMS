{
  "$schema": "appsettings-schema.json",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://synergos.local:5000"
      },
      "Https": {
        "Url": "https://synergos.local:5001",
        "Certificate": {
          "Path": "C:\\LOCAL_CDN\\synergos-dev.crt",
          "KeyPath": "C:\\LOCAL_CDN\\synergos-dev.key"
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Umbraco.Cms.Web.BackOffice.Controllers.DashboardController": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Synergos": {
    "Seed": {
      "Enabled": false
    },
    "Runtime": {
      "WebHost": "synergos.local",
      "HttpPort": 5000,
      "HttpsPort": 5001,
      "AllowedOrigins": [
        "https://static.synergos.local",
        "https://synergos-static-local",
        "http://localhost:4201",
        "https://localhost:4201"
      ]
    },
    "StaticAssets": {
      "Origin": "https://synergos-static-local",
      "UiBasePath": "/synergos",
      "UiFramework": "angular",
      "UiSlot": "latest",
      "RegistryLocalPath": "C:\\LOCAL_CDN",
      "RegistryManifest": "/synergos/registry.json",
      "ClientHosted": [ "elementCompHero" ]
    },
    "ElementServers": {
      "Overrides": {}
    }
  },
  "Umbraco": {
    "CMS": {
      "WebRouting": {
        "UmbracoApplicationUrl": "https://synergos.local:5001/"
      },
      "Content": {
        "MacroErrors": "Throw",
        "ShowDeprecatedPropertyEditors": false
      },
      "Hosting": {
        "Debug": true
      },
      "RuntimeMinification": {
        "UseInMemoryCache": true,
        "CacheBuster": "Timestamp"
      }
    }
  }
}
