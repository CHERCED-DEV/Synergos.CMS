# Synergos.CMS — shared editor configuration
# Applies to every project in the solution. Modifications require ADR approval.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[*.cs]
# Organize usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Naming conventions (minimal — CONTRIBUTING.md documents the full ruleset)
dotnet_naming_rule.interfaces_should_begin_with_i.severity = warning
dotnet_naming_rule.interfaces_should_begin_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_should_begin_with_i.style = interface_style
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.interface_style.required_prefix = I
dotnet_naming_style.interface_style.capitalization = pascal_case

# var preferences — explicit over implicit for readability
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Modern C# conventions
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = false:silent
csharp_new_line_before_open_brace = all

# Style/perf code analysis severities — silenciados para evitar log noise
# en cada build. Errores de compilación reales (CS*) siguen visibles.
# Si en el futuro queremos enforce, subir estos a "warning" o "suggestion".
dotnet_diagnostic.IDE0005.severity = warning   # unused using directive (sí útil)
dotnet_diagnostic.IDE0011.severity = none      # add braces to if/foreach
dotnet_diagnostic.CA1305.severity  = none      # IFormatProvider ausente
dotnet_diagnostic.CA1848.severity  = none      # LoggerMessage delegates (perf)
dotnet_diagnostic.CA1859.severity  = none      # devolver concrete type
dotnet_diagnostic.CA1861.severity  = none      # static readonly array args
dotnet_diagnostic.CA1873.severity  = none      # lazy logger arg evaluation
dotnet_diagnostic.CA1805.severity  = none      # explicit default initialization
# CS1574 (cref que no resuelve) NO está silenciado, y estuvo: esa línea decía
# `dotnet_diagnostic.CS1574.severity = none  # XML cref not resolved`, y detrás se pudrieron
# QUINCE crefs sin que nadie lo supiera — cinco nombres viejos de después de un rename, cuatro
# referencias hacia arriba que el grafo de dependencias prohíbe, dos miembros de otro record sin
# calificar, uno heredado de una interfaz base (un cref no las busca) y tres imports ausentes.
# Lo destapó que el CONTENEDOR sí los veía: este fichero no viajaba en el `COPY` del Dockerfile,
# así que dentro la supresión no existía y `TreatWarningsAsErrors` los convertía en errores. El
# `COPY` está arreglado, y con él ésta habría vuelto a tapar los quince. Si un cref nuevo pone el
# build rojo, se arregla el cref: no hay nada que un cref roto diga que valga la señal entera.
# Un cref a un tipo de OTRA capa se escribe calificado —añadir el `using` lo caza IDE0005, que
# sí es warning acá—, y a algo que este proyecto no puede ver, con `<c>`.
# NU1902 = GHSA-54mj-vcvj-q3v5 sobre Umbraco.Cms: moderate, y su rango vulnerable `(, 16.3.3]`
# no lo cierra ninguna version de la rama 13 (ADR 0001). NO se nombra aca la version clavada:
# vive en Directory.Packages.props y una copia mas es una copia mas que se desvia.
dotnet_diagnostic.NU1902.severity  = none      # Umbraco.Cms, sin patch en 13.x (ADR 0001)
