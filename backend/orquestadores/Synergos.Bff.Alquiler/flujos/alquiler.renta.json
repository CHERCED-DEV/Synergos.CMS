{
  "clave": "alquiler.renta",
  "entrada": ["inquilino", "equipo", "unidades", "ventana"],
  "tipos": {
    "inquilino": { "de": "sujeto" },
    "equipo": "texto",
    "unidades": { "lista": { "unidad": "entero" } },
    "ventana": "ventana",
    "contacto": { "de": "contacto" }
  },
  "salida": ["total", "garantia", "garantiaId", "cobroId", "ventana", "equipo", "cantidad"],
  "efimera": { "cerrar": ["contacto"] },
  "fases": {
    "abrir": [
      "tramo",
      "cotizar",
      "desglose",
      "cotizar-garantia",
      "desglose-garantia",
      "hallar",
      { "para_cada": "unidades", "como": "u", "pasos": ["apartar"] },
      "retener",
      "autorizar"
    ],
    "cerrar": [
      "capturar",
      "anotar",
      { "para_cada": "reservas:apartar", "como": "apartado", "pasos": ["confirmar"] },
      "conservar",
      "avisar"
    ]
  },
  "pasos": {
    "tramo": {
      "tipo": "alquiler.tramo",
      "lee": ["equipo", "unidades", "ventana"],
      "escribe": ["aCotizar", "garantiaACotizar", "recursoSujeto", "cantidad"]
    },
    "cotizar": { "tipo": "pricing.cotizar-sin-codigo", "lee": ["aCotizar"], "escribe": ["cotizacion"] },
    "desglose": {
      "tipo": "pricing.desglose",
      "lee": ["cotizacion"],
      "escribe": ["subtotal", "descuento", "impuesto", "total"]
    },
    "cotizar-garantia": {
      "tipo": "pricing.cotizar-sin-codigo",
      "lee": ["garantiaACotizar"],
      "escribe": ["cotizacionGarantia"]
    },
    "desglose-garantia": {
      "tipo": "pricing.desglose",
      "lee": ["cotizacionGarantia"],
      "escribe": ["garantiaSubtotal", "garantiaDescuento", "garantiaImpuesto", "garantia"]
    },
    "hallar": {
      "tipo": "booking.hallar",
      "lee": ["recursoSujeto"],
      "escribe": ["recursoId"],
      "motivo": "ese equipo no tiene unidades publicadas para alquilar"
    },
    "apartar": {
      "tipo": "booking.apartar-por-indice",
      "lee": ["recursoId", "ventana", "inquilino"],
      "escribe": ["u.apartadoId"],
      "llave_base": "hold",
      "motivo": "no quedan unidades del equipo en esas fechas",
      "reserva": {
        "consumado_por": "confirmar",
        "antes": "booking.liberar",
        "despues": "booking.cancelar",
        "motivo": "alquiler no confirmado"
      }
    },
    "retener": {
      "tipo": "payments.autorizar",
      "lee": ["inquilino", "garantia"],
      "escribe": ["garantiaId"],
      "llave": "deposit",
      "omitir_si_cero": "garantia",
      "motivo": "no se pudo retener la garantía",
      "reserva": {
        "consumado_por": "conservar",
        "antes": "payments.anular",
        "motivo": "alquiler no confirmado"
      }
    },
    "autorizar": {
      "tipo": "payments.autorizar",
      "lee": ["inquilino", "total"],
      "escribe": ["cobroId"],
      "llave": "rental",
      "motivo": "no se pudo autorizar el alquiler",
      "reserva": {
        "consumado_por": "capturar",
        "antes": "payments.anular",
        "despues": "payments.devolver",
        "motivo": "alquiler no confirmado"
      }
    },
    "capturar": {
      "tipo": "payments.capturar",
      "lee": ["cobroId"],
      "llave": "capture",
      "cierra_reserva": "autorizar",
      "motivo": "no se pudo cobrar el alquiler"
    },
    "confirmar": {
      "tipo": "booking.confirmar-por-indice",
      "lee": ["apartado.holdId"],
      "escribe": ["apartado.reservaId"],
      "llave_base": "confirm",
      "cierra_reserva": "apartar",
      "motivo": "no se pudo confirmar una unidad"
    },
    "anotar": { "tipo": "alquiler.anotar", "lee": ["inquilino"] },
    "conservar": {
      "tipo": "alquiler.conservar-garantia",
      "lee": ["garantiaId"],
      "cierra_reserva": "retener",
      "motivo": "no se pudo dejar retenida la garantía"
    },
    "avisar": {
      "tipo": "notifications.avisar",
      "lee": ["inquilino", "contacto", "total"],
      "llave": "avisar",
      "plantilla": "alquiler.renta.confirmada",
      "al_fallar": "seguir"
    }
  }
}
