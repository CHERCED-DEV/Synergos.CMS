<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Orquestador. Habla con las capacidades por HTTP y NO referencia ninguna
         Synergos.Api.*: si pudiera llamarlas en proceso, la capacidad sería una
         carpeta con ínfulas. Ver docs/product/06 §4. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\nucleo\Synergos.Core\Synergos.Core.csproj" />
    <ProjectReference Include="..\..\nucleo\Synergos.Shared\Synergos.Shared.csproj" />
    <ProjectReference Include="..\Synergos.Bff.Core\Synergos.Bff.Core.csproj" />
    <!-- Los pasos sobre capacidades que interpreta su flujo declarado (ADR 0140; línea 006). -->
    <ProjectReference Include="..\Synergos.Bff.Pasos\Synergos.Bff.Pasos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los flujos declarados viajan DENTRO del ensamblado (ADR 0140), fuera de Content. -->
    <Content Remove="flujos\**" />
    <EmbeddedResource Include="flujos\*.json" LogicalName="flujos/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
