{
  "clave": "viajes.reserva",
  "entrada": ["viajero", "items"],
  "tipos": {
    "viajero": { "de": "sujeto" },
    "items": { "lista": { "producto": "texto", "etiqueta": "texto?", "ventana": "ventana", "porNoche": "booleano?" } },
    "contacto": { "de": "contacto" }
  },
  "salida": ["itinerario", "subtotal", "descuento", "impuesto", "total", "vence"],
  "para_lo_posterior": ["cobroId", "total", "reservas:apartar"],
  "efimera": { "cerrar": ["contacto"] },
  "fases": {
    "abrir": [
      "revisar",
      "cotizar",
      "desglose",
      { "para_cada": "items", "como": "item", "pasos": ["recurso", "hallar", "apartar"] },
      "vence",
      "autorizar"
    ],
    "cerrar": [
      "capturar",
      { "para_cada": "reservas:apartar", "como": "hold", "pasos": ["confirmar"] },
      "avisar"
    ]
  },
  "pasos": {
    "revisar": { "tipo": "viajes.revisar-itinerario", "lee": ["items"], "escribe": ["aCotizar", "itinerario"] },
    "cotizar": { "tipo": "pricing.cotizar-sin-codigo", "lee": ["aCotizar"], "escribe": ["cotizacion"] },
    "desglose": { "tipo": "pricing.desglose", "lee": ["cotizacion"], "escribe": ["subtotal", "descuento", "impuesto", "total"] },
    "recurso": { "tipo": "viajes.sujeto-del-producto", "lee": ["item.producto"], "escribe": ["item.recursoSujeto"] },
    "hallar": {
      "tipo": "booking.hallar",
      "lee": ["item.recursoSujeto"],
      "escribe": ["item.recursoId"],
      "motivo": "el producto no tiene recurso reservable"
    },
    "apartar": {
      "tipo": "booking.apartar-por-indice",
      "lee": ["item.recursoId", "item.ventana", "viajero"],
      "escribe": ["item.apartadoId", "item.vence"],
      "llave_base": "hold",
      "motivo": "un ítem del viaje no está disponible",
      "reserva": {
        "consumado_por": "confirmar",
        "antes": "booking.liberar",
        "despues": "booking.cancelar",
        "motivo": "viaje no confirmado"
      }
    },
    "vence": { "tipo": "viajes.vence", "lee": ["items"], "escribe": ["vence"] },
    "autorizar": {
      "tipo": "payments.autorizar",
      "lee": ["viajero", "total"],
      "escribe": ["cobroId"],
      "llave": "authorize",
      "omitir_si_cero": "total",
      "motivo": "el cobro no se pudo autorizar",
      "reserva": {
        "consumado_por": "capturar",
        "antes": "payments.anular",
        "despues": "payments.devolver",
        "motivo": "viaje no confirmado"
      }
    },
    "capturar": {
      "tipo": "payments.capturar",
      "lee": ["cobroId"],
      "llave": "capture",
      "cierra_reserva": "autorizar",
      "motivo": "el cobro no se pudo capturar"
    },
    "confirmar": {
      "tipo": "booking.confirmar-por-indice",
      "lee": ["hold.holdId"],
      "escribe": ["hold.reservaId"],
      "llave_base": "confirm",
      "cierra_reserva": "apartar",
      "motivo": "un ítem no se pudo confirmar tras cobrar"
    },
    "avisar": {
      "tipo": "notifications.avisar",
      "lee": ["viajero", "contacto", "total"],
      "llave": "avisar",
      "plantilla": "viajes.reserva.confirmada",
      "al_fallar": "seguir"
    }
  }
}
