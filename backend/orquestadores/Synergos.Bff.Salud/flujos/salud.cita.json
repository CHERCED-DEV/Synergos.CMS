{
  "clave": "salud.cita",
  "entrada": ["paciente", "profesional", "ventana", "servicio"],
  "tipos": {
    "paciente": { "de": "sujeto" },
    "profesional": "ref",
    "ventana": "ventana",
    "servicio": { "de": "negocio", "campo": "servicio", "tipo": "ref" },
    "contacto": { "de": "contacto" }
  },
  "salida": ["profesional", "ventana", "total", "reservaId"],
  "efimera": { "cerrar": ["contacto"] },
  "fases": {
    "abrir": ["permiso", "lineas", "copago", "desglose", "agenda", "apartar", "autorizar"],
    "cerrar": ["capturar", "confirmar", "avisar"]
  },
  "pasos": {
    "permiso": { "tipo": "salud.permiso", "lee": ["paciente"] },
    "lineas": { "tipo": "forma.una-linea", "lee": ["servicio"], "escribe": ["aCotizar"] },
    "copago": { "tipo": "pricing.cotizar-o-cero", "lee": ["aCotizar"], "escribe": ["cotizacion"] },
    "desglose": { "tipo": "pricing.desglose", "lee": ["cotizacion"], "escribe": ["subtotal", "descuento", "impuesto", "total"] },
    "agenda": {
      "tipo": "booking.hallar",
      "lee": ["profesional"],
      "escribe": ["recursoId"],
      "motivo": "el profesional no tiene agenda"
    },
    "apartar": {
      "tipo": "booking.apartar",
      "lee": ["recursoId", "ventana", "paciente"],
      "escribe": ["apartadoId"],
      "llave": "hold",
      "motivo": "no se pudo apartar la franja",
      "reserva": {
        "consumado_por": "confirmar",
        "antes": "booking.liberar",
        "motivo": "cita no confirmada"
      }
    },
    "autorizar": {
      "tipo": "payments.autorizar",
      "lee": ["paciente", "total"],
      "escribe": ["cobroId"],
      "llave": "authorize",
      "omitir_si_cero": "total",
      "motivo": "el cobro no se pudo autorizar",
      "reserva": {
        "consumado_por": "capturar",
        "antes": "payments.anular",
        "despues": "payments.devolver",
        "motivo": "cita no confirmada"
      }
    },
    "capturar": {
      "tipo": "payments.capturar",
      "lee": ["cobroId"],
      "llave": "capture",
      "cierra_reserva": "autorizar",
      "motivo": "el cobro no se pudo capturar"
    },
    "confirmar": {
      "tipo": "booking.confirmar",
      "lee": ["apartadoId"],
      "escribe": ["reservaId"],
      "llave": "confirm",
      "cierra_reserva": "apartar",
      "motivo": "la cita no se pudo confirmar tras cobrar"
    },
    "avisar": {
      "tipo": "notifications.avisar",
      "lee": ["paciente", "contacto", "total"],
      "llave": "avisar",
      "plantilla": "salud.cita.confirmada",
      "al_fallar": "seguir"
    }
  }
}
