<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Orquestador del caso común (011-booking-reserva): la reserva de un servicio por franja. Habla
         con las capacidades por HTTP y NO referencia ninguna Synergos.Api.*. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\nucleo\Synergos.Core\Synergos.Core.csproj" />
    <ProjectReference Include="..\..\nucleo\Synergos.Shared\Synergos.Shared.csproj" />
    <ProjectReference Include="..\Synergos.Bff.Core\Synergos.Bff.Core.csproj" />
    <ProjectReference Include="..\Synergos.Bff.Pasos\Synergos.Bff.Pasos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- El flujo declarado viaja DENTRO del ensamblado (ADR 0140), como el de Eventos. -->
    <Content Remove="flujos\**" />
    <EmbeddedResource Include="flujos\*.json" LogicalName="flujos/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
