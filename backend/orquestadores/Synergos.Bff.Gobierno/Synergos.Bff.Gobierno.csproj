<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Orquestador del caso común (009-gobierno-tramite): el trámite de gobierno por la puerta, radicar con la
         tasa publicada y los actos sobre el expediente. Habla con las capacidades por HTTP y NO referencia
         ninguna Synergos.Api.*. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\nucleo\Synergos.Core\Synergos.Core.csproj" />
    <ProjectReference Include="..\..\nucleo\Synergos.Shared\Synergos.Shared.csproj" />
    <ProjectReference Include="..\Synergos.Bff.Core\Synergos.Bff.Core.csproj" />
    <ProjectReference Include="..\Synergos.Bff.Pasos\Synergos.Bff.Pasos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los flujos declarados viajan DENTRO del ensamblado (ADR 0140), como el de Eventos. -->
    <Content Remove="flujos\**" />
    <EmbeddedResource Include="flujos\*.json" LogicalName="flujos/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
