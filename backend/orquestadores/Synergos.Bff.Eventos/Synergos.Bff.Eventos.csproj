<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Orquestador. Habla con las capacidades por HTTP y NO referencia ninguna
         Synergos.Api.*: si pudiera llamarlas en proceso, la capacidad sería una
         carpeta con ínfulas. Ver docs/product/06 §4. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\nucleo\Synergos.Core\Synergos.Core.csproj" />
    <ProjectReference Include="..\..\nucleo\Synergos.Shared\Synergos.Shared.csproj" />
    <ProjectReference Include="..\Synergos.Bff.Core\Synergos.Bff.Core.csproj" />
    <!-- La única Synergos.Bff.* que un orquestador puede referenciar además de Bff.Core:
         los pasos sobre capacidades que interpreta su flujo declarado (ADR 0140). -->
    <ProjectReference Include="..\Synergos.Bff.Pasos\Synergos.Bff.Pasos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los flujos declarados viajan DENTRO del ensamblado (ADR 0140): un despliegue no puede
         quedar con el binario de una versión y la definición de otra. Fuera de Content, que el
         SDK Web le pone a todo .json, para que no salgan además sueltos en la publicación. -->
    <Content Remove="flujos\**" />
    <EmbeddedResource Include="flujos\*.json" LogicalName="flujos/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
