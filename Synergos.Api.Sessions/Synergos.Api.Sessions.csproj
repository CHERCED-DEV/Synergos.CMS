<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Sin referencia a Synergos.CMS.*: el acople es el contrato HTTP, no un
         ensamblado compartido. Si algún día este servicio se muda a su propio
         repo, esto es lo único que hay que mover. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Fontanería de host sin dominio (llave compartida, ventanas de consulta).
         Viaja con el servicio si algún día se muda de repo. -->
    <ProjectReference Include="..\Synergos.Shared\Synergos.Shared.csproj" />
  </ItemGroup>

</Project>
